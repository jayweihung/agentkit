    top=$(GIT_OPTIONAL_LOCKS=0 "$g" -C "$1" rev-parse --show-toplevel 2>/dev/null) && [ -n "$top" ] || return 0
    GIT_OPTIONAL_LOCKS=0 "$g" -C "$1" status --porcelain -z --ignore-submodules=all 2>/dev/null | tr '\0' '\n' |
        FILES_TOP=$top LC_ALL=C awk 'BEGIN { top = ENVIRON["FILES_TOP"] } skip { skip = 0; next }
            length($0) > 3 { if (substr($0, 1, 2) ~ /[RC]/) skip = 1; print "git\t" top "/" substr($0, 4) }'
