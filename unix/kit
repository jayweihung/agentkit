#!/usr/bin/env bash
# kit - manage rules, skills, MCP servers, tool permissions and agents
# for AI coding tools. Linux and macOS version (bash 3.2+, POSIX awk).
#
# No network access except the git URLs you give it, and only to hosts
# allowed by the sources' kit.yaml (allowed_hosts).

set -u
KIT_LIB=$(cd "$(dirname "$0")" && pwd)
[ -f "$KIT_LIB/json.awk" ] || KIT_LIB=$(cd "$(dirname "$(readlink "$0" 2>/dev/null || echo "$0")")" && pwd)
KIT_VERSION=$(cat "$KIT_LIB/VERSION" 2>/dev/null || cat "$KIT_LIB/../VERSION" 2>/dev/null || echo dev)
KIT_CONF=${AGENTKIT_CONFIG:-$HOME/.config/agentkit}
KIT_SRC=${AGENTKIT_SOURCES:-$HOME/agentkit}
MACHINE="$KIT_CONF/machine.yaml"
STATE="$KIT_CONF/state.tsv"
if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    CLAUDE_DIR=$CLAUDE_CONFIG_DIR; CLAUDE_JSON=$CLAUDE_CONFIG_DIR/.claude.json
else
    CLAUDE_DIR=$HOME/.claude; CLAUDE_JSON=$HOME/.claude.json
fi
CODEX_DIR=${CODEX_HOME:-$HOME/.codex}
OMP_DIR=${PI_CODING_AGENT_DIR:-$HOME/.omp/agent}
AGENTS_SKILLS=$HOME/.agents/skills          # read by Codex and omp
TAB=$(printf '\t')
BEGIN_MARK='<!-- agentkit:begin (managed by kit, do not edit) -->'
END_MARK='<!-- agentkit:end -->'
TOML_BEGIN='# agentkit:begin (managed by kit, do not edit)'
TOML_END='# agentkit:end'
KINDS="rule skill mcp agent"

# ---------- small helpers ----------
die()  { printf 'kit: %s\n' "$*" >&2; exit 1; }
say()  { [ -n "${QUIET:-}" ] || printf '%s\n' "$*"; }
warn() { printf 'kit: %s\n' "$*" >&2; }

yaml()     { LC_ALL=C awk -f "$KIT_LIB/yaml.awk" "$@"; }
# yget FILE PATH -> values (one per line) for PATH or PATH[]
yget() { [ -f "$1" ] || return 0; yaml "$1" | awk -F'\t' -v p="$2" '$1 == p || $1 == p "[]" { sub(/^[^\t]*\t/, ""); print }'; }

json_edit() { # json_edit FILE OPSFILE : edit FILE, keep a backup
    # Other programs (a running Claude) may write FILE at any time, so:
    # edit a snapshot, and only swap the result in (atomic rename) if FILE did
    # not change meanwhile; otherwise try again.
    local f=$1 ops=$2 snap tmp try new=0
    [ -f "$f" ] || { mkdir -p "$(dirname "$f")"; printf '{}\n' > "$f"; new=1; }
    snap=$(mktemp "$f.kit.XXXXXX") || die "cannot write next to $f"
    tmp=$(mktemp "$f.kit.XXXXXX") || { rm -f "$snap"; die "cannot write next to $f"; }
    for try in 1 2 3 4 5; do
        cp -p "$f" "$snap" && cp -p "$f" "$tmp" || break     # tmp gets f's permissions
        if ! { LC_ALL=C awk -f "$KIT_LIB/json.awk" -v ops="$ops" "$snap" > "$tmp" &&
               LC_ALL=C awk -f "$KIT_LIB/json.awk" "$tmp" > /dev/null; }; then
            rm -f "$snap" "$tmp"; die "沒辦法更新 ${f}（檔案沒有被改動）"
        fi
        if cmp -s "$snap" "$f"; then
            [ $new = 1 ] || cp -p "$snap" "$f.kit-backup" 2>/dev/null
            if [ -L "$f" ]; then cat "$tmp" > "$f"; rm -f "$tmp"; else mv -f "$tmp" "$f"; fi
            rm -f "$snap"; return 0
        fi
        sleep 1                                             # someone else wrote it; retry
    done
    rm -f "$snap" "$tmp"; die "沒辦法更新 ${f}：別的程式一直在寫它（檔案沒有被改動）"
}
prune_empty() { # prune_empty FILE PATH... : delete each PATH whose value is [] or {} (in order)
    local f=$1 p v ops; shift
    [ -f "$f" ] || return 0
    ops=$(mktemp)
    for p in "$@"; do
        v=$(json_get "$f" "$p" | tr -d ' \n')
        if [ "$v" = "[]" ] || [ "$v" = "{}" ]; then printf 'del\t%s\n' "$p" > "$ops"; json_edit "$f" "$ops"; fi
    done
    rm -f "$ops"
}
prune_deny() { prune_empty "$CLAUDE_DIR/settings.json" permissions.deny permissions hooks.SessionStart hooks; }

json_get() { LC_ALL=C awk -f "$KIT_LIB/json.awk" -v get="$2" "$1" 2>/dev/null; }

json_str() { # quote a string for JSON
    local s=$1
    s=${s//\\/\\\\}; s=${s//\"/\\\"}
    s=${s//$TAB/\\t}
    printf '"%s"' "$s"
}

dir_hash() { # content hash of a directory (portable: cksum)
    ( cd "$1" && find . -type f ! -name '.DS_Store' | LC_ALL=C sort | while IFS= read -r f; do printf '%s ' "$f"; cksum < "$f"; done ) | cksum | awk '{print $1}'
}

# ---------- state ----------
# state.tsv lines: kind<TAB>name<TAB>detail
state_get() { [ -f "$STATE" ] && awk -F'\t' -v k="$1" -v n="$2" '$1 == k && $2 == n { print $3; exit }' "$STATE"; }
state_list() { [ -f "$STATE" ] && awk -F'\t' -v k="$1" '$1 == k { print $2 }' "$STATE"; }
state_set() {
    mkdir -p "$KIT_CONF"; touch "$STATE"
    awk -F'\t' -v k="$1" -v n="$2" '!($1 == k && $2 == n)' "$STATE" > "$STATE.tmp"
    [ $# -ge 3 ] && printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$STATE.tmp"
    mv "$STATE.tmp" "$STATE"
}
state_del() { [ -f "$STATE" ] || return 0; awk -F'\t' -v k="$1" -v n="$2" '!($1 == k && $2 == n)' "$STATE" > "$STATE.tmp"; mv "$STATE.tmp" "$STATE"; }

# ---------- machine.yaml ----------
m_sources() { yget "$MACHINE" sources; }
M_APPROVALS=$(yget "$MACHINE" approvals 2>/dev/null); M_SIGNERS=$(yget "$MACHINE" signers 2>/dev/null)
m_added()   { yget "$MACHINE" added; }
m_removed() { yget "$MACHINE" removed; }

write_machine() { # write_machine SOURCES ADDED REMOVED (newline separated lists)
    mkdir -p "$KIT_CONF"
    {
        echo "# written by kit - use kit add / kit rm instead of editing"
        echo "sources:            # earlier sources win when names repeat"
        printf '%s\n' "$1" | awk 'NF { print "  - " $0 }'
        printf 'added: [%s]\n'   "$(printf '%s\n' "$2" | awk 'NF' | paste -sd, - | sed 's/,/, /g')"
        printf 'removed: [%s]    # kit rm; sync will not add these back\n' "$(printf '%s\n' "$3" | awk 'NF' | paste -sd, - | sed 's/,/, /g')"
        if [ -n "${M_APPROVALS:-}" ]; then
            echo "# only signed, approved versions of the sources are used (kit approve)"
            printf 'approvals: %s\nsigners: %s\n' "$M_APPROVALS" "$M_SIGNERS"
        fi
    } > "$MACHINE.tmp" && mv "$MACHINE.tmp" "$MACHINE"
}

# ---------- sources ----------
is_url() { case $1 in *://*|*@*:*) return 0;; *) return 1;; esac; }
url_host() { printf '%s\n' "$1" | sed -E 's#^[a-z+]+://##; s#^[^@/]*@##; s#[:/].*$##'; }
src_name() { basename "$1" .git; }
src_dir() { # local checkout of a source
    if is_url "$1"; then printf '%s/%s\n' "$KIT_SRC" "$(src_name "$1")"; else (cd "$1" 2>/dev/null && pwd) || printf '%s\n' "$1"; fi
}
src_dirs() { m_sources | while IFS= read -r s; do src_dir "$s"; done; }

allowed_hosts() { # from the configured sources (+ the source kit push sends from)
    { [ -f "$MACHINE" ] && src_dirs; [ -n "${PUSH_DIR:-}" ] && printf '%s\n' "$PUSH_DIR"; } | while IFS= read -r d; do yget "$d/kit.yaml" allowed_hosts; done | awk 'NF && !seen[$0]++'
}

check_host() { # refuse URLs whose host is not allowed
    local url=$1 hosts h
    is_url "$url" || return 0
    hosts=$(allowed_hosts)
    [ -n "$hosts" ] || return 0
    h=$(url_host "$url")
    printf '%s\n' "$hosts" | grep -qxF "$h" || die "$h 不在允許的主機清單：$(printf '%s' "$hosts" | paste -sd' ' -)"
    # git config "insteadOf" rules can rewrite a URL; check where git really goes
    local real; real=$(git ls-remote --get-url "$url" 2>/dev/null)
    [ -z "$real" ] || [ "$real" = "$url" ] || { h=$(url_host "$real"); printf '%s\n' "$hosts" | grep -qxF "$h" || die "git 設定把網址改到 ${h}，不在允許的主機清單"; }
    return 0
}

git_safe() { # git without prompts, submodules or LFS downloads
    GIT_TERMINAL_PROMPT=0 GIT_LFS_SKIP_SMUDGE=1 git "$@"
}

# ---------- signed approvals (for accounts, like root, that must not follow sources blindly) ----------
# approved.txt (in the approvals repo) lists "<repo name> <commit>" lines and "serial: N";
# approved.txt.sig is an ssh signature (namespace agentkit) checked against the signers file.
APPROVED=""; APPROVED_READ=""
approvals_dir() { printf '%s/.approvals\n' "$KIT_SRC"; }
read_approvals() { # sets APPROVED ("name sha" lines); returns 1 when there is no valid signed list
    [ -n "$APPROVED_READ" ] && { [ -n "$APPROVED" ]; return; }
    APPROVED_READ=1
    local d f p serial old
    d=$(approvals_dir)
    if is_url "$M_APPROVALS"; then
        check_host "$M_APPROVALS"
        if [ -d "$d/.git" ]; then git_safe -C "$d" pull --ff-only -q --no-recurse-submodules || warn "沒辦法更新核准紀錄（沒網路？）"
        else mkdir -p "$KIT_SRC"; git_safe clone -q --no-recurse-submodules "$M_APPROVALS" "$d" || { warn "沒辦法 clone 核准紀錄 $M_APPROVALS"; return 1; }; fi
    else d=$M_APPROVALS; fi
    f="$d/approved.txt"
    [ -f "$f" ] && [ -f "$f.sig" ] || { warn "核准紀錄裡沒有 approved.txt 和 approved.txt.sig"; return 1; }
    [ -f "$M_SIGNERS" ] || { warn "找不到 signers 檔：$M_SIGNERS"; return 1; }
    p=$(ssh-keygen -Y find-principals -s "$f.sig" -f "$M_SIGNERS" 2>/dev/null | head -n 1)
    if [ -z "$p" ] || ! ssh-keygen -Y verify -f "$M_SIGNERS" -I "$p" -n agentkit -s "$f.sig" < "$f" >/dev/null 2>&1; then
        warn "核准紀錄的簽章不對，不換版本（有人改過 approved.txt？）"; return 1
    fi
    serial=$(awk '$1 == "serial:" { print $2; exit }' "$f"); old=$(state_get approvals serial)
    case $serial in ""|*[!0-9]*) warn "核准紀錄沒有 serial"; return 1;; esac
    if [ -n "$old" ] && [ "$serial" -lt "$old" ]; then warn "核准紀錄比上次用的舊（serial ${serial} < ${old}），不換版本"; return 1; fi
    state_set approvals serial "$serial"
    APPROVED=$(awk 'NF == 2 && $1 !~ /^#/ && $1 != "serial:"' "$f")
    [ -n "$APPROVED" ]
}
approved_sha() { # approved_sha NAME
    read_approvals || return 1
    printf '%s\n' "$APPROVED" | awk -v n="$1" '$1 == n { print $2; exit }' | grep .
}
fetch_approved() { # fetch_approved URL DIR : check out the approved commit of a source, never anything else
    local s=$1 d=$2 n sha cur
    n=$(src_name "$s")
    if ! sha=$(approved_sha "$n"); then
        [ -d "$d/.git" ] && { warn "$n 沒有有效的核准，繼續用現在的版本"; return 0; }
        die "$n 還沒核准，不能用（先在 Mac 上 kit approve）"
    fi
    if [ -d "$d/.git" ]; then git_safe -C "$d" fetch -q --no-recurse-submodules origin || warn "沒辦法更新 ${n}（沒網路？）"
    else mkdir -p "$KIT_SRC"; git_safe clone -q --no-checkout --no-recurse-submodules "$s" "$d" || die "沒辦法 clone $s"; fi
    cur=$(git -C "$d" rev-parse -q --verify HEAD 2>/dev/null)
    [ "$cur" = "$sha" ] && [ -z "$(git -C "$d" status --porcelain 2>/dev/null)" ] && return 0
    git -C "$d" -c advice.detachedHead=false checkout -q -f --detach "$sha" 2>/dev/null || { warn "$n 找不到核准的版本 $(printf %.12s "$sha")（還沒 push？），繼續用現在的版本"; return 0; }
    git -C "$d" clean -qfdx
    say "kit：$n 換到核准的版本 $(printf %.12s "$sha")"
}

fetch_source() { # clone or fast-forward one source
    local s=$1 d
    is_url "$s" || { [ -d "$s" ] || die "找不到來源資料夾：$s"; return 0; }
    check_host "$s"
    d=$(src_dir "$s")
    [ -n "$M_APPROVALS" ] && { fetch_approved "$s" "$d"; return 0; }
    if [ -d "$d/.git" ]; then
        git_safe -C "$d" pull --ff-only --quiet --no-recurse-submodules || warn "沒辦法更新 $(src_name "$s")（沒網路？）"
    else
        mkdir -p "$KIT_SRC"
        git_safe clone --quiet --no-recurse-submodules "$s" "$d" || die "沒辦法 clone $s"
    fi
}

item_path() { # item_path DIR KIND NAME
    case $2 in
        rule)  printf '%s/rules/%s.md\n' "$1" "$3";;
        skill) printf '%s/skills/%s/SKILL.md\n' "$1" "$3";;
        mcp)   printf '%s/mcp/%s.yaml\n' "$1" "$3";;
        agent) printf '%s/agents/%s.md\n' "$1" "$3";;
    esac
}
find_item() { # find_item KIND NAME -> path of the first source that has it
    local d p
    while IFS= read -r d; do
        p=$(item_path "$d" "$1" "$2")
        [ -f "$p" ] && { printf '%s\n' "$p"; return 0; }
    done <<EOF
$(src_dirs)
EOF
    return 1
}
available() { # all kind:name in all sources
    src_dirs | while IFS= read -r d; do
        for f in "$d"/rules/*.md;          do [ -f "$f" ] && echo "rule:$(basename "$f" .md)"; done
        for f in "$d"/skills/*/SKILL.md;   do [ -f "$f" ] && echo "skill:$(basename "$(dirname "$f")")"; done
        for f in "$d"/mcp/*.yaml;          do [ -f "$f" ] && echo "mcp:$(basename "$f" .yaml)"; done
        for f in "$d"/agents/*.md;         do [ -f "$f" ] && echo "agent:$(basename "$f" .md)"; done
    done | awk '!seen[$0]++'
}
required_items() {
    src_dirs | while IFS= read -r d; do
        for k in rule skill mcp; do yget "$d/kit.yaml" "required.${k}s" | sed "s/^/$k:/"; done
    done | awk 'NF && !seen[$0]++'
}
recommended_items() {
    src_dirs | while IFS= read -r d; do
        for k in rule skill mcp; do yget "$d/kit.yaml" "recommended.${k}s" | sed "s/^/$k:/"; done
    done | awk 'NF && !seen[$0]++'
}
required_deny() { src_dirs | while IFS= read -r d; do yget "$d/kit.yaml" required.tools.deny; done | awk 'NF && !seen[$0]++'; }

wanted() { # required + added - removed(non-required)
    { required_items; m_added | grep -vxF -f <(m_removed; echo '##none##'); } | awk 'NF && !seen[$0]++'
}

# ---------- MCP yaml -> JSON ----------
mcp_json() { # mcp_json FILE -> {"command":..,"args":[..],"env":{..}}
    local f=$1 out cmd first a
    cmd=$(yget "$f" command)
    [ -n "$cmd" ] || { warn "$f has no command"; return 1; }
    out="{\"command\":$(json_str "$cmd"),\"args\":["
    first=1
    while IFS= read -r a; do
        [ -n "$a" ] || continue
        [ $first = 1 ] || out="$out,"; first=0; out="$out$(json_str "$a")"
    done <<EOF
$(yget "$f" args)
EOF
    out="$out]"
    local envs
    envs=$(yaml "$f" | awk -F'\t' '$1 ~ /^env\./ { k = substr($1, 5); sub(/^[^\t]*\t/, ""); print k "\t" $0 }')
    if [ -n "$envs" ]; then
        out="$out,\"env\":{"; first=1
        while IFS="$TAB" read -r k v; do
            [ $first = 1 ] || out="$out,"; first=0; out="$out$(json_str "$k"):$(json_str "$v")"
        done <<EOF
$envs
EOF
        out="$out}"
    fi
    printf '%s}\n' "$out"
}

# ---------- apply to Claude Code ----------
has_codex() { [ -d "$CODEX_DIR" ] || command -v codex >/dev/null 2>&1; }
has_omp()   { [ -d "$OMP_DIR" ] || [ -d "$HOME/.omp" ] || command -v omp >/dev/null 2>&1; }
targets()   { printf 'Claude'; has_codex && printf '、Codex'; has_omp && printf '、omp'; echo; }

replace_block() { # replace_block FILE BEGIN END : put $KIT_BLOCK between the markers, at the end of FILE
    # The block has newlines, which "awk -v" refuses on BSD awk; it comes in via the environment.
    local f=$1 tmp
    if [ ! -f "$f" ]; then [ -n "${KIT_BLOCK:-}" ] || return 0; mkdir -p "$(dirname "$f")"; : > "$f"; fi
    tmp="$f.kit.tmp"; cp -p "$f" "$tmp"                      # keep the file's permissions
    awk -v b="$2" -v e="$3" '
        $0 == b { skip = 1; next }
        $0 == e { skip = 0; next }
        !skip { lines[++n] = $0 }
        END {
            body = ENVIRON["KIT_BLOCK"]
            if (body != "" && substr(body, length(body)) != "\n") body = body "\n"
            while (n > 0 && lines[n] == "") n--
            for (i = 1; i <= n; i++) print lines[i]
            if (body != "") { if (n > 0) print ""; print b; printf "%s", body; print e }
        }' "$f" > "$tmp" || { rm -f "$tmp"; return 1; }
    if cmp -s "$tmp" "$f"; then rm -f "$tmp"
    elif [ -s "$tmp" ]; then mv -f "$tmp" "$f"
    else rm -f "$tmp" "$f"                                    # nothing left: kit made it
    fi
}

rules_body() { # rules_body import|inline : rule names on stdin -> text for the instructions file
    local n p
    while IFS= read -r n; do
        [ -n "$n" ] || continue
        p=$(find_item rule "$n") || { warn "rule $n not found in any source"; continue; }
        if [ "$1" = import ]; then printf '@%s\n' "$p"
        else printf '<!-- rule: %s -->\n' "$n"; cat "$p"; [ -z "$(tail -c1 "$p")" ] || echo; fi
    done
}

set_rules() { # set_rules FILE import|inline : rule names on stdin
    local f=$1 body
    body=$(rules_body "$2")
    KIT_BLOCK="$body" replace_block "$f" "$BEGIN_MARK" "$END_MARK"
}

sync_skills() { # sync_skills DIR STATEKIND : copy wanted skills (names on stdin) into DIR
    local dir=$1 kind=$2 names n p dst h old
    names=$(cat)
    [ -n "$names" ] && mkdir -p "$dir"
    for n in $names; do
        p=$(find_item skill "$n") || { warn "skill $n not found in any source"; continue; }
        p=$(dirname "$p"); dst="$dir/$n"; h=$(dir_hash "$p")
        old=$(state_get "$kind" "$n")
        if [ -e "$dst" ] && [ -z "$old" ]; then
            # someone else's folder: say it once, not at every sync
            [ -n "$(state_get skipped "$dst")" ] || { warn "$dst 已經存在，不是 kit 放的，跳過（只提醒這一次）"; state_set skipped "$dst" 1; }
            continue
        fi
        state_del skipped "$dst"
        if [ -n "$old" ] && [ -d "$dst" ] && [ "$(dir_hash "$dst")" != "$old" ] && [ -z "${FORCE:-}" ]; then
            warn "skill ${n}（${dir}）被手動改過，跳過（kit sync --force 會蓋掉）"; continue
        fi
        [ "$h" = "$old" ] && [ -d "$dst" ] && continue
        rm -rf "$dst"; cp -R "$p" "$dst"; state_set "$kind" "$n" "$h"; say "  skill $n → $dir"
    done
    for n in $(state_list "$kind"); do
        printf '%s\n' "$names" | grep -qxF "$n" && continue
        rm -rf "$dir/$n"; state_del "$kind" "$n"; say "  removed skill $n ← $dir"
    done
}

sync_mcp_json() { # sync_mcp_json FILE STATEKIND : wanted MCP names on stdin -> FILE's mcpServers
    local f=$1 kind=$2 names n p k sum ops
    names=$(cat); ops=$(mktemp)
    for n in $names; do
        p=$(find_item mcp "$n") || { warn "mcp $n not found in any source"; continue; }
        k=$(mcp_json "$p") || continue
        sum=$(printf '%s' "$k" | cksum | awk '{print $1}')
        [ "$(state_get "$kind" "$n")" = "$sum" ] && continue
        printf 'set\tmcpServers.%s\t%s\n' "$n" "$k" >> "$ops"; state_set "$kind" "$n" "$sum"; say "  mcp $n → $f"
    done
    for n in $(state_list "$kind"); do
        printf '%s\n' "$names" | grep -qxF "$n" && continue
        printf 'del\tmcpServers.%s\n' "$n" >> "$ops"; state_del "$kind" "$n"; say "  removed mcp $n ← $f"
    done
    [ -s "$ops" ] && { mkdir -p "$(dirname "$f")"; json_edit "$f" "$ops"; prune_empty "$f" mcpServers; }
    rm -f "$ops"
}

toml_key() { case $1 in *[!A-Za-z0-9_-]*|"") json_str "$1";; *) printf '%s' "$1";; esac; }

codex_mcp_toml() { # wanted MCP names on stdin -> [mcp_servers.x] tables for Codex
    local names n p cmd a first out tools t user
    names=$(cat)
    user=$(awk -v b="$TOML_BEGIN" -v e="$TOML_END" '$0 == b { s = 1 } !s { print } $0 == e { s = 0 }' "$CODEX_DIR/config.toml" 2>/dev/null)
    for n in $names; do
        p=$(find_item mcp "$n") || { warn "mcp $n not found in any source"; continue; }
        cmd=$(yget "$p" command); [ -n "$cmd" ] || { warn "$p has no command"; continue; }
        if printf '%s\n' "$user" | grep -qE "^[[:space:]]*\[mcp_servers\.\"?$n\"?[]. ]"; then
            warn "Codex 的 config.toml 已經有自己的 mcp_servers.${n}，kit 不動它"; continue
        fi
        printf '[mcp_servers.%s]\ncommand = %s\n' "$(toml_key "$n")" "$(json_str "$cmd")"
        out=""; first=1
        while IFS= read -r a; do [ -n "$a" ] || continue; [ $first = 1 ] || out="$out, "; first=0; out="$out$(json_str "$a")"; done <<EOF
$(yget "$p" args)
EOF
        [ -n "$out" ] && printf 'args = [%s]\n' "$out"
        # team deny rules for this server's tools (mcp__<server>__<tool>) become disabled_tools
        tools=""; first=1
        for t in $(required_deny | sed -n "s/^mcp__${n}__//p"); do [ $first = 1 ] || tools="$tools, "; first=0; tools="$tools$(json_str "$t")"; done
        [ -n "$tools" ] && printf 'disabled_tools = [%s]\n' "$tools"
        yaml "$p" | awk -F'\t' '$1 ~ /^env\./ { k = substr($1, 5); sub(/^[^\t]*\t/, ""); print k "\t" $0 }' > "$KIT_CONF/.env.tmp"
        if [ -s "$KIT_CONF/.env.tmp" ]; then
            printf '\n[mcp_servers.%s.env]\n' "$(toml_key "$n")"
            while IFS="$TAB" read -r k v; do printf '%s = %s\n' "$(toml_key "$k")" "$(json_str "$v")"; done < "$KIT_CONF/.env.tmp"
        fi
        rm -f "$KIT_CONF/.env.tmp"
        echo
    done
}

apply_claude() {
    local want n p dst h old ops k rules skills mcps
    want=$(wanted)
    rules=$(printf '%s\n' "$want" | sed -n 's/^rule://p')
    skills=$(printf '%s\n' "$want" | sed -n 's/^skill://p')
    mcps=$(printf '%s\n' "$want" | sed -n 's/^mcp://p')

    # Claude: rules as @imports, skills, MCP in ~/.claude.json
    printf '%s\n' "$rules" | set_rules "$CLAUDE_DIR/CLAUDE.md" import
    printf '%s\n' "$skills" | sync_skills "$CLAUDE_DIR/skills" skill
    printf '%s\n' "$mcps" | sync_mcp_json "$CLAUDE_JSON" mcp

    # Codex and omp share ~/.agents/skills; their AGENTS.md get the rule text itself
    if has_codex || has_omp; then printf '%s\n' "$skills" | sync_skills "$AGENTS_SKILLS" skill.agents; fi
    if has_codex; then
        printf '%s\n' "$rules" | set_rules "$CODEX_DIR/AGENTS.md" inline
        KIT_BLOCK=$(printf '%s\n' "$mcps" | codex_mcp_toml) replace_block "$CODEX_DIR/config.toml" "$TOML_BEGIN" "$TOML_END"
    fi
    if has_omp; then
        printf '%s\n' "$rules" | set_rules "$OMP_DIR/AGENTS.md" inline
        printf '%s\n' "$mcps" | sync_mcp_json "$OMP_DIR/mcp.json" mcp.omp
    fi

    ops=$(mktemp); : > "$ops"
    # tool deny rules -> ~/.claude/settings.json
    : > "$ops"
    local deny; deny=$(required_deny)
    while IFS= read -r n; do
        [ -n "$n" ] || continue
        [ -n "$(state_get deny "$n")" ] && continue
        printf 'addstr\tpermissions.deny\t%s\n' "$n" >> "$ops"; state_set deny "$n" 1; say "  deny $n"
    done <<EOF
$deny
EOF
    for n in $(state_list deny); do
        printf '%s\n' "$deny" | grep -qxF "$n" && continue
        printf 'rmstr\tpermissions.deny\t%s\n' "$n" >> "$ops"; state_del deny "$n"; say "  removed deny $n"
    done
    # update automatically when Claude starts -> settings.json hooks.SessionStart
    local hj old; hj=$(hook_json); old=$(state_get hook SessionStart)
    if [ "$hj" != "$old" ]; then
        [ -n "$old" ] && printf 'rmjson\thooks.SessionStart\t%s\n' "$old" >> "$ops"
        printf 'addjson\thooks.SessionStart\t%s\n' "$hj" >> "$ops"; state_set hook SessionStart "$hj"
    fi
    [ -s "$ops" ] && { json_edit "$CLAUDE_DIR/settings.json" "$ops"; prune_deny; }
    rm -f "$ops"
}

hook_json() { # the SessionStart hook entry kit adds to settings.json
    local k="$HOME/.local/bin/kit"
    [ -x "$k" ] || k="$KIT_LIB/kit"
    printf '{"hooks":[{"type":"command","command":%s,"timeout":10}]}' "$(json_str "'$k' sync --hook")"
}

sync_hook() { # run by Claude at start: sync in the background, at most every 10 minutes
    [ -f "$MACHINE" ] || exit 0
    local stamp="$KIT_CONF/last-sync" lock="$KIT_CONF/sync.lock" log="$KIT_CONF/sync.log"
    [ -f "$stamp" ] && [ -z "$(find "$stamp" -mmin +10 2>/dev/null)" ] && exit 0
    [ -d "$lock" ] && [ -n "$(find "$lock" -maxdepth 0 -mmin +10 2>/dev/null)" ] && rmdir "$lock" 2>/dev/null
    mkdir "$lock" 2>/dev/null || exit 0                      # another sync is running
    touch "$stamp"
    [ -f "$log" ] && [ "$(wc -c < "$log")" -gt 100000 ] && mv -f "$log" "$log.old"
    (
        trap 'rmdir "$lock" 2>/dev/null' EXIT
        printf '== %s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
        GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=20 NO_NAG=1 cmd_sync
    ) </dev/null >>"$log" 2>&1 &
    exit 0
}

# ---------- commands ----------
need_init() { [ -f "$MACHINE" ] || die "還沒設定：先打  kit init <網址或資料夾>"; }

cmd_init() {
    local KIT_INIT=1
    local s srcs="" more d args=()
    M_APPROVALS=""; M_SIGNERS=""
    while [ $# -gt 0 ]; do
        case $1 in
            --approvals) M_APPROVALS=${2:-}; shift 2 || die "--approvals 後面要接核准紀錄的 repo";;
            --signers)   M_SIGNERS=${2:-}; shift 2 || die "--signers 後面要接 allowed_signers 檔";;
            *) args+=("$1"); shift;;
        esac
    done
    [ ${#args[@]} -ge 1 ] || die "用法：kit init <網址或資料夾> [更多來源...] [--approvals <repo> --signers <檔>]"
    if [ -n "$M_APPROVALS$M_SIGNERS" ]; then
        [ -n "$M_APPROVALS" ] && [ -n "$M_SIGNERS" ] || die "--approvals 和 --signers 要一起給"
        M_SIGNERS=$(cd "$(dirname "$M_SIGNERS")" 2>/dev/null && printf '%s/%s' "$(pwd)" "$(basename "$M_SIGNERS")") || die "找不到 $M_SIGNERS"
        is_url "$M_APPROVALS" || M_APPROVALS=$(cd "$M_APPROVALS" && pwd) || die "找不到 $M_APPROVALS"
    fi
    set -- "${args[@]}"
    for s in "$@"; do
        is_url "$s" || s=$(cd "$s" 2>/dev/null && pwd) || die "找不到資料夾：$s"
        srcs="$srcs$s
"
    done
    write_machine "$srcs" "" ""
    for s in $(m_sources); do fetch_source "$s"; done
    add_includes
    write_machine "$(m_sources)" "$(recommended_items)" ""
    say "kit：設定好 $(m_sources | wc -l | tr -d ' ') 個來源"
    apply_claude
    seen_all
    say "kit：完成。打  kit list  看有哪些"
}

seen_all() { for i in $(available); do state_set seen "$i" 1; done; }

wanted_version() { # the newest kit_version the sources ask for, when it is newer than this kit
    # x.y.z compared as numbers, "+build" ignored; a dev build (no VERSION) is never told
    src_dirs | while IFS= read -r d; do yget "$d/kit.yaml" kit_version; done | awk -v have="$KIT_VERSION" '
        function num(v,   p, n, i) {
            sub(/\+.*/, "", v); n = split(v, p, ".")
            if (n < 1 || n > 3) return ""
            for (i = 1; i <= n; i++) if (p[i] !~ /^[0-9]+$/) return ""
            return sprintf("%09d%09d%09d", p[1], p[2], p[3])
        }
        BEGIN { best = num(have); if (best == "") exit }
        { n = num($0); if (n != "" && n > best) { best = n; need = $0 } }
        END { if (need != "") print need }'
}
version_nag() { # tell once when a source's kit.yaml wants a newer kit (not in the background, not when quiet)
    [ -z "${QUIET:-}${NO_NAG:-}" ] || return 0
    local need
    need=$(wanted_version)
    if [ -z "$need" ]; then [ -z "$(state_get nag kit_version)" ] || state_del nag kit_version; return 0; fi
    [ "$(state_get nag kit_version)" = "$need $KIT_VERSION" ] && return 0
    say "kit：團隊要 kit ${need} 以上，你的是 ${KIT_VERSION}。請打  kit self-update"
    state_set nag kit_version "$need $KIT_VERSION"
}

includes() { # include: entries of every source; a local path is relative to the source that lists it
    local d i
    src_dirs | while IFS= read -r d; do
        yget "$d/kit.yaml" include | while IFS= read -r i; do
            [ -n "$i" ] || continue
            if is_url "$i"; then printf '%s\n' "$i"; continue; fi
            case $i in /*) ;; *) i="$d/$i";; esac
            (cd "$i" 2>/dev/null && pwd) || printf '%s\n' "$i"
        done
    done | awk 'NF && !seen[$0]++'
}
add_includes() { # add sources that a source includes but machine.yaml does not list yet (also chains)
    local more s n
    for n in 1 2 3 4 5; do
        # skip includes that are already a source (same URL, or the same folder as a clone)
        more=$(includes | while IFS= read -r s; do src_dirs | grep -qxF "$(src_dir "$s")" || printf '%s\n' "$s"; done | grep -vxF -f <(m_sources; echo '##none##'))
        [ -n "$more" ] || return 0
        write_machine "$(m_sources; printf '%s\n' "$more")" "$(m_added)" "$(m_removed)"
        while IFS= read -r s; do
            fetch_source "$s"
            [ -n "${KIT_INIT:-}" ] || say "kit：加了來源 ${s}（某個來源的 kit.yaml 引用它）"
        done <<EOF
$more
EOF
    done
}

cmd_sync() {
    need_init
    local s
    for s in $(m_sources); do fetch_source "$s"; done
    add_includes
    apply_claude
    local new=""
    for i in $(available); do [ -n "$(state_get seen "$i")" ] || new="$new $i"; done
    [ -n "$new" ] && say "kit：新：$new  （要用就 kit add <種類> <名字>）"
    seen_all
    version_nag
}

json_s() { # a JSON string: \ " TAB LF CR escaped, other control characters dropped (the same as kit.ps1)
    local s=$1
    s=${s//\\/\\\\}; s=${s//\"/\\\"}
    s=${s//$TAB/\\t}; s=${s//$'\n'/\\n}; s=${s//$'\r'/\\r}
    case $s in *[$'\001'-$'\037']*) s=$(printf '%s' "$s" | LC_ALL=C tr -d '\000-\037');; esac
    printf '"%s"' "$s"
}
item_desc() { # item_desc KIND FILE : the description of a skill or agent (frontmatter) or of an MCP yaml
    case $1 in
        skill|agent) head -n 1 "$2" | grep -qx -- '---' && fm_val "$(fm_of "$2")" description | head -n 1;;
        mcp) yget "$2" description 2>/dev/null | head -n 1;;
    esac
}
cmd_list_json() { # what kit list shows, as JSON for programs (the Herdr panel); kit.ps1 prints the same
    local want req i k n p d status new first s tools
    want=$(wanted); req=$(required_items)
    printf '{\n  "kit": %s,\n  "sources": [' "$(json_s "$KIT_VERSION")"
    first=1
    while IFS= read -r s; do
        [ -n "$s" ] || continue
        [ $first = 1 ] || printf ','; first=0
        printf '\n    {"name": %s, "source": %s, "dir": %s}' "$(json_s "$(src_name "$s")")" "$(json_s "$s")" "$(json_s "$(src_dir "$s")")"
    done <<EOF
$(m_sources)
EOF
    tools='"claude"'; has_codex && tools="$tools, \"codex\""; has_omp && tools="$tools, \"omp\""
    printf '\n  ],\n  "tools": [%s],\n  "items": [' "$tools"
    first=1
    for i in $(available); do
        k=${i%%:*}; n=${i#*:}
        p=$(find_item "$k" "$n") || continue
        status=unused
        printf '%s\n' "$want" | grep -qxF "$i" && status=used
        printf '%s\n' "$req" | grep -qxF "$i" && status=required
        [ "$k" = agent ] && status=agent
        new=false; [ -n "$(state_get seen "$i")" ] || new=true
        d=$(item_path "" "$k" "$n"); d=${p%"$d"}               # the source folder that has it
        [ $first = 1 ] || printf ','; first=0
        printf '\n    {"kind": %s, "name": %s, "status": %s, "new": %s, "source": %s, "description": %s}' \
            "$(json_s "$k")" "$(json_s "$n")" "$(json_s "$status")" "$new" "$(json_s "$(basename "$d")")" "$(json_s "$(item_desc "$k" "$p")")"
    done
    printf '\n  ],\n  "kit_version_wanted": %s\n}\n' "$(json_s "$(wanted_version)")"
}

cmd_list() {
    case ${1:-} in
        --json) need_init; cmd_list_json; return;;
        "") ;;
        *) die "用法：kit list [--json]";;
    esac
    need_init
    local want req i mark
    want=$(wanted); req=$(required_items)
    for i in $(available); do
        mark="  "
        printf '%s\n' "$want" | grep -qxF "$i" && mark="* "
        printf '%s\n' "$req" | grep -qxF "$i" && mark="R "
        case $i in agent:*) mark="  ";; esac
        [ -n "$(state_get seen "$i")" ] || mark="${mark%% }N"
        printf '%s %s\n' "$mark" "$i"
    done
    say ""
    say "* 在用   R 團隊必備   N 新的   agent 用  kit run <名字>  開"
    say "寫到：$(targets)"
    version_nag
}

cmd_add_rm() {
    local verb=$1; shift
    [ $# -eq 2 ] || die "用法：kit $verb rule|skill|mcp <名字>"
    need_init
    local k=$1 n=$2 i="$1:$2" added removed
    case " rule skill mcp " in *" $k "*) ;; *) die "種類只能是 rule、skill、mcp";; esac
    find_item "$k" "$n" > /dev/null || die "找不到 ${i}（打 kit list 看有哪些）"
    added=$(m_added); removed=$(m_removed)
    if [ "$verb" = add ]; then
        added=$(printf '%s\n%s\n' "$added" "$i" | awk 'NF && !seen[$0]++')
        removed=$(printf '%s\n' "$removed" | grep -vxF "$i")
    else
        required_items | grep -qxF "$i" && die "$i 是團隊必備，拿不掉"
        added=$(printf '%s\n' "$added" | grep -vxF "$i")
        removed=$(printf '%s\n%s\n' "$removed" "$i" | awk 'NF && !seen[$0]++')
    fi
    write_machine "$(m_sources)" "$added" "$removed"
    apply_claude
}

toml_str() { # quote a string for TOML (a basic string; newlines escaped)
    local s=$1
    s=${s//\\/\\\\}; s=${s//\"/\\\"}
    s=${s//$TAB/\\t}; s=${s//$'\r'/\\r}; s=${s//$'\n'/\\n}
    printf '"%s"' "$s"
}

mcp_toml_inline() { # mcp_toml_inline FILE NAME -> {command="..", args=[..], env={..}, disabled_tools=[..]}
    local f=$1 n=$2 cmd out a first t k v
    cmd=$(yget "$f" command); [ -n "$cmd" ] || { warn "$f has no command"; return 1; }
    out="{command=$(toml_str "$cmd")"
    first=1; a=""
    while IFS= read -r v; do [ -n "$v" ] || continue; [ $first = 1 ] || a="$a, "; first=0; a="$a$(toml_str "$v")"; done <<EOF
$(yget "$f" args)
EOF
    [ -n "$a" ] && out="$out, args=[$a]"
    first=1; a=""
    while IFS="$TAB" read -r k v; do [ -n "$k" ] || continue; [ $first = 1 ] || a="$a, "; first=0; a="$a$(toml_key "$k")=$(toml_str "$v")"; done <<EOF
$(yaml "$f" | awk -F'\t' '$1 ~ /^env\./ { k = substr($1, 5); sub(/^[^\t]*\t/, ""); print k "\t" $0 }')
EOF
    [ -n "$a" ] && out="$out, env={$a}"
    printf '%s}' "$out"
}

cmd_run() {
    [ $# -ge 1 ] || die "用法：kit run <agent> [--tool claude|codex|omp] [工具的參數...]"
    need_init
    local name=$1; shift
    local tool=claude
    if [ "${1:-}" = --tool ]; then tool=${2:-}; shift 2 || die "--tool 後面要接 claude、codex 或 omp"; fi
    case $tool in claude|codex|omp) ;; *) die "--tool 只能是 claude、codex 或 omp";; esac
    local f; f=$(find_item agent "$name") || die "找不到 agent ${name}（打 kit list 看有哪些）"
    QUIET=1 cmd_sync 2>/dev/null || true

    local tmp; tmp=$(mktemp -d "${TMPDIR:-/tmp}/kit-run.XXXXXX")
    local n p d k
    local fm; fm=$(LC_ALL=C awk -f "$KIT_LIB/yaml.awk" -v frontmatter=1 "$f") || die "bad header in $f"
    fmget() { printf '%s\n' "$fm" | awk -F'\t' -v p="$1" '$1 == p || $1 == p "[]" { sub(/^[^\t]*\t/, ""); print }'; }

    # the agent's skills, each in its own folder
    local skdir="$tmp/skills"; [ $tool = claude ] && skdir="$tmp/.claude/skills"
    mkdir -p "$skdir"
    for n in $(fmget skills); do
        p=$(find_item skill "$n") || { warn "skill $n not found"; continue; }
        cp -R "$(dirname "$p")" "$skdir/$n"
    done
    # the agent's rules + its prompt
    {
        for n in $(fmget rules); do
            p=$(find_item rule "$n") || { warn "rule $n not found"; continue; }
            cat "$p"; echo
        done
        awk 'c >= 2 { print } /^---$/ { c++ }' "$f"
        if [ $tool = codex ] && [ -n "$(ls "$skdir")" ]; then
            # Codex cannot load skills from an extra folder: list them, it reads one when needed
            echo; echo "## Skills"
            echo "Skills you have. Before doing a task one of them covers, read its SKILL.md and follow it."
            for d in "$skdir"/*/; do
                n=$(basename "$d")
                printf -- '- %s: %s (%sSKILL.md)\n' "$n" "$(LC_ALL=C awk -f "$KIT_LIB/yaml.awk" -v frontmatter=1 "$d/SKILL.md" 2>/dev/null | awk -F'\t' '$1 == "description" { print $2 }')" "$d"
            done
        fi
    } > "$tmp/prompt.md"
    local only deny; only=$(fmget tools.only | paste -sd, -); deny=$(fmget tools.deny)

    local args=()
    case $tool in
    claude)
        local mcps="" first=1
        for n in $(fmget mcp); do
            p=$(find_item mcp "$n") || { warn "mcp $n not found"; continue; }
            k=$(mcp_json "$p") || continue
            [ $first = 1 ] || mcps="$mcps,"; first=0
            mcps="$mcps$(json_str "$n"):$k"
        done
        printf '{"mcpServers":{%s}}\n' "$mcps" > "$tmp/mcp.json"
        args=(--add-dir "$tmp" --append-system-prompt-file "$tmp/prompt.md" --mcp-config "$tmp/mcp.json")
        [ -n "$only" ] && args+=(--tools "$only")
        while IFS= read -r d; do [ -n "$d" ] && args+=(--disallowedTools "$d"); done <<EOF
$deny
EOF
        ;;
    codex)
        args=(-c "developer_instructions=$(toml_str "$(cat "$tmp/prompt.md")")")
        for n in $(fmget mcp); do
            p=$(find_item mcp "$n") || { warn "mcp $n not found"; continue; }
            k=$(mcp_toml_inline "$p" "$n") || continue
            local t="" first=1
            while IFS= read -r d; do case $d in "mcp__${n}__"*) [ $first = 1 ] || t="$t, "; first=0; t="$t$(toml_str "${d#mcp__${n}__}")";; esac; done <<EOF
$deny
EOF
            [ -n "$t" ] && k="${k%\}}, disabled_tools=[$t]}"
            args+=(-c "mcp_servers.$(toml_key "$n")=$k")
        done
        [ -n "$only" ] && warn "Codex 不能只開某些內建工具，tools.only 這次不套用"
        printf '%s\n' "$deny" | grep -qv '^mcp__' && [ -n "$deny" ] && warn "Codex 只能禁用 MCP 的工具，其他的 tools.deny 這次不套用"
        ;;
    omp)
        printf 'skills:\n  customDirectories:\n    - %s\n' "$(toml_str "$skdir")" > "$tmp/omp.yml"
        args=(--config "$tmp/omp.yml" --append-system-prompt "$tmp/prompt.md")
        [ -n "$only" ] && args+=(--tools "$(printf '%s' "$only" | tr 'A-Z' 'a-z')")
        [ -n "$(fmget mcp)" ] && warn "omp 不能在啟動時加 MCP：這個 agent 的 MCP 請用  kit add mcp <名字>  加到全域"
        [ -n "$deny" ] && warn "omp 不能禁用單一工具，tools.deny 這次不套用"
        ;;
    esac
    set -- "${args[@]}" "$@"
    [ -n "${KIT_DRY_RUN:-}" ] && { printf '%s\n' "$tool" "$@"; printf 'tmp=%s\n' "$tmp"; return 0; }
    "$tool" "$@"
    local rc=$?
    rm -rf "$tmp"
    return $rc
}

cmd_uninstall() {
    local self=0; [ "${1:-}" = "--self" ] && self=1
    local n ops k v
    local f
    for f in "$CLAUDE_DIR/CLAUDE.md" "$CODEX_DIR/AGENTS.md" "$OMP_DIR/AGENTS.md"; do KIT_BLOCK= replace_block "$f" "$BEGIN_MARK" "$END_MARK"; done
    KIT_BLOCK= replace_block "$CODEX_DIR/config.toml" "$TOML_BEGIN" "$TOML_END"
    QUIET=1
    : | sync_skills "$CLAUDE_DIR/skills" skill
    : | sync_skills "$AGENTS_SKILLS" skill.agents
    : | sync_mcp_json "$CLAUDE_JSON" mcp
    : | sync_mcp_json "$OMP_DIR/mcp.json" mcp.omp
    QUIET=
    ops=$(mktemp); : > "$ops"
    while IFS="$TAB" read -r k n v; do
        [ "$k" = deny ] && printf 'rmstr\tpermissions.deny\t%s\n' "$n" >> "$ops"
        [ "$k" = hook ] && printf 'rmjson\thooks.%s\t%s\n' "$n" "$v" >> "$ops"
    done < "${STATE:-/dev/null}" 2>/dev/null
    [ -s "$ops" ] && { json_edit "$CLAUDE_DIR/settings.json" "$ops"; prune_deny; }
    rm -f "$ops" "$STATE" "$MACHINE"
    say "kit：已移除 kit 放進 Claude、Codex、omp 的東西（你自己的檔案沒動）"
    say "     來源的 clone 還留在 $KIT_SRC"
    if [ $self = 1 ]; then
        rm -f "$HOME/.local/bin/kit"; rm -rf "$HOME/.local/share/agentkit"
        say "kit：kit 本身也移除了"
    fi
}

cmd_self_update() { # pull the clone kit was installed from, then reinstall
    local repo; repo=$(cat "$KIT_LIB/.repo" 2>/dev/null) || die "不知道 kit 是從哪個 clone 裝的；請到 clone 裡 git pull 後重跑 unix/install.sh"
    [ -d "$repo/.git" ] || die "找不到 clone：$repo"
    local url; url=$(git -C "$repo" remote get-url origin 2>/dev/null) && check_host "$url"
    local before; before=$(git -C "$repo" rev-parse --short=12 HEAD 2>/dev/null)
    if [ -n "$M_APPROVALS" ]; then
        [ -n "$url" ] || die "$repo 沒有 origin"
        local sha; sha=$(approved_sha "$(src_name "$url")") || die "kit 本身（$(src_name "$url")）沒有有效的核准，不更新"
        git_safe -C "$repo" fetch -q --no-recurse-submodules origin || die "沒辦法 fetch $repo"
        git -C "$repo" -c advice.detachedHead=false checkout -q -f --detach "$sha" || die "找不到核准的版本 $sha"
    else
        git_safe -C "$repo" pull --ff-only -q || die "沒辦法更新 ${repo}（沒網路，或 clone 裡有自己的改動？）"
    fi
    sh "$repo/unix/install.sh" --quiet || die "重新安裝失敗"
    local now; now=$(git -C "$repo" rev-parse --short=12 HEAD 2>/dev/null)
    if [ -n "$before" ] && [ "$before" = "$now" ]; then say "kit：已經是最新（$(cat "$KIT_LIB/VERSION" 2>/dev/null)，${now}）"
    else say "kit：已更新到 $(cat "$KIT_LIB/VERSION" 2>/dev/null)（${now}）"; fi
}

# ---------- authoring: new / diff / update (local folders only, never the network) ----------
valid_name() { case $1 in ""|-*|*[!a-z0-9-]*) return 1;; *) return 0;; esac; }
target_dir() { # where new/update write: --to <source name|folder>, else the folder you are in if it has kit.yaml, else the first source
    local d
    if [ -n "$1" ]; then
        while IFS= read -r d; do [ -n "$d" ] && [ "$(basename "$d")" = "$1" ] && { printf '%s\n' "$d"; return 0; }; done <<EOF
$( [ -f "$MACHINE" ] && src_dirs )
EOF
        [ -d "$1" ] || die "找不到 --to $1（要是來源名字或資料夾）"
        (cd "$1" && pwd); return 0
    fi
    [ -f ./kit.yaml ] && { pwd; return 0; }
    need_init
    src_dirs | head -n 1
}
item_hash() { # item_hash KIND PATH(the item file)
    if [ "$1" = skill ]; then dir_hash "$(dirname "$2")"; else cksum < "$2" | awk '{print $1}'; fi
}
stage_from() { # stage_from KIND NAME FROM OUTDIR : copy what kit accepts from a local folder/file into OUTDIR; prints the item file
    local kind=$1 name=$2 from=$3 out=$4 f rel scripts=0 skipped=0 ext
    is_url "$from" && die "--from 只吃本機的資料夾或檔案（先自己 git clone 到暫存資料夾）"
    [ -e "$from" ] || die "找不到 $from"
    [ -d "$from" ] && from=$(cd "$from" && pwd -P)
    case $kind in
    skill)
        [ -d "$from" ] && [ -f "$from/SKILL.md" ] || die "$from 要是有 SKILL.md 的資料夾"
        grep -q 'scripts/' "$from/SKILL.md" && scripts=1
        mkdir -p "$out/$name"
        while IFS= read -r f; do
            rel=${f#"$from"/}
            case /$rel in */.git/*|*/.DS_Store) continue;; esac
            case $(basename "$rel") in LICENSE*|LICENCE*|COPYING*|README*|CHANGELOG*) skipped=$((skipped+1)); continue;; esac
            if [ -L "$f" ]; then skipped=$((skipped+1)); continue; fi
            case $rel in
                scripts/*) [ $scripts = 1 ] || { skipped=$((skipped+1)); continue; };;
                *.md) ;;
                *) skipped=$((skipped+1)); continue;;
            esac
            mkdir -p "$(dirname "$out/$name/$rel")"; cp "$f" "$out/$name/$rel"
        done <<EOF
$(cd "$from" && find "$(pwd -P)" -name .git -prune -o \( -type f -o -type l \) -print | LC_ALL=C sort)
EOF
        [ $skipped -gt 0 ] && warn "跳過 $skipped 個檔案（只帶 .md$( [ $scripts = 1 ] && echo '、scripts/')；不帶 LICENSE、README、.git）"
        printf '%s\n' "$out/$name/SKILL.md";;
    rule|agent|mcp)
        ext=md; [ $kind = mcp ] && ext=yaml
        f=$from; [ -d "$f" ] && f="$from/$name.$ext"
        [ -f "$f" ] && [ ! -L "$f" ] || die "$from 要是一個 .$ext 檔（或有 $name.$ext 的資料夾）"
        case $f in *.$ext) ;; *) die "$f 要是 .$ext 檔";; esac
        cp "$f" "$out/$name.$ext"; printf '%s\n' "$out/$name.$ext";;
    esac
}
put_item() { # put_item KIND NAME STAGED_FILE TARGET_DIR : replace the item in the target with the staged copy
    local dst; dst=$(item_path "$4" "$1" "$2")
    mkdir -p "$(dirname "$dst")"
    if [ "$1" = skill ]; then rm -rf "$(dirname "$dst")"; cp -R "$(dirname "$3")" "$(dirname "$dst")"; else cp "$3" "$dst"; fi
    printf '%s\n' "$dst"
}
skeleton() { # skeleton KIND NAME FILE
    case $1 in
    rule)  printf '# %s\n\n（在這裡寫規則，一條一行。）\n' "$2";;
    skill) printf -- '---\nname: %s\ndescription: （什麼時候用這個 skill，一句話）\n---\n\n（在這裡寫步驟。）\n' "$2";;
    mcp)   printf 'command: （啟動 MCP server 的程式，例如 uvx）\nargs: []\n# env:\n#   KEY: value      # 不要放密碼\n';;
    agent) printf -- '---\nname: %s\ndescription: （這個 agent 做什麼）\nrules: []\nskills: []\nmcp: []\n# tools:\n#   only: [Read, Grep, Glob]\n#   deny: []\n---\n（在這裡寫 agent 的角色和做法。）\n' "$2";;
    esac > "$3"
}
parse_item_args() { # sets KIND NAME FROM TO FORCE_IT from: [KIND] NAME [--from P] [--to T] [--force]
    KIND=; NAME=; FROM=; TO=; FORCE_IT=
    while [ $# -gt 0 ]; do
        case $1 in
            --from) FROM=${2:-}; shift 2 || die "--from 後面要接資料夾";;
            --to)   TO=${2:-}; shift 2 || die "--to 後面要接來源";;
            --force) FORCE_IT=1; shift;;
            *) if [ -z "$NAME" ] && [ -z "$KIND" ] && printf '%s\n' $KINDS | grep -qxF "$1"; then KIND=$1; elif [ -z "$NAME" ]; then NAME=$1; else die "多了一個參數：$1"; fi; shift;;
        esac
    done
}
guess_kind() { # guess_kind DIR NAME
    local k found=""
    for k in $KINDS; do [ -f "$(item_path "$1" "$k" "$2")" ] && found="$found $k"; done
    set -- $found
    [ $# = 1 ] || { [ $# = 0 ] && die "$(basename "$1") 裡沒有 ${NAME}"; die "$NAME 有好幾種（$*），請寫出種類，例：kit diff skill $NAME"; }
    printf '%s\n' "$1"
}

cmd_new() {
    parse_item_args "$@"
    [ -n "$KIND" ] && [ -n "$NAME" ] || die "用法：kit new rule|skill|mcp|agent <名字> [--from 本機資料夾] [--to 來源]"
    valid_name "$NAME" || die "名字只能用小寫英文、數字和 -：$NAME"
    local dir dst tmp f; dir=$(target_dir "$TO")
    dst=$(item_path "$dir" "$KIND" "$NAME")
    [ -e "$dst" ] && die "$(basename "$dir") 已經有 $KIND:${NAME}（要更新用 kit update）"
    if [ -f "$MACHINE" ] && f=$(find_item "$KIND" "$NAME"); then die "名字重複：別的來源已經有 $KIND:${NAME}（${f}）"; fi
    if [ -n "$FROM" ]; then
        tmp=$(mktemp -d "${TMPDIR:-/tmp}/kit-new.XXXXXX")
        f=$(stage_from "$KIND" "$NAME" "$FROM" "$tmp") || { rm -rf "$tmp"; exit 1; }
        dst=$(put_item "$KIND" "$NAME" "$f" "$dir"); rm -rf "$tmp"
        state_set from "$KIND:$NAME@$dir" "$(item_hash "$KIND" "$dst")"
        say "已從 $FROM 帶進 ${dst#"$dir"/}（在 $(basename "$dir")）"
        say "記得刪掉暫存的資料夾：$FROM"
    else
        mkdir -p "$(dirname "$dst")"; skeleton "$KIND" "$NAME" "$dst"
        say "已建立 ${dst#"$dir"/}（在 $(basename "$dir")），打開它寫內容"
    fi
    check_dirs "$dir" >/dev/null 2>&1 || warn "kit check 有問題，送出前請先打  kit check  看看"
    return 0
}

cmd_diff_update() { # cmd_diff_update diff|update ARGS...
    local mode=$1; shift
    parse_item_args "$@"
    [ -n "$NAME" ] && [ -n "$FROM" ] || die "用法：kit $mode [種類] <名字> --from 本機資料夾 [--to 來源]"
    local dir dst tmp f old now
    dir=$(target_dir "$TO")
    [ -n "$KIND" ] || KIND=$(guess_kind "$dir" "$NAME") || exit 1
    dst=$(item_path "$dir" "$KIND" "$NAME")
    [ -f "$dst" ] || die "$(basename "$dir") 裡沒有 $KIND:${NAME}（新的用 kit new）"
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/kit-diff.XXXXXX")
    f=$(stage_from "$KIND" "$NAME" "$FROM" "$tmp") || { rm -rf "$tmp"; exit 1; }
    if [ "$mode" = diff ]; then
        if [ "$KIND" = skill ]; then diff -ru "$(dirname "$dst")" "$(dirname "$f")"; else diff -u "$dst" "$f"; fi
        [ $? = 0 ] && say "一樣，沒有要更新的"
        rm -rf "$tmp"; return 0
    fi
    old=$(state_get from "$KIND:$NAME@$dir"); now=$(item_hash "$KIND" "$dst")
    if [ -z "$FORCE_IT" ] && [ "$old" != "$now" ]; then
        rm -rf "$tmp"
        if [ -z "$old" ]; then die "$KIND:$NAME 不是這台用 kit new --from 帶進來的，不知道有沒有人改過。先 kit diff 看清楚，確定要蓋掉再加 --force"; fi
        die "$KIND:$NAME 在 $(basename "$dir") 被改過（跟上次帶進來的不一樣）。先 kit diff 看差在哪；要保留別人的修改就手動合併，確定要蓋掉再加 --force"
    fi
    if [ "$KIND" = skill ]; then diff -rq "$(dirname "$dst")" "$(dirname "$f")" >/dev/null; else cmp -s "$dst" "$f"; fi && { rm -rf "$tmp"; say "一樣，沒有要更新的"; return 0; }
    dst=$(put_item "$KIND" "$NAME" "$f" "$dir"); rm -rf "$tmp"
    state_set from "$KIND:$NAME@$dir" "$(item_hash "$KIND" "$dst")"
    say "已更新 ${dst#"$dir"/}（在 $(basename "$dir")）。記得刪掉暫存的資料夾：$FROM"
}

# ---------- check ----------
problem() { printf '%s\n' "$*" >> "$PROBLEM_FILE"; printf '%s: %s\n' "${PROBLEM_TAG:-kit check}" "$*" >&2; }
fm_of() { LC_ALL=C awk -f "$KIT_LIB/yaml.awk" -v frontmatter=1 "$1" 2>/dev/null; }
fm_val() { printf '%s\n' "$1" | awk -F'\t' -v p="$2" '$1 == p || $1 == p "[]" { sub(/^[^\t]*\t/, ""); print }'; }
private_words() { # private_words OUT [DIR...] : nonblank lines of the private word lists (this machine, sources, DIRs) into OUT
    local out=$1 d; shift
    { cat "$KIT_CONF/private-words.txt" 2>/dev/null
      [ -f "$MACHINE" ] && src_dirs | while IFS= read -r d; do cat "$d/private-words.txt" 2>/dev/null; done
      for d in "$@"; do cat "$d/private-words.txt" 2>/dev/null; done
    } | sed 's/#.*//; s/^[[:space:]]*//; s/[[:space:]]*$//' | awk 'NF && !seen[$0]++' > "$out"
}
check_dirs() { # check_dirs DIR... : print problems, return 1 if any
    local d f n k v hosts names pw rel line h ref fm range
    names=$(mktemp "${TMPDIR:-/tmp}/kit-check.XXXXXX"); pw="$names.pw"
    PROBLEM_FILE="$names.problems"; : > "$PROBLEM_FILE"
    # every item name, from the folders checked and the configured sources
    for d in "$@" $( [ -f "$MACHINE" ] && src_dirs ); do
        [ -d "$d" ] || continue
        for f in "$d"/rules/*.md "$d"/skills/*/SKILL.md "$d"/mcp/*.yaml "$d"/agents/*.md; do
            [ -f "$f" ] || continue
            case $f in */rules/*) printf 'rule:%s\t%s\n' "$(basename "$f" .md)" "$d";; */skills/*) printf 'skill:%s\t%s\n' "$(basename "$(dirname "$f")")" "$d";;
                        */mcp/*) printf 'mcp:%s\t%s\n' "$(basename "$f" .yaml)" "$d";; *) printf 'agent:%s\t%s\n' "$(basename "$f" .md)" "$d";; esac
        done
    done | awk -F'\t' '!seen[$0]++' > "$names"
    # the same name in two places
    awk -F'\t' '{ c[$1]++; w[$1] = w[$1] " " $2 } END { for (k in c) if (c[k] > 1) print k "\t" w[k] }' "$names" | while IFS="$TAB" read -r k v; do
        problem "名字重複：$k 在$v"
    done
    private_words "$pw"
    for d in "$@"; do
        [ -d "$d" ] || { problem "找不到資料夾 $d"; continue; }
        # format of each item
        for f in "$d"/skills/*/SKILL.md "$d"/agents/*.md; do
            [ -f "$f" ] || continue
            rel=${f#"$d"/}
            case $f in */SKILL.md) n=$(basename "$(dirname "$f")");; *) n=$(basename "$f" .md);; esac
            valid_name "$n" || problem "$rel: 名字只能用小寫英文、數字和 -"
            head -n 1 "$f" | grep -qx -- '---' && fm=$(fm_of "$f") || { problem "$rel: 開頭要有 --- 包起來的 name、description"; continue; }
            [ "$(fm_val "$fm" name)" = "$n" ] || problem "$rel: name 要寫 $n"
            [ -n "$(fm_val "$fm" description)" ] || problem "$rel: 少了 description"
            case $f in */agents/*)
                for k in rule skill mcp; do
                    for ref in $(fm_val "$fm" "${k}s"); do grep -q "^$k:$ref$TAB" "$names" || problem "$rel: 找不到 $k:$ref"; done
                done;;
            esac
        done
        for f in "$d"/rules/*.md; do [ -f "$f" ] || continue; valid_name "$(basename "$f" .md)" || problem "${f#"$d"/}: 名字只能用小寫英文、數字和 -"; [ -s "$f" ] || problem "${f#"$d"/}: 是空的"; done
        for f in "$d"/mcp/*.yaml; do
            [ -f "$f" ] || continue; rel=${f#"$d"/}
            valid_name "$(basename "$f" .yaml)" || problem "$rel: 名字只能用小寫英文、數字和 -"
            [ -n "$(yget "$f" command)" ] || problem "$rel: 少了 command"
            for v in $(yget "$f" command) $(yget "$f" args); do
                case $v in git+*|github:*|*://*|git@*) problem "$rel: MCP 只能從公司允許的套件來源裝，不能用 $v 這種寫法";; esac
            done
        done
        if [ -f "$d/kit.yaml" ]; then
            for k in rule skill mcp; do
                for ref in $(yget "$d/kit.yaml" "required.${k}s") $(yget "$d/kit.yaml" "recommended.${k}s"); do
                    grep -q "^$k:$ref$TAB" "$names" || { if [ -n "${CHECK_CI:-}" ] && [ -n "$(yget "$d/kit.yaml" include)" ]; then warn "kit.yaml: $k:$ref 不在這個 repo（應該在 include 的來源）"; else problem "kit.yaml: 找不到 $k:$ref"; fi; }
                done
            done
        fi
        # files: no git inside, no links, text only
        ( cd "$d" && find . -mindepth 1 \( -name .git -prune -o -print \) ) | while IFS= read -r f; do
            rel=${f#./}
            if [ -L "$d/$rel" ]; then echo "$rel: 不能放捷徑（symlink）"
            elif [ -f "$d/$rel" ]; then
                case $rel in .gitmodules|*/.gitmodules) echo "$rel: 不能用 git submodule";; esac
                [ -s "$d/$rel" ] && ! LC_ALL=C grep -qI . "$d/$rel" 2>/dev/null && [ "$(LC_ALL=C tr -d '\n' < "$d/$rel" | wc -c)" -gt 0 ] && echo "$rel: 只能放文字檔"
            fi
        done > "$names.files"
        ( cd "$d" && find . -mindepth 2 -name .git | sed 's#^\./##; s#$#: 裡面不能有別的 git repo#' ) >> "$names.files"
        while IFS= read -r line; do problem "$line"; done < "$names.files"
        # URLs only to content_hosts (when the source lists them)
        hosts=$( { yget "$d/kit.yaml" content_hosts; [ -f "$MACHINE" ] && src_dirs | while IFS= read -r v; do yget "$v/kit.yaml" content_hosts; done; } | awk 'NF && !seen[$0]++')
        if [ -n "$hosts" ]; then
            LC_ALL=C grep -rnIoE --exclude-dir=.git '(https?|ssh|git)://[^][ "<>()`'"'"']+|git@[A-Za-z0-9.-]+:' "$d" 2>/dev/null | while IFS= read -r line; do
                v=${line#*:*:}; h=$(url_host "$v")
                printf '%s\n' "$hosts" | grep -qxF "$h" || echo "${line%%:*}" "$(printf '%s' "$line" | cut -d: -f2)" "$h"
            done | while read -r f n h; do problem "${f#"$d"/}:$n: 網址 $h 不在 content_hosts"; done
        fi
        # private words (only the place, never the word)
        if [ -s "$pw" ]; then
            LC_ALL=C grep -rnIiF -f "$pw" --exclude-dir=.git --exclude=private-words.txt "$d" 2>/dev/null | cut -d: -f1,2 | while IFS= read -r line; do problem "${line#"$d"/}: 有不該公開的字"; done
            ( cd "$d" && find . -mindepth 1 -name .git -prune -o -print ) | sed 's#^\./##' | grep -iF -f "$pw" | while IFS= read -r line; do problem "$line: 檔名有不該公開的字"; done
        fi
        # --ci: commit author emails
        if [ -n "${CHECK_CI:-}" ] && [ -d "$d/.git" ]; then
            v=$(yget "$d/kit.yaml" author_domains)
            if [ -n "$v" ]; then
                if [ -n "${KIT_CI_BASE:-}" ]; then range="$KIT_CI_BASE..HEAD"; else range="-1"; fi
                git -C "$d" log --format='%h %ae' "$range" 2>/dev/null | while read -r h line; do
                    printf '%s\n' "$v" | grep -qxF "${line##*@}" || problem "commit $h: 作者 email 不是公司網域"
                done
            fi
        fi
    done
    PROBLEMS=$(wc -l < "$PROBLEM_FILE" | tr -d ' ')
    rm -f "$names" "$names.files" "$pw" "$PROBLEM_FILE"
    [ "$PROBLEMS" = 0 ]
}

cmd_check() {
    local dirs=() a
    for a in "$@"; do
        case $a in --ci) CHECK_CI=1;; -*) die "不認得 $a";; *) dirs+=("$(cd "$a" 2>/dev/null && pwd || echo "$a")");; esac
    done
    if [ ${#dirs[@]} = 0 ]; then
        if [ -f ./kit.yaml ] || [ -n "${CHECK_CI:-}" ]; then dirs=("$(pwd)")
        else need_init; while IFS= read -r a; do dirs+=("$a"); done <<EOF
$(src_dirs)
EOF
        fi
    fi
    if check_dirs "${dirs[@]}"; then say "kit check：沒問題（${#dirs[@]} 個來源）"; else printf 'kit check：%s 個問題\n' "$PROBLEMS" >&2; exit 1; fi
}

# ---------- export-self: a clean copy of kit's own source, for a company git server ----------
kit_repo() { # the clone kit was installed from, else the repo this kit runs from
    local d
    d=$(cat "$KIT_LIB/.repo" 2>/dev/null)
    if [ -n "$d" ] && [ -f "$d/unix/kit" ] && [ -f "$d/windows/kit.ps1" ]; then printf '%s\n' "$d"; return 0; fi
    d=$KIT_LIB
    while [ -n "$d" ] && [ "$d" != / ] && [ "$d" != . ]; do
        [ -f "$d/unix/kit" ] && [ -f "$d/windows/kit.ps1" ] && { printf '%s\n' "$d"; return 0; }
        d=$(dirname "$d")
    done
    return 1
}
export_skip() { # files that stay out of the export
    case /$1 in */.github/*) return 0;; esac
    case $(basename "$1" | tr 'A-Z' 'a-z') in readme*|changelog*|license*|licence*|private-words.txt) return 0;; esac
    return 1
}
mask_paths() { # mask_paths WORDFILE : paths on stdin -> those with a word in them, each such part shown as <不公開>
    awk 'NR == FNR { if (NF) w[++n] = tolower($0); next }
         { k = split($0, p, "/"); s = ""; hit = 0
           for (i = 1; i <= k; i++) {
               q = p[i]
               for (j = 1; j <= n; j++) if (index(tolower(q), w[j])) { q = "<不公開>"; hit = 1; break }
               s = s (i > 1 ? "/" : "") q
           }
           if (hit) print s }' "$1" -
}
install_md() { # INSTALL.md of the export (no URLs; the same text as kit.ps1 writes)
    cat <<'EOF'
# 安裝 kit

先把公司的 agentkit repo clone 下來（網址問管理這個 repo 的人），再照你的系統做。

## Windows

在 clone 的資料夾裡打：

    powershell -NoProfile -ExecutionPolicy Bypass -File windows\install.ps1

不用管理員權限。開新的終端機後，在 cmd 和 PowerShell 都能打 `kit`。

## Linux / Mac

需要 bash、awk、git。Mac 還沒有 git 的話，先打 `xcode-select --install`。
在 clone 的資料夾裡打：

    sh unix/install.sh

開新的終端機後就能打 `kit`。

## 裝好以後

    kit init <團隊來源的網址>
    kit help
EOF
}
cmd_export_self() {
    local out="" ver="" repo line mode rel f n probs
    while [ $# -gt 0 ]; do
        case $1 in
            --version) ver=${2:-}; [ -n "$ver" ] || die "--version 後面要接版本，例：0.4.0+gitea.12"; shift 2;;
            -*) die "不認得 $1";;
            *) [ -z "$out" ] || die "多了一個參數：$1"; out=$1; shift;;
        esac
    done
    [ -n "$out" ] || die "用法：kit export-self <資料夾> [--version <版本>]"
    case $ver in *[!A-Za-z0-9.+_-]*) die "版本只能用英文、數字和 . + - _：$ver";; esac
    repo=$(kit_repo) || die "找不到 kit 的原始碼（有 unix/kit 和 windows/kit.ps1 的 git clone）"
    git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || die "$repo 不是 git repo"
    if [ -e "$out" ] || [ -L "$out" ]; then
        [ -d "$out" ] && [ ! -L "$out" ] && [ -z "$(ls -A "$out")" ] || die "$out 已經存在而且不是空的；請給一個新的資料夾"
    fi
    mkdir -p "$out" || die "沒辦法建立 $out"
    out=$(cd "$out" && pwd)
    [ -z "$(git -C "$repo" status --porcelain --untracked-files=no 2>/dev/null)" ] || warn "$repo 有還沒 commit 的改動，匯出的是資料夾裡現在的檔案"

    PROBLEM_TAG="kit export-self"; PROBLEM_FILE=$(mktemp "${TMPDIR:-/tmp}/kit-export.XXXXXX")
    # only files git tracks (the index), taken from the working folder
    while IFS= read -r -d '' line; do
        mode=${line%% *}; rel=${line#*"$TAB"}
        export_skip "$rel" && continue
        case $mode in
            120000) problem "$rel: 不能放捷徑（symlink）"; continue;;
            160000) problem "$rel: 不能用 git submodule"; continue;;
        esac
        f="$repo/$rel"
        [ -f "$f" ] && [ ! -L "$f" ] || { warn "$rel 在 git 裡有、資料夾裡沒有，跳過"; continue; }
        mkdir -p "$(dirname "$out/$rel")" && cp "$f" "$out/$rel" || { rm -rf "$out" "$PROBLEM_FILE"; die "沒辦法複製 $rel"; }
        [ "$mode" = 100755 ] && chmod 755 "$out/$rel"
    done < <(git -C "$repo" -c core.quotepath=off ls-files -s -z)
    install_md > "$out/INSTALL.md"
    [ -n "$ver" ] && printf '%s\n' "$ver" > "$out/VERSION"

    # nothing that points back to GitHub or names private things; text files only
    printf '%s\n' 'github''.com' 'github''usercontent' 'noreply''.github' > "$PROBLEM_FILE.gh"   # split so the export does not flag itself
    private_words "$PROBLEM_FILE.pw" "$repo"
    ( cd "$out" && find . -type f | sed 's#^\./##' | LC_ALL=C sort ) > "$PROBLEM_FILE.files"
    while IFS= read -r rel; do
        f="$out/$rel"
        case $(printf '%s' "$rel" | tr 'A-Z' 'a-z') in
            *.exe|*.dll|*.so|*.dylib|*.msi|*.bin|*.jar|*.class|*.pyc|*.o|*.a|*.lib|*.zip|*.gz|*.tgz|*.7z|*.rar) problem "$rel: 不能放執行檔或壓縮檔"; continue;;
        esac
        [ -s "$f" ] && ! LC_ALL=C grep -qI . "$f" 2>/dev/null && [ "$(LC_ALL=C tr -d '\n' < "$f" | wc -c)" -gt 0 ] && problem "$rel: 只能放文字檔"
    done < "$PROBLEM_FILE.files"
    ( cd "$out" && LC_ALL=C grep -rnIiF -f "$PROBLEM_FILE.gh" . 2>/dev/null ) | cut -d: -f1,2 | sed 's#^\./##' | while IFS= read -r line; do problem "${line}: 有 GitHub 的字"; done
    mask_paths "$PROBLEM_FILE.gh" < "$PROBLEM_FILE.files" | while IFS= read -r line; do problem "${line}: 檔名有 GitHub 的字"; done
    if [ -s "$PROBLEM_FILE.pw" ]; then
        ( cd "$out" && LC_ALL=C grep -rnIiF -f "$PROBLEM_FILE.pw" . 2>/dev/null ) | cut -d: -f1,2 | sed 's#^\./##' | while IFS= read -r line; do problem "${line}: 有不該公開的字"; done
        mask_paths "$PROBLEM_FILE.pw" < "$PROBLEM_FILE.files" | while IFS= read -r line; do problem "${line}: 檔名有不該公開的字"; done
    fi
    n=$(wc -l < "$PROBLEM_FILE.files" | tr -d ' ')
    probs=$(wc -l < "$PROBLEM_FILE" | tr -d ' ')
    rm -f "$PROBLEM_FILE" "$PROBLEM_FILE.gh" "$PROBLEM_FILE.pw" "$PROBLEM_FILE.files"
    if [ "$probs" != 0 ]; then
        rm -rf "$out"
        die "匯出失敗：${probs} 個問題，已刪掉 ${out}。在 kit 的 repo 改好再匯出一次"
    fi
    [ -n "$ver" ] || ver=$(cat "$out/VERSION" 2>/dev/null) || ver=""
    [ -n "$ver" ] || ver="（沒有 VERSION）"
    say "kit：已匯出 ${n} 個檔案到 ${out}（版本 ${ver}）"
    say "下一步（在公司）：在 Gitea 的 agentkit repo clone 裡，刪掉 .git 以外的舊檔案，"
    say "  放進這個資料夾的內容後 commit，訊息只寫：kit ${ver}"
}
cmd_ci_template() { # print (or write to FILE) the Gitea Actions workflow that runs kit check --ci on pull requests
    local f
    for f in "$KIT_LIB/templates/gitea-kit-check.yaml" "$KIT_LIB/../templates/gitea-kit-check.yaml"; do
        [ -f "$f" ] || continue
        if [ -n "${1:-}" ]; then mkdir -p "$(dirname "$1")" && cp "$f" "$1" && say "已寫到 $1"; else cat "$f"; fi
        return 0
    done
    die "找不到範本 gitea-kit-check.yaml（請重跑 unix/install.sh）"
}

# ---------- push: send your changes in a source to Gitea as a pull request ----------
url_path() { # owner/repo of a git URL or folder (last two parts, no .git)
    printf '%s\n' "$1" | sed -E 's#^[a-z+]+://[^/]*/##; s#^[^/]*@[^:/]*:##; s#/+$##; s#\.git$##' | awk -F/ '{ if (NF >= 2) print $(NF-1) "/" $NF; else print $NF }'
}
push_items() { # changed item files (one per line) -> verb<TAB>kind:name, one per item
    local f k n p
    while IFS= read -r f; do
        case $f in
            rules/*.md) k=rule; n=${f#rules/}; n=${n%.md}; p=$f;;
            skills/*/*) k=skill; n=${f#skills/}; n=${n%%/*}; p=skills/$n/SKILL.md;;
            mcp/*.yaml) k=mcp; n=${f#mcp/}; n=${n%.yaml}; p=$f;;
            agents/*.md) k=agent; n=${f#agents/}; n=${n%.md}; p=$f;;
            *) continue;;
        esac
        if git cat-file -e "HEAD:$p" 2>/dev/null; then
            if [ -e "$p" ]; then printf 'update\t%s:%s\n' "$k" "$n"; else printf 'remove\t%s:%s\n' "$k" "$n"; fi
        else printf 'add\t%s:%s\n' "$k" "$n"; fi
    done | awk -F'\t' '!seen[$2]++'
}
token_file_ok() { # warn when the token file can be read by others
    local m; m=$(ls -l "$1" 2>/dev/null | cut -c5-10)
    [ "$m" = "------" ] || warn "${1} 的權限太開放了，請打  chmod 600 $1"
}
cmd_push() {
    local to="" dry=""
    while [ $# -gt 0 ]; do
        case $1 in
            --to) to=${2:-}; shift 2 || die "--to 後面要接來源";;
            --dry-run) dry=1; shift;;
            *) die "用法：kit push [--to 來源] [--dry-run]";;
        esac
    done
    local dir; dir=$(target_dir "$to") || exit 1
    cd "$dir" || die "找不到 $dir"
    [ "$(git rev-parse --show-toplevel 2>/dev/null)" = "$(pwd -P)" ] || die "$(basename "$dir") 不是 git repo（要先 git clone 團隊來源）"
    PUSH_DIR=$(pwd -P)

    # what changed: only item files are sent
    local all files items other
    all=$(git -c core.quotePath=false status --porcelain --untracked-files=all | cut -c4- | sed 's/.* -> //')
    files=$(printf '%s\n' "$all" | grep -E '^(rules/[^/]+\.md|skills/[^/]+/.+|mcp/[^/]+\.yaml|agents/[^/]+\.md|third_party\.lock)$')
    other=$(printf '%s\n' "$all" | grep -vxF -f <(printf '%s\n' "$files"; echo '##none##') | awk 'NF')
    [ -n "$files" ] || { say "沒有要送的（$(basename "$dir") 裡沒有改過的 rule、skill、mcp、agent）"; return 0; }
    items=$(printf '%s\n' "$files" | push_items)
    [ -n "$other" ] && warn "這些不是 rule、skill、mcp、agent，不會送：$(printf '%s' "$other" | paste -sd' ' -)"

    # checks: any problem stops everything
    check_dirs "$PUSH_DIR" || die "kit check 有問題，什麼都沒送（改好再 kit push）"
    local doms email
    doms=$(yget kit.yaml author_domains)
    if [ -n "$doms" ]; then
        email=$(git config user.email)
        printf '%s\n' "$doms" | grep -qxF "${email##*@}" || die "git 的 user.email 不是公司網域（要是 $(printf '%s' "$doms" | paste -sd' ' -)），什麼都沒送。請打  git config user.email 你的公司信箱"
    fi
    local origin; origin=$(git remote get-url origin 2>/dev/null) || die "$(basename "$dir") 沒有 origin，不知道要送到哪"
    check_host "$origin"
    local api web owner_repo
    owner_repo=$(url_path "$origin")
    if [ -n "${KIT_GITEA_API:-}" ]; then api=${KIT_GITEA_API%/}; check_host "$api"; web=${api%/api/v1}
    elif is_url "$origin"; then web="https://$(url_host "$origin")"; api="$web/api/v1"
    else api=""; web=""
    fi

    # branch: kit/<names>-YYYYMMDD, -2, -3 ... when taken
    local names base b i=1 remote
    names=$(printf '%s\n' "$items" | cut -f2 | sed 's/^[^:]*://' | paste -sd- - | cut -c1-40 | sed 's/-*$//')
    base="kit/${names}-$(date +%Y%m%d)"; b=$base
    remote=$(git_safe ls-remote --heads origin 2>/dev/null | awk '{ sub(/^refs\/heads\//, "", $2); print $2 }')
    while git show-ref --verify -q "refs/heads/$b" || printf '%s\n' "$remote" | grep -qxF "$b"; do i=$((i+1)); b="$base-$i"; done
    local into; into=$(git symbolic-ref --short -q refs/remotes/origin/HEAD); into=${into#origin/}; [ -n "$into" ] || into=main
    local msg="" v
    for v in add update remove; do
        local l; l=$(printf '%s\n' "$items" | awk -F'\t' -v v="$v" '$1 == v { print $2 }' | paste -sd, - | sed 's/,/, /g')
        [ -n "$l" ] && msg="${msg:+$msg; }$v $l"
    done
    msg="kit: $msg"

    say "要送的檔案（$(basename "$dir")）："
    printf '%s\n' "$files" | sed 's/^/  /'
    say "分支：${b}（PR 到 ${into}）"
    say "commit：${msg}"
    [ -n "$dry" ] && { say "（--dry-run：沒有 commit，沒有送）"; return 0; }

    # commit on the new branch, then go back to where you were
    # the branch starts from origin's base, so unpushed local commits are never sent
    local orig start=HEAD; orig=$(git symbolic-ref --short -q HEAD || git rev-parse HEAD)
    git_safe fetch -q --no-recurse-submodules origin "+refs/heads/$into:refs/remotes/origin/$into" 2>/dev/null || warn "沒辦法更新 origin/${into}（沒網路？）"
    git rev-parse -q --verify "refs/remotes/origin/$into" >/dev/null && start="refs/remotes/origin/$into"
    git checkout -q -b "$b" "$start" || die "沒辦法開分支 ${b}（你改的檔案跟 origin/$into 有衝突？），什麼都沒送"
    local list=() f
    while IFS= read -r f; do list+=("$f"); done <<EOF
$files
EOF
    if ! { git add -A -- "${list[@]}" && git commit -q -m "$msg" -- "${list[@]}"; }; then
        git checkout -q "$orig"; git branch -q -D "$b" 2>/dev/null
        die "commit 失敗，什麼都沒送"
    fi
    git checkout -q "$orig" || warn "沒辦法切回 ${orig}，你現在在 $b"
    git_safe push -q --no-recurse-submodules origin "refs/heads/$b:refs/heads/$b" || die "沒辦法 push 分支 ${b}（沒網路？）。commit 留在本機的 $b"
    say "已送出分支 ${b}。改的檔案已從這裡移到那個分支，PR 合併後打 git pull 就會回來；想先看可以  git checkout ${b}"

    # pull request
    local tok="" tf="$KIT_CONF/gitea-token" compare=""
    [ -n "$web" ] && compare="$web/$owner_repo/compare/$into...$b"
    if [ -n "${KIT_GITEA_TOKEN:-}" ]; then tok=$KIT_GITEA_TOKEN
    elif [ -f "$tf" ]; then token_file_ok "$tf"; tok=$(tr -d ' \r\n' < "$tf")
    fi
    if [ -n "$tok" ] && [ -n "$api" ]; then
        local tmp code pr body
        tmp=$(mktemp -d "${TMPDIR:-/tmp}/kit-push.XXXXXX"); chmod 700 "$tmp"
        ( umask 077; printf 'Authorization: token %s\n' "$tok" > "$tmp/h" )   # never on the command line
        body="由 kit push 送出：
$(printf '%s\n' "$items" | awk -F'\t' '{ print "- " $1 " " $2 }')"
        body=${body//\\/\\\\}; body=${body//\"/\\\"}; body=${body//$'\n'/\\n}
        printf '{"title":%s,"head":%s,"base":%s,"body":"%s"}' "$(json_str "$msg")" "$(json_str "$b")" "$(json_str "$into")" "$body" > "$tmp/body"
        code=$(curl -sS --max-time 30 -o "$tmp/resp" -w '%{http_code}' -X POST -H @"$tmp/h" -H 'Content-Type: application/json' \
            --data-binary @"$tmp/body" "$api/repos/$owner_repo/pulls" 2>/dev/null)
        pr=$(json_get "$tmp/resp" html_url | sed 's/^"//; s/"$//')
        rm -rf "$tmp"
        case $code in 2??) [ -n "$pr" ] && { say "已開 PR：$pr"; return 0; };; esac
        warn "沒辦法自動開 PR（Gitea 回 ${code:-沒回應}）"
    elif [ -z "$tok" ]; then
        say "沒有 Gitea token（KIT_GITEA_TOKEN 或 ${tf}），PR 請自己開"
    fi
    if [ -n "$compare" ]; then say "開 PR：$compare"; else say "請到 Gitea 用分支 $b 開 PR"; fi
    return 0
}
# ---------- collect / outdated: other people's skills, from their own repos ----------
# third_party.lock (in the source that keeps them): one line per skill
#   name<TAB>url<TAB>path<TAB>ref<TAB>commit<TAB>license<TAB>date
LOCK_HEAD='# third_party.lock - written by kit collect; name url path ref commit license date'
url_id() { # host/path of a git URL, without scheme, user, .git or trailing /
    printf '%s\n' "$1" | sed -E 's#^[a-z+]+://##; s#^[^@/]*@##; s#^([^/:]+):#\1/#; s#/+$##; s#\.git$##'
}
collect_allowed() { # collect_allowed URL DIR : the URL must be (inside) one of collect_sources
    local id e d; id=$(url_id "$1")
    for d in "$2" $( [ -f "$MACHINE" ] && src_dirs ); do
        for e in $(yget "$d/kit.yaml" collect_sources); do
            e=$(url_id "$e")
            [ "$id" = "$e" ] && return 0
            case $id in "$e"/*) return 0;; esac
        done
    done
    return 1
}
check_maintainer() { # check_maintainer DIR : when kit.yaml lists maintainers, you must be one
    local m me; m=$(yget "$1/kit.yaml" maintainers)
    [ -n "$m" ] || return 0
    me=$(git -C "$1" config user.email 2>/dev/null)
    printf '%s\n' "$m" | grep -qxF -e "$me" -e "${me%%@*}" -e "${USER:-}" -e "$(id -un 2>/dev/null)" && return 0
    die "只有維護者能用 collect／outdated（kit.yaml 的 maintainers）"
}
license_kind() { # license_kind FILE -> short name
    if grep -qiE 'Apache License' "$1"; then echo Apache-2.0
    elif grep -qiE 'MIT License|Permission is hereby granted, free of charge' "$1"; then echo MIT
    elif grep -qiE 'Mozilla Public License' "$1"; then echo MPL-2.0
    elif grep -qiE 'GNU (AFFERO|LESSER)? *GENERAL PUBLIC LICENSE' "$1"; then echo GPL
    elif grep -qiE 'Redistribution and use in source and binary forms' "$1"; then echo BSD
    elif grep -qiE 'CC0|Creative Commons' "$1"; then echo CC
    else echo unknown; fi
}
lock_get() { [ -f "$1/third_party.lock" ] && awk -F'\t' -v n="$2" '$1 == n' "$1/third_party.lock"; }
lock_set() { # lock_set DIR LINE(name first)
    local f="$1/third_party.lock" n=${2%%"$TAB"*}
    { echo "$LOCK_HEAD"; [ -f "$f" ] && awk -F'\t' -v n="$n" '$0 !~ /^#/ && NF && $1 != n' "$f"; printf '%s\n' "$2"; } | { read -r h; echo "$h"; LC_ALL=C sort; } > "$f.tmp" && mv "$f.tmp" "$f"
}
real_url_ok() { # git config insteadOf can send a URL elsewhere: the real one must be allowed too
    local real; real=$(git ls-remote --get-url "$1" 2>/dev/null)
    [ -z "$real" ] || [ "$real" = "$1" ] || collect_allowed "$real" "$2" || die "git 設定把 $1 改到 ${real}，不在 collect_sources"
}

cmd_collect() { # kit collect <url|name> [--path P] [--name N] [--ref R] [--to SOURCE] [--force]
    local arg="" path="" name="" ref="" to="" force=""
    while [ $# -gt 0 ]; do
        case $1 in
            --path) path=${2:-}; shift 2 || die "--path 後面要接 repo 裡的資料夾";;
            --name) name=${2:-}; shift 2 || die "--name 後面要接名字";;
            --ref)  ref=${2:-}; shift 2 || die "--ref 後面要接分支或 tag";;
            --to)   to=${2:-}; shift 2 || die "--to 後面要接來源";;
            --force) force=1; shift;;
            -*) die "不認得 $1";;
            *) [ -z "$arg" ] || die "多了一個參數：$1"; arg=$1; shift;;
        esac
    done
    [ -n "$arg" ] || die "用法：kit collect <原作者的 repo 網址> [--path repo 裡的資料夾] [--name 名字] [--ref 分支或 tag]，或 kit collect <名字>（再收一次）"
    local dir url line; dir=$(target_dir "$to") || exit 1
    check_maintainer "$dir"
    if is_url "$arg"; then url=$arg
    else # collect again what the lock says
        line=$(lock_get "$dir" "$arg"); [ -n "$line" ] || die "$(basename "$dir") 的 third_party.lock 裡沒有 ${arg}（第一次收要給網址）"
        name=$arg; url=$(printf '%s' "$line" | cut -f2)
        [ -n "$path" ] || path=$(printf '%s' "$line" | cut -f3); [ "$path" = . ] && path=""
        [ -n "$ref" ] || ref=$(printf '%s' "$line" | cut -f4); [ "$ref" = - ] && ref=""
    fi
    collect_allowed "$url" "$dir" || die "$(url_id "$url") 不在 collect_sources（$(basename "$dir")/kit.yaml），不能收"
    real_url_ok "$url" "$dir"
    path=${path#/}; path=${path%/}
    case /$path/ in */../*|*/./*) die "--path 不能有 .. 或 .";; esac

    local tmp repo src sha f lic kind skipped=0 scripts=""; tmp=$(mktemp -d "${TMPDIR:-/tmp}/kit-collect.XXXXXX"); repo="$tmp/repo"
    say "從 $(url_id "$url") 下載${ref:+（${ref}）}…"
    if ! git_safe -c protocol.file.allow=always clone -q --depth 1 --no-recurse-submodules ${ref:+--branch "$ref"} "$url" "$repo" 2>"$tmp/err"; then
        sed 's/^/  /' "$tmp/err" >&2; rm -rf "$tmp"; die "沒辦法下載 $url"
    fi
    sha=$(git -C "$repo" rev-parse HEAD)
    repo=$(cd "$repo" && pwd -P); src=$repo${path:+/$path}
    [ -d "$src" ] && src=$(cd "$src" && pwd -P)
    case $src/ in "$repo"/*) ;; *) rm -rf "$tmp"; die "--path 要在 repo 裡面";; esac
    [ -f "$src/SKILL.md" ] || { rm -rf "$tmp"; die "$(url_id "$url")${path:+/$path} 裡沒有 SKILL.md（用 --path 指出 skill 的資料夾）"; }
    [ -n "$name" ] || name=$(fm_val "$(fm_of "$src/SKILL.md")" name)
    [ -n "$name" ] || name=$(basename "$src")
    valid_name "$name" || { rm -rf "$tmp"; die "名字 $name 不行（只能小寫英文、數字和 -），用 --name 給一個"; }
    local dst="$dir/skills/$name"
    if [ -e "$dst" ] && [ -z "$(lock_get "$dir" "$name")" ] && [ -z "$force" ]; then
        rm -rf "$tmp"; die "$(basename "$dir") 已經有 skill:${name}，而且不是 collect 收的（要整份換掉加 --force，或用 --name 換名字）"
    fi
    # license: the skill's own, else the repo's
    lic=""
    for f in "$src"/LICENSE* "$src"/LICENCE* "$src"/COPYING* "$repo"/LICENSE* "$repo"/LICENCE* "$repo"/COPYING*; do [ -f "$f" ] && { lic=$f; break; }; done
    [ -n "$lic" ] || { rm -rf "$tmp"; die "$(url_id "$url") 沒有 LICENSE，不知道能不能用，不收"; }
    kind=$(license_kind "$lic")
    # copy: everything text, no links, no binaries, no git
    mkdir -p "$tmp/out"
    while IFS= read -r f; do
        local rel=${f#"$src"/}
        case /$rel in */.*) continue;; esac       # .github/, .claude-plugin/ ...: for other tools, not the skill
        if [ -L "$f" ]; then skipped=$((skipped+1)); warn "跳過捷徑 $rel"; continue; fi
        if [ -s "$f" ] && ! LC_ALL=C grep -qI . "$f"; then skipped=$((skipped+1)); warn "跳過非文字檔 $rel"; continue; fi
        mkdir -p "$(dirname "$tmp/out/$rel")"; cp "$f" "$tmp/out/$rel"
        case $rel in *.sh|*.py|*.js|*.mjs|*.cjs|*.ts|*.ps1|*.rb|*.pl|*.bat|*.cmd) scripts="$scripts $rel";; *) [ -x "$f" ] && scripts="$scripts $rel";; esac
    done <<EOF
$(cd "$src" && find "$(pwd -P)" -name .git -prune -o \( -type f -o -type l \) -print | LC_ALL=C sort)
EOF
    [ "$lic" = "$src/${lic##*/}" ] || cp "$lic" "$tmp/out/${lic##*/}"
    rm -rf "$dst"; mkdir -p "$dir/skills"; cp -R "$tmp/out" "$dst"
    lock_set "$dir" "$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s' "$name" "$url" "${path:-.}" "${ref:--}" "$sha" "$kind" "$(date +%Y-%m-%d)")"
    rm -rf "$tmp"
    say "已收 skill:$name ← $(url_id "$url")${path:+/$path} @ $(printf %.12s "$sha")（授權 ${kind}）"
    [ "$kind" = unknown ] && warn "認不出授權種類，請自己看 skills/$name/${lic##*/}"
    [ "$kind" = GPL ] && warn "GPL 類授權：改了再發布要公開原始碼，請確認可以用"
    [ -n "$scripts" ] && warn "這個 skill 有會執行的檔案，送出前請看過：$scripts"
    check_dirs "$dir" >/dev/null 2>&1 || warn "kit check 有問題，送出前請先打  kit check  看看"
    say "下一步：kit diff 看不到第三方的差異，請用 git diff 看；沒問題就  kit push  開 PR"
}

cmd_outdated() { # kit outdated [--to SOURCE]
    local to=""
    while [ $# -gt 0 ]; do case $1 in --to) to=${2:-}; shift 2 || die "--to 後面要接來源";; *) die "用法：kit outdated [--to 來源]";; esac; done
    local dir; dir=$(target_dir "$to") || exit 1
    check_maintainer "$dir"
    [ -f "$dir/third_party.lock" ] || { say "$(basename "$dir") 沒有 third_party.lock（還沒用 kit collect 收過東西）"; return 0; }
    local n url path ref sha lic day now new=0
    while IFS="$TAB" read -r n url path ref sha lic day; do
        case $n in ""|\#*) continue;; esac
        if ! collect_allowed "$url" "$dir"; then warn "${n}：$(url_id "$url") 已經不在 collect_sources，不檢查"; continue; fi
        if [ "$ref" = - ]; then now=$(git_safe ls-remote "$url" HEAD 2>/dev/null | awk '$2 == "HEAD" { print $1; exit }')
        else # a branch, or a tag (the commit it points to: ^{})
            now=$(git_safe ls-remote "$url" "refs/heads/$ref" "refs/tags/$ref" "refs/tags/$ref^{}" 2>/dev/null |
                  awk -v r="$ref" '$2 == "refs/heads/" r { b = $1 } $2 == "refs/tags/" r { t = $1 } $2 == "refs/tags/" r "^{}" { p = $1 }
                                   END { print (b != "" ? b : (p != "" ? p : t)) }')
        fi
        if [ -z "$now" ]; then warn "${n}：連不到 $(url_id "$url")"
        elif [ "$now" = "$sha" ]; then say "  ${n}：最新（$(printf %.12s "$sha")）"
        else say "  ${n}：有新版本 $(printf %.12s "$sha") → $(printf %.12s "$now")，打  kit collect $n  收新的"; new=$((new+1)); fi
    done < "$dir/third_party.lock"
    [ $new = 0 ] || say "kit：$new 個有新版本"
}

cmd_approve() { # kit approve <approvals repo> <source clone>... --key <ssh key> [--yes]
    local dir="" key="" yes="" repos=() r n sha prev f tmp serial
    while [ $# -gt 0 ]; do
        case $1 in
            --key) key=${2:-}; shift 2 || die "--key 後面要接簽章用的 ssh 金鑰";;
            --yes) yes=1; shift;;
            *) if [ -z "$dir" ]; then dir=$1; else repos+=("$1"); fi; shift;;
        esac
    done
    [ -n "$dir" ] && [ ${#repos[@]} -ge 1 ] && [ -n "$key" ] || die "用法：kit approve <核准紀錄的 repo> <來源的 clone>... --key <ssh 金鑰>"
    [ -d "$dir/.git" ] || die "$dir 要是一個 git repo（放核准紀錄）"
    [ -f "$key" ] || die "找不到金鑰 $key"
    f="$dir/approved.txt"; tmp=$(mktemp "${TMPDIR:-/tmp}/kit-approve.XXXXXX")
    serial=$(awk '$1 == "serial:" { print $2; exit }' "$f" 2>/dev/null); serial=$(( ${serial:-0} + 1 ))
    awk 'NF == 2 && $1 !~ /^#/ && $1 != "serial:"' "$f" 2>/dev/null > "$tmp"
    for r in "${repos[@]}"; do
        [ -d "$r/.git" ] || die "$r 不是 git clone"
        [ -z "$(git -C "$r" status --porcelain)" ] || die "$r 有還沒 commit 的改動"
        n=$(basename "$(cd "$r" && pwd)"); sha=$(git -C "$r" rev-parse HEAD)
        prev=$(awk -v n="$n" '$1 == n { print $2; exit }' "$tmp")
        printf '\n== %s  %s → %s\n' "$n" "$( [ -n "$prev" ] && printf %.12s "$prev" || echo 第一次)" "$(printf %.12s "$sha")"
        if [ "$prev" = "$sha" ]; then echo "（沒有變）"
        elif [ -n "$prev" ] && git -C "$r" cat-file -e "$prev^{commit}" 2>/dev/null; then
            git -C "$r" --no-pager log --oneline "$prev..$sha"; git -C "$r" --no-pager diff --stat "$prev" "$sha"
        else git -C "$r" --no-pager log --oneline -5 "$sha"; fi
        [ -n "$(git -C "$r" branch -r --contains "$sha" 2>/dev/null)" ] || warn "$n 的 $(printf %.12s "$sha") 還沒 push 到任何遠端"
        awk -v n="$n" '$1 != n' "$tmp" > "$tmp.2"; printf '%s %s\n' "$n" "$sha" >> "$tmp.2"; mv "$tmp.2" "$tmp"
    done
    if [ -z "$yes" ]; then
        local a=""
        if ! { printf '\n核准上面這些版本？[y/N] ' > /dev/tty && read -r a < /dev/tty; } 2>/dev/null; then
            rm -f "$tmp"; die "沒辦法在這裡問你（沒有終端機）。看過上面的內容、確定要核准，就加 --yes 再打一次"
        fi
        case $a in y|Y|yes) ;; *) rm -f "$tmp"; die "沒有核准";; esac
    fi
    { echo "# agentkit approvals - signed with kit approve; do not edit by hand"
      echo "serial: $serial"
      LC_ALL=C sort "$tmp"; } > "$f"
    rm -f "$tmp" "$f.sig"
    ssh-keygen -Y sign -q -f "$key" -n agentkit "$f" || die "簽章失敗"
    git -C "$dir" add approved.txt approved.txt.sig && git -C "$dir" commit -q -m "approve serial $serial" || die "commit 失敗"
    say "kit：已核准並簽章（serial ${serial}）。下一步：git -C $dir push"
}

# ---------- the Herdr panel (a Herdr mod that runs kit list --json / add / rm / sync / run) ----------
SHIPPED_LAYOUTS="main terminals win98"     # Herdr's own layouts: Herdr puts them back when edited
PANEL_TOGGLE='{"id":"kit-toggle","type":"block","content":{"mod":"kit","props":{"role":"toggle"}},"size":{"px":56}}'
PANEL_NODE='{"id":"kit-panel","type":"column","children":[{"id":"kit","type":"block","content":{"mod":"kit"}}],"size":{"px":420},"min":320,"max":800}'
herdr_home() { # the same rule as Herdr: $HERDR_APP_HOME, else $XDG_CONFIG_HOME/herdr-app, else ~/.config/herdr-app
    if [ -n "${HERDR_APP_HOME:-}" ]; then printf '%s\n' "$HERDR_APP_HOME"
    elif [ -n "${XDG_CONFIG_HOME:-}" ]; then printf '%s/herdr-app\n' "$XDG_CONFIG_HOME"
    else printf '%s/.config/herdr-app\n' "$HOME"; fi
}
panel_src() { # the panel's files: next to the installed kit, else in the repo kit runs from
    local d
    for d in "$KIT_LIB/herdr/kit-panel" "$(kit_repo 2>/dev/null)/herdr/kit-panel"; do
        [ -f "$d/main.js" ] && { printf '%s\n' "$d"; return 0; }
    done
    return 1
}
layout_without_panel() { # layout_without_panel FILE OUT : FILE without the panel's blocks
    printf 'rmwhere\tcontent.mod\tkit\nrmwhere\tid\tkit-toggle\nrmwhere\tid\tkit-panel\n' > "$2.ops"
    LC_ALL=C awk -f "$KIT_LIB/json.awk" -v ops="$2.ops" "$1" > "$2"; local rc=$?
    rm -f "$2.ops"; return $rc
}
swap_layout() { # swap_layout NEW FILE : FILE (backed up first) becomes NEW
    local b; b="$2.kit-backup-$(date +%Y%m%d-%H%M%S)"
    cp -p "$2" "$b" || { rm -f "$1"; die "沒辦法備份 $2"; }
    cat "$1" > "$2" && rm -f "$1"
    say "kit：改了版面 $(basename "$2")（原本的備份在 $(basename "$b")）"
}
cmd_herdr_panel() {
    local hh mods dest src name lf tmp place=none keep="" k v env first
    hh=$(herdr_home); mods="$hh/mods"; dest="$mods/kit"
    case ${1:-} in
    install)
        [ "${2:-}" = --keep-env ] && keep=1
        src=$(panel_src) || die "找不到 panel 的檔案（herdr/kit-panel）；請重裝 kit"
        [ -d "$mods" ] || die "找不到 Herdr 的 mods 資料夾：${mods}（Herdr 有裝、開過一次嗎？）"
        [ ! -e "$dest" ] || [ -f "$dest/.kit-panel" ] || die "$dest 已經有東西，不是 kit 放的，不動它"
        # where the panel goes: a button in the tab bar of the shown layout + the panel beside the work area
        name=$(json_get "$hh/shared.json" layout | sed 's/^"//; s/"$//'); [ -n "$name" ] || name=main
        lf="$hh/layouts/$name.json"; tmp=""
        case " $SHIPPED_LAYOUTS " in
        *" $name "*) place=right
            say "kit：現在的版面（${name}）是 Herdr 內建的，不能直接改：panel 會先出現在右邊，按 panel 上的「放進上排」會複製一份版面再放進去";;
        *)  if [ ! -f "$lf" ]; then place=right
            elif grep -q '"kit-toggle"' "$lf"; then :
            else
                tmp=$(mktemp "$lf.kit.XXXXXX")
                layout_without_panel "$lf" "$tmp.1" &&
                    printf 'addnear\tcontent.mod\ttabs\t%s\naddnear\tcontent.tab\tactive\t%s\n' "$PANEL_TOGGLE" "$PANEL_NODE" > "$tmp.ops" &&
                    LC_ALL=C awk -f "$KIT_LIB/json.awk" -v ops="$tmp.ops" "$tmp.1" > "$tmp"
                rm -f "$tmp.1" "$tmp.ops"
                if ! grep -q '"kit-toggle"' "$tmp" || ! grep -q '"kit-panel"' "$tmp"; then
                    rm -f "$tmp"; tmp=""; place=right
                    say "kit：版面 $name 找不到分頁列（tabs）或工作區，沒改它：panel 會先出現在右邊"
                fi
            fi;;
        esac
        # the files (main.js etc.), then mod.json and the panel's config (how to run kit here)
        mkdir -p "$dest" || die "沒辦法建立 $dest"
        cp -R "$src"/. "$dest"/ || die "沒辦法複製 panel 到 $dest"
        printf '{ "place": "%s", "size": 420, "title": "kit" }\n' "$place" > "$dest/mod.json"
        env=""; first=1
        if [ -n "$keep" ]; then
            for k in HOME AGENTKIT_CONFIG AGENTKIT_SOURCES CLAUDE_CONFIG_DIR CODEX_HOME PI_CODING_AGENT_DIR; do
                eval "v=\${$k:-}"; [ -n "$v" ] || continue
                [ $first = 1 ] || env="$env, "; first=0; env="$env$(json_s "$k"): $(json_s "$v")"
            done
        fi
        printf '{\n  "kit": [%s],\n  "env": {%s}\n}\n' "$(json_s "$(cd "$(dirname "$0")" && pwd)/$(basename "$0")")" "$env" > "$dest/config.json"
        : > "$dest/.kit-panel"
        [ -n "$tmp" ] && swap_layout "$tmp" "$lf"
        say "kit：Herdr 的 kit panel 裝好了（${dest}）"
        ;;
    uninstall)
        if [ -e "$dest" ]; then
            [ -f "$dest/.kit-panel" ] || die "$dest 不是 kit 放的，不動它"
            rm -rf "$dest"
        fi
        for lf in "$hh"/layouts/*.json; do
            [ -f "$lf" ] || continue
            case " $SHIPPED_LAYOUTS " in *" $(basename "$lf" .json) "*) continue;; esac
            grep -q '"kit-toggle"\|"kit-panel"\|"mod": "kit"' "$lf" || continue
            tmp=$(mktemp "$lf.kit.XXXXXX")
            layout_without_panel "$lf" "$tmp" || { rm -f "$tmp"; warn "沒辦法讀 ${lf}，沒改它"; continue; }
            swap_layout "$tmp" "$lf"
        done
        say "kit：Herdr 的 kit panel 拿掉了"
        ;;
    *) die "用法：kit herdr-panel install|uninstall";;
    esac
}

usage() {
    cat <<'EOF'
kit - 管理 AI 寫程式工具的 rule、skill、MCP 和 agent

  kit init <網址|資料夾> [更多...]   第一次：設定來源，加上預設的東西
  kit list [--json]                 有哪些、你在用哪些、哪些是新的（--json 給程式讀）
  kit add rule|skill|mcp <名字>     開始用
  kit rm  rule|skill|mcp <名字>     不用了（之後 sync 也不會加回來）
  kit run <agent> [--tool codex|omp] [參數]   開一個做好的 agent（預設用 Claude）
  kit sync [--force]                現在更新（kit run 會自動做）

寫內容的人用（只吃本機資料夾，不連網）：
  kit new rule|skill|mcp|agent <名字> [--from 本機資料夾] [--to 來源]
  kit diff   [種類] <名字> --from 本機資料夾   比較
  kit update [種類] <名字> --from 本機資料夾   更新；別人改過會停下來（--force 硬蓋）
  kit check [--ci] [資料夾...]      檢查格式、引用、名字重複、網址、不該公開的字

維護者用（只收 kit.yaml 的 collect_sources 列的原作者）：
  kit collect <原作者 repo 網址> [--path 資料夾] [--name 名字] [--ref 分支]   收別人的 skill（保留 LICENSE）
  kit collect <名字>                再收一次＝整份換成原作者的新版
  kit outdated                      看收過的 skill 原作者有沒有新版
  kit export-self <資料夾> [--version <版本>]   匯出 kit 的原始碼（給公司的 git server）
  kit ci-template [檔案]            Gitea Actions 範本（PR 自動跑 kit check --ci），例：
                                      kit ci-template .gitea/workflows/kit-check.yaml
  kit push [--to 來源] [--dry-run]  檢查後把改的東西送到 Gitea 開 PR

  kit approve <核准紀錄> <來源 clone>... --key <金鑰>   簽章核准這些版本（給 root 這類只用核准版本的帳號）
  kit herdr-panel install|uninstall 在 Herdr 加上（或拿掉）kit 的面板
  kit self-update                   更新 kit 本身
  kit uninstall [--self]            拿掉 kit 加的東西（--self 連 kit 也移除）
  kit --version
EOF
}

case ${1:-} in
    init)      shift; cmd_init "$@";;
    sync)      shift
               case ${1:-} in --force) FORCE=1;; --hook) sync_hook;; esac
               cmd_sync;;
    list|ls)   shift; cmd_list "$@";;
    add)       shift; cmd_add_rm add "$@";;
    rm|remove) shift; cmd_add_rm rm "$@";;
    run)       shift; cmd_run "$@";;
    new)       shift; cmd_new "$@";;
    diff)      shift; cmd_diff_update diff "$@";;
    update)    shift; cmd_diff_update update "$@";;
    check)     shift; cmd_check "$@";;
    export-self) shift; cmd_export_self "$@";;
    ci-template) shift; cmd_ci_template "$@";;
    push)      shift; cmd_push "$@";;
    uninstall) shift; cmd_uninstall "$@";;
    self-update) cmd_self_update;;
    approve)   shift; cmd_approve "$@";;
    collect)   shift; cmd_collect "$@";;
    outdated)  shift; cmd_outdated "$@";;
    herdr-panel) shift; cmd_herdr_panel "$@";;
    --version|version) echo "kit $KIT_VERSION";;
    ""|-h|--help|help) usage;;
    *) die "沒有這個指令：$1（打 kit help）";;
esac
