    if [ -n "$json" ]; then
        printf '{"tool": %s, "log": %s, "dir": %s, "files": [%s], "turns": [%s]%s}\n' "$(json_s "$tool")" "$(json_s "$log")" "$(json_s "$dir")" "$out" "$turns" \
            "$( [ -z "$note" ] || printf ', "note": %s' "$(json_s "$note")")" >&3
    else
        [ -z "$note" ] || warn "$note"
        if [ -n "$human" ]; then printf '%s' "$human"; else warn "沒有看到讀過或改過的檔案"; fi
    fi
}

# ---------- commands ----------
need_init() { [ -f "$MACHINE" ] || die_c not_init "還沒設定：先打  kit init <網址或資料夾>"; }

cmd_init() {
    local KIT_INIT=1
    local s srcs="" more d args=()
    M_APPROVALS=""; M_SIGNERS=""
    while [ $# -gt 0 ]; do
        case $1 in
            --approvals) M_APPROVALS=${2:-}; shift 2 || die "--approvals 後面要接核准紀錄的 repo";;
            --signers)   M_SIGNERS=${2:-}; shift 2 || die "--signers 後面要接 allowed_signers 檔";;
            *) args+=("$1"); shift;;
        esac
    done
    [ ${#args[@]} -ge 1 ] || die "用法：kit init <網址或資料夾> [更多來源...] [--approvals <repo> --signers <檔>]"
    if [ -n "$M_APPROVALS$M_SIGNERS" ]; then
        [ -n "$M_APPROVALS" ] && [ -n "$M_SIGNERS" ] || die "--approvals 和 --signers 要一起給"
        M_SIGNERS=$(cd "$(dirname "$M_SIGNERS")" 2>/dev/null && printf '%s/%s' "$(pwd)" "$(basename "$M_SIGNERS")") || die "找不到 $M_SIGNERS"
        is_url "$M_APPROVALS" || M_APPROVALS=$(cd "$M_APPROVALS" && pwd) || die "找不到 $M_APPROVALS"
    fi
    set -- "${args[@]}"
    for s in "$@"; do
        has_creds "$s" && die "網址裡有帳號或 token（$(url_safe "$s")）：不要把密碼放進網址，先用 git clone 登入一次（Git 的認證管理會記住），再用不含帳號的網址"
        is_url "$s" || s=$(real_dir "$s") || die "找不到資料夾：$s"
        srcs="$srcs$s
"
    done
    write_machine "$srcs" "" ""
    while IFS= read -r s; do [ -z "$s" ] || fetch_source "$s"; done <<< "$(m_sources)"
    add_includes
    write_machine "$(m_sources)" "$(recommended_items)" ""
    say "kit：設定好 $(m_sources | wc -l | tr -d ' ') 個來源"
    apply_claude
    seen_all
    say "kit：完成。打  kit list  看有哪些"
}

seen_all() { for i in $(available); do state_set seen "$i" 1; done; }

wanted_version() { # the newest kit_version the sources ask for, when it is newer than this kit
    # x.y.z compared as numbers, "+build" ignored; a dev build (no VERSION) is never told
    src_dirs | while IFS= read -r d; do yget "$d/kit.yaml" kit_version; done | awk -v have="$KIT_VERSION" '
        function num(v,   p, n, i) {
            sub(/\+.*/, "", v); n = split(v, p, ".")
            if (n < 1 || n > 3) return ""
            for (i = 1; i <= n; i++) if (p[i] !~ /^[0-9]+$/) return ""
            return sprintf("%09d%09d%09d", p[1], p[2], p[3])
        }
        BEGIN { best = num(have); if (best == "") exit }
        { n = num($0); if (n != "" && n > best) { best = n; need = $0 } }
        END { if (need != "") print need }'
}
version_nag() { # tell once when a source's kit.yaml wants a newer kit (not in the background, not when quiet)
    [ -z "${QUIET:-}${NO_NAG:-}" ] || return 0
    local need
    need=$(wanted_version)
    if [ -z "$need" ]; then [ -z "$(state_get nag kit_version)" ] || state_del nag kit_version; return 0; fi
    [ "$(state_get nag kit_version)" = "$need $KIT_VERSION" ] && return 0
    say "kit：團隊要 kit ${need} 以上，你的是 ${KIT_VERSION}。請打  kit self-update"
    state_set nag kit_version "$need $KIT_VERSION"
}

includes() { # include: entries of every source; a local path is relative to the source that lists it
    local d i
    src_dirs | while IFS= read -r d; do
        yget "$d/kit.yaml" include | while IFS= read -r i; do
            [ -n "$i" ] || continue
            if is_url "$i"; then printf '%s\n' "$i"; continue; fi
            case $i in /*) ;; *) i="$d/$i";; esac
            real_dir "$i" || printf '%s\n' "$i"
        done
    done | awk 'NF && !seen[$0]++'
}
add_includes() { # add sources that a source includes but machine.yaml does not list yet (also chains)
    local more s n
    for n in 1 2 3 4 5; do
        # skip includes that are already a source (same URL, or the same folder as a clone)
        more=$(includes | while IFS= read -r s; do src_dirs | grep -qxF "$(src_dir "$s")" || printf '%s\n' "$s"; done | grep -vxF -f <(m_sources; echo '##none##'))
        [ -n "$more" ] || return 0
        write_machine "$(m_sources; printf '%s\n' "$more")" "$(m_added)" "$(m_removed)"
        while IFS= read -r s; do
            fetch_source "$s"
            [ -n "${KIT_INIT:-}" ] || say "kit：加了來源 ${s}（某個來源的 kit.yaml 引用它）"
        done <<EOF
$more
EOF
    done
}

cmd_sync() {
    need_init
    local s
    while IFS= read -r s; do [ -z "$s" ] || fetch_source "$s"; done <<< "$(m_sources)"
    add_includes
    apply_dirs                                               # first: a folder that is gone leaves the list Codex's trust comes from
    apply_claude
    local new=""
    for i in $(available); do [ -n "$(state_get seen "$i")" ] || new="$new $i"; done
    [ -n "$new" ] && say "kit：新：$new  （要用就 kit add <種類> <名字>）"
    seen_all
    version_nag
}

json_s() { # a JSON string: \ " TAB LF CR escaped, other control characters dropped (the same as kit.ps1)
    local s=$1
    s=${s//\\/\\\\}; s=${s//\"/\\\"}
    s=${s//$TAB/\\t}; s=${s//$'\n'/\\n}; s=${s//$'\r'/\\r}
    case $s in *[$'\001'-$'\037']*) s=$(printf '%s' "$s" | LC_ALL=C tr -d '\000-\037');; esac
    printf '"%s"' "$s"
}
item_desc() { # item_desc KIND FILE : the description of a skill or agent (frontmatter) or of an MCP yaml
    case $1 in
        skill|agent) fm_starts "$2" && fm_val "$(fm_of "$2")" description | head -n 1;;
        mcp) yget "$2" description 2>/dev/null | head -n 1;;
    esac
}
json_keys() { # json_keys FILE PATH : the keys of the object at PATH (keys joined by TAB), one per line
    LC_ALL=C awk -f "$KIT_LIB/json.awk" -v keys="$2" -v sep="$TAB" "$1" 2>/dev/null
}
here_short() { # a path as the panel shows it: inside DIR relative to it, else with ~ for the home folder
    case $2 in
        "$1"/*) printf '%s' "${2#"$1"/}";;
        "$HOME"/*) printf '~/%s' "${2#"$HOME"/}";;
        *) printf '%s' "$2";;
    esac
}
kit_only() { # kit_only FILE : FILE has nothing but kit's block (kit made it for a folder's own)
    [ -z "$(awk -v b="$BEGIN_MARK" -v e="$END_MARK" '{ sub(/\r$/, "") } $0 == b { s = 1 } !s && NF { print; exit } $0 == e { s = 0 }' "$1")" ]
}
here_rows() { # here_rows DIR : what an agent started in DIR gets that kit does not manage
    # lines: scope<TAB>kind<TAB>name<TAB>path<TAB>tools   (scope dir = DIR and the folders above it, user = this account)
    # (the folder's own that kit put there, kit add --dir, are not listed: the panel shows them as kit's)
    local dir=$1 a f n mine root LC_ALL=C
    root=$(dir_root "$dir" 2>/dev/null); mine=$(dir_items "$root")
    a=$dir
    while :; do
        for f in "$a/CLAUDE.md" "$a/CLAUDE.local.md" "$a/.claude/CLAUDE.md"; do
            [ -f "$f" ] && [ "$f" != "$CLAUDE_DIR/CLAUDE.md" ] && ! kit_only "$f" && printf 'dir\trule\t%s\t%s\tclaude\n' "$(here_short "$dir" "$f")" "$f"
        done
        if [ "$a/.claude" != "$CLAUDE_DIR" ]; then
            for f in "$a"/.claude/rules/*.md; do [ -f "$f" ] && printf 'dir\trule\t%s\t%s\tclaude\n' "$(here_short "$dir" "$f")" "$f"; done
            for f in "$a"/.claude/skills/*/SKILL.md; do
                [ -f "$f" ] || continue; n=$(basename "$(dirname "$f")")
                [ "$a" = "$root" ] && printf '%s\n' "$mine" | grep -qxF "skill:$n" && continue
                printf 'dir\tskill\t%s\t%s\tclaude\n' "$n" "$f"
            done
        fi
        [ -f "$a/AGENTS.md" ] && ! kit_only "$a/AGENTS.md" && printf 'dir\trule\t%s\t%s\tcodex omp\n' "$(here_short "$dir" "$a/AGENTS.md")" "$a/AGENTS.md"
        [ "$a" = / ] && break
        a=$(dirname "$a")
    done
    [ -f "$dir/.mcp.json" ] && json_keys "$dir/.mcp.json" mcpServers | while IFS= read -r n; do
        [ "$dir" = "$root" ] && printf '%s\n' "$mine" | grep -qxF "mcp:$n" && continue
        printf 'dir\tmcp\t%s\t%s\tclaude\n' "$n" "$dir/.mcp.json"; done
    [ -f "$CLAUDE_JSON" ] && json_keys "$CLAUDE_JSON" "projects$TAB$dir${TAB}mcpServers" | while IFS= read -r n; do
        printf 'dir\tmcp\t%s\t%s\tclaude\n' "$n" "$CLAUDE_JSON"; done
    for f in "$CLAUDE_DIR"/skills/*/SKILL.md; do
        [ -f "$f" ] || continue; n=$(basename "$(dirname "$f")")
        [ -n "$(state_get skill "$n")" ] || printf 'user\tskill\t%s\t%s\tclaude\n' "$n" "$f"
    done
    [ -f "$CLAUDE_JSON" ] && json_keys "$CLAUDE_JSON" mcpServers | while IFS= read -r n; do
        [ -n "$(state_get mcp "$n")" ] || printf 'user\tmcp\t%s\t%s\tclaude\n' "$n" "$CLAUDE_JSON"; done
    return 0
}
other_user() { # other_user PID : the user of a process under PID that is not me (an agent started with sudo -i), if any
    local me; me=$(id -un 2>/dev/null) || return 0
    # (ps itself may run as root on macOS: not counted)
    { ps -A -o user= -o pid= -o ppid= -o comm= 2>/dev/null || ps -o user,pid,ppid,comm 2>/dev/null; } | awk -v top="$1" -v me="$me" '
        $2 ~ /^[0-9]+$/ && $4 !~ /(^|\/)ps$/ { u[$2] = $1; p[$2] = $3 }
        END { for (x in p) { y = x; for (i = 0; i < 64 && y != top && (y in p); i++) y = p[y]
                             if (y == top && x != top && u[x] != me) { print u[x]; exit } } }'
}
pid_tree() { # pid_tree PID : PID and every process under it
    { ps -A -o pid= -o ppid= 2>/dev/null || ps -o pid,ppid 2>/dev/null; } | awk -v top="$1" '
        $1 ~ /^[0-9]+$/ { p[$1] = $2 }
        END { print top; for (x in p) { y = x; for (i = 0; i < 64 && y != top && (y in p); i++) y = p[y]
                                        if (y == top && x != top) print x } }'
}
run_agent() { # run_agent PID : the agent that kit run started at or under PID (kit run leaves a marker), if any
    local d="$KIT_CONF/run" f p tree found=""
    [ -d "$d" ] || return 0
    tree=$(pid_tree "$1")
    for f in "$d"/*; do
        [ -f "$f" ] || continue
        p=${f##*/}
        case $p in *[!0-9]*) continue;; esac
        ps -p "$p" >/dev/null 2>&1 || { rm -f "$f"; continue; }       # that kit run has ended
        [ -z "$found" ] && printf '%s\n' "$tree" | grep -qxF "$p" && found=$f
    done
    [ -z "$found" ] || head -n 1 "$found"
    return 0
}
agent_json() { # agent_json NAME : {"name", "source", "rules", "skills", "mcp"} of a kit agent
    local f fm="" src=""
    f=$(find_item agent "$1") && { fm=$(fm_of "$f"); src=$(basename "${f%/agents/*}"); }
    printf '{"name": %s, "source": %s, "rules": %s, "skills": %s, "mcp": %s}' "$(json_s "$1")" "$(json_s "$src")" \
        "$(fm_val "$fm" rules | json_arr)" "$(fm_val "$fm" skills | json_arr)" "$(fm_val "$fm" mcp | json_arr)"
}
here_json() { # here_json DIR PID : the "here" part of kit list --json --dir
    local dir=$1 user="" agent="" first=1 sc k n f t d
    [ -n "$2" ] && { user=$(other_user "$2"); agent=$(run_agent "$2"); }
    printf ',\n  "here": {"dir": %s, "user": %s, "agent": %s' "$(json_s "$dir")" "$( [ -n "$user" ] && json_s "$user" || echo null)" \
        "$( [ -n "$agent" ] && agent_json "$agent" || echo null)"
    if [ -n "$user" ]; then printf ', "items": []}'; return; fi
    if [ ! -d "$dir" ]; then printf ', "error": %s, "items": []}' "$(json_s "找不到這個資料夾")"; return; fi
    local froot; froot=$(dir_root "$dir")
    local fa; fa=$(dir_mark "$froot" agent)
    printf ', "folder": {"dir": %s, "why": %s, "items": %s, "agent": %s}' "$(json_s "$froot")" "$(json_s "$(dir_why_not "$froot")")" "$(dir_items "$froot" | json_arr)" \
        "$( [ -n "$fa" ] && json_s "$fa" || echo null)"
    printf ', "items": ['
    while IFS="$TAB" read -r sc k n f t; do
        [ -n "$k" ] || continue
        d=""
        case $k in
            skill) d=$(item_desc skill "$f");;
            rule) d=$(grep -m 1 '^# ' "$f" 2>/dev/null | sed 's/^# *//');;
        esac
        [ $first = 1 ] || printf ','; first=0
        printf '\n    {"scope": %s, "kind": %s, "name": %s, "path": %s, "tools": %s, "description": %s}' \
            "$(json_s "$sc")" "$(json_s "$k")" "$(json_s "$n")" "$(json_s "$f")" "$(json_s "$t")" "$(json_s "$d")"
    done <<EOF
$(here_rows "$dir")
EOF
    printf '\n  ]}'
}
cmd_list_json() { # what kit list shows, as JSON for programs (a screen like a kit panel); kit.ps1 prints the same
    local want req i k n p d status new first s tools sf chg="" changed rel f
    want=$(wanted); req=$(required_items)
    tool_cache                                               # each program looked at once, not once per skill
    printf '{\n  "kit": %s,\n  "sources": [' "$(json_s "$KIT_VERSION")"
    first=1
    while IFS= read -r s; do
        [ -n "$s" ] || continue
        [ $first = 1 ] || printf ','; first=0
        d=$(src_dir "$s"); sf=$(cd "$d" 2>/dev/null && send_files)    # what kit push would send from it
        [ -z "$sf" ] || while IFS= read -r f; do chg="$chg$TAB$d/$f$LF"; done <<< "$sf"
        printf '\n    {"name": %s, "source": %s, "dir": %s, "push": %s, "changed": %s}' "$(json_s "$(src_name "$s")")" "$(json_s "$(url_safe "$s")")" "$(json_s "$d")" "$(json_s "$(push_mode "$d")")" "$(printf '%s\n' "$sf" | json_arr)"
    done <<EOF
$(m_sources)
EOF
    tools='"claude"'; has_codex && tools="$tools, \"codex\""; has_omp && tools="$tools, \"omp\""
    printf '\n  ],\n  "tools": [%s],\n  "items": [' "$tools"
    first=1
    for i in $(available); do
        k=${i%%:*}; n=${i#*:}
        p=$(find_item "$k" "$n") || continue
        status=unused
        printf '%s\n' "$want" | grep -qxF "$i" && status=used
        printf '%s\n' "$req" | grep -qxF "$i" && status=required
        [ "$k" = agent ] && status=agent
        new=false; [ -n "$(state_get seen "$i")" ] || new=true
        rel=$(item_path "" "$k" "$n"); d=${p%"$rel"}            # the source folder that has it
        # changed: kit push would send it (a skill: any file in its folder)
        changed=false
        case $k in skill) case $chg in *"$TAB$d${rel%/*}/"*) changed=true;; esac;;
                   *) case $chg in *"$TAB$d$rel$LF"*) changed=true;; esac;; esac
        [ $first = 1 ] || printf ','; first=0
        printf '\n    {"kind": %s, "name": %s, "status": %s, "new": %s, "changed": %s, "source": %s, "description": %s, "path": %s%s}' \
            "$(json_s "$k")" "$(json_s "$n")" "$(json_s "$status")" "$new" "$changed" "$(json_s "$(basename "$d")")" "$(json_s "$(item_desc "$k" "$p")")" "$(json_s "$p")" \
            "$(case $k in (skill) printf ', "needs": %s%s' "$(needs_json "$(dirname "$p")" "${d%/}")" "$(packages_json "$(dirname "$p")" "$n")";;
                         (mcp) mcp_list_json "$p" "$n";; esac)"
    done
    printf '\n  ],\n  "kit_version_wanted": %s' "$(json_s "$(wanted_version)")"
    [ -n "${HERE_DIR:-}" ] && here_json "$HERE_DIR" "${HERE_PID:-}"
    printf '\n}\n'
}

cmd_list() {
    case ${1:-} in
        --json) shift
            HERE_DIR=""; HERE_PID=""
            while [ $# -gt 0 ]; do
                case $1 in
                    --dir) [ $# -ge 2 ] || die_c usage "--dir 後面要接資料夾"; HERE_DIR=$2; shift 2
                        [ -d "$HERE_DIR" ] && HERE_DIR=$(cd "$HERE_DIR" && pwd -P);;
                    --pid) [ $# -ge 2 ] || die_c usage "--pid 後面要接數字"; HERE_PID=$2; shift 2
                        case $HERE_PID in ""|*[!0-9]*) die_c usage "--pid 後面要接數字";; esac;;
                    *) die_c usage "用法：kit list --json [--dir 資料夾] [--pid 程式編號]";;
                esac
            done
            need_init; cmd_list_json >&3; return;;
        "") ;;
        *) die_c usage "用法：kit list [--json [--dir 資料夾] [--pid 程式編號]]";;
    esac
    need_init
    local want req i mark
    want=$(wanted); req=$(required_items)
    for i in $(available); do
        mark="  "
        printf '%s\n' "$want" | grep -qxF "$i" && mark="* "
        printf '%s\n' "$req" | grep -qxF "$i" && mark="R "
        case $i in agent:*) mark="  ";; esac
        [ -n "$(state_get seen "$i")" ] || mark="${mark%% }N"
        printf '%s %s\n' "$mark" "$i"
    done
    # an MCP in use whose package is downloaded at each start (kit can install it once)
    local n p kind pkg ver argno bin first bad
    for n in $(printf '%s\n' "$want" | sed -n 's/^mcp://p'); do
        p=$(find_item mcp "$n") || continue
        IFS=$US read -r kind pkg ver argno bin first bad <<EOF
$(mcp_pkg "$p")
EOF
        [ -n "$kind" ] && ! mcp_installed "$n" "$kind" "$pkg" "$ver" "$bin" >/dev/null || continue
        if [ -n "$ver" ] && [ -z "$bad" ]; then say "   mcp:$n 每次啟動時下載 ${pkg}（先裝好：kit install-deps mcp ${n}）"
        else say "   mcp:$n 每次啟動時下載 ${pkg:-它的套件}"; fi
    done
    say ""
    say "* 在用   R 團隊必備   N 新的   agent 用  kit run <名字>  開"
    say "寫到：$(targets)"
    version_nag
}

cmd_add_rm() {
    local verb=$1; shift
    local dir=""
    if [ "${1:-}" = --dir ]; then [ $# -ge 2 ] || die "--dir 後面要接資料夾"; dir=$2; shift 2; fi
    [ $# -eq 2 ] || die "用法：kit $verb [--dir 資料夾] rule|skill|mcp <名字>"
    need_init
    local k=$1 n=$2 i="$1:$2" added removed
    case " rule skill mcp " in *" $k "*) ;; *) die "種類只能是 rule、skill、mcp";; esac
    if [ -n "$dir" ]; then dir_add_rm "$verb" "$dir" "$k" "$n"; return; fi
    find_item "$k" "$n" > /dev/null || die "找不到 ${i}（打 kit list 看有哪些）"
    added=$(m_added); removed=$(m_removed)
    if [ "$verb" = add ]; then
        added=$(printf '%s\n%s\n' "$added" "$i" | awk 'NF && !seen[$0]++')
        removed=$(printf '%s\n' "$removed" | grep -vxF "$i")
    else
        required_items | grep -qxF "$i" && die "$i 是團隊必備，拿不掉"
        added=$(printf '%s\n' "$added" | grep -vxF "$i")
        removed=$(printf '%s\n%s\n' "$removed" "$i" | awk 'NF && !seen[$0]++')
    fi
    write_machine "$(m_sources)" "$added" "$removed"
    apply_claude
}

dir_add_rm() { # dir_add_rm add|rm DIR KIND NAME : only that folder (and below it) gets it, or no longer
    # (a placed folder: taking out one of its agent's is kept as not:KIND:NAME, adding it again takes that away)
    local verb=$1 k=$3 n=$4 i="$3:$4" root why own nots ag items
    [ -d "$2" ] || die "找不到資料夾 $2"
    root=$(dir_root "$2") || die "找不到資料夾 $2"
    why=$(dir_why_not "$root"); [ -z "$why" ] || die "${root}：$why"
    own=$(dir_own "$root"); nots=$(dir_nots "$root"); ag=$(dir_agent_items "$root")
    if [ "$verb" = add ]; then
        find_item "$k" "$n" > /dev/null || die "找不到 ${i}（打 kit list 看有哪些）"
        dir_items "$root" | grep -qxF "$i" && { say "kit：$root 已經有 $i"; return 0; }
        nots=$(printf '%s\n' "$nots" | grep -vxF "$i")
        printf '%s\n' "$ag" | grep -qxF "$i" || own=$(printf '%s\n%s\n' "$own" "$i" | awk 'NF')
    else
        dir_items "$root" | grep -qxF "$i" || die "$root 沒有加 ${i}（這個資料夾自己加的才拿得掉）"
        own=$(printf '%s\n' "$own" | grep -vxF "$i")
        printf '%s\n' "$ag" | grep -qxF "$i" && nots=$(printf '%s\n%s\n' "$nots" "$i" | awk 'NF')
    fi
    items=$(printf '%s\n' "$own"; printf '%s\n' "$nots" | awk 'NF { print "not:" $0 }')
    items=$(printf '%s\n' "$items" | awk 'NF')
    dir_write "$root" "$items"
    if [ -n "$items$(dir_mark "$root" agent)" ]; then dirs_set "$root" add; else dirs_set "$root" rm; fi
    apply_dir "$root"
    has_codex && apply_claude                                # Codex: the folder's trust and the root marker
    if [ "$verb" = add ]; then say "kit：$i 加到 ${root}（只有在這裡和子資料夾開的 agent 讀得到，開新的才會讀到）"
    else say "kit：$i 從 $root 拿掉了"; fi
}

toml_str() { # quote a string for TOML (a basic string; newlines escaped)
    local s=$1
    s=${s//\\/\\\\}; s=${s//\"/\\\"}
    s=${s//$TAB/\\t}; s=${s//$'\r'/\\r}; s=${s//$'\n'/\\n}
    printf '"%s"' "$s"
}

mcp_toml_inline() { # mcp_toml_inline FILE NAME -> {command="..", args=[..], env={..}} or {url="..", ...} (kit run --tool codex)
    local f=$1 n=$2 fields out="" env="" k v
    fields=$(codex_mcp_fields "$f" "$n" toml_str) || return 1
    while IFS="$TAB" read -r k v; do
        case $k in "") ;; env.*) env="${env:+$env, }$(toml_key "${k#env.}")=$v";; *) out="${out:+$out, }$k=$v";; esac
    done <<EOF
$fields
EOF
    [ -n "$env" ] && out="$out, env={$env}"
    printf '{%s}' "$out"
}

cmd_run() {
    [ $# -ge 1 ] || die "用法：kit run <agent> [--tool claude|codex|omp] [工具的參數...]"
    need_init
    local name=$1; shift
    local tool=claude
    if [ "${1:-}" = --tool ]; then tool=${2:-}; shift 2 || die "--tool 後面要接 claude、codex 或 omp"; fi
    case $tool in claude|codex|omp) ;; *) die "--tool 只能是 claude、codex 或 omp";; esac
    local f; f=$(find_item agent "$name") || die "找不到 agent ${name}（打 kit list 看有哪些）"
    if take_lock soft; then ( QUIET=1 cmd_sync ) 2>/dev/null; release_lock; fi   # busy (another kit is syncing): start as it is

    # the agent's folder, gone when kit ends (also on Ctrl-C); a dry run keeps it to look at, without kit's links in it.
    # Folders of runs that were killed (their kit is gone) go now.
    local d; for d in "${TMPDIR:-/tmp}"/kit-run.*; do
        [ -f "$d/.kit-pid" ] && ! kill -0 "$(cat "$d/.kit-pid")" 2>/dev/null && rm -rf "$d"
    done
    local tmp; tmp=$(mktemp -d "${TMPDIR:-/tmp}/kit-run.XXXXXX") || die "沒辦法建立暫存資料夾"
    [ -n "${KIT_DRY_RUN:-}" ] || { KIT_RUN_TMP=$tmp; echo $$ > "$tmp/.kit-pid"; }
    local n p k
    local fm; fm=$(LC_ALL=C awk -f "$KIT_LIB/yaml.awk" -v frontmatter=1 "$f") || die "bad header in $f"
    fmget() { printf '%s\n' "$fm" | awk -F'\t' -v p="$1" '$1 == p || $1 == p "[]" { sub(/^[^\t]*\t/, ""); print }'; }

    # the agent's skills, each in its own folder
    local skdir="$tmp/skills"; [ $tool = claude ] && skdir="$tmp/.claude/skills"
    mkdir -p "$skdir"
    for n in $(fmget skills); do
        p=$(find_item skill "$n") || { warn "skill $n not found"; continue; }
        cp -R "$(dirname "$p")" "$skdir/$n"; [ -n "${KIT_DRY_RUN:-}" ] || link_deps "$n" "$skdir/$n"
    done
    # the agent's rules + its prompt
    {
        for n in $(fmget rules); do
            p=$(find_item rule "$n") || { warn "rule $n not found"; continue; }
            cat "$p"; echo
        done
        py_hint $(fmget skills)
        fm_body "$f"
        if [ $tool = codex ] && [ -n "$(ls "$skdir")" ]; then
            # Codex cannot load skills from an extra folder: list them, it reads one when needed
            echo; echo "## Skills"
            echo "Skills you have. Before doing a task one of them covers, read its SKILL.md and follow it."
            for d in "$skdir"/*/; do
                n=$(basename "$d")
                printf -- '- %s: %s (%sSKILL.md)\n' "$n" "$(LC_ALL=C awk -f "$KIT_LIB/yaml.awk" -v frontmatter=1 "$d/SKILL.md" 2>/dev/null | awk -F'\t' '$1 == "description" { print $2 }')" "$d"
            done
        fi
    } > "$tmp/prompt.md"
    local only deny; only=$(fmget tools.only | paste -sd, -); deny=$(fmget tools.deny)

    local args=()
    case $tool in
    claude)
        local mcps="" first=1
        for n in $(fmget mcp); do
            p=$(find_item mcp "$n") || { warn "mcp $n not found"; continue; }
            k=$(mcp_json "$p") || continue
            [ $first = 1 ] || mcps="$mcps,"; first=0
            mcps="$mcps$(json_str "$n"):$k"
        done
        printf '{"mcpServers":{%s}}\n' "$mcps" > "$tmp/mcp.json"
        args=(--add-dir "$tmp" --append-system-prompt-file "$tmp/prompt.md" --mcp-config "$tmp/mcp.json")
        [ -n "$only" ] && args+=(--tools "$only")
        while IFS= read -r d; do [ -n "$d" ] && args+=(--disallowedTools "$d"); done <<EOF
$deny
EOF
        ;;
    codex)
        args=(-c "developer_instructions=$(toml_str "$(cat "$tmp/prompt.md")")")
        for n in $(fmget mcp); do
            p=$(find_item mcp "$n") || { warn "mcp $n not found"; continue; }
            k=$(mcp_toml_inline "$p" "$n") || continue
            local t="" first=1
            while IFS= read -r d; do case $d in "mcp__${n}__"*) [ $first = 1 ] || t="$t, "; first=0; t="$t$(toml_str "${d#mcp__${n}__}")";; esac; done <<EOF
$deny
EOF
            [ -n "$t" ] && k="${k%\}}, disabled_tools=[$t]}"
            args+=(-c "mcp_servers.$(toml_key "$n")=$k")
        done
        [ -n "$only" ] && warn "Codex 不能只開某些內建工具，tools.only 這次不套用"
        printf '%s\n' "$deny" | grep -qv '^mcp__' && [ -n "$deny" ] && warn "Codex 只能禁用 MCP 的工具，其他的 tools.deny 這次不套用"
        ;;
    omp)
        printf 'skills:\n  customDirectories:\n    - %s\n' "$(toml_str "$skdir")" > "$tmp/omp.yml"
        args=(--config "$tmp/omp.yml" --append-system-prompt "$tmp/prompt.md")
        [ -n "$only" ] && args+=(--tools "$(printf '%s' "$only" | tr 'A-Z' 'a-z')")
        [ -n "$(fmget mcp)" ] && warn "omp 不能在啟動時加 MCP：這個 agent 的 MCP 請用  kit add mcp <名字>  加到全域"
        [ -n "$deny" ] && warn "omp 不能禁用單一工具，tools.deny 這次不套用"
        ;;
    esac
    set -- "${args[@]}" "$@"
    [ -n "${KIT_DRY_RUN:-}" ] && { printf '%s\n' "$tool" "$@"; printf 'tmp=%s\n' "$tmp"; return 0; }
    # a marker (this process -> agent name), so a program showing the pane can tell which agent runs in it
    mkdir -p "$KIT_CONF/run" 2>/dev/null && printf '%s\n' "$name" > "$KIT_CONF/run/$$"
    trap : INT                                               # Ctrl-C is the agent's; kit cleans up when it ends
    "$tool" "$@"
    local rc=$?
    trap 'exit 130' INT
    rm -rf "$tmp"; rm -f "$KIT_CONF/run/$$"; KIT_RUN_TMP=
    return $rc
}

cmd_place() { # kit place <agent> <dir> [--tool claude|codex|omp] [--json] : DIR becomes that agent's own folder
    # Built on a folder's own (kit add --dir): .agentkit lists the agent's rules, skills and MCP, and says which agent it is
    # (agent:NAME, tool:TOOL); kit sync puts the agent's prompt and tool limits in. Afterwards claude / codex / omp started
    # there is that agent, and kit add|rm --dir changes only this folder.
    local name="" dir="" tool=claude json="" a n k f fm d parent old items marks warns="" only deny
    while [ $# -gt 0 ]; do
        case $1 in
            --tool) [ $# -ge 2 ] || die_c usage "--tool 後面要接 claude、codex 或 omp"; tool=$2; shift 2;;
            --json) json=1; shift;;
            -*) die_c usage "用法：kit place <agent> <資料夾> [--tool claude|codex|omp] [--json]";;
            *) if [ -z "$name" ]; then name=$1; elif [ -z "$dir" ]; then dir=$1
               else die_c usage "用法：kit place <agent> <資料夾> [--tool claude|codex|omp] [--json]"; fi; shift;;
        esac
    done
    [ -n "$name" ] && [ -n "$dir" ] || die_c usage "用法：kit place <agent> <資料夾> [--tool claude|codex|omp] [--json]"
    case $tool in claude|codex|omp) ;; *) die_c usage "--tool 只能是 claude、codex 或 omp";; esac
    need_init
    f=$(find_item agent "$name") || die_c no_agent "找不到 agent ${name}（打 kit list 看有哪些）"
    case $dir in /) ;; *) while [ "${dir%/}" != "$dir" ]; do dir=${dir%/}; done;; esac
    if [ -d "$dir" ]; then d=$(cd "$dir" && pwd -P)
    else
        [ -e "$dir" ] && die_c bad_dir "$dir 不是資料夾"
        parent=$(dirname "$dir")
        [ -d "$parent" ] || die_c no_parent "上一層資料夾不在：${parent}（kit 只建最後一層）"
        d="$(cd "$parent" && pwd -P)/$(basename "$dir")"; d=${d#/}; d="/$d"
    fi
    a=$(dir_why_not "$d"); [ -z "$a" ] || die_c bad_dir "${d}：$a"
    if [ -d "$d" ]; then
        old=$(dir_mark "$d" agent)
        [ -z "$old" ] || [ "$old" = "$name" ] || die_c other_agent "$d 已經是 agent ${old}：換一個資料夾，或先把它的 .agentkit 拿掉"
        [ -n "$old" ] || [ -z "$(ls -A "$d" 2>/dev/null)" ] || die_c not_empty "$d 已經有東西（不是 kit place 放的）：kit 只放在新的或空的資料夾"
    else
        mkdir "$d" || die "沒辦法建立資料夾 $d"
    fi
    fm=$(fm_of "$f") || die "bad header in $f"
    # .agentkit: which agent, and what you changed there before (placed again); the agent's own come from it each time
    items=$(dir_lines "$d")
    for a in rule:rules skill:skills mcp:mcp; do
        k=${a%%:*}
        for n in $(fm_val "$fm" "${a#*:}"); do find_item "$k" "$n" >/dev/null || warns="$warns$k $n 不在任何來源裡：沒有放進來$LF"; done
    done
    marks="agent:$name${LF}tool:$tool"
    dir_write "$d" "$items" "$marks"
    dirs_set "$d" add
    apply_dir "$d"
    has_codex && apply_claude                                # Codex: the folder's trust and the root marker
    # what this tool cannot take from the agent in a folder (the README's table)
    only=$(fm_val "$fm" tools.only); deny=$(fm_val "$fm" tools.deny)
    case $tool in
    claude) ;;                                               # tools.only: deny for the others (kit check tells the author)
    codex)
        [ -z "$only" ] || warns="${warns}Codex 不能只開某些內建工具：tools.only 不套用$LF"
        printf '%s\n' "$deny" | grep -v '^mcp__' | grep -q . && warns="${warns}Codex 只能禁用 MCP 的工具：其他的 tools.deny 不套用$LF";;
    omp)
        [ -z "$(fm_val "$fm" mcp)" ] || warns="${warns}omp 只讀整個帳號的 MCP：這個 agent 的 MCP 在這裡只有 Claude Code 和 Codex 會用（omp 要用：kit add mcp <名字>）$LF"
        [ -z "$only$deny" ] || warns="${warns}omp 不能在資料夾裡限制工具：tools.only、tools.deny 不套用$LF";;
    esac
    [ -z "$warns" ] || printf '%s' "$warns" | while IFS= read -r a; do warn "$a"; done
    if [ -n "$json" ]; then
        printf '{"dir": %s, "agent": %s, "tool": %s, "command": %s, "warnings": %s}\n' "$(json_s "$d")" "$(json_s "$name")" "$(json_s "$tool")" \
            "$(printf '%s\n' "$tool" | json_arr)" "$(printf '%s' "$warns" | json_arr)" >&3
    else
        say "kit：$d 是 agent $name 了（在這裡打 $tool 開的就是它；之後用 kit add|rm --dir 改這個資料夾）"
    fi
}

cmd_uninstall() {
    local self=0; [ "${1:-}" = "--self" ] && self=1
    local n ops k v
    local f
    local left=0 d
    while IFS= read -r d; do                                 # the folders' own: kit's files out, .agentkit gone
        [ -n "$d" ] || continue
        [ -d "$d" ] && { rm -f "$d/$DIR_FILE"; QUIET=1 apply_dir "$d"; }
        dirs_set "$d" rm
    done <<EOF
$(dirs_registered)
EOF
    for f in "$CLAUDE_DIR/CLAUDE.md" "$CODEX_DIR/AGENTS.md" "$OMP_DIR/AGENTS.md"; do KIT_BLOCK= replace_block "$f" "$BEGIN_MARK" "$END_MARK" || left=1; done
    KIT_BLOCK= replace_block "$CODEX_DIR/config.toml" "$TOML_BEGIN" "$TOML_END" || left=1
    KIT_BLOCK= replace_top_block "$CODEX_DIR/config.toml" "$TOP_BEGIN" "$TOP_END" || left=1
    QUIET=1
    sync_skills "$CLAUDE_DIR/skills" skill < /dev/null
    sync_skills "$AGENTS_SKILLS" skill.agents < /dev/null
    sync_mcp_json "$CLAUDE_JSON" mcp < /dev/null           # stops kit (state.tsv kept) when the file cannot be written
    sync_mcp_json "$OMP_DIR/mcp.json" mcp.omp < /dev/null
    QUIET=
    ops=$(mktemp "${TMPDIR:-/tmp}/kit-ops.XXXXXX"); : > "$ops"
    while IFS="$TAB" read -r k n v; do
        [ "$k" = deny ] && printf 'rmstr\tpermissions.deny\t%s\n' "$n" >> "$ops"
        [ "$k" = hook ] && printf 'rmjson\thooks.%s\t%s\n' "$n" "$v" >> "$ops"
        [ "$k" = statusline ] && [ "$(json_get "$CLAUDE_DIR/settings.json" statusLine | tr -d ' \t\r\n')" = "$(printf '%s' "$v" | tr -d ' \t\r\n')" ] && printf 'del\tstatusLine\n' >> "$ops"
    done < "${STATE:-/dev/null}" 2>/dev/null
    [ -s "$ops" ] && { json_edit "$CLAUDE_DIR/settings.json" "$ops"; prune_deny; }
    rm -f "$ops"
    [ $left = 0 ] || die "有的檔案 kit 沒辦法改（看上面），其他的已經拿掉；修好後再打一次  kit uninstall"
    rm -f "$STATE" "$MACHINE"; rm -rf "$KIT_CONF/deps" "$KIT_CONF/pydeps" "$KIT_CONF/mcp-deps" "$KIT_CONF/placed" "$CTX_DIR"
    say "kit：已移除 kit 放進 Claude、Codex、omp 的東西（你自己的檔案沒動）"
    say "     來源的 clone 還留在 $KIT_SRC"
    if [ $self = 1 ]; then
        rm -f "$HOME/.local/bin/kit"; rm -rf "$HOME/.local/share/agentkit"
        say "kit：kit 本身也移除了"
    fi
}

cmd_self_update() { # pull the clone kit was installed from, then reinstall
    local repo; repo=$(cat "$KIT_LIB/.repo" 2>/dev/null) || die "不知道 kit 是從哪個 clone 裝的；請到 clone 裡 git pull 後重跑 unix/install.sh"
    [ -d "$repo/.git" ] || die "找不到 clone：$repo"
    local url; url=$(git -C "$repo" remote get-url origin 2>/dev/null) && check_host "$url"
    local before; before=$(git -C "$repo" rev-parse --short=12 HEAD 2>/dev/null)
    if [ -n "$M_APPROVALS" ]; then
        [ -n "$url" ] || die "$repo 沒有 origin"
        local sha; sha=$(approved_sha "$(src_name "$url")") || die "kit 本身（$(src_name "$url")）沒有有效的核准，不更新"
        git_safe -C "$repo" fetch -q --no-recurse-submodules origin || die "沒辦法 fetch $repo"
        git -C "$repo" -c advice.detachedHead=false checkout -q -f --detach "$sha" || die "找不到核准的版本 $sha"
    else
        git_safe -C "$repo" pull --ff-only -q || die "沒辦法更新 ${repo}（沒網路，或 clone 裡有自己的改動？）"
    fi
    sh "$repo/unix/install.sh" --quiet || die "重新安裝失敗"
    local now; now=$(git -C "$repo" rev-parse --short=12 HEAD 2>/dev/null)
    if [ -n "$before" ] && [ "$before" = "$now" ]; then say "kit：已經是最新（$(cat "$KIT_LIB/VERSION" 2>/dev/null)，${now}）"
    else say "kit：已更新到 $(cat "$KIT_LIB/VERSION" 2>/dev/null)（${now}）"; fi
}

# ---------- authoring: new / diff / update (local folders only, never the network) ----------
valid_name() { case $1 in ""|-*|*[!a-z0-9-]*) return 1;; *) return 0;; esac; }
target_dir() { # where new/update write: --to <source name|folder>, else the folder you are in if it has kit.yaml, else the first source
    local d
    if [ -n "$1" ]; then
        while IFS= read -r d; do [ -n "$d" ] && [ "$(basename "$d")" = "$1" ] && { printf '%s\n' "$d"; return 0; }; done <<EOF
$( [ -f "$MACHINE" ] && src_dirs )
EOF
        [ -d "$1" ] || die_c no_source "找不到 --to $1（要是來源名字或資料夾）"
        real_dir "$1"; return 0
    fi
    [ -f ./kit.yaml ] && { pwd -P; return 0; }        # links resolved, as src_dir names it
    need_init
    src_dirs | head -n 1
}
item_hash() { # item_hash KIND PATH(the item file)
    if [ "$1" = skill ]; then dir_hash "$(dirname "$2")"; else cksum < "$2" | awk '{print $1}'; fi
}
stage_from() { # stage_from KIND NAME FROM OUTDIR : copy what kit accepts from a local folder/file into OUTDIR; prints the item file
    local kind=$1 name=$2 from=$3 out=$4 f rel scripts=0 skipped=0 ext
    is_url "$from" && die "--from 只吃本機的資料夾或檔案（先自己 git clone 到暫存資料夾）"
    [ -e "$from" ] || die "找不到 $from"
    [ -d "$from" ] && from=$(cd "$from" && pwd -P)
    case $kind in
    skill)
        [ -d "$from" ] && [ -f "$from/SKILL.md" ] || die "$from 要是有 SKILL.md 的資料夾"
        grep -q 'scripts/' "$from/SKILL.md" && scripts=1
        mkdir -p "$out/$name"
        while IFS= read -r f; do
            rel=${f#"$from"/}
            case /$rel in */.git/*|*/.DS_Store) continue;; esac
            case $(basename "$rel") in LICENSE*|LICENCE*|COPYING*|README*|CHANGELOG*) skipped=$((skipped+1)); continue;; esac
            if [ -L "$f" ]; then skipped=$((skipped+1)); continue; fi
            case $rel in
                scripts/*) [ $scripts = 1 ] || { skipped=$((skipped+1)); continue; };;
                *.md) ;;
                *) skipped=$((skipped+1)); continue;;
            esac
            mkdir -p "$(dirname "$out/$name/$rel")"; cp "$f" "$out/$name/$rel"
        done <<EOF
$(cd "$from" && find "$(pwd -P)" -name .git -prune -o \( -type f -o -type l \) -print | LC_ALL=C sort)
EOF
        [ $skipped -gt 0 ] && warn "跳過 $skipped 個檔案（只帶 .md$( [ $scripts = 1 ] && echo '、scripts/')；不帶 LICENSE、README、.git）"
        printf '%s\n' "$out/$name/SKILL.md";;
    rule|agent|mcp)
        ext=md; [ $kind = mcp ] && ext=yaml
        f=$from; [ -d "$f" ] && f="$from/$name.$ext"
        [ -f "$f" ] && [ ! -L "$f" ] || die "$from 要是一個 .$ext 檔（或有 $name.$ext 的資料夾）"
        case $f in *.$ext) ;; *) die "$f 要是 .$ext 檔";; esac
        cp "$f" "$out/$name.$ext"; printf '%s\n' "$out/$name.$ext";;
    esac
}
put_item() { # put_item KIND NAME STAGED_FILE TARGET_DIR : replace the item in the target with the staged copy
    local dst; dst=$(item_path "$4" "$1" "$2")
    mkdir -p "$(dirname "$dst")"
    if [ "$1" = skill ]; then rm -rf "$(dirname "$dst")"; cp -R "$(dirname "$3")" "$(dirname "$dst")"; else cp "$3" "$dst"; fi
    printf '%s\n' "$dst"
}
MCP_SKELETON='# 一個 MCP server。兩種寫法選一種，另一種刪掉。
# 密碼、token 不要寫在這裡：寫成 ${變數名}，值放在每台電腦自己的環境變數。
# 別人給的設定（JSON、claude mcp add …）：存成檔案，用  kit new mcp --config 檔案  帶進來比較快。

# 1. 在這台電腦跑一個程式：
command: （啟動 MCP server 的程式，例如 npx 或 uvx）
args: []
# env:
#   API_TOKEN: ${API_TOKEN}

# 2. 連到一個網址（把上面的 command、args、env 刪掉，打開下面幾行）：
# type: http          # 或 sse
# url: https://mcp.example.com/mcp
# headers:
#   Authorization: Bearer ${API_TOKEN}'
skeleton() { # skeleton KIND NAME FILE
    case $1 in
    rule)  printf '# %s\n\n（在這裡寫規則，一條一行。）\n' "$2";;
    skill) printf -- '---\nname: %s\ndescription: （什麼時候用這個 skill，一句話）\n---\n\n（在這裡寫步驟。）\n' "$2";;
    mcp)   printf '%s\n' "$MCP_SKELETON";;
    agent) printf -- '---\nname: %s\ndescription: （這個 agent 做什麼）\nrules: []\nskills: []\nmcp: []\n# tools:\n#   only: [Read, Grep, Glob]\n#   deny: []\n---\n（在這裡寫 agent 的角色和做法。）\n' "$2";;
    esac > "$3"
}
parse_item_args() { # sets KIND NAME FROM TO FORCE_IT from: [KIND] NAME [--from P] [--to T] [--force]
    KIND=; NAME=; FROM=; TO=; FORCE_IT=; CONFIG=; LOOK=
    while [ $# -gt 0 ]; do
        case $1 in
            --from) FROM=${2:-}; shift 2 || die "--from 後面要接資料夾";;
            --config) [ $# -ge 2 ] || die_c usage "--config 後面要接檔案（或 - 從標準輸入讀）"; CONFIG=$2; shift 2;;
            --look) LOOK=1; shift;;
            --to)   TO=${2:-}; shift 2 || die "--to 後面要接來源";;
            --force) FORCE_IT=1; shift;;
            *) if [ -z "$NAME" ] && [ -z "$KIND" ] && printf '%s\n' $KINDS | grep -qxF "$1"; then KIND=$1; elif [ -z "$NAME" ]; then NAME=$1; else die_c usage "多了一個參數：$1"; fi; shift;;
        esac
    done
}
guess_kind() { # guess_kind DIR NAME
    local k found=""
    for k in $KINDS; do [ -f "$(item_path "$1" "$k" "$2")" ] && found="$found $k"; done
    set -- $found
    [ $# = 1 ] || { [ $# = 0 ] && die "$(basename "$1") 裡沒有 ${NAME}"; die "$NAME 有好幾種（$*），請寫出種類，例：kit diff skill $NAME"; }
    printf '%s\n' "$1"
}

mcp_latest() { # mcp_latest npm|pip PACKAGE[@RANGE] -> its newest version (that matches RANGE: npm view; PyPI's JSON API),
    # empty when kit cannot tell
    local v="" u h hosts
    case $1 in
    npm) command -v npm >/dev/null 2>&1 || return 0
         # (not in a project: its .npmrc) a range that matches several prints "pkg@1.2.3 '1.2.3'" lines: the highest one
         v=$(cd "$KIT_STAGE" && ctx_capped 30 npm view "$2" version 2>/dev/null | ver_top);;
    pip) command -v curl >/dev/null 2>&1 || return 0
         u=${KIT_PYPI_URL:-https://pypi.org/pypi}; u="${u%/}/${2%%\[*}/json"; h=$(url_host "$u")
         hosts=$(allowed_hosts)
         if [ -n "$hosts" ] && ! printf '%s\n' "$hosts" | grep -qxF "$h"; then warn "$h 不在 allowed_hosts：不查最新版本"; return 0; fi
         curl -fsSL --max-time 20 "$u" > "$KIT_STAGE/pypi.json" 2>/dev/null && v=$(json_get "$KIT_STAGE/pypi.json" info.version | tr -d '"');;
    esac
    printf '%s\n' "$v" | grep -E '^[0-9][0-9A-Za-z.+!-]*$' | head -n 1
}
ver_top() { # version lines on stdin (1.2.3, or pkg@1.2.3 '1.2.3') -> the highest (a release before its pre-releases)
    LC_ALL=C awk '{ v = $NF; gsub(/'"'"'/, "", v) }
        v ~ /^[0-9]+\.[0-9]+\.[0-9]+/ {
            k = v; p = ""; if (match(k, /[-+]/)) { p = substr(k, RSTART); k = substr(k, 1, RSTART - 1) }
            split(k, n, "."); key = sprintf("%09d.%09d.%09d.%s", n[1], n[2], n[3], (p ~ /^-/) ? "0" p : "1")
            if (top == "" || key > top) { top = key; best = v } }
        END { if (best != "") print best }'
}
mcp_paste_err() { # mcp_paste_err OUT : mcp.awk stopped (an E line): stop kit with its code (the servers' names too)
    local code msg names
    case $1 in E"$TAB"*) ;; *) return 0;; esac
    code=$(printf '%s\n' "$1" | awk -F'\t' 'NR == 1 { print $2 }'); msg=$(printf '%s\n' "$1" | awk -F'\t' 'NR == 1 { sub(/^E\t[^\t]*\t/, ""); print }')
    names=$(printf '%s\n' "$1" | awk -F'\t' '$1 == "L" { print $2 }')
    if [ -n "$names" ]; then DIE_EXTRA=", \"servers\": $(printf '%s\n' "$names" | json_arr)"; msg="${msg}：$(printf '%s\n' "$names" | paste -sd'|' - | sed 's/|/、/g')"; fi
    die_c "$code" "$msg"
}
mcp_lines() { printf '%s\n' "$1" | awk -F'\t' -v t="$2" '$1 == t { sub(/^[^\t]*\t/, ""); print }'; }   # mcp_lines OUT TYPE -> those lines, without the type
mcp_new_config() { # kit new mcp [NAME] --config FILE|- [--to SOURCE] [--look] : a pasted setup -> mcp/<name>.yaml, secrets as ${VAR}
    local tmp form out n t dir dst f kind pkg ver argno bin first bad v exists=false notes="" w x
    [ -z "$NAME" ] || valid_name "$NAME" || die_c bad_name "名字只能用小寫英文、數字和 -：$NAME"
    # the paste may hold secrets: a folder only you can read, gone when kit ends (also on Ctrl-C); never printed
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/kit-mcp.XXXXXX") && chmod 700 "$tmp" || die "沒辦法建立暫存資料夾"; KIT_STAGE=$tmp
    if [ "$CONFIG" = - ]; then LC_ALL=C awk 'NR == 1 { sub(/^\357\273\277/, "") } { print }' > "$tmp/paste"
    else
        [ -f "$CONFIG" ] || die_c usage "找不到 $CONFIG"
        LC_ALL=C awk 'NR == 1 { sub(/^\357\273\277/, "") } { print }' "$CONFIG" > "$tmp/paste"
    fi
    case $(LC_ALL=C awk '/^[ \t\r]*#/ { next } { gsub(/[ \t\r]/, ""); printf "%s", $0 }' "$tmp/paste" | head -c 1) in   # (# lines: comments)
        "") die_c bad_config "貼上的內容是空的";;
        "{") form=json
             LC_ALL=C awk -f "$KIT_LIB/json.awk" -v leaves=1 "$tmp/paste" > "$tmp/in" 2>/dev/null || die_c bad_config "JSON 讀不懂（是不是少了括號、逗號或引號？）";;
        "[") form=toml; cp "$tmp/paste" "$tmp/in";;
        *) form=cmd; cp "$tmp/paste" "$tmp/in";;
    esac
    out=$(mcp_awk -v mode=$form -v name="$NAME" "$tmp/in"); mcp_paste_err "$out"
    # a package without a version: pinned to today's newest (the same version on every machine, until you change it)
    IFS=$US read -r kind pkg ver argno bin first bad <<EOF
$(mcp_lines "$out" P | head -n 1 | tr '\t' "$US")
EOF
    # (a range or tag: the newest that matches it; mcp.awk says what it was pinned from)
    if [ -n "$kind" ] && [ -n "$pkg" ] && [ -z "$ver" ] && [ -z "$bad" ]; then
        w=$(mcp_lines "$out" G | head -n 1)
        v=$(mcp_latest "$kind" "$pkg${w:+@$w}")
        if [ -n "$v" ]; then out=$(mcp_awk -v mode=$form -v name="$NAME" -v pin="$v" "$tmp/in"); mcp_paste_err "$out"
        elif [ -n "$w" ]; then notes="查不到 $pkg 符合 $w 的版本（沒網路，或沒有 npm？）：先不固定版本，照原本寫的 @$w 在每次啟動時下載"
        else notes="查不到 $pkg 的最新版本（沒網路，或沒有 $( [ "$kind" = npm ] && echo npm || echo curl )？）：先不固定版本，每次啟動時下載最新的"; fi
    fi
    n=$(mcp_lines "$out" N | head -n 1); t=$(mcp_lines "$out" T | head -n 1)
    dir=$(target_dir "$TO") || exit 1; dst=$(item_path "$dir" mcp "$n")
    [ -e "$dst" ] && exists=true
    if [ -f "$MACHINE" ] && f=$(find_item mcp "$n"); then exists=true; dst=$f; fi
    if [ -n "$LOOK" ]; then
        printf '{"name": %s, "source": %s, "path": %s, "exists": %s, "type": %s, "yaml": %s, "secrets": [%s], "vars": %s, "requires": %s, "packages": [%s], "warnings": %s}\n' \
            "$(json_s "$n")" "$(json_s "$(basename "$(dirname "$(dirname "$dst")")")")" "$(json_s "$dst")" "$exists" "$(json_s "$t")" \
            "$(json_s "$(mcp_lines "$out" Y)$LF")" \
            "$(mcp_lines "$out" X | while IFS="$TAB" read -r w x; do printf '%s{"where": %s, "var": %s}' "${sep:-}" "$(json_s "$w")" "$(json_s "$x")"; sep=", "; done)" \
            "$(mcp_lines "$out" V | json_arr)" "$(mcp_lines "$out" R | json_arr)" \
            "$(mcp_lines "$out" P | tr '\t' "$US" | while IFS=$US read -r kind pkg ver argno bin first bad; do printf '{"kind": %s, "package": %s, "version": %s, "bad": %s}' "$(json_s "$kind")" "$(json_s "$pkg")" "$(json_s "$ver")" "$(json_s "$bad")"; done)" \
            "$( { mcp_lines "$out" W; [ -z "$notes" ] || printf '%s\n' "$notes"; } | json_arr)" >&3
        return 0
    fi
    [ $exists = false ] || die_c exists "已經有 mcp:${n}（${dst}）：換個名字（kit new mcp 新名字 --config …），或先刪掉它"
    { mkdir -p "$(dirname "$dst")" && mcp_lines "$out" Y > "$dst"; } 2>/dev/null || { rm -f "$dst"; die "沒辦法寫 $dst"; }
    say "已建立 ${dst#"$dir"/}（在 $(basename "$dir")）"
    mcp_lines "$out" X | while IFS="$TAB" read -r w x; do say "  $w 像是密碼或 token：檔案裡寫成 \${$x}（值沒有寫進去）"; done
    v=$(mcp_lines "$out" V | paste -sd'|' - | sed 's/|/、/g')
    [ -z "$v" ] || say "  每台電腦要先設定環境變數：$v"
    mcp_lines "$out" W | while IFS= read -r w; do warn "$w"; done
    [ -z "$notes" ] || warn "$notes"
    IFS=$US read -r kind pkg ver argno bin first bad <<EOF
$(mcp_lines "$out" P | head -n 1 | tr '\t' "$US")
EOF
    if [ -n "$kind" ] && [ -n "$ver" ] && [ -z "$bad" ]; then
        say "  套件 $pkg 固定在 $ver 版。先裝好（不然每次啟動時下載）：kit install-deps mcp $n"
    fi
    say "要用它：kit add mcp $n"
    check_dirs "$dir" >/dev/null 2>&1 || warn "kit check 有問題，送出前請先打  kit check  看看"
    return 0
}
cmd_new() {
    parse_item_args "$@"
    if [ -n "$CONFIG" ]; then
        [ "$KIND" = mcp ] && [ -z "$FROM" ] || die_c usage "用法：kit new mcp [名字] --config 檔案|- [--to 來源] [--look]"
        mcp_new_config; return
    fi
    [ -z "$LOOK" ] || die_c usage "--look 要和 --config 一起用：kit new mcp [名字] --config 檔案 --look"
    [ -n "$KIND" ] && [ -n "$NAME" ] || die "用法：kit new rule|skill|mcp|agent <名字> [--from 本機資料夾] [--to 來源]"
    valid_name "$NAME" || die "名字只能用小寫英文、數字和 -：$NAME"
    local dir dst tmp f; dir=$(target_dir "$TO") || exit 1
    dst=$(item_path "$dir" "$KIND" "$NAME")
    [ -e "$dst" ] && die "$(basename "$dir") 已經有 $KIND:${NAME}（要更新用 kit update）"
    if [ -f "$MACHINE" ] && f=$(find_item "$KIND" "$NAME"); then die "名字重複：別的來源已經有 $KIND:${NAME}（${f}）"; fi
    if [ -n "$FROM" ]; then
        tmp=$(mktemp -d "${TMPDIR:-/tmp}/kit-new.XXXXXX")
        f=$(stage_from "$KIND" "$NAME" "$FROM" "$tmp") || { rm -rf "$tmp"; exit 1; }
        dst=$(put_item "$KIND" "$NAME" "$f" "$dir"); rm -rf "$tmp"
        state_set from "$KIND:$NAME@$dir" "$(item_hash "$KIND" "$dst")"
        say "已從 $FROM 帶進 ${dst#"$dir"/}（在 $(basename "$dir")）"
        say "記得刪掉暫存的資料夾：$FROM"
    else
        { mkdir -p "$(dirname "$dst")" && skeleton "$KIND" "$NAME" "$dst"; } 2>/dev/null || { rm -f "$dst"; die "沒辦法寫 $dst"; }
        say "已建立 ${dst#"$dir"/}（在 $(basename "$dir")），打開它寫內容"
    fi
    check_dirs "$dir" >/dev/null 2>&1 || warn "kit check 有問題，送出前請先打  kit check  看看"
    return 0
}

cmd_diff_update() { # cmd_diff_update diff|update ARGS...
    local mode=$1; shift
    parse_item_args "$@"
    [ -n "$NAME" ] && [ -n "$FROM" ] || die "用法：kit $mode [種類] <名字> --from 本機資料夾 [--to 來源]"
    local dir dst tmp f old now
    dir=$(target_dir "$TO") || exit 1
    [ -n "$KIND" ] || KIND=$(guess_kind "$dir" "$NAME") || exit 1
    dst=$(item_path "$dir" "$KIND" "$NAME")
    [ -f "$dst" ] || die "$(basename "$dir") 裡沒有 $KIND:${NAME}（新的用 kit new）"
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/kit-diff.XXXXXX")
    f=$(stage_from "$KIND" "$NAME" "$FROM" "$tmp") || { rm -rf "$tmp"; exit 1; }
    if [ "$mode" = diff ]; then
        if [ "$KIND" = skill ]; then diff -ru "$(dirname "$dst")" "$(dirname "$f")"; else diff -u "$dst" "$f"; fi
        [ $? = 0 ] && say "一樣，沒有要更新的"
        rm -rf "$tmp"; return 0
    fi
    old=$(state_get from "$KIND:$NAME@$dir"); [ -n "$old" ] || old=$(state_from_old "$KIND:$NAME" "$dir"); now=$(item_hash "$KIND" "$dst")
    if [ -z "$FORCE_IT" ] && [ "$old" != "$now" ]; then
        rm -rf "$tmp"
        if [ -z "$old" ]; then die "$KIND:$NAME 不是這台用 kit new --from 帶進來的，不知道有沒有人改過。先 kit diff 看清楚，確定要蓋掉再加 --force"; fi
        die "$KIND:$NAME 在 $(basename "$dir") 被改過（跟上次帶進來的不一樣）。先 kit diff 看差在哪；要保留別人的修改就手動合併，確定要蓋掉再加 --force"
    fi
    if [ "$KIND" = skill ]; then diff -rq "$(dirname "$dst")" "$(dirname "$f")" >/dev/null; else cmp -s "$dst" "$f"; fi && { rm -rf "$tmp"; say "一樣，沒有要更新的"; return 0; }
    dst=$(put_item "$KIND" "$NAME" "$f" "$dir"); rm -rf "$tmp"
    state_set from "$KIND:$NAME@$dir" "$(item_hash "$KIND" "$dst")"
    say "已更新 ${dst#"$dir"/}（在 $(basename "$dir")）。記得刪掉暫存的資料夾：$FROM"
}

# ---------- check ----------
problem() { printf '%s\n' "$*" >> "$PROBLEM_FILE"; printf '%s: %s\n' "${PROBLEM_TAG:-kit check}" "$*" >&2; }
fm_of() { LC_ALL=C awk -f "$KIT_LIB/yaml.awk" -v frontmatter=1 "$1" 2>/dev/null; }
fm_starts() { head -n 1 "$1" | tr -d '\r' | grep -qx -- '---'; }   # the file starts with a --- line
fm_body() { awk '{ l = $0; sub(/\r$/, "", l) } c >= 2 { print l; next } l == "---" { c++ }' "$1"; }   # the lines after the frontmatter
push_mode() { local m; m=$(yget "$1/kit.yaml" push); printf '%s\n' "${m:-pr}"; }   # push_mode DIR : pr (the default) or direct
fm_val() { printf '%s\n' "$1" | awk -F'\t' -v p="$2" '$1 == p || $1 == p "[]" { sub(/^[^\t]*\t/, ""); print }'; }
private_words() { # private_words OUT [DIR...] : nonblank lines of the private word lists (this machine, sources, DIRs) into OUT
    local out=$1 d; shift
    { cat "$KIT_CONF/private-words.txt" 2>/dev/null
      [ -f "$MACHINE" ] && src_dirs | while IFS= read -r d; do cat "$d/private-words.txt" 2>/dev/null; done
      for d in "$@"; do cat "$d/private-words.txt" 2>/dev/null; done
    } | sed 's/#.*//; s/^[[:space:]]*//; s/[[:space:]]*$//' | awk 'NF && !seen[$0]++' > "$out"
}
check_dirs() { # check_dirs DIR... : print problems, return 1 if any
    local d f n k v hosts mhosts names pw rel line h ref fm range
    names=$(mktemp "${TMPDIR:-/tmp}/kit-check.XXXXXX"); pw="$names.pw"
    PROBLEM_FILE="$names.problems"; : > "$PROBLEM_FILE"
    # every item name, from the folders checked and the configured sources
    for d in "$@" $( [ -f "$MACHINE" ] && src_dirs ); do
        [ -d "$d" ] || continue
        for f in "$d"/rules/*.md "$d"/skills/*/SKILL.md "$d"/mcp/*.yaml "$d"/agents/*.md; do
            [ -f "$f" ] || continue
            case $f in */rules/*) printf 'rule:%s\t%s\n' "$(basename "$f" .md)" "$d";; */skills/*) printf 'skill:%s\t%s\n' "$(basename "$(dirname "$f")")" "$d";;
                        */mcp/*) printf 'mcp:%s\t%s\n' "$(basename "$f" .yaml)" "$d";; *) printf 'agent:%s\t%s\n' "$(basename "$f" .md)" "$d";; esac
        done
    done | awk -F'\t' '!seen[$0]++' > "$names"
    # the same name in two places
    awk -F'\t' '{ c[$1]++; w[$1] = w[$1] " " $2 } END { for (k in c) if (c[k] > 1) print k "\t" w[k] }' "$names" | while IFS="$TAB" read -r k v; do
        problem "名字重複：$k 在$v"
    done
    private_words "$pw"
    for d in "$@"; do
        [ -d "$d" ] || { problem "找不到資料夾 $d"; continue; }
        mhosts=$( { yget "$d/kit.yaml" allowed_hosts; yget "$d/kit.yaml" content_hosts
                    [ -f "$MACHINE" ] && src_dirs | while IFS= read -r v; do yget "$v/kit.yaml" allowed_hosts; yget "$v/kit.yaml" content_hosts; done; } | tr 'A-Z' 'a-z' | awk 'NF && !seen[$0]++')
        # format of each item
        for f in "$d"/skills/*/SKILL.md "$d"/agents/*.md; do
            [ -f "$f" ] || continue
            rel=${f#"$d"/}
            case $f in */SKILL.md) n=$(basename "$(dirname "$f")");; *) n=$(basename "$f" .md);; esac
            valid_name "$n" || problem "$rel: 名字只能用小寫英文、數字和 -"
            fm_starts "$f" && fm=$(fm_of "$f") || { problem "$rel: 開頭要有 --- 包起來的 name、description"; continue; }
            [ "$(fm_val "$fm" name)" = "$n" ] || problem "$rel: name 要寫 $n"
            [ -n "$(fm_val "$fm" description)" ] || problem "$rel: 少了 description"
            case $f in */agents/*)
                for k in rule skill mcp; do      # the keys: rules, skills, mcp
                    v=${k}s; [ $k = mcp ] && v=mcp
                    for ref in $(fm_val "$fm" "$v"); do grep -q "^$k:$ref$TAB" "$names" || problem "$rel: 找不到 $k:$ref"; done
                done
                # for whoever writes it, not a problem: what tools.only can't do in Claude Code
                [ -z "$(fm_val "$fm" tools.only)" ] || warn "$rel: tools.only 在 Claude 是把其他內建工具寫進 deny：Claude 之後新加的內建工具擋不到（要擋就寫進 tools.deny）";;
            esac
        done
        for f in "$d"/rules/*.md; do [ -f "$f" ] || continue; valid_name "$(basename "$f" .md)" || problem "${f#"$d"/}: 名字只能用小寫英文、數字和 -"; [ -s "$f" ] || problem "${f#"$d"/}: 是空的"; done
        for f in "$d"/mcp/*.yaml; do
            [ -f "$f" ] || continue; rel=${f#"$d"/}
            valid_name "$(basename "$f" .yaml)" || problem "$rel: 名字只能用小寫英文、數字和 -"
            case $(mcp_type "$f") in
                stdio) [ -n "$(yget "$f" command)" ] || problem "$rel: 少了 command";;
                http|sse) [ -n "$(yget "$f" url)" ] || problem "$rel: 少了 url"
                    [ -z "$(yget "$f" command)" ] || problem "$rel: 有 type: http 或 sse（網址的 MCP）就不要 command";;
                *) problem "$rel: type 只能是 stdio、http 或 sse";;
            esac
            # a secret written in the source (the value is never printed): it goes in an environment variable
            mcp_info "$f" 2>/dev/null | awk -F'\t' '$1 == "X" { print $2 "\t" $3 }' | while IFS="$TAB" read -r w v; do
                problem "$rel: $w 看起來是密碼或 token，不能寫在來源裡：改成 \${$v}，值放在每台電腦自己的環境變數"
            done
            for v in $(yget "$f" command) $(yget "$f" args); do
                case $v in
                    git+*|github:*|git@*) problem "$rel: MCP 只能從公司允許的套件來源裝，不能用 $v 這種寫法";;
                    *://*)    # a package index etc.: only a host the sources list (allowed_hosts or content_hosts)
                        h=$(printf '%s' "${v#*://}" | sed -E 's#^[^@/]*@##; s#[:/?#].*$##' | tr 'A-Z' 'a-z')
                        printf '%s\n' "$mhosts" | grep -qxF "$h" || problem "$rel: MCP 只能從公司允許的套件來源裝：$h 不在 allowed_hosts 或 content_hosts";;
                esac
            done
        done
        if [ -f "$d/kit.yaml" ]; then
            case $(push_mode "$d") in pr|direct) ;; *) problem "kit.yaml: push 只能是 pr 或 direct";; esac
            for k in rule skill mcp; do
                for ref in $(yget "$d/kit.yaml" "required.${k}s") $(yget "$d/kit.yaml" "recommended.${k}s"); do
                    grep -q "^$k:$ref$TAB" "$names" || { if [ -n "${CHECK_CI:-}" ] && [ -n "$(yget "$d/kit.yaml" include)" ]; then warn "kit.yaml: $k:$ref 不在這個 repo（應該在 include 的來源）"; else problem "kit.yaml: 找不到 $k:$ref"; fi; }
                done
            done
        fi
        # files: no git inside, no links, text only
        ( cd "$d" && find . -mindepth 1 \( -name .git -prune -o -print \) ) | while IFS= read -r f; do
            rel=${f#./}
            if [ -L "$d/$rel" ]; then echo "$rel: 不能放捷徑（symlink）"
            elif [ -f "$d/$rel" ]; then
                case $rel in .gitmodules|*/.gitmodules) echo "$rel: 不能用 git submodule";; esac
                [ -s "$d/$rel" ] && ! LC_ALL=C grep -qI . "$d/$rel" 2>/dev/null && [ "$(LC_ALL=C tr -d '\n' < "$d/$rel" | wc -c)" -gt 0 ] && echo "$rel: 只能放文字檔"
            fi
        done > "$names.files"
        ( cd "$d" && find . -mindepth 2 -name .git | sed 's#^\./##; s#$#: 裡面不能有別的 git repo#' ) >> "$names.files"
        while IFS= read -r line; do problem "$line"; done < "$names.files"
        # URLs only to content_hosts (when the source lists them)
        hosts=$( { yget "$d/kit.yaml" content_hosts; [ -f "$MACHINE" ] && src_dirs | while IFS= read -r v; do yget "$v/kit.yaml" content_hosts; done; } | tr 'A-Z' 'a-z' | awk 'NF && !seen[$0]++')
        if [ -n "$hosts" ]; then
            LC_ALL=C grep -rnIoE --exclude-dir=.git '(https?|ssh|git)://[^][ "<>()`'"'"']+|git@[A-Za-z0-9.-]+:' "$d" 2>/dev/null | while IFS= read -r line; do
                v=${line#*:*:}; h=$(url_host "$v")
                printf '%s\n' "$hosts" | grep -qxF "$h" || echo "${line%%:*}" "$(printf '%s' "$line" | cut -d: -f2)" "$h"
            done | while read -r f n h; do problem "${f#"$d"/}:$n: 網址 $h 不在 content_hosts"; done
        fi
        # private words (only the place, never the word)
        if [ -s "$pw" ]; then
            LC_ALL=C grep -rnIiF -f "$pw" --exclude-dir=.git --exclude=private-words.txt "$d" 2>/dev/null | cut -d: -f1,2 | while IFS= read -r line; do problem "${line#"$d"/}: 有不該公開的字"; done
            ( cd "$d" && find . -mindepth 1 -name .git -prune -o -print ) | sed 's#^\./##' | grep -iF -f "$pw" | while IFS= read -r line; do problem "$line: 檔名有不該公開的字"; done
        fi
        # --ci: commit author emails
        if [ -n "${CHECK_CI:-}" ] && [ -d "$d/.git" ]; then
            v=$(yget "$d/kit.yaml" author_domains)
            if [ -n "$v" ]; then
                if [ -n "${KIT_CI_BASE:-}" ]; then range="$KIT_CI_BASE..HEAD"; else range="-1"; fi
                git -C "$d" log --format='%h %ae' "$range" 2>/dev/null | while read -r h line; do
                    printf '%s\n' "$v" | grep -qixF "${line##*@}" || problem "commit $h: 作者 email 不是公司網域"
                done
            fi
        fi
    done
    PROBLEMS=$(wc -l < "$PROBLEM_FILE" | tr -d ' ')
    rm -f "$names" "$names.files" "$pw" "$PROBLEM_FILE"
    [ "$PROBLEMS" = 0 ]
}

cmd_check() {
    local dirs=() a
    for a in "$@"; do
        case $a in --ci) CHECK_CI=1;; -*) die "不認得 $a";; *) dirs+=("$(real_dir "$a" || echo "$a")");; esac
    done
    if [ ${#dirs[@]} = 0 ]; then
        if [ -f ./kit.yaml ] || [ -n "${CHECK_CI:-}" ]; then dirs=("$(pwd -P)")
        else need_init; while IFS= read -r a; do dirs+=("$a"); done <<EOF
$(src_dirs)
EOF
        fi
    fi
    if check_dirs "${dirs[@]}"; then say "kit check：沒問題（${#dirs[@]} 個來源）"; else printf 'kit check：%s 個問題\n' "$PROBLEMS" >&2; exit 1; fi
}

# ---------- export-self: a clean copy of kit's own source, for a company git server ----------
kit_repo() { # the clone kit was installed from, else the repo this kit runs from
    local d
    d=$(cat "$KIT_LIB/.repo" 2>/dev/null)
    if [ -n "$d" ] && [ -f "$d/unix/kit" ] && [ -f "$d/windows/kit.ps1" ]; then printf '%s\n' "$d"; return 0; fi
    d=$KIT_LIB
    while [ -n "$d" ] && [ "$d" != / ] && [ "$d" != . ]; do
        [ -f "$d/unix/kit" ] && [ -f "$d/windows/kit.ps1" ] && { printf '%s\n' "$d"; return 0; }
        d=$(dirname "$d")
    done
    return 1
}
export_skip() { # files that stay out of the export (README goes along: it is the manual; the scan below still checks it)
    case /$1 in */.github/*) return 0;; esac
    case $(basename "$1" | tr 'A-Z' 'a-z') in changelog*|license*|licence*|private-words.txt) return 0;; esac
    return 1
}
mask_paths() { # mask_paths WORDFILE : paths on stdin -> those with a word in them, each such part shown as <不公開>
    awk 'NR == FNR { if (NF) w[++n] = tolower($0); next }
         { k = split($0, p, "/"); s = ""; hit = 0
           for (i = 1; i <= k; i++) {
               q = p[i]
               for (j = 1; j <= n; j++) if (index(tolower(q), w[j])) { q = "<不公開>"; hit = 1; break }
               s = s (i > 1 ? "/" : "") q
           }
           if (hit) print s }' "$1" -
}
install_md() { # INSTALL.md of the export (no URLs; the same text as kit.ps1 writes)
    cat <<'EOF'
# 安裝 kit

先把公司的 agentkit repo clone 下來（網址問管理這個 repo 的人），再照你的系統做。
第一次用（特別是 Windows）：照 docs/company.md 從頭做一次，從安裝到第一次送出修改都有。

## Windows

在 clone 的資料夾裡打：

    powershell -NoProfile -ExecutionPolicy Bypass -File windows\install.ps1

不用管理員權限。開新的終端機後，在 cmd 和 PowerShell 都能打 `kit`。

## Linux / Mac

需要 bash、awk、git。Mac 還沒有 git 的話，先打 `xcode-select --install`。
在 clone 的資料夾裡打：

    sh unix/install.sh

開新的終端機後就能打 `kit`。

## 裝好以後

    kit init <團隊來源的網址>
    kit help

每個指令的用法看 README.md，各版改了什麼看 docs/changes.md。
EOF
}
cmd_export_self() {
    local out="" ver="" repo line mode rel f n probs
    while [ $# -gt 0 ]; do
        case $1 in
            --version) ver=${2:-}; [ -n "$ver" ] || die "--version 後面要接版本，例：0.2.0+gitea.1"; shift 2;;
            -*) die "不認得 $1";;
            *) [ -z "$out" ] || die "多了一個參數：$1"; out=$1; shift;;
        esac
    done
    [ -n "$out" ] || die "用法：kit export-self <資料夾> [--version <版本>]"
    case $ver in *[!A-Za-z0-9.+_-]*) die "版本只能用英文、數字和 . + - _：$ver";; esac
    repo=$(kit_repo) || die "找不到 kit 的原始碼（有 unix/kit 和 windows/kit.ps1 的 git clone）"
    git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || die "$repo 不是 git repo"
    if [ -e "$out" ] || [ -L "$out" ]; then
        [ -d "$out" ] && [ ! -L "$out" ] && [ -z "$(ls -A "$out")" ] || die "$out 已經存在而且不是空的；請給一個新的資料夾"
    fi
    mkdir -p "$out" || die "沒辦法建立 $out"
    out=$(cd "$out" && pwd)
    [ -z "$(git -C "$repo" status --porcelain --untracked-files=no 2>/dev/null)" ] || warn "$repo 有還沒 commit 的改動，匯出的是資料夾裡現在的檔案"

    PROBLEM_TAG="kit export-self"; PROBLEM_FILE=$(mktemp "${TMPDIR:-/tmp}/kit-export.XXXXXX")
    # only files git tracks (the index), taken from the working folder
    while IFS= read -r -d '' line; do
        mode=${line%% *}; rel=${line#*"$TAB"}
        export_skip "$rel" && continue
        case $mode in
            120000) problem "$rel: 不能放捷徑（symlink）"; continue;;
            160000) problem "$rel: 不能用 git submodule"; continue;;
        esac
        f="$repo/$rel"
        [ -f "$f" ] && [ ! -L "$f" ] || { warn "$rel 在 git 裡有、資料夾裡沒有，跳過"; continue; }
        mkdir -p "$(dirname "$out/$rel")" && cp "$f" "$out/$rel" || { rm -rf "$out" "$PROBLEM_FILE"; die "沒辦法複製 $rel"; }
        [ "$mode" = 100755 ] && chmod 755 "$out/$rel"
    done < <(git -C "$repo" -c core.quotepath=off ls-files -s -z)
    install_md > "$out/INSTALL.md"
    [ -n "$ver" ] && printf '%s\n' "$ver" > "$out/VERSION"

    # nothing that points back to GitHub or names private things; text files only
    printf '%s\n' 'github''.com' 'github''usercontent' 'noreply''.github' > "$PROBLEM_FILE.gh"   # split so the export does not flag itself
    private_words "$PROBLEM_FILE.pw" "$repo"
    ( cd "$out" && find . -type f | sed 's#^\./##' | LC_ALL=C sort ) > "$PROBLEM_FILE.files"
    while IFS= read -r rel; do
        f="$out/$rel"
        case $(printf '%s' "$rel" | tr 'A-Z' 'a-z') in
            *.exe|*.dll|*.so|*.dylib|*.msi|*.bin|*.jar|*.class|*.pyc|*.o|*.a|*.lib|*.zip|*.gz|*.tgz|*.7z|*.rar) problem "$rel: 不能放執行檔或壓縮檔"; continue;;
        esac
        [ -s "$f" ] && ! LC_ALL=C grep -qI . "$f" 2>/dev/null && [ "$(LC_ALL=C tr -d '\n' < "$f" | wc -c)" -gt 0 ] && problem "$rel: 只能放文字檔"
    done < "$PROBLEM_FILE.files"
    ( cd "$out" && LC_ALL=C grep -rnIiF -f "$PROBLEM_FILE.gh" . 2>/dev/null ) | cut -d: -f1,2 | sed 's#^\./##' | while IFS= read -r line; do problem "${line}: 有 GitHub 的字"; done
    mask_paths "$PROBLEM_FILE.gh" < "$PROBLEM_FILE.files" | while IFS= read -r line; do problem "${line}: 檔名有 GitHub 的字"; done
    if [ -s "$PROBLEM_FILE.pw" ]; then
        ( cd "$out" && LC_ALL=C grep -rnIiF -f "$PROBLEM_FILE.pw" . 2>/dev/null ) | cut -d: -f1,2 | sed 's#^\./##' | while IFS= read -r line; do problem "${line}: 有不該公開的字"; done
        mask_paths "$PROBLEM_FILE.pw" < "$PROBLEM_FILE.files" | while IFS= read -r line; do problem "${line}: 檔名有不該公開的字"; done
    fi
    n=$(wc -l < "$PROBLEM_FILE.files" | tr -d ' ')
    probs=$(wc -l < "$PROBLEM_FILE" | tr -d ' ')
    rm -f "$PROBLEM_FILE" "$PROBLEM_FILE.gh" "$PROBLEM_FILE.pw" "$PROBLEM_FILE.files"
    if [ "$probs" != 0 ]; then
        rm -rf "$out"
        die "匯出失敗：${probs} 個問題，已刪掉 ${out}。在 kit 的 repo 改好再匯出一次"
    fi
    [ -n "$ver" ] || ver=$(cat "$out/VERSION" 2>/dev/null) || ver=""
    [ -n "$ver" ] || ver="（沒有 VERSION）"
    say "kit：已匯出 ${n} 個檔案到 ${out}（版本 ${ver}）"
    say "下一步（在公司）：在 Gitea 的 agentkit repo clone 裡，刪掉 .git 以外的舊檔案，"
    say "  放進這個資料夾的內容後 commit，訊息只寫：kit ${ver}"
}
cmd_ci_template() { # print (or write to FILE) the Gitea Actions workflow that runs kit check --ci on pull requests
    local f
    for f in "$KIT_LIB/templates/gitea-kit-check.yaml" "$KIT_LIB/../templates/gitea-kit-check.yaml"; do
        [ -f "$f" ] || continue
        if [ -n "${1:-}" ]; then mkdir -p "$(dirname "$1")" && cp "$f" "$1" && say "已寫到 $1"; else cat "$f"; fi
        return 0
    done
    die "找不到範本 gitea-kit-check.yaml（請重跑 unix/install.sh）"
}

# ---------- push: send your changes in a source to Gitea as a pull request ----------
url_path() { # owner/repo of a git URL or folder (last two parts, no .git)
    printf '%s\n' "$1" | sed -E 's#^[a-z+]+://[^/]*/##; s#^[^/]*@[^:/]*:##; s#/+$##; s#\.git$##' | awk -F/ '{ if (NF >= 2) print $(NF-1) "/" $NF; else print $NF }'
}
push_items() { # changed item files (one per line) -> verb<TAB>kind:name, one per item
    local f k n p
    while IFS= read -r f; do
        case $f in
            rules/*.md) k=rule; n=${f#rules/}; n=${n%.md}; p=$f;;
            skills/*/*) k=skill; n=${f#skills/}; n=${n%%/*}; p=skills/$n/SKILL.md;;
            mcp/*.yaml) k=mcp; n=${f#mcp/}; n=${n%.yaml}; p=$f;;
            agents/*.md) k=agent; n=${f#agents/}; n=${n%.md}; p=$f;;
            *) continue;;
        esac
        if git cat-file -e "HEAD:$p" 2>/dev/null; then
            if [ -e "$p" ]; then printf 'update\t%s:%s\n' "$k" "$n"; else printf 'remove\t%s:%s\n' "$k" "$n"; fi
        else printf 'add\t%s:%s\n' "$k" "$n"; fi
    done | awk -F'\t' '!seen[$2]++'
}
ITEM_RE='^(rules/[^/]+\.md|skills/[^/]+/.+|mcp/[^/]+\.yaml|agents/[^/]+\.md|third_party\.lock)$'   # the files kit push sends
send_files() { # send_files : (in a source's folder) what kit push would send, one per line: the changed item files, and
    # kit.yaml when all that changed in it is collect_sources (kit collect --allow added an author); nothing else
    local all files
    all=$(changed_files 2>/dev/null)
    files=$(printf '%s\n' "$all" | grep -E "$ITEM_RE")
    [ -n "$files" ] || return 0
    printf '%s\n' "$files"
    printf '%s\n' "$all" | grep -qx kit.yaml && collect_only_yaml && echo kit.yaml
    return 0
}
changed_files() { # changed files here, one per line, exactly as named (a rename: the new and the old name)
    git status --porcelain -z --untracked-files=all | tr '\0' '\n' |
        awk '{ if (old) { old = 0; print; next } if (substr($0, 1, 1) == "R") old = 1; print substr($0, 4) }'
}
git_add_commit() { # git_add_commit MSG FILE... : commit exactly these files (names taken literally, not as patterns)
    # if git (or a commit hook) says no, the files go back to how they were before: nothing staged
    local msg=$1; shift
    GIT_LITERAL_PATHSPECS=1 git add -A -- "$@" && GIT_LITERAL_PATHSPECS=1 git commit -q -m "$msg" -- "$@" && return 0
    GIT_LITERAL_PATHSPECS=1 git reset -q -- "$@" 2>/dev/null
    return 1
}
collect_only_yaml() { # collect_only_yaml : kit.yaml differs from the last commit only in collect_sources (kit collect --allow)
    local strip='/^collect_sources:/ { s = 1; next } s && /^[ \t]*(-[ \t]|#|\r?$)/ { next } { s = 0; print }'
    git cat-file -e HEAD:kit.yaml 2>/dev/null || return 1
    [ "$(git show HEAD:kit.yaml | awk "$strip")" = "$(awk "$strip" kit.yaml)" ]
}
author_check() { # author_check DIR : with author_domains in kit.yaml, the commit's author and committer must use one
    local doms e
    doms=$(yget "$1/kit.yaml" author_domains | tr 'A-Z' 'a-z')
    [ -n "$doms" ] || return 0
    e=$( { git var GIT_AUTHOR_IDENT; git var GIT_COMMITTER_IDENT; } 2>/dev/null | sed -n 's/.*<\([^>]*\)>.*/\1/p')
    [ -n "$e" ] || die_c no_git_identity "git 還不知道你的名字和信箱，什麼都沒送。請打  git config --global user.name \"你的名字\"  和  git config --global user.email 你的公司信箱"
    for e in $e; do
        printf '%s\n' "$doms" | grep -qxF "$(printf '%s' "${e##*@}" | tr 'A-Z' 'a-z')" ||
            die_c author_not_allowed "git 的作者信箱 $e 不是公司網域（要是 $(printf '%s' "$doms" | paste -sd' ' -)），什麼都沒送。請打  git config user.email 你的公司信箱（也看看 GIT_AUTHOR_EMAIL、GIT_COMMITTER_EMAIL）"
    done
}
token_file_ok() { # warn when the token file can be read by others
    local m; m=$(ls -l "$1" 2>/dev/null | cut -c5-10)
    [ "$m" = "------" ] || warn "${1} 的權限太開放了，請打  chmod 600 $1"
}
push_direct() { # push_direct DIR FILES MSG DRY : kit.yaml says push: direct: commit on this branch, push to every remote
    local dir=$1 files=$2 msg=$3 dry=$4 remotes cur r n list=() f fail=0
    remotes=$(git remote)
    [ -n "$remotes" ] || die_c no_remote "$(basename "$dir") 沒有 remote，不知道要送到哪"
    cur=$(git symbolic-ref --short -q HEAD) || die_c not_on_branch "$(basename "$dir") 現在不在分支上，什麼都沒送"
    for r in $remotes; do check_push_urls "$r"; done
    # only the new commit may go out: every remote has this branch already, with nothing unpushed here or new there
    for r in $remotes; do
        git_safe fetch -q --no-recurse-submodules "$r" "+refs/heads/$cur:refs/remotes/$r/$cur" 2>/dev/null || warn "沒辦法更新 $r/${cur}（沒網路？），用上次拿到的"
        git rev-parse -q --verify "refs/remotes/$r/$cur" >/dev/null || die_c out_of_sync "$r 上沒有 ${cur}，什麼都沒送（第一次請自己  git push $r ${cur}）"
        n=$(git rev-list --count "refs/remotes/$r/$cur..HEAD" 2>/dev/null) || n=1
        [ "$n" = 0 ] || die_c out_of_sync "${cur} 有 ${n} 個 commit 還沒推到 ${r}，什麼都沒送（先自己  git push $r ${cur}）"
        n=$(git rev-list --count "HEAD..refs/remotes/$r/$cur" 2>/dev/null) || n=1
        [ "$n" = 0 ] || die_c out_of_sync "$r 的 ${cur} 有 ${n} 個你這裡沒有的 commit，什麼都沒送（先  git pull $r ${cur}）"
    done
    say "要送的檔案（$(basename "$dir")）："
    printf '%s\n' "$files" | sed 's/^/  /'
    say "kit.yaml 寫 push: direct：直接 commit 到 ${cur}，推到 $(printf '%s' "$remotes" | paste -sd' ' -)，不開 PR"
    say "commit：${msg}"
    PJ_BRANCH=$cur; PJ_REMOTES=$remotes
    [ -n "$dry" ] && { say "（--dry-run：沒有 commit，沒有送）"; [ -z "$JSON_OUT" ] || push_json false; return 0; }
    while IFS= read -r f; do [ -n "$f" ] && list+=("$f"); done <<< "$files"
    git_add_commit "$msg" "${list[@]}" || die_c push_failed "commit 失敗，什麼都沒送"
    local err; err=$(mktemp "${TMPDIR:-/tmp}/kit-git.XXXXXX")
    for r in $remotes; do
        if git_safe push -q --no-recurse-submodules "$r" "HEAD:refs/heads/$cur" 2>"$err"; then say "已推到 ${r}"
        else warn "沒辦法推到 ${r}（落後了要先 git pull？沒網路？），git 說："; git_err "$err"; fail=1; fi
    done
    rm -f "$err"
    [ $fail = 0 ] || die_c push_failed "commit 已經在本機的 ${cur}，有的 remote 沒推成功（看上面）"
    [ -z "$JSON_OUT" ] || push_json true
    return 0
}
json_or_null() { if [ -n "$1" ]; then json_s "$1"; else printf null; fi; }
push_json() { # push_json SENT : with --json, what kit push sends (or would), from PJ_*, on stdout (kit.ps1 prints the same)
    printf '{"source": %s, "dir": %s, "push": %s, "dry_run": %s, "files": %s, "skipped": %s, "commit": %s, "branch": %s, "into": %s, "remotes": %s, "sent": %s, "pr_url": %s, "compare_url": %s}\n' \
        "$(json_s "$(basename "$PJ_DIR")")" "$(json_s "$PJ_DIR")" "$(json_s "$PJ_MODE")" "$PJ_DRY" \
        "$(printf '%s\n' "$PJ_FILES" | json_arr)" "$(printf '%s\n' "$PJ_SKIPPED" | json_arr)" \
        "$(json_or_null "$PJ_COMMIT")" "$(json_or_null "$PJ_BRANCH")" "$(json_or_null "$PJ_INTO")" "$(printf '%s\n' "$PJ_REMOTES" | json_arr)" \
        "$1" "$(json_or_null "$PJ_PR")" "$(json_or_null "$PJ_COMPARE")" >&3
}
cmd_push() {
    local to="" dry=""
    while [ $# -gt 0 ]; do
        case $1 in
            --to) to=${2:-}; shift 2 || die_c usage "--to 後面要接來源";;
            --dry-run) dry=1; shift;;
            --json) shift;;           # (set before: stdout has only the JSON)
            *) die_c usage "用法：kit push [--to 來源] [--dry-run] [--json]";;
        esac
    done
    local dir; dir=$(target_dir "$to") || exit 1
    cd "$dir" || die_c no_source "找不到 $dir"
    [ "$(git rev-parse --show-toplevel 2>/dev/null)" = "$(pwd -P)" ] || die_c not_git "$(basename "$dir") 不是 git repo（要先 git clone 團隊來源）"
    PUSH_DIR=$(pwd -P)
    # what --json prints (push_json)
    PJ_DIR=$dir; PJ_MODE=$(push_mode .); PJ_DRY=false; [ -n "$dry" ] && PJ_DRY=true
    PJ_FILES=""; PJ_SKIPPED=""; PJ_COMMIT=""; PJ_BRANCH=""; PJ_INTO=""; PJ_REMOTES=""; PJ_PR=""; PJ_COMPARE=""

    # what changed: only item files are sent
    local all files items other
    all=$(changed_files)
    files=$(printf '%s\n' "$all" | grep -E "$ITEM_RE")
    other=$(printf '%s\n' "$all" | grep -vxF -f <(printf '%s\n' "$files"; echo '##none##') | awk 'NF')
    if [ -z "$files" ]; then
        say "沒有要送的（$(basename "$dir") 裡沒有改過的 rule、skill、mcp、agent）"
        PJ_SKIPPED=$other; [ -z "$JSON_OUT" ] || push_json false
        return 0
    fi
    items=$(printf '%s\n' "$files" | push_items)
    # kit.yaml goes too when all that changed in it is collect_sources (kit collect --allow added an author)
    if printf '%s\n' "$other" | grep -qx kit.yaml && collect_only_yaml; then
        files=$(printf '%s\nkit.yaml\n' "$files"); other=$(printf '%s\n' "$other" | grep -vx kit.yaml)
    fi
    [ -n "$other" ] && warn "這些不是 rule、skill、mcp、agent，不會送：$(printf '%s' "$other" | paste -sd' ' -)"
    PJ_FILES=$files; PJ_SKIPPED=$other

    # checks: any problem stops everything
    check_dirs "$PUSH_DIR" || die_c check_failed "kit check 有問題，什麼都沒送（改好再 kit push）"
    author_check .
    local msg="" v
    for v in add update remove; do
        local l; l=$(printf '%s\n' "$items" | awk -F'\t' -v v="$v" '$1 == v { print $2 }' | paste -sd, - | sed 's/,/, /g')
        [ -n "$l" ] && msg="${msg:+$msg; }$v $l"
    done
    msg="kit: $msg"; PJ_COMMIT=$msg
    # kit.yaml push: pr (the default): a branch on origin + a PR; push: direct (your own source): commit here, push to every remote
    local mode; mode=$(push_mode .)
    case $mode in
        pr) ;;
        direct) push_direct "$dir" "$files" "$msg" "$dry"; return;;
        *) die_c bad_push_mode "kit.yaml 的 push 只能是 pr 或 direct（現在是 ${mode}）";;
    esac
    local origin; origin=$(git remote get-url origin 2>/dev/null) ||
        die_c no_origin "$(basename "$dir") 沒有 origin，不知道要開 PR 到哪，什麼都沒送（團隊來源要有 origin；自己的來源想直接推到它的 remote，在 kit.yaml 加一行  push: direct）"
    check_host "$origin"; check_push_urls origin
    local api web owner_repo token_to=""
    owner_repo=$(url_path "$origin")
    # the Gitea token goes only to the Gitea you named (KIT_GITEA_API), or to origin's host when this source's own
    # kit.yaml lists it in allowed_hosts; anywhere else kit prints the link and you open the PR yourself
    if [ -n "${KIT_GITEA_API:-}" ]; then api=${KIT_GITEA_API%/}; check_host "$api"; web=${api%/api/v1}; token_to=1
    elif is_url "$origin"; then
        web="https://$(url_host "$origin")"; api="$web/api/v1"
        yget kit.yaml allowed_hosts | tr 'A-Z' 'a-z' | grep -qxF "$(url_host "$origin")" && token_to=1
    else api=""; web=""
    fi

    # branch: kit/<names>-YYYYMMDD, -2, -3 ... when taken
    local names base b i=1 remote
    names=$(printf '%s\n' "$items" | cut -f2 | sed 's/^[^:]*://' | paste -sd- - | cut -c1-40 | sed 's/-*$//')
    base="kit/${names}-$(date +%Y%m%d)"; b=$base
    remote=$(git_safe ls-remote --heads origin 2>/dev/null | awk '{ sub(/^refs\/heads\//, "", $2); print $2 }')
    while git show-ref --verify -q "refs/heads/$b" || printf '%s\n' "$remote" | grep -qxF "$b"; do i=$((i+1)); b="$base-$i"; done
    # where the PR goes: origin's default branch (as this clone knows it, else as origin says)
    local into; into=$(git symbolic-ref --short -q refs/remotes/origin/HEAD); into=${into#origin/}
    [ -n "$into" ] || into=$(git_safe ls-remote --symref origin HEAD 2>/dev/null | awk '$1 == "ref:" && $3 == "HEAD" { sub(/^refs\/heads\//, "", $2); print $2; exit }')
    [ -n "$into" ] || into=main

    local compare=""; [ -n "$web" ] && compare="$web/$owner_repo/compare/$into...$b"
    say "要送的檔案（$(basename "$dir")）："
    printf '%s\n' "$files" | sed 's/^/  /'
    say "分支：${b}（PR 到 ${into}）"
    say "commit：${msg}"
    PJ_BRANCH=$b; PJ_INTO=$into; PJ_REMOTES=origin; PJ_COMPARE=$compare
    [ -n "$dry" ] && { say "（--dry-run：沒有 commit，沒有送）"; [ -z "$JSON_OUT" ] || push_json false; return 0; }

    # commit on the new branch, then go back to where you were
    # the branch starts from origin's base, so unpushed local commits are never sent
    local orig start; orig=$(git symbolic-ref --short -q HEAD || git rev-parse HEAD)
    git_safe fetch -q --no-recurse-submodules origin "+refs/heads/$into:refs/remotes/origin/$into" 2>/dev/null || warn "沒辦法更新 origin/${into}（沒網路？）"
    git rev-parse -q --verify "refs/remotes/origin/$into" >/dev/null ||
        die_c push_failed "找不到 origin 的 ${into} 分支（沒網路？還是 origin 的主分支不叫 ${into}？），什麼都沒送"
    start="refs/remotes/origin/$into"
    git checkout -q --no-track -b "$b" "$start" || die_c push_failed "沒辦法開分支 ${b}（你改的檔案跟 origin/$into 有衝突？），什麼都沒送"
    local list=() f
    while IFS= read -r f; do list+=("$f"); done <<EOF
$files
EOF
    if ! git_add_commit "$msg" "${list[@]}"; then
        git checkout -q "$orig"; git branch -q -D "$b" 2>/dev/null
        die_c push_failed "commit 失敗，什麼都沒送"
    fi
    git checkout -q "$orig" || warn "沒辦法切回 ${orig}，你現在在 $b"
    local err; err=$(mktemp "${TMPDIR:-/tmp}/kit-git.XXXXXX")
    git_safe push -q --no-recurse-submodules origin "refs/heads/$b:refs/heads/$b" 2>"$err" ||
        { warn "沒辦法 push 分支 ${b}，git 說："; git_err "$err"; die_c push_failed "commit 留在本機的 ${b}（沒網路？沒權限？）"; }
    rm -f "$err"
    say "已送出分支 ${b}。改的檔案已從這裡移到那個分支，PR 合併後打 git pull 就會回來；想先看可以  git checkout ${b}"

    # pull request
    local tok="" tf="$KIT_CONF/gitea-token"
    if [ -n "${KIT_GITEA_TOKEN:-}" ]; then tok=$KIT_GITEA_TOKEN
    elif [ -f "$tf" ]; then token_file_ok "$tf"; tok=$(tr -d ' \r\n' < "$tf")
    fi
    if [ -n "$tok" ] && [ -n "$api" ] && [ -z "$token_to" ]; then
        say "kit.yaml 的 allowed_hosts 沒有列 $(url_host "$origin")，kit 不把 Gitea token 送過去；PR 請自己開（或設 KIT_GITEA_API）"
    elif [ -n "$tok" ] && [ -n "$api" ]; then
        local tmp code pr body
        tmp=$(mktemp -d "${TMPDIR:-/tmp}/kit-push.XXXXXX"); chmod 700 "$tmp"; KIT_TMPDIR=$tmp     # removed on exit, even on Ctrl-C
        ( umask 077; printf 'Authorization: token %s\n' "$tok" > "$tmp/h" )   # never on the command line
        body="由 kit push 送出：
$(printf '%s\n' "$items" | awk -F'\t' '{ print "- " $1 " " $2 }')"
        body=${body//\\/\\\\}; body=${body//\"/\\\"}; body=${body//$'\n'/\\n}
        printf '{"title":%s,"head":%s,"base":%s,"body":"%s"}' "$(json_str "$msg")" "$(json_str "$b")" "$(json_str "$into")" "$body" > "$tmp/body"
        code=$(curl -sS --max-time 30 -o "$tmp/resp" -w '%{http_code}' -X POST -H @"$tmp/h" -H 'Content-Type: application/json' \
            --data-binary @"$tmp/body" "$api/repos/$owner_repo/pulls" 2>/dev/null)
        pr=$(json_get "$tmp/resp" html_url | sed 's/^"//; s/"$//')
        rm -rf "$tmp"; KIT_TMPDIR=
        case $code in 2??) PJ_PR=$pr;; esac
        if [ -n "$PJ_PR" ]; then say "已開 PR：$PJ_PR"; else warn "沒辦法自動開 PR（Gitea 回 ${code:-沒回應}）"; fi
    elif [ -z "$tok" ]; then
        say "沒有 Gitea token（KIT_GITEA_TOKEN 或 ${tf}），PR 請自己開"
    fi
    if [ -z "$PJ_PR" ]; then if [ -n "$compare" ]; then say "開 PR：$compare"; else say "請到 Gitea 用分支 $b 開 PR"; fi; fi
    [ -z "$JSON_OUT" ] || push_json true
    return 0
}
# ---------- collect / outdated: other people's skills, from their own repos ----------
# third_party.lock (in the source that keeps them): one line per skill
#   name<TAB>url<TAB>path<TAB>ref<TAB>commit<TAB>license<TAB>date
LOCK_HEAD='# third_party.lock - written by kit collect; name url path ref commit license date'
url_id() { # host/path of a git URL, without scheme, user, .git or trailing /
    printf '%s\n' "$1" | sed -E 's#^[a-z+]+://##; s#^[^@/]*@##; s#^([^/:]+):#\1/#; s#/+$##; s#\.git$##'
}
collect_allowed() { # collect_allowed URL DIR : the URL must be (inside) one of collect_sources
    local id e d; id=$(url_id "$1")
    for d in "$2" $( [ -f "$MACHINE" ] && src_dirs ); do
        for e in $(yget "$d/kit.yaml" collect_sources); do
            e=$(url_id "$e")
            [ "$id" = "$e" ] && return 0
            case $id in "$e"/*) return 0;; esac
        done
    done
    return 1
}
check_maintainer() { # check_maintainer DIR : when kit.yaml lists maintainers, you must be one
    local m me; m=$(yget "$1/kit.yaml" maintainers)
    [ -n "$m" ] || return 0
    me=$(git -C "$1" config user.email 2>/dev/null)
    printf '%s\n' "$m" | grep -qxF -e "$me" -e "${me%%@*}" -e "${USER:-}" -e "$(id -un 2>/dev/null)" && return 0
    die_c not_maintainer "只有維護者能用 collect／outdated（kit.yaml 的 maintainers）"
}
license_kind() { # license_kind FILE -> short name
    if grep -qiE 'Apache License' "$1"; then echo Apache-2.0
    elif grep -qiE 'MIT License|Permission is hereby granted, free of charge' "$1"; then echo MIT
    elif grep -qiE 'Mozilla Public License' "$1"; then echo MPL-2.0
    elif grep -qiE 'GNU (AFFERO|LESSER)? *GENERAL PUBLIC LICENSE' "$1"; then echo GPL
    elif grep -qiE 'Redistribution and use in source and binary forms' "$1"; then echo BSD
    elif grep -qiE 'CC0|Creative Commons' "$1"; then echo CC
    else echo unknown; fi
}
lock_get() { [ -f "$1/third_party.lock" ] && awk -F'\t' -v n="$2" '$1 == n' "$1/third_party.lock"; }
lock_set() { # lock_set DIR LINE(name first)
    local f="$1/third_party.lock" n=${2%%"$TAB"*}
    { echo "$LOCK_HEAD"; [ -f "$f" ] && awk -F'\t' -v n="$n" '$0 !~ /^#/ && NF && $1 != n' "$f"; printf '%s\n' "$2"; } | { read -r h; echo "$h"; LC_ALL=C sort; } > "$f.tmp" && mv "$f.tmp" "$f"
}
real_url_ok() { # git config insteadOf can send a URL elsewhere: the real one must be allowed too
    local real; real=$(git ls-remote --get-url "$1" 2>/dev/null)
    [ -z "$real" ] || [ "$real" = "$1" ] || collect_allowed "$real" "$2" || die "git 設定把 $1 改到 ${real}，不在 collect_sources"
}

skill_dirs() { # skill_dirs REPO : the folders that hold a SKILL.md, relative ("." = the top); not inside dot folders or node_modules
    ( cd "$1" && find . \( -name '.?*' -o -name node_modules \) -prune -o -type f -name SKILL.md -print ) |
        sed 's#^\./##; s#/\{0,1\}SKILL\.md$##; s#^$#.#' | LC_ALL=C sort
}
collect_license() { # collect_license SRC REPO -> the skill's own LICENSE, else the repo's (empty: none)
    local f
    for f in "$1"/LICENSE* "$1"/LICENCE* "$1"/COPYING* "$2"/LICENSE* "$2"/LICENCE* "$2"/COPYING*; do [ -f "$f" ] && { printf '%s\n' "$f"; return 0; }; done
    return 0
}
collect_scan() { # collect_scan SRC [OUT] : what collect takes (text files, no links, no dot folders); copies into OUT when given
    # sets COL_SCRIPTS (files that run) and COL_SKIPPED (how many were left out)
    local src=$1 out=${2:-} f rel
    COL_SCRIPTS=""; COL_SKIPPED=0
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        rel=${f#"$src"/}
        case /$rel in */.*) continue;; esac       # .github/, .claude-plugin/ ...: for other tools, not the skill
        if [ -L "$f" ]; then COL_SKIPPED=$((COL_SKIPPED+1)); [ -z "$out" ] || warn "跳過捷徑 $rel"; continue; fi
        if [ -s "$f" ] && ! LC_ALL=C grep -qI . "$f"; then COL_SKIPPED=$((COL_SKIPPED+1)); [ -z "$out" ] || warn "跳過非文字檔 $rel"; continue; fi
        [ -z "$out" ] || { mkdir -p "$(dirname "$out/$rel")"; cp "$f" "$out/$rel"; }
        case $rel in *.sh|*.py|*.js|*.mjs|*.cjs|*.ts|*.ps1|*.rb|*.pl|*.bat|*.cmd) COL_SCRIPTS="$COL_SCRIPTS $rel";; *) [ -x "$f" ] && COL_SCRIPTS="$COL_SCRIPTS $rel";; esac
    done <<EOT
$(cd "$src" && find "$(pwd -P)" \( -name .git -o -name node_modules \) -prune -o \( -type f -o -type l \) -print | LC_ALL=C sort)
EOT
    COL_SCRIPTS=${COL_SCRIPTS# }
}
yaml_list_add() { # yaml_list_add FILE KEY VALUE : VALUE goes into the list KEY ([a, b] on its line, or "- x" lines under it); no KEY: a new line KEY: [VALUE]
    local f=$1 k=$2 v=$3 t="$1.tmp.$$"
    if ! grep -q "^$k:" "$f" 2>/dev/null; then
        { [ -f "$f" ] && cat "$f"; [ -s "$f" ] && [ -n "$(tail -c 1 "$f")" ] && echo; printf '%s: [%s]\n' "$k" "$v"; } > "$t"
    else
        awk -v k="$k" -v v="$v" '
            function cr(l) { return (l ~ /\r$/) ? "\r" : "" }
            function item() { print ind "- " v eol; for (j = 1; j <= nb; j++) print hold[j]; nb = 0; st = 2 }
            st == 1 && /^[ \t]*-[ \t]/ { for (j = 1; j <= nb; j++) print hold[j]; nb = 0; ind = $0; sub(/-.*/, "", ind); print; next }
            st == 1 && /^[ \t]*(#.*)?\r?$/ { hold[++nb] = $0; next }
            st == 1 { item() }
            st == 0 && index($0, k ":") == 1 {
                eol = cr($0); rest = substr($0, length(k) + 2)
                if (rest ~ /^[ \t]*\[/) {
                    if (rest !~ /\]/) exit 3
                    a = index($0, "["); b = index($0, "]")
                    inner = substr($0, a + 1, b - a - 1)
                    print substr($0, 1, a) (inner ~ /^[ \t]*$/ ? v : inner ", " v) substr($0, b); st = 2; next
                }
                if (rest !~ /^[ \t]*(#.*)?\r?$/) exit 3
                st = 1; ind = "  "; print; next
            }
            { print }
            END { if (st == 1) item(); if (st == 0) exit 3 }' "$f" > "$t" || { rm -f "$t"; die "看不懂 $f 的 ${k}，請自己把 $v 加進去"; }
    fi
    mv "$t" "$f"
    yget "$f" "$k" | grep -qxF "$v" || die "加進 $f 的 $k 沒成功，請自己把 $v 加進去"
}

cmd_collect() { # kit collect <url|name> [--path P] [--name N] [--ref R] [--to SOURCE] [--force] [--allow] [--look]
    local arg="" path="" name="" ref="" to="" force="" allow="" look=""
    while [ $# -gt 0 ]; do
        case $1 in
            --path) path=${2:-}; shift 2 || die "--path 後面要接 repo 裡的資料夾";;
            --name) name=${2:-}; shift 2 || die "--name 後面要接名字";;
            --ref)  ref=${2:-}; shift 2 || die "--ref 後面要接分支或 tag";;
            --to)   to=${2:-}; shift 2 || die "--to 後面要接來源";;
            --force) force=1; shift;;
            --allow) allow=1; shift;;
            --look) look=1; shift;;
            -*) die_c usage "不認得 $1";;
            *) [ -z "$arg" ] || die_c usage "多了一個參數：$1"; arg=$1; shift;;
        esac
    done
    [ -n "$arg" ] || die_c usage "用法：kit collect <原作者的 repo 網址> [--path repo 裡的資料夾] [--name 名字] [--ref 分支或 tag] [--allow]，或 kit collect <名字>（再收一次）"
    local dir url line add=""; dir=$(target_dir "$to") || exit 1
    check_maintainer "$dir"
    if is_url "$arg"; then url=$arg
    else # collect again what the lock says
        line=$(lock_get "$dir" "$arg"); [ -n "$line" ] || die "$(basename "$dir") 的 third_party.lock 裡沒有 ${arg}（第一次收要給網址）"
        name=$arg; url=$(printf '%s' "$line" | cut -f2)
        [ -n "$path" ] || path=$(printf '%s' "$line" | cut -f3)
        [ -n "$ref" ] || ref=$(printf '%s' "$line" | cut -f4); [ "$ref" = - ] && ref=""
    fi
    [ "$path" = . ] && path=""
    # collect_sources: who may be collected from. --allow adds this author to it, only in your own source (push: direct);
    # a team source's list is the maintainers' to change. --look only looks: it says whether the author is on the list.
    local ok=1 real; collect_allowed "$url" "$dir" || ok=0
    real=$(git ls-remote --get-url "$url" 2>/dev/null)
    if [ -n "$real" ] && [ "$real" != "$url" ] && ! collect_allowed "$real" "$dir"; then
        [ -n "$look" ] || die_c not_allowed "git 設定把 $url 改到 ${real}，不在 collect_sources"
        ok=0
    fi
    local own=0; [ "$(push_mode "$dir")" = direct ] && own=1
    # --look downloads only what kit collect could take: a host in allowed_hosts (the target source's own list, else
    # every source's), and an author on collect_sources or one your own source can add (--allow)
    PUSH_DIR=$dir check_host "$url"
    if [ $ok = 0 ] && [ -n "$look" ]; then
        [ -z "$real" ] || [ "$real" = "$url" ] || die_c not_allowed "git 設定把 $url 改到 ${real}，不在 collect_sources，不下載"
        [ $own = 1 ] || die_c not_allowed "$(url_id "$url") 不在 collect_sources（$(basename "$dir")/kit.yaml），不下載；這是團隊的來源，要請維護者把它加進 kit.yaml 的 collect_sources"
    fi
    if [ $ok = 0 ] && [ -z "$look" ]; then
        if [ -z "$allow" ]; then
            [ $own = 1 ] && die "$(url_id "$url") 不在 collect_sources（$(basename "$dir")/kit.yaml），不能收；確定要收就加 --allow，一起加進清單"
            die "$(url_id "$url") 不在 collect_sources（$(basename "$dir")/kit.yaml），不能收"
        fi
        [ $own = 1 ] || die "--allow 只能用在你自己的來源（kit.yaml 寫 push: direct 的）；團隊來源請維護者把 $(url_id "$url") 加進 kit.yaml 的 collect_sources"
        [ -z "$real" ] || [ "$real" = "$url" ] || die "git 設定把 $url 改到 ${real}：--allow 不幫這種網址加清單"
        add=1
    fi
    path=${path#/}; path=${path%/}
    case /$path/ in */../*|*/./*) die "--path 不能有 .. 或 .";; esac

    local tmp repo src sha lic kind d; tmp=$(mktemp -d "${TMPDIR:-/tmp}/kit-collect.XXXXXX"); repo="$tmp/repo"
    [ -n "$look" ] || say "從 $(url_id "$url") 下載${ref:+（${ref}）}…"
    if ! git_safe -c protocol.file.allow=always clone -q --depth 1 --no-recurse-submodules ${ref:+--branch "$ref"} "$url" "$repo" 2>"$tmp/err"; then
        sed 's/^/  /' "$tmp/err" >&2; rm -rf "$tmp"; die_c download_failed "沒辦法下載 $url"
    fi
    sha=$(git -C "$repo" rev-parse HEAD)
    repo=$(cd "$repo" && pwd -P)
    # which folder: --path, else the top if it has a SKILL.md, else the only folder in the repo that has one
    local found
    if [ -n "$path" ] || [ -f "$repo/SKILL.md" ]; then found=${path:-.}
    else found=$(skill_dirs "$repo"); fi
    [ -n "$found" ] || { rm -rf "$tmp"; die_c no_skill "$(url_id "$url") 裡找不到 SKILL.md"; }

    if [ -n "$look" ]; then # what kit would collect, as JSON (a screen program shows it before you collect)
        local first=1 n desc fm ex out
        out=$(printf '{"source": %s, "dir": %s, "push": %s, "url": %s, "id": %s, "commit": %s, "allowed": %s, "can_allow": %s, "skills": [' \
            "$(json_s "$(basename "$dir")")" "$(json_s "$dir")" "$(json_s "$(push_mode "$dir")")" "$(json_s "$url")" "$(json_s "$(url_id "$url")")" "$(json_s "$sha")" \
            "$( [ $ok = 1 ] && echo true || echo false)" "$( [ $ok = 0 ] && [ $own = 1 ] && [ -z "$real" -o "$real" = "$url" ] && echo true || echo false)")
        while IFS= read -r d; do
            [ -n "$d" ] || continue
            src=$repo; [ "$d" = . ] || src="$repo/$d"
            [ -f "$src/SKILL.md" ] || { rm -rf "$tmp"; die_c no_skill "$(url_id "$url")/$d 裡沒有 SKILL.md"; }
            fm=$(fm_of "$src/SKILL.md"); n=$name; [ -n "$n" ] || n=$(fm_val "$fm" name); desc=$(fm_val "$fm" description)
            [ -n "$n" ] || { if [ "$d" = . ]; then n=$(basename "$(url_id "$url")"); else n=$(basename "$d"); fi; }
            lic=$(collect_license "$src" "$repo"); kind=""; [ -z "$lic" ] || kind=$(license_kind "$lic")
            collect_scan "$src"
            ex=""; if [ -e "$dir/skills/$n" ]; then if [ -n "$(lock_get "$dir" "$n")" ]; then ex=collected; else ex=own; fi; fi
            [ $first = 1 ] || out="$out,"; first=0
            out="$out$(printf '\n  {"path": %s, "name": %s, "valid": %s, "description": %s, "license": %s, "scripts": %s, "skipped": %s, "exists": %s, "dest": %s}' \
                "$(json_s "$d")" "$(json_s "$n")" "$(valid_name "$n" && echo true || echo false)" "$(json_s "$desc")" "$(json_s "$kind")" \
                "$(json_s "$COL_SCRIPTS")" "$COL_SKIPPED" "$(json_s "$ex")" "$(json_s "$dir/skills/$n/SKILL.md")")"
        done <<EOT
$found
EOT
        printf '%s\n]}\n' "$out" >&3
        rm -rf "$tmp"; return 0
    fi
    if [ "$(printf '%s\n' "$found" | wc -l | tr -d ' ')" -gt 1 ]; then
        rm -rf "$tmp"
        die "$(url_id "$url") 裡有好幾個 skill，用 --path 選一個：
$(printf '%s\n' "$found" | sed 's/^/  /')"
    fi
    path=$found; [ "$path" = . ] && path=""
    src=$repo${path:+/$path}
    [ -d "$src" ] && src=$(cd "$src" && pwd -P)
    case $src/ in "$repo"/*) ;; *) rm -rf "$tmp"; die "--path 要在 repo 裡面";; esac
    [ -f "$src/SKILL.md" ] || { rm -rf "$tmp"; die "$(url_id "$url")${path:+/$path} 裡沒有 SKILL.md（用 --path 指出 skill 的資料夾）"; }
    [ -n "$name" ] || name=$(fm_val "$(fm_of "$src/SKILL.md")" name)
    [ -n "$name" ] || { if [ -z "$path" ]; then name=$(basename "$(url_id "$url")"); else name=$(basename "$src"); fi; }
    valid_name "$name" || { rm -rf "$tmp"; die "名字 $name 不行（只能小寫英文、數字和 -），用 --name 給一個"; }
    local dst="$dir/skills/$name"
    if [ -e "$dst" ] && [ -z "$(lock_get "$dir" "$name")" ] && [ -z "$force" ]; then
        rm -rf "$tmp"; die "$(basename "$dir") 已經有 skill:${name}，而且不是 collect 收的（要整份換掉加 --force，或用 --name 換名字）"
    fi
    # license: the skill's own, else the repo's
    lic=$(collect_license "$src" "$repo")
    [ -n "$lic" ] || { rm -rf "$tmp"; die "$(url_id "$url") 沒有 LICENSE，不知道能不能用，不收"; }
    kind=$(license_kind "$lic")
    # copy: everything text, no links, no binaries, no git
    mkdir -p "$tmp/out"
    collect_scan "$src" "$tmp/out"
    [ "$lic" = "$src/${lic##*/}" ] || cp "$lic" "$tmp/out/${lic##*/}"
    rm -rf "$dst"; mkdir -p "$dir/skills"; cp -R "$tmp/out" "$dst"
    lock_set "$dir" "$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s' "$name" "$url" "${path:-.}" "${ref:--}" "$sha" "$kind" "$(date +%Y-%m-%d)")"
    rm -rf "$tmp"
    if [ -n "$add" ]; then yaml_list_add "$dir/kit.yaml" collect_sources "$(url_id "$url")"; say "已把 $(url_id "$url") 加進 $(basename "$dir")/kit.yaml 的 collect_sources"; fi
    say "已收 skill:$name ← $(url_id "$url")${path:+/$path} @ $(printf %.12s "$sha")（授權 ${kind}）"
    [ "$kind" = unknown ] && warn "認不出授權種類，請自己看 skills/$name/${lic##*/}"
    [ "$kind" = GPL ] && warn "GPL 類授權：改了再發布要公開原始碼，請確認可以用"
    [ -n "$COL_SCRIPTS" ] && warn "這個 skill 有會執行的檔案，送出前請看過：$COL_SCRIPTS"
    check_dirs "$dir" >/dev/null 2>&1 || warn "kit check 有問題，送出前請先打  kit check  看看"
    if [ "$(push_mode "$dir")" = direct ]; then say "下一步：用 git diff 看收進來的檔案；沒問題就  kit push  送出，要用它就  kit add skill $name"
    else say "下一步：kit diff 看不到第三方的差異，請用 git diff 看；沒問題就  kit push  開 PR"; fi
}

cmd_outdated() { # kit outdated [--to SOURCE]
    local to=""
    while [ $# -gt 0 ]; do case $1 in --to) to=${2:-}; shift 2 || die "--to 後面要接來源";; *) die "用法：kit outdated [--to 來源]";; esac; done
    local dir; dir=$(target_dir "$to") || exit 1
    check_maintainer "$dir"
    [ -f "$dir/third_party.lock" ] || { say "$(basename "$dir") 沒有 third_party.lock（還沒用 kit collect 收過東西）"; return 0; }
    local n url path ref sha lic day now new=0
    while IFS="$TAB" read -r n url path ref sha lic day; do
        case $n in ""|\#*) continue;; esac
        if ! collect_allowed "$url" "$dir"; then warn "${n}：$(url_id "$url") 已經不在 collect_sources，不檢查"; continue; fi
        if [ "$ref" = - ]; then now=$(git_safe ls-remote "$url" HEAD 2>/dev/null | awk '$2 == "HEAD" { print $1; exit }')
        else # a branch, or a tag (the commit it points to: ^{})
            now=$(git_safe ls-remote "$url" "refs/heads/$ref" "refs/tags/$ref" "refs/tags/$ref^{}" 2>/dev/null |
                  awk -v r="$ref" '$2 == "refs/heads/" r { b = $1 } $2 == "refs/tags/" r { t = $1 } $2 == "refs/tags/" r "^{}" { p = $1 }
                                   END { print (b != "" ? b : (p != "" ? p : t)) }')
        fi
        if [ -z "$now" ]; then warn "${n}：連不到 $(url_id "$url")"
        elif [ "$now" = "$sha" ]; then say "  ${n}：最新（$(printf %.12s "$sha")）"
        else say "  ${n}：有新版本 $(printf %.12s "$sha") → $(printf %.12s "$now")，打  kit collect $n  收新的"; new=$((new+1)); fi
    done < "$dir/third_party.lock"
    [ $new = 0 ] || say "kit：$new 個有新版本"
}

cmd_approve() { # kit approve <approvals repo> <source clone>... --key <ssh key> [--yes]
    local dir="" key="" yes="" repos=() r n sha prev f tmp serial
    while [ $# -gt 0 ]; do
        case $1 in
            --key) key=${2:-}; shift 2 || die "--key 後面要接簽章用的 ssh 金鑰";;
            --yes) yes=1; shift;;
            *) if [ -z "$dir" ]; then dir=$1; else repos+=("$1"); fi; shift;;
        esac
    done
    [ -n "$dir" ] && [ ${#repos[@]} -ge 1 ] && [ -n "$key" ] || die "用法：kit approve <核准紀錄的 repo> <來源的 clone>... --key <ssh 金鑰>"
    [ -d "$dir/.git" ] || die "$dir 要是一個 git repo（放核准紀錄）"
    [ -f "$key" ] || die "找不到金鑰 $key"
    f="$dir/approved.txt"; tmp=$(mktemp "${TMPDIR:-/tmp}/kit-approve.XXXXXX")
    serial=$(awk '$1 == "serial:" { print $2; exit }' "$f" 2>/dev/null); serial=$(( ${serial:-0} + 1 ))
    awk 'NF == 2 && $1 !~ /^#/ && $1 != "serial:"' "$f" 2>/dev/null > "$tmp"
    for r in "${repos[@]}"; do
        [ -d "$r/.git" ] || die "$r 不是 git clone"
        [ -z "$(git -C "$r" status --porcelain)" ] || die "$r 有還沒 commit 的改動"
        n=$(basename "$(cd "$r" && pwd)"); sha=$(git -C "$r" rev-parse HEAD)
        prev=$(awk -v n="$n" '$1 == n { print $2; exit }' "$tmp")
        printf '\n== %s  %s → %s\n' "$n" "$( [ -n "$prev" ] && printf %.12s "$prev" || echo 第一次)" "$(printf %.12s "$sha")"
        if [ "$prev" = "$sha" ]; then echo "（沒有變）"
        elif [ -n "$prev" ] && git -C "$r" cat-file -e "$prev^{commit}" 2>/dev/null; then
            git -C "$r" --no-pager log --oneline "$prev..$sha"; git -C "$r" --no-pager diff --stat "$prev" "$sha"
        else git -C "$r" --no-pager log --oneline -5 "$sha"; fi
        [ -n "$(git -C "$r" branch -r --contains "$sha" 2>/dev/null)" ] || warn "$n 的 $(printf %.12s "$sha") 還沒 push 到任何遠端"
        awk -v n="$n" '$1 != n' "$tmp" > "$tmp.2"; printf '%s %s\n' "$n" "$sha" >> "$tmp.2"; mv "$tmp.2" "$tmp"
    done
    if [ -z "$yes" ]; then
        local a=""
        if ! { printf '\n核准上面這些版本？[y/N] ' > /dev/tty && read -r a < /dev/tty; } 2>/dev/null; then
            rm -f "$tmp"; die "沒辦法在這裡問你（沒有終端機）。看過上面的內容、確定要核准，就加 --yes 再打一次"
        fi
        case $a in y|Y|yes) ;; *) rm -f "$tmp"; die "沒有核准";; esac
    fi
    { echo "# agentkit approvals - signed with kit approve; do not edit by hand"
      echo "serial: $serial"
      LC_ALL=C sort "$tmp"; } > "$f"
    rm -f "$tmp" "$f.sig"
    ssh-keygen -Y sign -q -f "$key" -n agentkit "$f" || die "簽章失敗"
    git -C "$dir" add approved.txt approved.txt.sig && git -C "$dir" commit -q -m "approve serial $serial" || die "commit 失敗"
    say "kit：已核准並簽章（serial ${serial}）。下一步：git -C $dir push"
}

# ---------- status --json: the kit, api and commits this account uses, for a panel (kit.ps1 prints the same) ----------
# Read only: no network (no clone, pull or fetch), nothing written, no lock. An account a panel cannot ask (root)
# runs kit status --json > FILE itself and the panel reads that file.
head_sha() { [ -e "$1/.git" ] && git -C "$1" rev-parse -q --verify HEAD 2>/dev/null; }   # head_sha DIR : when DIR is a git clone
json_uint() { case $1 in ""|*[!0-9]*) printf null;; *) printf '%s' "$1" | sed 's/^0*\(.\)/\1/';; esac; }   # a number, or null
cmd_status() {
    [ $# -eq 1 ] && [ "$1" = --json ] || die_c usage "用法：kit status --json"
    local repo url name s d f ad appr="" valid=false first=1 self=null approvals=null
    if [ -n "$M_APPROVALS" ]; then                           # only what is here already: the clone kit sync keeps, or the folder
        if is_url "$M_APPROVALS"; then ad=$(approvals_dir); else ad=$M_APPROVALS; fi
        f="$ad/approved.txt"
        if [ -f "$f" ] && [ -f "$f.sig" ] && [ -f "$M_SIGNERS" ] && approvals_sig_ok "$f"; then
            valid=true; appr=$(awk 'NF == 2 && $1 !~ /^#/ && $1 != "serial:"' "$f")
        fi
        approvals="{\"serial\": $(json_uint "$(awk '$1 == "serial:" { print $2; exit }' "$f" 2>/dev/null)"), \"used\": $(json_uint "$(state_get approvals serial)"), \"valid\": $valid}"
    fi
    repo=$(cat "$KIT_LIB/.repo" 2>/dev/null)                  # kit's own clone (the one kit self-update pulls)
    if [ -n "$repo" ]; then
        name=$(basename "$repo")
        [ -e "$repo/.git" ] && url=$(git -C "$repo" remote get-url origin 2>/dev/null) && [ -n "$url" ] && name=$(src_name "$url")
        self="{\"name\": $(json_s "$name"), \"commit\": $(json_or_null "$(head_sha "$repo")"), \"approved\": $(json_or_null "$(printf '%s\n' "$appr" | awk -v n="$name" '$1 == n { print $2; exit }')")}"
    fi
    printf '{\n  "kit": %s,\n  "api": %s,\n  "user": %s,\n  "at": %s,\n  "self": %s,\n  "approvals": %s,\n  "sources": [' \
        "$(json_s "$KIT_VERSION")" "$(json_s "$KIT_API")" "$(json_s "$(id -un)")" "$(date +%s)" "$self" "$approvals"
    while IFS= read -r s; do
        [ -n "$s" ] || continue
        [ $first = 1 ] || printf ','; first=0
        d=$(src_dir "$s"); name=$(src_name "$s")
        printf '\n    {"name": %s, "source": %s, "dir": %s, "commit": %s, "approved": %s}' "$(json_s "$name")" "$(json_s "$(url_safe "$s")")" "$(json_s "$d")" \
            "$(json_or_null "$(head_sha "$d")")" "$(json_or_null "$(printf '%s\n' "$appr" | awk -v n="$name" '$1 == n { print $2; exit }')")"
    done <<EOF
$(m_sources)
EOF
    if [ $first = 1 ]; then printf ']\n}\n'; else printf '\n  ]\n}\n'; fi
}

# ---------- agents: the definitions (agents/<name>.md), for programs that show agents ----------
json_arr() { # lines -> ["a", "b"]
    local first=1 v out="["
    while IFS= read -r v; do [ -n "$v" ] || continue; [ $first = 1 ] || out="$out, "; first=0; out="$out$(json_s "$v")"; done
    printf '%s]' "$out"
}
git_state() { # git_state DIR FILE : "new", "changed" or "" (or "no-git")
    git -C "$1" rev-parse --git-dir >/dev/null 2>&1 || { echo no-git; return; }
    case $(git -C "$1" status --porcelain --untracked-files=all -- "$2" 2>/dev/null | cut -c1-2) in
        "") ;; "??"|A*) echo new;; *) echo changed;;
    esac
}
cmd_agents() {
    [ "${1:-}" = --json ] || die_c usage "用法：kit agents --json"
    need_init
    agents_json >&3
}
agents_json() {
    local i n f d fm first=1 st items
    items=$(available)
    printf '{\n  "kit": %s,\n  "tools": [%s],\n  "available": {"rule": %s, "skill": %s, "mcp": %s},\n  "agents": [' "$(json_s "$KIT_VERSION")" \
        "$(t='"claude"'; has_codex && t="$t, \"codex\""; has_omp && t="$t, \"omp\""; printf '%s' "$t")" \
        "$(printf '%s\n' "$items" | sed -n 's/^rule://p' | json_arr)" "$(printf '%s\n' "$items" | sed -n 's/^skill://p' | json_arr)" "$(printf '%s\n' "$items" | sed -n 's/^mcp://p' | json_arr)"
    for i in $(printf '%s\n' "$items" | grep '^agent:'); do
        n=${i#agent:}; f=$(find_item agent "$n") || continue
        d=${f%/agents/*}; fm=$(fm_of "$f")
        st=$(git_state "$d" "agents/$n.md")
        [ $first = 1 ] || printf ','; first=0
        printf '\n    {"name": %s, "description": %s, "source": %s, "path": %s, "git": %s,\n     "rules": %s, "skills": %s, "mcp": %s, "tools_only": %s, "tools_deny": %s,\n     "prompt": %s}' \
            "$(json_s "$n")" "$(json_s "$(fm_val "$fm" description | head -n 1)")" "$(json_s "$(basename "$d")")" "$(json_s "$f")" "$(json_s "$st")" \
            "$(fm_val "$fm" rules | json_arr)" "$(fm_val "$fm" skills | json_arr)" "$(fm_val "$fm" mcp | json_arr)" \
            "$(fm_val "$fm" tools.only | json_arr)" "$(fm_val "$fm" tools.deny | json_arr)" \
            "$(json_s "$(fm_body "$f")")"
    done
    printf '\n  ]\n}\n'
}
fm_set_list() { # fm_set_list FILE KEY "a, b" : KEY: [a, b] in the file's frontmatter (block lists replaced, added if missing)
    local tmp; tmp=$(mktemp "$1.kit.XXXXXX")
    # a block list: the indented lines after KEY go, up to the next key or ---; blank and comment lines
    # in between stay only when the block goes on after them. Line ends (LF or CRLF) are kept.
    awk -v key="$2" -v val="[$3]" '
        { l = $0; cr = sub(/\r$/, "", l) ? "\r" : "" }
        NR == 1 { eol = cr }
        NR == 1 && l == "---" { infm = 1; print; next }
        infm && skip { if (l ~ /^[ \t]*(#.*)?$/) { held = held $0 "\n"; next }
                       if (l ~ /^[ \t]/) { held = ""; next }
                       skip = 0; printf "%s", held; held = "" }
        infm && l == "---" { if (!done) print key ": " val eol; done = 1; infm = 0; print; next }
        infm && index(l, key ":") == 1 { print key ": " val eol; done = 1; if (substr(l, length(key) + 2) ~ /^[ \t]*(#.*)?$/) skip = 1; next }
        { print }' "$1" > "$tmp" && mv "$tmp" "$1" || { rm -f "$tmp"; die "沒辦法改 $1"; }
}
cmd_agent() { # kit agent <name> add|rm rule|skill|mcp <item>
    [ $# -eq 4 ] || die "用法：kit agent <名字> add|rm rule|skill|mcp <東西>"
    need_init
    local n=$1 verb=$2 k=$3 item=$4 f fm key cur new d
    case $verb in add|rm) ;; *) die "用法：kit agent <名字> add|rm rule|skill|mcp <東西>";; esac
    case $k in rule) key=rules;; skill) key=skills;; mcp) key=mcp;; *) die "種類只能是 rule、skill、mcp";; esac
    f=$(find_item agent "$n") || die "找不到 agent ${n}（打 kit list 看有哪些）"
    fm_starts "$f" || die "$f 沒有開頭的 --- 區塊"
    fm=$(fm_of "$f") || die "$f 開頭的 --- 區塊讀不懂，沒改（打 kit check 看哪裡錯）"
    cur=$(fm_val "$fm" "$key")
    if [ "$verb" = add ]; then
        find_item "$k" "$item" >/dev/null || die "找不到 ${k}:${item}（kit 的來源裡沒有）"
        printf '%s\n' "$cur" | grep -qxF "$item" && { say "agent $n 已經有 ${k}:${item}"; return 0; }
        new=$(printf '%s\n%s\n' "$cur" "$item" | awk 'NF' | paste -sd, - | sed 's/,/, /g')
    else
        printf '%s\n' "$cur" | grep -qxF "$item" || { say "agent $n 本來就沒有 ${k}:${item}"; return 0; }
        new=$(printf '%s\n' "$cur" | grep -vxF "$item" | awk 'NF' | paste -sd, - | sed 's/,/, /g')
    fi
    fm_set_list "$f" "$key" "$new"
    d=${f%/agents/*}
    say "agent ${n}：$( [ "$verb" = add ] && echo 加上 || echo 拿掉) ${k}:${item}（改了 ${f}，還沒送出：打  kit push --to $(basename "$d")）"
    case $d/ in "$KIT_SRC"/*|"$(real_dir "$KIT_SRC" || printf '%s' "$KIT_SRC")"/*) warn "這個檔案在 kit 自己同步用的資料夾（${KIT_SRC}）裡：沒送出前，kit sync 可能沒辦法更新它；最好在你自己 clone 的來源改";; esac
    [ -z "$M_APPROVALS" ] || warn "這台只用簽過的版本（approvals）：改的要送出、合併、再簽過，這台才會用到"
}

usage() {
    cat <<'EOF'
kit - 管理 AI 寫程式工具的 rule、skill、MCP 和 agent

  kit init <網址|資料夾> [更多...]   第一次：設定來源，加上預設的東西
  kit list [--json]                 有哪些、你在用哪些、哪些是新的（--json 給程式讀）
     --json --dir 資料夾 [--pid 程式編號]
                                    再列出在那個資料夾開的 agent 另外會讀到的（不是 kit 管的）
  kit agents --json                 每個 agent 用了哪些 rule、skill、MCP（JSON，給畫面程式用）
  kit agent <名字> add|rm rule|skill|mcp <東西>   改 agent 用的東西（改來源裡的檔案，再用 kit push 送出）
  kit add rule|skill|mcp <名字>     開始用（整個帳號：每個資料夾、每個 agent 都有）
  kit rm  rule|skill|mcp <名字>     不用了（之後 sync 也不會加回來）
  kit add --dir <資料夾> rule|skill|mcp <名字>
                                    只加到這個資料夾：在這裡（含子資料夾）開的 agent 才有
  kit rm  --dir <資料夾> rule|skill|mcp <名字>
  kit tools                         skill 會用到的程式（node、python…）：這台有沒有、怎麼裝
  kit install-tool <程式名> [--min 版本]
                                    用 kit 的裝法裝，太舊就升級（畫面程式的「安裝」按鈕也是用這個）
  kit install-deps <skill> [npm|pip] 裝 skill 自己的套件（在 kit 的資料夾，不跑套件的安裝程式）
  kit install-deps mcp <名字>       裝 MCP 的套件（固定的版本），之後不用每次啟動時下載
  kit context --pid <pid> [--tool claude|codex|omp] [--dir 資料夾] [--detail [--fresh]]
                                  那個 agent 的 context 用了多少（JSON；--detail：用在哪些地方）
  kit files --pid <pid> [--tool claude|codex|omp] [--dir 資料夾] [--git] [--json]
                                  那個 agent 讀過、改過的檔案，新的在前（--json 給程式讀；--git：再加上 git 有變動的）
  kit note ["做了什麼；下一步"]      agent 寫自己做到哪（一兩行，畫面上看得到）；不帶文字：印出現在寫的
  kit note --history [--dir 資料夾]   這個資料夾最近的進度（包括已經關掉的 agent），交接時先看
  kit note --pid <pid> [--json]     某個 agent 的進度（--json 給程式讀）；--clear 清掉自己的
  kit run <agent> [--tool codex|omp] [參數]   開一個做好的 agent（預設用 Claude）
  kit place <agent> <資料夾> [--tool claude|codex|omp] [--json]
                                    讓這個資料夾變成那個 agent：之後在這裡開的 claude、codex、omp 就是它
                                    （建立最後一層資料夾；之後用 kit add|rm --dir 改，每個資料夾各自獨立）
  kit sync [--force]                現在更新（kit run 會自動做）

寫內容的人用（只吃本機資料夾，不連網）：
  kit new rule|skill|mcp|agent <名字> [--from 本機資料夾] [--to 來源]
  kit new mcp [名字] --config 檔案|- [--to 來源] [--look]
                                    從貼上的 MCP 設定建立（JSON、claude mcp add、codex mcp add、config.toml）；
                                    密碼和 token 換成 ${變數}，套件固定版本（只有這個會連網：查最新版本）；--look 只看不寫（JSON）
  kit diff  [種類] <名字> --from 本機資料夾   比較
  kit update [種類] <名字> --from 本機資料夾   更新；別人改過會停下來（--force 硬蓋）
  kit check [--ci] [資料夾...]      檢查格式、引用、名字重複、網址、不該公開的字

維護者用（只收 kit.yaml 的 collect_sources 列的原作者）：
  kit collect <原作者 repo 網址> [--path 資料夾] [--name 名字] [--ref 分支] [--allow]   收別人的 skill（保留 LICENSE）
                                    （沒給 --path：repo 裡只有一個 SKILL.md 就用它；--allow：自己的來源一起加進 collect_sources）
  kit collect <名字>                再收一次＝整份換成原作者的新版
  kit collect <原作者 repo 網址> --look [--path 資料夾] [--ref 分支] [--to 來源]
                                    只下載來看、什麼都不寫：找到的 skill、授權、會執行的檔案（JSON，給程式讀）
  kit outdated                      看收過的 skill 原作者有沒有新版
  kit export-self <資料夾> [--version <版本>]   匯出 kit 的原始碼（給公司的 git server）
  kit ci-template [檔案]            Gitea Actions 範本（PR 自動跑 kit check --ci），例：
                                      kit ci-template .gitea/workflows/kit-check.yaml
  kit push [--to 來源] [--dry-run] [--json]
                                    檢查後送出改的東西：開 PR（預設），或 kit.yaml 寫 push: direct 就直接推
                                    （--json：送了／會送什麼、錯誤，都印成 JSON 給程式讀）

  kit approve <核准紀錄> <來源 clone>... --key <金鑰>   簽章核准這些版本（給 root 這類只用核准版本的帳號）
  kit self-update                   更新 kit 本身
  kit uninstall [--self]            拿掉 kit 加的東西（--self 連 kit 也移除）
  kit status --json                 這個帳號用的 kit 版本、api，kit 本身和每個來源的 commit、核准的 commit
                                    （JSON 給程式讀；不連網、什麼都不寫：root 這類帳號可以自己存成檔案給畫面程式讀）
  kit --version
  kit api                           給程式讀的介面版本（major.minor，例如 1.2）：給畫面程式確認看得懂 kit 的輸出。
                                    不相容的改變 major 加一；新增欄位或指令 minor 加一（清單看 README 的「給程式讀的介面」）
EOF
}

# programs read JSON: list/agents/push/files --json, status, and collect/new --look print only JSON on stdout (errors too)
case ${1:-} in
    list|ls|agents|push|files|place) for a in "$@"; do [ "$a" = --json ] && { json_mode; break; }; done;;
    collect|new) for a in "$@"; do [ "$a" = --look ] && { json_mode; break; }; done;;
    status) json_mode;;
esac
# the commands that change state.tsv, the tools' files or a source: one kit at a time (sync --hook takes it itself)
case ${1:-} in init|sync|add|rm|remove|uninstall|push|agent|install-deps|place) [ "${2:-}" = --hook ] || take_lock;; esac
case ${1:-} in
    init)      shift; cmd_init "$@";;
    sync)      shift
               case ${1:-} in --force) FORCE=1;; --hook) sync_hook;; esac
               cmd_sync;;
    list|ls)   shift; cmd_list "$@";;
    add)       shift; cmd_add_rm add "$@";;
    rm|remove) shift; cmd_add_rm rm "$@";;
    run)       shift; cmd_run "$@";;
    place)     shift; cmd_place "$@";;
    agents)    shift; cmd_agents "$@";;
    agent)     shift; cmd_agent "$@";;
    new)       shift; cmd_new "$@";;
    diff)      shift; cmd_diff_update diff "$@";;
    update)    shift; cmd_diff_update update "$@";;
    check)     shift; cmd_check "$@";;
    export-self) shift; cmd_export_self "$@";;
    ci-template) shift; cmd_ci_template "$@";;
    push)      shift; cmd_push "$@";;
    uninstall) shift; cmd_uninstall "$@";;
    self-update) cmd_self_update;;
    approve)   shift; cmd_approve "$@";;
    tools)     shift; cmd_tools "$@";;
    install-tool) shift; cmd_install_tool "$@";;
    install-deps) shift; cmd_install_deps "$@";;
    context)   shift; cmd_context "$@";;
    files)     shift; cmd_files "$@";;
    note)      shift; cmd_note "$@";;
    statusline) shift; cmd_statusline "$@";;
    collect)   shift; cmd_collect "$@";;
    outdated)  shift; cmd_outdated "$@";;
    status)    shift; cmd_status "$@" >&3;;
    api)       echo "$KIT_API";;   # the version of what programs read (README: 給程式讀的介面)
    --version|version) echo "kit $KIT_VERSION";;
    ""|-h|--help|help) usage;;
    *) die "沒有這個指令：$1（打 kit help）";;
esac
