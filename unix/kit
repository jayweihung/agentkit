# ---------- push: send your changes in a source to Gitea as a pull request ----------
url_path() { # owner/repo of a git URL or folder (last two parts, no .git)
    printf '%s\n' "$1" | sed -E 's#^[a-z+]+://[^/]*/##; s#^[^/]*@[^:/]*:##; s#/+$##; s#\.git$##' | awk -F/ '{ if (NF >= 2) print $(NF-1) "/" $NF; else print $NF }'
}
push_items() { # changed item files (one per line) -> verb<TAB>kind:name, one per item
    local f k n p
    while IFS= read -r f; do
        case $f in
            rules/*.md) k=rule; n=${f#rules/}; n=${n%.md}; p=$f;;
            skills/*/*) k=skill; n=${f#skills/}; n=${n%%/*}; p=skills/$n/SKILL.md;;
            mcp/*.yaml) k=mcp; n=${f#mcp/}; n=${n%.yaml}; p=$f;;
            agents/*.md) k=agent; n=${f#agents/}; n=${n%.md}; p=$f;;
            *) continue;;
        esac
        if git cat-file -e "HEAD:$p" 2>/dev/null; then
            if [ -e "$p" ]; then printf 'update\t%s:%s\n' "$k" "$n"; else printf 'remove\t%s:%s\n' "$k" "$n"; fi
        else printf 'add\t%s:%s\n' "$k" "$n"; fi
    done | awk -F'\t' '!seen[$2]++'
}
changed_files() { # changed files here, one per line, exactly as named (a rename: the new and the old name)
    git status --porcelain -z --untracked-files=all | tr '\0' '\n' |
        awk '{ if (old) { old = 0; print; next } if (substr($0, 1, 1) == "R") old = 1; print substr($0, 4) }'
}
git_add_commit() { # git_add_commit MSG FILE... : commit exactly these files (names taken literally, not as patterns)
    # if git (or a commit hook) says no, the files go back to how they were before: nothing staged
    local msg=$1; shift
    GIT_LITERAL_PATHSPECS=1 git add -A -- "$@" && GIT_LITERAL_PATHSPECS=1 git commit -q -m "$msg" -- "$@" && return 0
    GIT_LITERAL_PATHSPECS=1 git reset -q -- "$@" 2>/dev/null
    return 1
}
collect_only_yaml() { # collect_only_yaml : kit.yaml differs from the last commit only in collect_sources (kit collect --allow)
    local strip='/^collect_sources:/ { s = 1; next } s && /^[ \t]*(-[ \t]|#|\r?$)/ { next } { s = 0; print }'
    git cat-file -e HEAD:kit.yaml 2>/dev/null || return 1
    [ "$(git show HEAD:kit.yaml | awk "$strip")" = "$(awk "$strip" kit.yaml)" ]
}
author_check() { # author_check DIR : with author_domains in kit.yaml, the commit's author and committer must use one
    local doms e
    doms=$(yget "$1/kit.yaml" author_domains | tr 'A-Z' 'a-z')
    [ -n "$doms" ] || return 0
    e=$( { git var GIT_AUTHOR_IDENT; git var GIT_COMMITTER_IDENT; } 2>/dev/null | sed -n 's/.*<\([^>]*\)>.*/\1/p')
    [ -n "$e" ] || die "git 還不知道你的名字和信箱，什麼都沒送。請打  git config --global user.name \"你的名字\"  和  git config --global user.email 你的公司信箱"
    for e in $e; do
        printf '%s\n' "$doms" | grep -qxF "$(printf '%s' "${e##*@}" | tr 'A-Z' 'a-z')" ||
            die "git 的作者信箱 $e 不是公司網域（要是 $(printf '%s' "$doms" | paste -sd' ' -)），什麼都沒送。請打  git config user.email 你的公司信箱（也看看 GIT_AUTHOR_EMAIL、GIT_COMMITTER_EMAIL）"
    done
}
token_file_ok() { # warn when the token file can be read by others
    local m; m=$(ls -l "$1" 2>/dev/null | cut -c5-10)
    [ "$m" = "------" ] || warn "${1} 的權限太開放了，請打  chmod 600 $1"
}
push_direct() { # push_direct DIR FILES MSG DRY : kit.yaml says push: direct: commit on this branch, push to every remote
    local dir=$1 files=$2 msg=$3 dry=$4 remotes cur r n list=() f fail=0
    remotes=$(git remote)
    [ -n "$remotes" ] || die "$(basename "$dir") 沒有 remote，不知道要送到哪"
    cur=$(git symbolic-ref --short -q HEAD) || die "$(basename "$dir") 現在不在分支上，什麼都沒送"
    for r in $remotes; do check_push_urls "$r"; done
    # only the new commit may go out: every remote has this branch already, with nothing unpushed here or new there
    for r in $remotes; do
        git_safe fetch -q --no-recurse-submodules "$r" "+refs/heads/$cur:refs/remotes/$r/$cur" 2>/dev/null || warn "沒辦法更新 $r/${cur}（沒網路？），用上次拿到的"
        git rev-parse -q --verify "refs/remotes/$r/$cur" >/dev/null || die "$r 上沒有 ${cur}，什麼都沒送（第一次請自己  git push $r ${cur}）"
        n=$(git rev-list --count "refs/remotes/$r/$cur..HEAD" 2>/dev/null) || n=1
        [ "$n" = 0 ] || die "${cur} 有 ${n} 個 commit 還沒推到 ${r}，什麼都沒送（先自己  git push $r ${cur}）"
        n=$(git rev-list --count "HEAD..refs/remotes/$r/$cur" 2>/dev/null) || n=1
        [ "$n" = 0 ] || die "$r 的 ${cur} 有 ${n} 個你這裡沒有的 commit，什麼都沒送（先  git pull $r ${cur}）"
    done
    say "要送的檔案（$(basename "$dir")）："
    printf '%s\n' "$files" | sed 's/^/  /'
    say "kit.yaml 寫 push: direct：直接 commit 到 ${cur}，推到 $(printf '%s' "$remotes" | paste -sd' ' -)，不開 PR"
    say "commit：${msg}"
    [ -n "$dry" ] && { say "（--dry-run：沒有 commit，沒有送）"; return 0; }
    while IFS= read -r f; do [ -n "$f" ] && list+=("$f"); done <<< "$files"
    git_add_commit "$msg" "${list[@]}" || die "commit 失敗，什麼都沒送"
    local err; err=$(mktemp "${TMPDIR:-/tmp}/kit-git.XXXXXX")
    for r in $remotes; do
        if git_safe push -q --no-recurse-submodules "$r" "HEAD:refs/heads/$cur" 2>"$err"; then say "已推到 ${r}"
        else warn "沒辦法推到 ${r}（落後了要先 git pull？沒網路？），git 說："; git_err "$err"; fail=1; fi
    done
    rm -f "$err"
    [ $fail = 0 ] || die "commit 已經在本機的 ${cur}，有的 remote 沒推成功（看上面）"
    return 0
}
cmd_push() {
    local to="" dry=""
    while [ $# -gt 0 ]; do
        case $1 in
            --to) to=${2:-}; shift 2 || die "--to 後面要接來源";;
            --dry-run) dry=1; shift;;
            *) die "用法：kit push [--to 來源] [--dry-run]";;
        esac
    done
    local dir; dir=$(target_dir "$to") || exit 1
    cd "$dir" || die "找不到 $dir"
    [ "$(git rev-parse --show-toplevel 2>/dev/null)" = "$(pwd -P)" ] || die "$(basename "$dir") 不是 git repo（要先 git clone 團隊來源）"
    PUSH_DIR=$(pwd -P)

    # what changed: only item files are sent
    local all files items other
    all=$(changed_files)
    files=$(printf '%s\n' "$all" | grep -E '^(rules/[^/]+\.md|skills/[^/]+/.+|mcp/[^/]+\.yaml|agents/[^/]+\.md|third_party\.lock)$')
    other=$(printf '%s\n' "$all" | grep -vxF -f <(printf '%s\n' "$files"; echo '##none##') | awk 'NF')
    [ -n "$files" ] || { say "沒有要送的（$(basename "$dir") 裡沒有改過的 rule、skill、mcp、agent）"; return 0; }
    items=$(printf '%s\n' "$files" | push_items)
    # kit.yaml goes too when all that changed in it is collect_sources (kit collect --allow added an author)
    if printf '%s\n' "$other" | grep -qx kit.yaml && collect_only_yaml; then
        files=$(printf '%s\nkit.yaml\n' "$files"); other=$(printf '%s\n' "$other" | grep -vx kit.yaml)
    fi
    [ -n "$other" ] && warn "這些不是 rule、skill、mcp、agent，不會送：$(printf '%s' "$other" | paste -sd' ' -)"

    # checks: any problem stops everything
    check_dirs "$PUSH_DIR" || die "kit check 有問題，什麼都沒送（改好再 kit push）"
    author_check .
    local msg="" v
    for v in add update remove; do
        local l; l=$(printf '%s\n' "$items" | awk -F'\t' -v v="$v" '$1 == v { print $2 }' | paste -sd, - | sed 's/,/, /g')
        [ -n "$l" ] && msg="${msg:+$msg; }$v $l"
    done
    msg="kit: $msg"
    # kit.yaml push: pr (the default): a branch on origin + a PR; push: direct (your own source): commit here, push to every remote
    local mode; mode=$(push_mode .)
    case $mode in
        pr) ;;
        direct) push_direct "$dir" "$files" "$msg" "$dry"; return;;
        *) die "kit.yaml 的 push 只能是 pr 或 direct（現在是 ${mode}）";;
    esac
    local origin; origin=$(git remote get-url origin 2>/dev/null) ||
        die "$(basename "$dir") 沒有 origin，不知道要開 PR 到哪，什麼都沒送（團隊來源要有 origin；自己的來源想直接推到它的 remote，在 kit.yaml 加一行  push: direct）"
    check_host "$origin"; check_push_urls origin
    local api web owner_repo token_to=""
    owner_repo=$(url_path "$origin")
    # the Gitea token goes only to the Gitea you named (KIT_GITEA_API), or to origin's host when this source's own
    # kit.yaml lists it in allowed_hosts; anywhere else kit prints the link and you open the PR yourself
    if [ -n "${KIT_GITEA_API:-}" ]; then api=${KIT_GITEA_API%/}; check_host "$api"; web=${api%/api/v1}; token_to=1
    elif is_url "$origin"; then
        web="https://$(url_host "$origin")"; api="$web/api/v1"
        yget kit.yaml allowed_hosts | tr 'A-Z' 'a-z' | grep -qxF "$(url_host "$origin")" && token_to=1
    else api=""; web=""
    fi

    # branch: kit/<names>-YYYYMMDD, -2, -3 ... when taken
    local names base b i=1 remote
    names=$(printf '%s\n' "$items" | cut -f2 | sed 's/^[^:]*://' | paste -sd- - | cut -c1-40 | sed 's/-*$//')
    base="kit/${names}-$(date +%Y%m%d)"; b=$base
    remote=$(git_safe ls-remote --heads origin 2>/dev/null | awk '{ sub(/^refs\/heads\//, "", $2); print $2 }')
    while git show-ref --verify -q "refs/heads/$b" || printf '%s\n' "$remote" | grep -qxF "$b"; do i=$((i+1)); b="$base-$i"; done
    # where the PR goes: origin's default branch (as this clone knows it, else as origin says)
    local into; into=$(git symbolic-ref --short -q refs/remotes/origin/HEAD); into=${into#origin/}
    [ -n "$into" ] || into=$(git_safe ls-remote --symref origin HEAD 2>/dev/null | awk '$1 == "ref:" && $3 == "HEAD" { sub(/^refs\/heads\//, "", $2); print $2; exit }')
    [ -n "$into" ] || into=main

    say "要送的檔案（$(basename "$dir")）："
    printf '%s\n' "$files" | sed 's/^/  /'
    say "分支：${b}（PR 到 ${into}）"
    say "commit：${msg}"
    [ -n "$dry" ] && { say "（--dry-run：沒有 commit，沒有送）"; return 0; }

    # commit on the new branch, then go back to where you were
    # the branch starts from origin's base, so unpushed local commits are never sent
    local orig start; orig=$(git symbolic-ref --short -q HEAD || git rev-parse HEAD)
    git_safe fetch -q --no-recurse-submodules origin "+refs/heads/$into:refs/remotes/origin/$into" 2>/dev/null || warn "沒辦法更新 origin/${into}（沒網路？）"
    git rev-parse -q --verify "refs/remotes/origin/$into" >/dev/null ||
        die "找不到 origin 的 ${into} 分支（沒網路？還是 origin 的主分支不叫 ${into}？），什麼都沒送"
    start="refs/remotes/origin/$into"
    git checkout -q --no-track -b "$b" "$start" || die "沒辦法開分支 ${b}（你改的檔案跟 origin/$into 有衝突？），什麼都沒送"
    local list=() f
    while IFS= read -r f; do list+=("$f"); done <<EOF
$files
EOF
    if ! git_add_commit "$msg" "${list[@]}"; then
        git checkout -q "$orig"; git branch -q -D "$b" 2>/dev/null
        die "commit 失敗，什麼都沒送"
    fi
    git checkout -q "$orig" || warn "沒辦法切回 ${orig}，你現在在 $b"
    local err; err=$(mktemp "${TMPDIR:-/tmp}/kit-git.XXXXXX")
    git_safe push -q --no-recurse-submodules origin "refs/heads/$b:refs/heads/$b" 2>"$err" ||
        { warn "沒辦法 push 分支 ${b}，git 說："; git_err "$err"; die "commit 留在本機的 ${b}（沒網路？沒權限？）"; }
    rm -f "$err"
    say "已送出分支 ${b}。改的檔案已從這裡移到那個分支，PR 合併後打 git pull 就會回來；想先看可以  git checkout ${b}"

    # pull request
    local tok="" tf="$KIT_CONF/gitea-token" compare=""
    [ -n "$web" ] && compare="$web/$owner_repo/compare/$into...$b"
    if [ -n "${KIT_GITEA_TOKEN:-}" ]; then tok=$KIT_GITEA_TOKEN
    elif [ -f "$tf" ]; then token_file_ok "$tf"; tok=$(tr -d ' \r\n' < "$tf")
    fi
    if [ -n "$tok" ] && [ -n "$api" ] && [ -z "$token_to" ]; then
        say "kit.yaml 的 allowed_hosts 沒有列 $(url_host "$origin")，kit 不把 Gitea token 送過去；PR 請自己開（或設 KIT_GITEA_API）"
    elif [ -n "$tok" ] && [ -n "$api" ]; then
        local tmp code pr body
        tmp=$(mktemp -d "${TMPDIR:-/tmp}/kit-push.XXXXXX"); chmod 700 "$tmp"; KIT_TMPDIR=$tmp     # removed on exit, even on Ctrl-C
        ( umask 077; printf 'Authorization: token %s\n' "$tok" > "$tmp/h" )   # never on the command line
        body="由 kit push 送出：
$(printf '%s\n' "$items" | awk -F'\t' '{ print "- " $1 " " $2 }')"
        body=${body//\\/\\\\}; body=${body//\"/\\\"}; body=${body//$'\n'/\\n}
        printf '{"title":%s,"head":%s,"base":%s,"body":"%s"}' "$(json_str "$msg")" "$(json_str "$b")" "$(json_str "$into")" "$body" > "$tmp/body"
        code=$(curl -sS --max-time 30 -o "$tmp/resp" -w '%{http_code}' -X POST -H @"$tmp/h" -H 'Content-Type: application/json' \
            --data-binary @"$tmp/body" "$api/repos/$owner_repo/pulls" 2>/dev/null)
        pr=$(json_get "$tmp/resp" html_url | sed 's/^"//; s/"$//')
        rm -rf "$tmp"; KIT_TMPDIR=
        case $code in 2??) [ -n "$pr" ] && { say "已開 PR：$pr"; return 0; };; esac
        warn "沒辦法自動開 PR（Gitea 回 ${code:-沒回應}）"
    elif [ -z "$tok" ]; then
        say "沒有 Gitea token（KIT_GITEA_TOKEN 或 ${tf}），PR 請自己開"
    fi
    if [ -n "$compare" ]; then say "開 PR：$compare"; else say "請到 Gitea 用分支 $b 開 PR"; fi
    return 0
}
# ---------- collect / outdated: other people's skills, from their own repos ----------
# third_party.lock (in the source that keeps them): one line per skill
#   name<TAB>url<TAB>path<TAB>ref<TAB>commit<TAB>license<TAB>date
LOCK_HEAD='# third_party.lock - written by kit collect; name url path ref commit license date'
url_id() { # host/path of a git URL, without scheme, user, .git or trailing /
    printf '%s\n' "$1" | sed -E 's#^[a-z+]+://##; s#^[^@/]*@##; s#^([^/:]+):#\1/#; s#/+$##; s#\.git$##'
}
collect_allowed() { # collect_allowed URL DIR : the URL must be (inside) one of collect_sources
    local id e d; id=$(url_id "$1")
    for d in "$2" $( [ -f "$MACHINE" ] && src_dirs ); do
        for e in $(yget "$d/kit.yaml" collect_sources); do
            e=$(url_id "$e")
            [ "$id" = "$e" ] && return 0
            case $id in "$e"/*) return 0;; esac
        done
    done
    return 1
}
check_maintainer() { # check_maintainer DIR : when kit.yaml lists maintainers, you must be one
    local m me; m=$(yget "$1/kit.yaml" maintainers)
    [ -n "$m" ] || return 0
    me=$(git -C "$1" config user.email 2>/dev/null)
    printf '%s\n' "$m" | grep -qxF -e "$me" -e "${me%%@*}" -e "${USER:-}" -e "$(id -un 2>/dev/null)" && return 0
    die "只有維護者能用 collect／outdated（kit.yaml 的 maintainers）"
}
license_kind() { # license_kind FILE -> short name
    if grep -qiE 'Apache License' "$1"; then echo Apache-2.0
    elif grep -qiE 'MIT License|Permission is hereby granted, free of charge' "$1"; then echo MIT
    elif grep -qiE 'Mozilla Public License' "$1"; then echo MPL-2.0
    elif grep -qiE 'GNU (AFFERO|LESSER)? *GENERAL PUBLIC LICENSE' "$1"; then echo GPL
    elif grep -qiE 'Redistribution and use in source and binary forms' "$1"; then echo BSD
    elif grep -qiE 'CC0|Creative Commons' "$1"; then echo CC
    else echo unknown; fi
}
lock_get() { [ -f "$1/third_party.lock" ] && awk -F'\t' -v n="$2" '$1 == n' "$1/third_party.lock"; }
lock_set() { # lock_set DIR LINE(name first)
    local f="$1/third_party.lock" n=${2%%"$TAB"*}
    { echo "$LOCK_HEAD"; [ -f "$f" ] && awk -F'\t' -v n="$n" '$0 !~ /^#/ && NF && $1 != n' "$f"; printf '%s\n' "$2"; } | { read -r h; echo "$h"; LC_ALL=C sort; } > "$f.tmp" && mv "$f.tmp" "$f"
}
real_url_ok() { # git config insteadOf can send a URL elsewhere: the real one must be allowed too
    local real; real=$(git ls-remote --get-url "$1" 2>/dev/null)
    [ -z "$real" ] || [ "$real" = "$1" ] || collect_allowed "$real" "$2" || die "git 設定把 $1 改到 ${real}，不在 collect_sources"
}

skill_dirs() { # skill_dirs REPO : the folders that hold a SKILL.md, relative ("." = the top); not inside dot folders or node_modules
    ( cd "$1" && find . \( -name '.?*' -o -name node_modules \) -prune -o -type f -name SKILL.md -print ) |
        sed 's#^\./##; s#/\{0,1\}SKILL\.md$##; s#^$#.#' | LC_ALL=C sort
}
collect_license() { # collect_license SRC REPO -> the skill's own LICENSE, else the repo's (empty: none)
    local f
    for f in "$1"/LICENSE* "$1"/LICENCE* "$1"/COPYING* "$2"/LICENSE* "$2"/LICENCE* "$2"/COPYING*; do [ -f "$f" ] && { printf '%s\n' "$f"; return 0; }; done
    return 0
}
collect_scan() { # collect_scan SRC [OUT] : what collect takes (text files, no links, no dot folders); copies into OUT when given
    # sets COL_SCRIPTS (files that run) and COL_SKIPPED (how many were left out)
    local src=$1 out=${2:-} f rel
    COL_SCRIPTS=""; COL_SKIPPED=0
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        rel=${f#"$src"/}
        case /$rel in */.*) continue;; esac       # .github/, .claude-plugin/ ...: for other tools, not the skill
        if [ -L "$f" ]; then COL_SKIPPED=$((COL_SKIPPED+1)); [ -z "$out" ] || warn "跳過捷徑 $rel"; continue; fi
        if [ -s "$f" ] && ! LC_ALL=C grep -qI . "$f"; then COL_SKIPPED=$((COL_SKIPPED+1)); [ -z "$out" ] || warn "跳過非文字檔 $rel"; continue; fi
        [ -z "$out" ] || { mkdir -p "$(dirname "$out/$rel")"; cp "$f" "$out/$rel"; }
        case $rel in *.sh|*.py|*.js|*.mjs|*.cjs|*.ts|*.ps1|*.rb|*.pl|*.bat|*.cmd) COL_SCRIPTS="$COL_SCRIPTS $rel";; *) [ -x "$f" ] && COL_SCRIPTS="$COL_SCRIPTS $rel";; esac
    done <<EOT
$(cd "$src" && find "$(pwd -P)" \( -name .git -o -name node_modules \) -prune -o \( -type f -o -type l \) -print | LC_ALL=C sort)
EOT
    COL_SCRIPTS=${COL_SCRIPTS# }
}
yaml_list_add() { # yaml_list_add FILE KEY VALUE : VALUE goes into the list KEY ([a, b] on its line, or "- x" lines under it); no KEY: a new line KEY: [VALUE]
    local f=$1 k=$2 v=$3 t="$1.tmp.$$"
    if ! grep -q "^$k:" "$f" 2>/dev/null; then
        { [ -f "$f" ] && cat "$f"; [ -s "$f" ] && [ -n "$(tail -c 1 "$f")" ] && echo; printf '%s: [%s]\n' "$k" "$v"; } > "$t"
    else
        awk -v k="$k" -v v="$v" '
            function cr(l) { return (l ~ /\r$/) ? "\r" : "" }
            function item() { print ind "- " v eol; for (j = 1; j <= nb; j++) print hold[j]; nb = 0; st = 2 }
            st == 1 && /^[ \t]*-[ \t]/ { for (j = 1; j <= nb; j++) print hold[j]; nb = 0; ind = $0; sub(/-.*/, "", ind); print; next }
            st == 1 && /^[ \t]*(#.*)?\r?$/ { hold[++nb] = $0; next }
            st == 1 { item() }
            st == 0 && index($0, k ":") == 1 {
                eol = cr($0); rest = substr($0, length(k) + 2)
                if (rest ~ /^[ \t]*\[/) {
                    if (rest !~ /\]/) exit 3
                    a = index($0, "["); b = index($0, "]")
                    inner = substr($0, a + 1, b - a - 1)
                    print substr($0, 1, a) (inner ~ /^[ \t]*$/ ? v : inner ", " v) substr($0, b); st = 2; next
                }
                if (rest !~ /^[ \t]*(#.*)?\r?$/) exit 3
                st = 1; ind = "  "; print; next
            }
            { print }
            END { if (st == 1) item(); if (st == 0) exit 3 }' "$f" > "$t" || { rm -f "$t"; die "看不懂 $f 的 ${k}，請自己把 $v 加進去"; }
    fi
    mv "$t" "$f"
    yget "$f" "$k" | grep -qxF "$v" || die "加進 $f 的 $k 沒成功，請自己把 $v 加進去"
}

cmd_collect() { # kit collect <url|name> [--path P] [--name N] [--ref R] [--to SOURCE] [--force] [--allow] [--look]
    local arg="" path="" name="" ref="" to="" force="" allow="" look=""
    while [ $# -gt 0 ]; do
        case $1 in
            --path) path=${2:-}; shift 2 || die "--path 後面要接 repo 裡的資料夾";;
            --name) name=${2:-}; shift 2 || die "--name 後面要接名字";;
            --ref)  ref=${2:-}; shift 2 || die "--ref 後面要接分支或 tag";;
            --to)   to=${2:-}; shift 2 || die "--to 後面要接來源";;
            --force) force=1; shift;;
            --allow) allow=1; shift;;
            --look) look=1; shift;;
            -*) die "不認得 $1";;
            *) [ -z "$arg" ] || die "多了一個參數：$1"; arg=$1; shift;;
        esac
    done
    [ -n "$arg" ] || die "用法：kit collect <原作者的 repo 網址> [--path repo 裡的資料夾] [--name 名字] [--ref 分支或 tag] [--allow]，或 kit collect <名字>（再收一次）"
    local dir url line add=""; dir=$(target_dir "$to") || exit 1
    check_maintainer "$dir"
    if is_url "$arg"; then url=$arg
    else # collect again what the lock says
        line=$(lock_get "$dir" "$arg"); [ -n "$line" ] || die "$(basename "$dir") 的 third_party.lock 裡沒有 ${arg}（第一次收要給網址）"
        name=$arg; url=$(printf '%s' "$line" | cut -f2)
        [ -n "$path" ] || path=$(printf '%s' "$line" | cut -f3)
        [ -n "$ref" ] || ref=$(printf '%s' "$line" | cut -f4); [ "$ref" = - ] && ref=""
    fi
    [ "$path" = . ] && path=""
    # collect_sources: who may be collected from. --allow adds this author to it, only in your own source (push: direct);
    # a team source's list is the maintainers' to change. --look only looks: it says whether the author is on the list.
    local ok=1 real; collect_allowed "$url" "$dir" || ok=0
    real=$(git ls-remote --get-url "$url" 2>/dev/null)
    if [ -n "$real" ] && [ "$real" != "$url" ] && ! collect_allowed "$real" "$dir"; then
        [ -n "$look" ] || die "git 設定把 $url 改到 ${real}，不在 collect_sources"
        ok=0
    fi
    local own=0; [ "$(push_mode "$dir")" = direct ] && own=1
    if [ $ok = 0 ] && [ -z "$look" ]; then
        if [ -z "$allow" ]; then
            [ $own = 1 ] && die "$(url_id "$url") 不在 collect_sources（$(basename "$dir")/kit.yaml），不能收；確定要收就加 --allow，一起加進清單"
            die "$(url_id "$url") 不在 collect_sources（$(basename "$dir")/kit.yaml），不能收"
        fi
        [ $own = 1 ] || die "--allow 只能用在你自己的來源（kit.yaml 寫 push: direct 的）；團隊來源請維護者把 $(url_id "$url") 加進 kit.yaml 的 collect_sources"
        [ -z "$real" ] || [ "$real" = "$url" ] || die "git 設定把 $url 改到 ${real}：--allow 不幫這種網址加清單"
        add=1
    fi
    path=${path#/}; path=${path%/}
    case /$path/ in */../*|*/./*) die "--path 不能有 .. 或 .";; esac

    local tmp repo src sha lic kind d; tmp=$(mktemp -d "${TMPDIR:-/tmp}/kit-collect.XXXXXX"); repo="$tmp/repo"
    [ -n "$look" ] || say "從 $(url_id "$url") 下載${ref:+（${ref}）}…"
    if ! git_safe -c protocol.file.allow=always clone -q --depth 1 --no-recurse-submodules ${ref:+--branch "$ref"} "$url" "$repo" 2>"$tmp/err"; then
        sed 's/^/  /' "$tmp/err" >&2; rm -rf "$tmp"; die "沒辦法下載 $url"
    fi
    sha=$(git -C "$repo" rev-parse HEAD)
    repo=$(cd "$repo" && pwd -P)
    # which folder: --path, else the top if it has a SKILL.md, else the only folder in the repo that has one
    local found
    if [ -n "$path" ] || [ -f "$repo/SKILL.md" ]; then found=${path:-.}
    else found=$(skill_dirs "$repo"); fi
    [ -n "$found" ] || { rm -rf "$tmp"; die "$(url_id "$url") 裡找不到 SKILL.md"; }

    if [ -n "$look" ]; then # what kit would collect, as JSON (the Herdr panel shows it before you collect)
        local first=1 n desc fm ex
        printf '{"source": %s, "dir": %s, "push": %s, "url": %s, "id": %s, "commit": %s, "allowed": %s, "can_allow": %s, "skills": [' \
            "$(json_s "$(basename "$dir")")" "$(json_s "$dir")" "$(json_s "$(push_mode "$dir")")" "$(json_s "$url")" "$(json_s "$(url_id "$url")")" "$(json_s "$sha")" \
            "$( [ $ok = 1 ] && echo true || echo false)" "$( [ $ok = 0 ] && [ $own = 1 ] && [ -z "$real" -o "$real" = "$url" ] && echo true || echo false)"
        while IFS= read -r d; do
            [ -n "$d" ] || continue
            src=$repo; [ "$d" = . ] || src="$repo/$d"
            [ -f "$src/SKILL.md" ] || { rm -rf "$tmp"; die "$(url_id "$url")/$d 裡沒有 SKILL.md"; }
            fm=$(fm_of "$src/SKILL.md"); n=$name; [ -n "$n" ] || n=$(fm_val "$fm" name); desc=$(fm_val "$fm" description)
            [ -n "$n" ] || { if [ "$d" = . ]; then n=$(basename "$(url_id "$url")"); else n=$(basename "$d"); fi; }
            lic=$(collect_license "$src" "$repo"); kind=""; [ -z "$lic" ] || kind=$(license_kind "$lic")
            collect_scan "$src"
            ex=""; if [ -e "$dir/skills/$n" ]; then if [ -n "$(lock_get "$dir" "$n")" ]; then ex=collected; else ex=own; fi; fi
            [ $first = 1 ] || printf ','; first=0
            printf '\n  {"path": %s, "name": %s, "valid": %s, "description": %s, "license": %s, "scripts": %s, "skipped": %s, "exists": %s, "dest": %s}' \
                "$(json_s "$d")" "$(json_s "$n")" "$(valid_name "$n" && echo true || echo false)" "$(json_s "$desc")" "$(json_s "$kind")" \
                "$(json_s "$COL_SCRIPTS")" "$COL_SKIPPED" "$(json_s "$ex")" "$(json_s "$dir/skills/$n/SKILL.md")"
        done <<EOT
$found
EOT
        printf '\n]}\n'
        rm -rf "$tmp"; return 0
    fi
    if [ "$(printf '%s\n' "$found" | wc -l | tr -d ' ')" -gt 1 ]; then
        rm -rf "$tmp"
        die "$(url_id "$url") 裡有好幾個 skill，用 --path 選一個：
$(printf '%s\n' "$found" | sed 's/^/  /')"
    fi
    path=$found; [ "$path" = . ] && path=""
    src=$repo${path:+/$path}
    [ -d "$src" ] && src=$(cd "$src" && pwd -P)
    case $src/ in "$repo"/*) ;; *) rm -rf "$tmp"; die "--path 要在 repo 裡面";; esac
    [ -f "$src/SKILL.md" ] || { rm -rf "$tmp"; die "$(url_id "$url")${path:+/$path} 裡沒有 SKILL.md（用 --path 指出 skill 的資料夾）"; }
    [ -n "$name" ] || name=$(fm_val "$(fm_of "$src/SKILL.md")" name)
    [ -n "$name" ] || { if [ -z "$path" ]; then name=$(basename "$(url_id "$url")"); else name=$(basename "$src"); fi; }
    valid_name "$name" || { rm -rf "$tmp"; die "名字 $name 不行（只能小寫英文、數字和 -），用 --name 給一個"; }
    local dst="$dir/skills/$name"
    if [ -e "$dst" ] && [ -z "$(lock_get "$dir" "$name")" ] && [ -z "$force" ]; then
        rm -rf "$tmp"; die "$(basename "$dir") 已經有 skill:${name}，而且不是 collect 收的（要整份換掉加 --force，或用 --name 換名字）"
    fi
    # license: the skill's own, else the repo's
    lic=$(collect_license "$src" "$repo")
    [ -n "$lic" ] || { rm -rf "$tmp"; die "$(url_id "$url") 沒有 LICENSE，不知道能不能用，不收"; }
    kind=$(license_kind "$lic")
    # copy: everything text, no links, no binaries, no git
    mkdir -p "$tmp/out"
    collect_scan "$src" "$tmp/out"
    [ "$lic" = "$src/${lic##*/}" ] || cp "$lic" "$tmp/out/${lic##*/}"
    rm -rf "$dst"; mkdir -p "$dir/skills"; cp -R "$tmp/out" "$dst"
    lock_set "$dir" "$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s' "$name" "$url" "${path:-.}" "${ref:--}" "$sha" "$kind" "$(date +%Y-%m-%d)")"
    rm -rf "$tmp"
    if [ -n "$add" ]; then yaml_list_add "$dir/kit.yaml" collect_sources "$(url_id "$url")"; say "已把 $(url_id "$url") 加進 $(basename "$dir")/kit.yaml 的 collect_sources"; fi
    say "已收 skill:$name ← $(url_id "$url")${path:+/$path} @ $(printf %.12s "$sha")（授權 ${kind}）"
    [ "$kind" = unknown ] && warn "認不出授權種類，請自己看 skills/$name/${lic##*/}"
    [ "$kind" = GPL ] && warn "GPL 類授權：改了再發布要公開原始碼，請確認可以用"
    [ -n "$COL_SCRIPTS" ] && warn "這個 skill 有會執行的檔案，送出前請看過：$COL_SCRIPTS"
    check_dirs "$dir" >/dev/null 2>&1 || warn "kit check 有問題，送出前請先打  kit check  看看"
    if [ "$(push_mode "$dir")" = direct ]; then say "下一步：用 git diff 看收進來的檔案；沒問題就  kit push  送出，要用它就  kit add skill $name"
    else say "下一步：kit diff 看不到第三方的差異，請用 git diff 看；沒問題就  kit push  開 PR"; fi
}

cmd_outdated() { # kit outdated [--to SOURCE]
    local to=""
    while [ $# -gt 0 ]; do case $1 in --to) to=${2:-}; shift 2 || die "--to 後面要接來源";; *) die "用法：kit outdated [--to 來源]";; esac; done
    local dir; dir=$(target_dir "$to") || exit 1
    check_maintainer "$dir"
    [ -f "$dir/third_party.lock" ] || { say "$(basename "$dir") 沒有 third_party.lock（還沒用 kit collect 收過東西）"; return 0; }
    local n url path ref sha lic day now new=0
    while IFS="$TAB" read -r n url path ref sha lic day; do
        case $n in ""|\#*) continue;; esac
        if ! collect_allowed "$url" "$dir"; then warn "${n}：$(url_id "$url") 已經不在 collect_sources，不檢查"; continue; fi
        if [ "$ref" = - ]; then now=$(git_safe ls-remote "$url" HEAD 2>/dev/null | awk '$2 == "HEAD" { print $1; exit }')
        else # a branch, or a tag (the commit it points to: ^{})
            now=$(git_safe ls-remote "$url" "refs/heads/$ref" "refs/tags/$ref" "refs/tags/$ref^{}" 2>/dev/null |
                  awk -v r="$ref" '$2 == "refs/heads/" r { b = $1 } $2 == "refs/tags/" r { t = $1 } $2 == "refs/tags/" r "^{}" { p = $1 }
                                   END { print (b != "" ? b : (p != "" ? p : t)) }')
        fi
        if [ -z "$now" ]; then warn "${n}：連不到 $(url_id "$url")"
        elif [ "$now" = "$sha" ]; then say "  ${n}：最新（$(printf %.12s "$sha")）"
        else say "  ${n}：有新版本 $(printf %.12s "$sha") → $(printf %.12s "$now")，打  kit collect $n  收新的"; new=$((new+1)); fi
    done < "$dir/third_party.lock"
    [ $new = 0 ] || say "kit：$new 個有新版本"
}

cmd_approve() { # kit approve <approvals repo> <source clone>... --key <ssh key> [--yes]
    local dir="" key="" yes="" repos=() r n sha prev f tmp serial
    while [ $# -gt 0 ]; do
        case $1 in
            --key) key=${2:-}; shift 2 || die "--key 後面要接簽章用的 ssh 金鑰";;
            --yes) yes=1; shift;;
            *) if [ -z "$dir" ]; then dir=$1; else repos+=("$1"); fi; shift;;
        esac
    done
    [ -n "$dir" ] && [ ${#repos[@]} -ge 1 ] && [ -n "$key" ] || die "用法：kit approve <核准紀錄的 repo> <來源的 clone>... --key <ssh 金鑰>"
    [ -d "$dir/.git" ] || die "$dir 要是一個 git repo（放核准紀錄）"
    [ -f "$key" ] || die "找不到金鑰 $key"
    f="$dir/approved.txt"; tmp=$(mktemp "${TMPDIR:-/tmp}/kit-approve.XXXXXX")
    serial=$(awk '$1 == "serial:" { print $2; exit }' "$f" 2>/dev/null); serial=$(( ${serial:-0} + 1 ))
    awk 'NF == 2 && $1 !~ /^#/ && $1 != "serial:"' "$f" 2>/dev/null > "$tmp"
    for r in "${repos[@]}"; do
        [ -d "$r/.git" ] || die "$r 不是 git clone"
        [ -z "$(git -C "$r" status --porcelain)" ] || die "$r 有還沒 commit 的改動"
        n=$(basename "$(cd "$r" && pwd)"); sha=$(git -C "$r" rev-parse HEAD)
        prev=$(awk -v n="$n" '$1 == n { print $2; exit }' "$tmp")
        printf '\n== %s  %s → %s\n' "$n" "$( [ -n "$prev" ] && printf %.12s "$prev" || echo 第一次)" "$(printf %.12s "$sha")"
        if [ "$prev" = "$sha" ]; then echo "（沒有變）"
        elif [ -n "$prev" ] && git -C "$r" cat-file -e "$prev^{commit}" 2>/dev/null; then
            git -C "$r" --no-pager log --oneline "$prev..$sha"; git -C "$r" --no-pager diff --stat "$prev" "$sha"
        else git -C "$r" --no-pager log --oneline -5 "$sha"; fi
        [ -n "$(git -C "$r" branch -r --contains "$sha" 2>/dev/null)" ] || warn "$n 的 $(printf %.12s "$sha") 還沒 push 到任何遠端"
        awk -v n="$n" '$1 != n' "$tmp" > "$tmp.2"; printf '%s %s\n' "$n" "$sha" >> "$tmp.2"; mv "$tmp.2" "$tmp"
    done
    if [ -z "$yes" ]; then
        local a=""
        if ! { printf '\n核准上面這些版本？[y/N] ' > /dev/tty && read -r a < /dev/tty; } 2>/dev/null; then
            rm -f "$tmp"; die "沒辦法在這裡問你（沒有終端機）。看過上面的內容、確定要核准，就加 --yes 再打一次"
        fi
        case $a in y|Y|yes) ;; *) rm -f "$tmp"; die "沒有核准";; esac
    fi
    { echo "# agentkit approvals - signed with kit approve; do not edit by hand"
      echo "serial: $serial"
      LC_ALL=C sort "$tmp"; } > "$f"
    rm -f "$tmp" "$f.sig"
    ssh-keygen -Y sign -q -f "$key" -n agentkit "$f" || die "簽章失敗"
    git -C "$dir" add approved.txt approved.txt.sig && git -C "$dir" commit -q -m "approve serial $serial" || die "commit 失敗"
    say "kit：已核准並簽章（serial ${serial}）。下一步：git -C $dir push"
}

# ---------- the Herdr panel (a Herdr mod that runs kit list --json / add / rm / sync / run) ----------
SHIPPED_LAYOUTS="main terminals win98"     # Herdr's own layouts: Herdr puts them back when edited
PANEL_TOGGLE='{"id":"kit-toggle","type":"block","content":{"mod":"kit","props":{"role":"toggle"}},"size":{"px":56}}'
PANEL_NODE='{"id":"kit-panel","type":"column","children":[{"id":"kit","type":"block","content":{"mod":"kit"}}],"size":{"px":420},"min":320,"max":800}'
# Agents stand beside Kit: their own tab-bar button (before Kit's) and their own panel (hidden until clicked)
AGENTS_TOGGLE='{"id":"kit-agents-toggle","type":"block","content":{"mod":"kit-agents","props":{"role":"toggle"}},"size":{"px":66}}'
AGENTS_NODE='{"id":"kit-agents-panel","type":"column","children":[{"id":"kit-agents","type":"block","content":{"mod":"kit-agents"}}],"size":{"px":420},"min":320,"max":800,"hidden":true}'
herdr_home() { # the same rule as Herdr: $HERDR_APP_HOME, else $XDG_CONFIG_HOME/herdr-app, else ~/.config/herdr-app
    if [ -n "${HERDR_APP_HOME:-}" ]; then printf '%s\n' "$HERDR_APP_HOME"
    elif [ -n "${XDG_CONFIG_HOME:-}" ]; then printf '%s/herdr-app\n' "$XDG_CONFIG_HOME"
    else printf '%s/.config/herdr-app\n' "$HOME"; fi
}
panel_src() { # the panel's files: next to the installed kit, else in the repo kit runs from
    local d
    for d in "$KIT_LIB/herdr/kit-panel" "$(kit_repo 2>/dev/null)/herdr/kit-panel"; do
        [ -f "$d/main.js" ] && { printf '%s\n' "$d"; return 0; }
    done
    return 1
}
case $(uname -s 2>/dev/null) in Darwin) TOGGLE_OP=addnear;; *) TOGGLE_OP=addbefore;; esac   # see herdr-panel install
[ -z "${KIT_TEST_BAR_BUTTONS:-}" ] || TOGGLE_OP=addbefore     # tests: a bar that draws window buttons, on a Mac
has_id() { grep -Eq "\"id\"[[:space:]]*:[[:space:]]*\"$1\"" "$2"; }   # has_id ID FILE : a layout node with this id
layout_without_panel() { # layout_without_panel FILE OUT : FILE without the panel's blocks
    # rmholder first: a column holding only kit's block goes too, whatever its id became
    printf 'rmholder\tcontent.mod\tkit\nrmholder\tcontent.mod\tkit-agents\nrmwhere\tcontent.mod\tkit\nrmwhere\tid\tkit-toggle\nrmwhere\tid\tkit-panel\nrmwhere\tcontent.mod\tkit-agents\nrmwhere\tid\tkit-agents-toggle\nrmwhere\tid\tkit-agents-panel\nunrow\tkit-tabs-row\nswapwhere\tcontent.mod\tkit-pane\tpane\n' > "$2.ops"
    LC_ALL=C awk -f "$KIT_LIB/json.awk" -v ops="$2.ops" "$1" > "$2"; local rc=$?
    rm -f "$2.ops"; return $rc
}
swap_layout() { # swap_layout NEW FILE : FILE (backed up first) becomes NEW
    local b; b="$2.kit-backup-$(date +%Y%m%d-%H%M%S)"
    cp -p "$2" "$b" || { rm -f "$1"; die "沒辦法備份 $2"; }
    cat "$1" > "$2" && rm -f "$1"
    say "kit：改了版面 $(basename "$2")（原本的備份在 $(basename "$b")）"
}
cmd_herdr_panel() {
    local hh mods dest src name lf tmp place=none keep="" k v env first
    hh=$(herdr_home); mods="$hh/mods"; dest="$mods/kit"
    case ${1:-} in
    install)
        [ "${2:-}" = --keep-env ] && keep=1
        src=$(panel_src) || die "找不到 panel 的檔案（herdr/kit-panel）；請重裝 kit"
        [ -d "$mods" ] || die "找不到 Herdr 的 mods 資料夾：${mods}（Herdr 有裝、開過一次嗎？）"
        [ ! -e "$dest" ] || [ -f "$dest/.kit-panel" ] || die "$dest 已經有東西，不是 kit 放的，不動它"
        local xm mj
        for xm in kit-pane kit-agents; do      # every conflict before anything is written
            [ ! -e "$mods/$xm" ] || [ -f "$mods/$xm/.kit-panel" ] || die "$mods/$xm 已經有東西，不是 kit 放的，不動它"
        done
        # where the panel goes: a button in the tab bar of the shown layout + the panel beside the work area
        name=$(json_get "$hh/shared.json" layout | sed 's/^"//; s/"$//'); [ -n "$name" ] || name=main
        lf="$hh/layouts/$name.json"; tmp=""
        case " $SHIPPED_LAYOUTS " in
        *" $name "*) place=right
            say "kit：現在的版面（${name}）是 Herdr 內建的，不能直接改：panel 會先出現在右邊，按 panel 上的「放進上排」會複製一份版面再放進去";;
        *)  if [ ! -f "$lf" ]; then place=right
            else
                # the button and panel, and each pane's header with kit's button (the pane header mod "kit-pane")
                tmp=$(mktemp "$lf.kit.XXXXXX")
                # Kit's button and panel already there (maybe moved or resized by hand): keep them where they are,
                # only add what is missing. Otherwise start clean (old or half-placed blocks taken out first).
                if has_id kit-toggle "$lf" && has_id kit-panel "$lf"; then cp "$lf" "$tmp.1"
                else layout_without_panel "$lf" "$tmp.1"; fi &&
                    { # the buttons go in one row with the tab bar: a tab bar in a column (Herdr's own layouts) gets a row
                      # around it first. Where the bar draws the window buttons itself (Linux, Windows) they go before it,
                      # so the close button stays in the corner; on a Mac after it.
                      { has_id kit-agents-toggle "$tmp.1" && has_id kit-toggle "$tmp.1"; } || printf 'rowaround\tcontent.mod\ttabs\tkit-tabs-row\n'
                      has_id kit-agents-toggle "$tmp.1" || printf '%s\tcontent.mod\ttabs\t%s\n' "$TOGGLE_OP" "$AGENTS_TOGGLE"
                      has_id kit-toggle "$tmp.1" || printf '%s\tcontent.mod\ttabs\t%s\n' "$TOGGLE_OP" "$PANEL_TOGGLE"
                      has_id kit-panel "$tmp.1" || printf 'addnear\tcontent.tab\tactive\t%s\n' "$PANEL_NODE"
                      has_id kit-agents-panel "$tmp.1" || printf 'addnear\tcontent.tab\tactive\t%s\n' "$AGENTS_NODE"
                      printf 'swapwhere\tcontent.mod\tpane\tkit-pane\n'; } > "$tmp.ops" &&
                    LC_ALL=C awk -f "$KIT_LIB/json.awk" -v ops="$tmp.ops" "$tmp.1" > "$tmp"
                rm -f "$tmp.1" "$tmp.ops"
                if ! has_id kit-toggle "$tmp" || ! has_id kit-panel "$tmp"; then
                    rm -f "$tmp"; tmp=""; place=right
                    say "kit：版面 $name 找不到分頁列（tabs）或工作區，沒改它：panel 會先出現在右邊"
                elif cmp -s "$tmp" "$lf"; then rm -f "$tmp"; tmp=""     # already like this: no backup, no write
                fi
            fi;;
        esac
        # the files (main.js etc.), then mod.json and the panel's config (how to run kit here)
        mkdir -p "$dest" || { rm -f "$tmp"; die "沒辦法建立 $dest"; }
        cp -R "$src"/. "$dest"/ || { rm -f "$tmp"; die "沒辦法複製 panel 到 $dest"; }
        # the other mods next to it: each pane's header (kit-pane) and the Agents window (kit-agents)
        for xm in kit-pane kit-agents; do
            [ -f "$(dirname "$src")/$xm/main.js" ] || continue
            mkdir -p "$mods/$xm" && cp -R "$(dirname "$src")/$xm"/. "$mods/$xm"/ || { rm -f "$tmp"; die "沒辦法複製到 $mods/$xm"; }
            case $xm in
                kit-pane) mj='{ "place": "none", "title": "Pane header (kit)" }';;
                *) mj='{ "place": "none", "title": "kit Agents", "overlay": { "kind": "window", "width": 520, "height": 640 } }';;
            esac
            printf '%s\n' "$mj" > "$mods/$xm/mod.json"; : > "$mods/$xm/.kit-panel"
        done
        printf '{ "place": "%s", "size": 420, "title": "kit" }\n' "$place" > "$dest/mod.json"
        env=""; first=1
        if [ -n "$keep" ]; then
            for k in HOME AGENTKIT_CONFIG AGENTKIT_SOURCES CLAUDE_CONFIG_DIR CODEX_HOME PI_CODING_AGENT_DIR; do
                eval "v=\${$k:-}"; [ -n "$v" ] || continue
                [ $first = 1 ] || env="$env, "; first=0; env="$env$(json_s "$k"): $(json_s "$v")"
            done
        fi
        printf '{\n  "kit": [%s],\n  "env": {%s}\n}\n' "$(json_s "$(cd "$(dirname "$0")" && pwd)/$(basename "$0")")" "$env" > "$dest/config.json"
        : > "$dest/.kit-panel"
        [ -n "$tmp" ] && swap_layout "$tmp" "$lf"
        say "kit：Herdr 的 kit panel 裝好了（${dest}）"
        ;;
    uninstall)
        if [ -e "$dest" ]; then
            [ -f "$dest/.kit-panel" ] || die "$dest 不是 kit 放的，不動它"
            rm -rf "$dest"
        fi
        for xm in kit-pane kit-agents; do [ ! -f "$mods/$xm/.kit-panel" ] || rm -rf "${mods:?}/$xm"; done
        for lf in "$hh"/layouts/*.json; do
            [ -f "$lf" ] || continue
            case " $SHIPPED_LAYOUTS " in *" $(basename "$lf" .json) "*) continue;; esac
            tmp=$(mktemp "$lf.kit.XXXXXX")
            layout_without_panel "$lf" "$tmp" || { rm -f "$tmp"; warn "沒辦法讀 ${lf}，沒改它"; continue; }
            # nothing of kit's in it: the same as the file only re-read (json.awk lays JSON out its own way)
            : > "$tmp.none"; LC_ALL=C awk -f "$KIT_LIB/json.awk" -v ops="$tmp.none" "$lf" > "$tmp.same" 2>/dev/null
            if cmp -s "$tmp" "$tmp.same"; then rm -f "$tmp" "$tmp.none" "$tmp.same"; continue; fi
            rm -f "$tmp.none" "$tmp.same"
            swap_layout "$tmp" "$lf"
        done
        say "kit：Herdr 的 kit panel 拿掉了"
        ;;
    *) die "用法：kit herdr-panel install|uninstall";;
    esac
}

# ---------- agents: the definitions (agents/<name>.md), for the Herdr agent panel ----------
json_arr() { # lines -> ["a", "b"]
    local first=1 v out="["
    while IFS= read -r v; do [ -n "$v" ] || continue; [ $first = 1 ] || out="$out, "; first=0; out="$out$(json_s "$v")"; done
    printf '%s]' "$out"
}
git_state() { # git_state DIR FILE : "new", "changed" or "" (or "no-git")
    git -C "$1" rev-parse --git-dir >/dev/null 2>&1 || { echo no-git; return; }
    case $(git -C "$1" status --porcelain --untracked-files=all -- "$2" 2>/dev/null | cut -c1-2) in
        "") ;; "??"|A*) echo new;; *) echo changed;;
    esac
}
cmd_agents() {
    [ "${1:-}" = --json ] || die "用法：kit agents --json"
    need_init
    local i n f d fm first=1 st items
    items=$(available)
    printf '{\n  "kit": %s,\n  "tools": [%s],\n  "available": {"rule": %s, "skill": %s, "mcp": %s},\n  "agents": [' "$(json_s "$KIT_VERSION")" \
        "$(t='"claude"'; has_codex && t="$t, \"codex\""; has_omp && t="$t, \"omp\""; printf '%s' "$t")" \
        "$(printf '%s\n' "$items" | sed -n 's/^rule://p' | json_arr)" "$(printf '%s\n' "$items" | sed -n 's/^skill://p' | json_arr)" "$(printf '%s\n' "$items" | sed -n 's/^mcp://p' | json_arr)"
    for i in $(printf '%s\n' "$items" | grep '^agent:'); do
        n=${i#agent:}; f=$(find_item agent "$n") || continue
        d=${f%/agents/*}; fm=$(fm_of "$f")
        st=$(git_state "$d" "agents/$n.md")
        [ $first = 1 ] || printf ','; first=0
        printf '\n    {"name": %s, "description": %s, "source": %s, "path": %s, "git": %s,\n     "rules": %s, "skills": %s, "mcp": %s, "tools_only": %s, "tools_deny": %s,\n     "prompt": %s}' \
            "$(json_s "$n")" "$(json_s "$(fm_val "$fm" description | head -n 1)")" "$(json_s "$(basename "$d")")" "$(json_s "$f")" "$(json_s "$st")" \
            "$(fm_val "$fm" rules | json_arr)" "$(fm_val "$fm" skills | json_arr)" "$(fm_val "$fm" mcp | json_arr)" \
            "$(fm_val "$fm" tools.only | json_arr)" "$(fm_val "$fm" tools.deny | json_arr)" \
            "$(json_s "$(fm_body "$f")")"
    done
    printf '\n  ]\n}\n'
}
fm_set_list() { # fm_set_list FILE KEY "a, b" : KEY: [a, b] in the file's frontmatter (block lists replaced, added if missing)
    local tmp; tmp=$(mktemp "$1.kit.XXXXXX")
    # a block list: the indented lines after KEY go, up to the next key or ---; blank and comment lines
    # in between stay only when the block goes on after them. Line ends (LF or CRLF) are kept.
    awk -v key="$2" -v val="[$3]" '
        { l = $0; cr = sub(/\r$/, "", l) ? "\r" : "" }
        NR == 1 { eol = cr }
        NR == 1 && l == "---" { infm = 1; print; next }
        infm && skip { if (l ~ /^[ \t]*(#.*)?$/) { held = held $0 "\n"; next }
                       if (l ~ /^[ \t]/) { held = ""; next }
                       skip = 0; printf "%s", held; held = "" }
        infm && l == "---" { if (!done) print key ": " val eol; done = 1; infm = 0; print; next }
        infm && index(l, key ":") == 1 { print key ": " val eol; done = 1; if (substr(l, length(key) + 2) ~ /^[ \t]*(#.*)?$/) skip = 1; next }
        { print }' "$1" > "$tmp" && mv "$tmp" "$1" || { rm -f "$tmp"; die "沒辦法改 $1"; }
}
cmd_agent() { # kit agent <name> add|rm rule|skill|mcp <item>
    [ $# -eq 4 ] || die "用法：kit agent <名字> add|rm rule|skill|mcp <東西>"
    need_init
    local n=$1 verb=$2 k=$3 item=$4 f fm key cur new d
    case $verb in add|rm) ;; *) die "用法：kit agent <名字> add|rm rule|skill|mcp <東西>";; esac
    case $k in rule) key=rules;; skill) key=skills;; mcp) key=mcp;; *) die "種類只能是 rule、skill、mcp";; esac
    f=$(find_item agent "$n") || die "找不到 agent ${n}（打 kit list 看有哪些）"
    fm_starts "$f" || die "$f 沒有開頭的 --- 區塊"
    fm=$(fm_of "$f") || die "$f 開頭的 --- 區塊讀不懂，沒改（打 kit check 看哪裡錯）"
    cur=$(fm_val "$fm" "$key")
    if [ "$verb" = add ]; then
        find_item "$k" "$item" >/dev/null || die "找不到 ${k}:${item}（kit 的來源裡沒有）"
        printf '%s\n' "$cur" | grep -qxF "$item" && { say "agent $n 已經有 ${k}:${item}"; return 0; }
        new=$(printf '%s\n%s\n' "$cur" "$item" | awk 'NF' | paste -sd, - | sed 's/,/, /g')
    else
        printf '%s\n' "$cur" | grep -qxF "$item" || { say "agent $n 本來就沒有 ${k}:${item}"; return 0; }
        new=$(printf '%s\n' "$cur" | grep -vxF "$item" | awk 'NF' | paste -sd, - | sed 's/,/, /g')
    fi
    fm_set_list "$f" "$key" "$new"
    d=${f%/agents/*}
    say "agent ${n}：$( [ "$verb" = add ] && echo 加上 || echo 拿掉) ${k}:${item}（改了 ${f}，還沒送出：打  kit push --to $(basename "$d")）"
    case $d/ in "$KIT_SRC"/*) warn "這個檔案在 kit 自己同步用的資料夾（${KIT_SRC}）裡：沒送出前，kit sync 可能沒辦法更新它；最好在你自己 clone 的來源改";; esac
    [ -z "$M_APPROVALS" ] || warn "這台只用簽過的版本（approvals）：改的要送出、合併、再簽過，這台才會用到"
}

usage() {
    cat <<'EOF'
kit - 管理 AI 寫程式工具的 rule、skill、MCP 和 agent

  kit init <網址|資料夾> [更多...]   第一次：設定來源，加上預設的東西
  kit list [--json]                 有哪些、你在用哪些、哪些是新的（--json 給程式讀）
     --json --dir 資料夾              再列出在那個資料夾開的 agent 另外會讀到的（不是 kit 管的）
  kit agents --json                 每個 agent 用了哪些 rule、skill、MCP（給 Herdr 的 Agent 面板）
  kit agent <名字> add|rm rule|skill|mcp <東西>   改 agent 用的東西（改來源裡的檔案，再用 kit push 送出）
  kit add rule|skill|mcp <名字>     開始用
  kit rm  rule|skill|mcp <名字>     不用了（之後 sync 也不會加回來）
  kit run <agent> [--tool codex|omp] [參數]   開一個做好的 agent（預設用 Claude）
  kit sync [--force]                現在更新（kit run 會自動做）

寫內容的人用（只吃本機資料夾，不連網）：
  kit new rule|skill|mcp|agent <名字> [--from 本機資料夾] [--to 來源]
  kit diff   [種類] <名字> --from 本機資料夾   比較
  kit update [種類] <名字> --from 本機資料夾   更新；別人改過會停下來（--force 硬蓋）
  kit check [--ci] [資料夾...]      檢查格式、引用、名字重複、網址、不該公開的字

維護者用（只收 kit.yaml 的 collect_sources 列的原作者）：
  kit collect <原作者 repo 網址> [--path 資料夾] [--name 名字] [--ref 分支] [--allow]   收別人的 skill（保留 LICENSE）
                                    （沒給 --path：repo 裡只有一個 SKILL.md 就用它；--allow：自己的來源一起加進 collect_sources）
  kit collect <名字>                再收一次＝整份換成原作者的新版
  kit outdated                      看收過的 skill 原作者有沒有新版
  kit export-self <資料夾> [--version <版本>]   匯出 kit 的原始碼（給公司的 git server）
  kit ci-template [檔案]            Gitea Actions 範本（PR 自動跑 kit check --ci），例：
                                      kit ci-template .gitea/workflows/kit-check.yaml
  kit push [--to 來源] [--dry-run]  檢查後送出改的東西：開 PR（預設），或 kit.yaml 寫 push: direct 就直接推

  kit approve <核准紀錄> <來源 clone>... --key <金鑰>   簽章核准這些版本（給 root 這類只用核准版本的帳號）
  kit herdr-panel install|uninstall 在 Herdr 加上（或拿掉）kit 的面板
  kit self-update                   更新 kit 本身
  kit uninstall [--self]            拿掉 kit 加的東西（--self 連 kit 也移除）
  kit --version
EOF
}

# the commands that change state.tsv, the tools' files or a source: one kit at a time (sync --hook takes it itself)
case ${1:-} in init|sync|add|rm|remove|uninstall|push|agent) [ "${2:-}" = --hook ] || take_lock;; esac
case ${1:-} in
    init)      shift; cmd_init "$@";;
    sync)      shift
               case ${1:-} in --force) FORCE=1;; --hook) sync_hook;; esac
               cmd_sync;;
    list|ls)   shift; cmd_list "$@";;
    add)       shift; cmd_add_rm add "$@";;
    rm|remove) shift; cmd_add_rm rm "$@";;
    run)       shift; cmd_run "$@";;
    agents)    shift; cmd_agents "$@";;
    agent)     shift; cmd_agent "$@";;
    new)       shift; cmd_new "$@";;
    diff)      shift; cmd_diff_update diff "$@";;
    update)    shift; cmd_diff_update update "$@";;
    check)     shift; cmd_check "$@";;
    export-self) shift; cmd_export_self "$@";;
    ci-template) shift; cmd_ci_template "$@";;
    push)      shift; cmd_push "$@";;
    uninstall) shift; cmd_uninstall "$@";;
    self-update) cmd_self_update;;
    approve)   shift; cmd_approve "$@";;
    collect)   shift; cmd_collect "$@";;
    outdated)  shift; cmd_outdated "$@";;
    herdr-panel) shift; cmd_herdr_panel "$@";;
    --version|version) echo "kit $KIT_VERSION";;
    ""|-h|--help|help) usage;;
    *) die "沒有這個指令：$1（打 kit help）";;
esac
