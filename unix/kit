        while (match(x, /(^|\\n)\[[^]]+#[0-9A-Za-z]+]\\n/)) {
            h = substr(x, RSTART, RLENGTH); x = substr(x, RSTART + RLENGTH - 2)
            sub(/^\\n/, "", h); sub(/#[0-9A-Za-z]+]\\n$/, "", h); out("edit", unesc(substr(h, 2)))
        }
    }
}'
# newest first, one per path: absolute (a relative one under DIR; ~/ is the home folder), a path with a drive letter
# (or \\server) with / and compared ignoring case; then the --git ones (after a line --git--), not already listed
FILES_PICK='
BEGIN { dir = ENVIRON["FILES_DIR"]; home = ENVIRON["HOME"] }
function abs(p,   d, i) {
    if (substr(p, 1, 2) == "~/" && home != "") p = home substr(p, 2)
    if (p !~ /^\// && p !~ /^[A-Za-z]:[\\\/]/ && p !~ /^\\\\/) {
        if (dir == "") return ""
        while (substr(p, 1, 2) == "./") p = substr(p, 3)
        d = dir; sub(/[\\\/]+$/, "", d); p = d "/" p
    }
    if (p ~ /^[A-Za-z]:[\\\/]/ || p ~ /^\\\\/) gsub(/\\/, "/", p)
    while ((i = index(p, "/./")) > 0) p = substr(p, 1, i) substr(p, i + 3)
    return p
}
function key(p) { return (p ~ /^[A-Za-z]:\// || p ~ /^\/\//) ? tolower(p) : p }
function pick(g, p,   k) { p = abs(p); if (p == "") return; k = key(p); if (k in seen) return; seen[k] = 1; print "F\t" g "\t" p }
# the rows: "time TAB turn TAB tag TAB path", a turn start "time TAB n TAB turn TAB at TAB text"; then "F TAB tag TAB
# path" for files, and the turns newest first (n 0 last), "T TAB n TAB at TAB text" and its files "P TAB tag TAB path"
# (newest first, one per path; a sub-agent touch: in the turn that started last before it, the rows are in time order)
$0 == "--git--" { git = 1; next }
git { m++; gp[m] = substr($0, 5); next }
$3 == "turn" { cur = $2; if ($2 > top) top = $2; at[$2] = $4; tx[$2] = $5; next }
{ n++; tg[n] = $3; pa[n] = substr($0, length($1) + length($2) + length($3) + 4); tu[n] = $2 == "-" ? cur + 0 : $2 + 0 }
END {
    for (i = n; i >= 1; i--) pick(tg[i], pa[i])
    for (i = 1; i <= m; i++) pick("git", gp[i])
    for (i = n; i >= 1; i--) {
        p = abs(pa[i]); if (p == "") continue
        k = tu[i] SUBSEP key(p); if (k in ts) continue; ts[k] = 1; tl[tu[i], ++tc[tu[i]]] = tg[i] "\t" p
    }
    for (u = top + 0; u >= 0; u--) {
        if (!tc[u]) continue
        print "T\t" u "\t" at[u] "\t" tx[u]; for (i = 1; i <= tc[u]; i++) print "P\t" tl[u, i]
    }
}'
files_rows() { # files_rows TOOL LOG [used] : the rows of every file the log (and, Claude, its sub-agents) shows, oldest first
    local f i=0 m prog pat=""
    case ${3:-}$1 in
        claude) prog=$FILES_CLAUDE;; codex) prog=$FILES_CODEX;; omp) prog=$FILES_OMP;;
        usedclaude) prog=$USED_CLAUDE$FILES_CLAUDE; pat='"message":\{"role":"user","content":("|\[\{"type":"text")|"type":"tool_use","id":"[^"]*","name":"mcp__';;
        usedcodex) prog=$USED_CODEX$FILES_CODEX; pat='"user_message"|"UserMessage"|SKILL\.md|"McpToolCall"|"mcp_tool_call_end"';;
        usedomp) prog=$USED_OMP$FILES_OMP; pat='"role":"user"|skill://|SKILL\.md|mcp__';;
        *) return 0;;
    esac
    [ -n "$2" ] && [ -f "$2" ] || return 0
    { if [ "$1" = claude ]; then ls -tr "$2" "${2%.jsonl}/subagents/"*.jsonl 2>/dev/null; else printf '%s\n' "$2"; fi; } |
    while IFS= read -r f; do
        [ -f "$f" ] || continue; i=$((i + 1)); m=0; [ "$f" = "$2" ] && m=1
        if [ -n "${3:-}" ]; then             # used: the whole log, only the lines that can matter (a long one is big)
            LC_ALL=C grep -E -- "$pat" "$f" | LC_ALL=C awk -v cut=0 "BEGIN { fi = $i; main = $m }$CTX_AWK$FILES_AWK$prog"
        else ctx_scan "$f" "BEGIN { fi = $i; main = $m }$CTX_AWK$FILES_AWK$prog"; fi
    done | LC_ALL=C sort -t "$TAB" -k1,1 -k2,2n -k3,3n
}
files_git() { # files_git DIR : "git TAB path" for what git status shows in the repo DIR is in (a rename: its new name)
    local g top
    [ -n "$1" ] && [ -d "$1" ] && g=$(prog_path git) || return 0
    top=$(GIT_OPTIONAL_LOCKS=0 "$g" -C "$1" rev-parse --show-toplevel 2>/dev/null) && [ -n "$top" ] || return 0
    GIT_OPTIONAL_LOCKS=0 "$g" -C "$1" status --porcelain -z --ignore-submodules=all 2>/dev/null | tr '\0' '\n' |
        FILES_TOP=$top LC_ALL=C awk 'BEGIN { top = ENVIRON["FILES_TOP"] } skip { skip = 0; next }
            length($0) > 3 { if (substr($0, 1, 2) ~ /[RC]/) skip = 1; print "git\t" top "/" substr($0, 4) }'
}
agent_log() { # agent_log PID TOOL DIR : A_LOG (that agent's conversation log) or A_NOTE (why there is none)
    local s; A_LOG=""; A_NOTE=""
    case $2 in
        claude) s=$(claude_where "$1" "$3") && A_LOG=${s##*"$TAB"}
                [ -n "$A_LOG" ] || A_NOTE="找不到這個 Claude 的對話紀錄（~/.claude/projects）";;
        codex) A_LOG=$(codex_rollout "$3" "$1") || A_NOTE="找不到這個資料夾的 Codex 對話紀錄（~/.codex/sessions）";;
        omp) A_LOG=$(omp_session "$1" "$3"); [ -n "$A_LOG" ] || A_NOTE="找不到這個 omp 的 session（~/.omp/agent/sessions）";;
        "") A_NOTE="看不出是哪種 agent（用 --tool claude|codex|omp 指定）";;
        *) A_NOTE="不認得這種 agent：${2}（只認得 claude、codex、omp）";;
    esac
}
cmd_files() { # kit files --pid PID [--tool claude|codex|omp] [--dir DIR] [--git] [--json] : the files that agent read or changed
    local pid="" tool="" dir="" git="" json="" log="" note="" s picked tag p e n=0 out="" human="" k th tf=0 tl="" tn=0 turns=""
    turn_end() { [ -z "$tl" ] || { turns="$turns${turns:+, }$th$tl]}"; tn=$((tn + 1)); }; tl=""; }
    local use="用法：kit files --pid <pid> [--tool claude|codex|omp] [--dir 資料夾] [--git] [--json]"
    while [ $# -gt 0 ]; do
        case $1 in
            --pid|--tool|--dir) [ $# -ge 2 ] || die_c usage "$use"
                case $1 in --pid) pid=$2;; --tool) tool=$2;; *) dir=$2;; esac; shift 2;;
            --git) git=1; shift;;
            --json) json=1; shift;;
            *) die_c usage "$use";;
        esac
    done
    case $pid in ""|*[!0-9]*) die_c usage "$use";; esac
    agent_guess "$pid" "$tool" "$dir"; tool=$A_TOOL; dir=$A_DIR
    agent_log "$pid" "$tool" "$dir"; log=$A_LOG; note=$A_NOTE
    picked=$( { files_rows "$tool" "$log" | cut -f 1,4-; [ -z "$git" ] || { echo --git--; files_git "$dir"; }; } |
        FILES_DIR=$dir LC_ALL=C awk -F '\t' "$FILES_PICK")
    while IFS= read -r p; do
        k=${p%%"$TAB"*}; p=${p#*"$TAB"}
        case $k in
            F) [ $n -lt $FILES_MAX ] || continue;;
            T) turn_end; [ $tn -lt $TURNS_MAX ] || break
               th=${p%%"$TAB"*}; p=${p#*"$TAB"}; th="{\"n\": $th, \"at\": \"${p%%"$TAB"*}\", \"text\": \"${p#*"$TAB"}\", \"files\": ["
               tf=0; tl=""; continue;;
            P) [ $tf -lt $TURN_FILES ] || continue;;
            *) continue;;
        esac
        tag=${p%%"$TAB"*}; p=${p#*"$TAB"}
        [ -n "$p" ] || continue
        if [ -f "$p" ]; then e=true; else case $tag in read|git) continue;; esac; e=false; fi
        if [ "$k" = P ]; then tf=$((tf + 1)); tl="$tl${tl:+, }{\"path\": $(json_s "$p"), \"tag\": \"$tag\", \"exists\": $e}"; continue; fi
        n=$((n + 1))
        out="$out${out:+, }{\"path\": $(json_s "$p"), \"tag\": \"$tag\", \"exists\": $e}"
        human="$human$p  $tag$( [ $e = true ] || printf '（已經不在）')$LF"
    done <<EOF
$picked
EOF
    turn_end
    if [ -n "$json" ]; then
        printf '{"tool": %s, "log": %s, "dir": %s, "files": [%s], "turns": [%s]%s}\n' "$(json_s "$tool")" "$(json_s "$log")" "$(json_s "$dir")" "$out" "$turns" \
            "$( [ -z "$note" ] || printf ', "note": %s' "$(json_s "$note")")" >&3
    else
        [ -z "$note" ] || warn "$note"
        if [ -n "$human" ]; then printf '%s' "$human"; else warn "沒有看到讀過或改過的檔案"; fi
    fi
}

# kit used: the skills and MCP servers an agent's conversation used, how many times and in which turn (the files_rows
# producers, with these rows put in front: "time TAB file TAB n TAB turn TAB skill|mcp TAB name").
# Claude: a skill it loaded (the "Base directory for this skill: ..." record, for the Skill tool and for /name alike),
#   its mcp__<server>__<tool> calls. Codex: .../skills/<name>/SKILL.md in its tool calls (it reads a skill through the
#   shell; a patch is not a use), McpToolCall items (mcp_tool_call_end in older versions). omp: a read of skill://<name>
#   or .../skills/<name>/SKILL.md, mcp__<server>_<tool> calls (by name, or written to xd://): <server> with what is not
#   a letter, digit or _ made _, matched against the MCP servers it has (USED_MCP).
USED_CLAUDE='
!/^\{"type":"api-request/ && index($0, "\"type\":\"user\"") && (k = index($0, "[{\"type\":\"text\",\"text\":\"Base directory for this skill: ")) {
    x = lastts($0); if (x != "") t = sortt(x); else if (t == "") t = "00000000000000000"
    s = substr($0, k + 55); i = index(s, "\\n"); if (i) s = substr(s, 1, i - 1)
    s = unesc(s); sub(/[\/\\]+$/, "", s); sub(/.*[\/\\]/, "", s)
    if (s != "") print t "\t" fi "\t" (++r) "\t" tno() "\tskill\t" s
}
!/^\{"type":"api-request/ && index($0, "\"type\":\"assistant\"") && index($0, "\"name\":\"mcp__") && index($0, "\"type\":\"tool_use\"") {
    x = lastts($0); if (x != "") t = sortt(x); else if (t == "") t = "00000000000000000"
    s = $0
    while (match(s, /"type":"tool_use","id":"[^"]*","name":"mcp__([^"\\]|\\.)*"/)) {
        n = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH); n = substr(n, index(n, "\"name\":\"mcp__") + 13); n = substr(n, 1, length(n) - 1)
        if ((i = index(n, "__")) > 1) print t "\t" fi "\t" (++r) "\t" tno() "\tmcp\t" unesc(substr(n, 1, i - 1))
    }
}'
USED_CODEX='
function uskills(s,   n, seen) {
    if (index(s, "*** Begin Patch")) return
    while (match(s, /[\/\\]skills[\/\\][^\/\\"* ]+[\/\\]SKILL\.md/)) {
        n = substr(s, RSTART + 8, RLENGTH - 17); s = substr(s, RSTART + RLENGTH)
        if (!(n in seen)) { seen[n] = 1; print "00000000000000000\t" fi "\t" (++r) "\t" tno() "\tskill\t" n }
    }
}
index($0, "\"type\":\"custom_tool_call\"") || index($0, "\"type\":\"function_call\"") { uskills($0) }
index($0, "\"type\":\"item_completed\"") && (i = index($0, "\"item\":{\"type\":\"McpToolCall\"")) {
    n = unesc(strv(substr($0, i), "server")); if (n != "") print "00000000000000000\t" fi "\t" (++r) "\t" tno() "\tmcp\t" n
}
index($0, "\"type\":\"mcp_tool_call_end\"") && (i = index($0, "\"invocation\":{")) {
    n = unesc(strv(substr($0, i), "server")); if (n != "") print "00000000000000000\t" fi "\t" (++r) "\t" tno() "\tmcp\t" n
}'
USED_OMP='
BEGIN { unm = split(ENVIRON["USED_MCP"], um, "\n"); for (i = 1; i <= unm; i++) { us[i] = tolower(um[i]); gsub(/[^a-z0-9_]/, "_", us[i]) } }
function useen(k, n) { print "00000000000000000\t" fi "\t" (++r) "\t" tno() "\t" k "\t" n }
function umcp(x,   i, b, lx) { # the server of a tool name (after mcp__): the longest MCP server it starts with, else up to the last _
    lx = tolower(x); b = 0
    for (i = 1; i <= unm; i++) if (us[i] != "" && index(lx, us[i] "_") == 1 && (!b || length(us[i]) > length(us[b]))) b = i
    if (b) return um[b]
    sub(/_[^_]*$/, "", x); return x
}
index($0, "\"role\":\"assistant\"") && index($0, "{\"type\":\"toolCall\"") {
    s = $0
    while ((i = index(s, "{\"type\":\"toolCall\"")) > 0) {
        s = substr(s, i + 18); seg = s; j = index(seg, "{\"type\":\"toolCall\""); if (j) seg = substr(seg, 1, j - 1)
        n = strv(seg, "name"); k = index(seg, "\"arguments\":{"); p = k ? unesc(strv(substr(seg, k + 12), "path")) : ""
        if (n == "read" && substr(p, 1, 8) == "skill://") { p = substr(p, 9); sub(/[\/:?#].*/, "", p); if (p != "") useen("skill", p) }
        else if (n == "read" && match(p, /[\/\\]skills[\/\\][^\/\\]+[\/\\]SKILL\.md(:[0-9,-]*)?$/)) { p = substr(p, RSTART + 8); sub(/[\/\\].*/, "", p); useen("skill", p) }
        else if (index(n, "mcp__") == 1) useen("mcp", umcp(substr(n, 6)))
        else if (n == "write" && index(p, "xd://mcp__") == 1) useen("mcp", umcp(substr(p, 11)))
    }
}'
# the rows (stdin: "turn TAB tag TAB ..." from files_rows) -> "turn TAB N" (the last turn), then "tag TAB name TAB count TAB
# turn" for each skill and MCP server, the last used first (a sub-agent's: the turn that started last before it)
USED_SUM='
$2 == "turn" { cur = $1; if ($1 > top) top = $1; next }
$2 == "skill" || $2 == "mcp" {
    k = $2 "\t" $3; u = $1 == "-" ? cur + 0 : $1 + 0
    if (!(k in c)) o[++n] = k; c[k]++; if (u >= l[k]) l[k] = u; ord[k] = ++seq
}
END {
    print "turn\t" top + 0
    for (i = 1; i <= n; i++) for (j = i + 1; j <= n; j++) if (l[o[j]] > l[o[i]] || (l[o[j]] == l[o[i]] && ord[o[j]] > ord[o[i]])) { x = o[i]; o[i] = o[j]; o[j] = x }
    for (i = 1; i <= n; i++) print o[i] "\t" c[o[i]] "\t" l[o[i]]
}'
used_plugin() { # used_plugin NAME : the kit plugin whose skills/ has a skill NAME (in any source), else nothing
    local d p
    while IFS= read -r d; do
        for p in "$d"/plugins/*/skills/"$1"; do [ -d "$p" ] && { p=${p%/skills/*}; printf '%s' "${p##*/}"; return 0; }; done
    done <<EOF
$(src_dirs)
EOF
    return 0
}
omp_mcp_names() { # omp_mcp_names DIR : the MCP servers omp has there (its own, the folder's, the folder's Codex ones)
    local x
    for x in "$OMP_DIR/mcp.json" ${1:+"$1/.omp/mcp.json" "$1/.mcp.json" "$1/mcp.json" "$1/.claude/mcp.json" "$1/.claude/.mcp.json"}; do [ -f "$x" ] && json_keys "$x" mcpServers; done
    [ -n "$1" ] && [ -f "$1/.codex/config.toml" ] && [ "$1/.codex" != "$CODEX_DIR" ] && sed -n 's/^[[:space:]]*\[mcp_servers\.\([^].]*\)\][[:space:]]*$/\1/p' "$1/.codex/config.toml" | tr -d '"'
    return 0
}
cmd_used() { # kit used --pid PID [--tool claude|codex|omp] [--dir DIR] [--json] : the skills and MCP servers that conversation used
    local pid="" tool="" dir="" json="" log note k n c u pl turn=0 sk="" mc="" human="" mcps="" prog="" e
    local use="用法：kit used --pid <pid> [--tool claude|codex|omp] [--dir 資料夾] [--json]"
    while [ $# -gt 0 ]; do
        case $1 in
            --pid|--tool|--dir) [ $# -ge 2 ] || die_c usage "$use"
                case $1 in --pid) pid=$2;; --tool) tool=$2;; *) dir=$2;; esac; shift 2;;
            --json) json=1; shift;;
            *) die_c usage "$use";;
        esac
    done
    case $pid in ""|*[!0-9]*) die_c usage "$use";; esac
    agent_guess "$pid" "$tool" "$dir"; tool=$A_TOOL; dir=$A_DIR
    agent_log "$pid" "$tool" "$dir"; log=$A_LOG; note=$A_NOTE
    [ "$tool" != omp ] || mcps=$(omp_mcp_names "$dir")
    while IFS="$TAB" read -r k n c u; do
        case $k in
            turn) turn=${n:-0};;
            skill) pl=$(used_plugin "$n")
                e="{\"name\": $(json_s "$n"),$( [ -z "$pl" ] || printf ' "plugin": %s,' "$(json_s "$pl")") \"count\": $c, \"turn\": $u}"
                sk="$sk${sk:+, }$e"; human="${human}skill ${n}$( [ -z "$pl" ] || printf '（外掛 %s）' "$pl")  ${c} 次，第 ${u} 輪$LF";;
            mcp) mc="$mc${mc:+, }{\"name\": $(json_s "$n"), \"count\": $c, \"turn\": $u}"
                human="${human}MCP ${n}  ${c} 次，第 ${u} 輪$LF";;
        esac
    done <<EOF
$(USED_MCP=$mcps files_rows "$tool" "$log" used | cut -f 4- | LC_ALL=C awk -F '\t' "$USED_SUM")
EOF
    if [ -n "$json" ]; then
        printf '{"tool": %s, "log": %s, "dir": %s, "turn": %s, "skills": [%s], "mcp": [%s]%s}\n' "$(json_s "$tool")" "$(json_s "$log")" "$(json_s "$dir")" "$turn" "$sk" "$mc" \
            "$( [ -z "$note" ] || printf ', "note": %s' "$(json_s "$note")")" >&3
    else
        [ -z "$note" ] || warn "$note"
        if [ -n "$human" ]; then printf '%s' "$human"; else warn "這次對話還沒用到 skill 或 MCP"; fi
    fi
}

# ---------- commands ----------
need_init() { [ -f "$MACHINE" ] || die_c not_init "還沒設定：先打  kit init <網址或資料夾>"; }

cmd_init() {
    local KIT_INIT=1
    local s srcs="" more d args=()
    M_APPROVALS=""; M_SIGNERS=""
    while [ $# -gt 0 ]; do
        case $1 in
            --approvals) M_APPROVALS=${2:-}; shift 2 || die "--approvals 後面要接核准紀錄的 repo";;
            --signers)   M_SIGNERS=${2:-}; shift 2 || die "--signers 後面要接 allowed_signers 檔";;
            *) args+=("$1"); shift;;
        esac
    done
    [ ${#args[@]} -ge 1 ] || die "用法：kit init <網址或資料夾> [更多來源...] [--approvals <repo> --signers <檔>]"
    if [ -n "$M_APPROVALS$M_SIGNERS" ]; then
        [ -n "$M_APPROVALS" ] && [ -n "$M_SIGNERS" ] || die "--approvals 和 --signers 要一起給"
        M_SIGNERS=$(cd "$(dirname "$M_SIGNERS")" 2>/dev/null && printf '%s/%s' "$(pwd)" "$(basename "$M_SIGNERS")") || die "找不到 $M_SIGNERS"
        is_url "$M_APPROVALS" || M_APPROVALS=$(cd "$M_APPROVALS" && pwd) || die "找不到 $M_APPROVALS"
    fi
    set -- "${args[@]}"
    for s in "$@"; do
        has_creds "$s" && die "網址裡有帳號或 token（$(url_safe "$s")）：不要把密碼放進網址，先用 git clone 登入一次（Git 的認證管理會記住），再用不含帳號的網址"
        is_url "$s" || s=$(real_dir "$s") || die "找不到資料夾：$s"
        srcs="$srcs$s
"
    done
    write_machine "$srcs" "" ""
    while IFS= read -r s; do [ -z "$s" ] || fetch_source "$s"; done <<< "$(m_sources)"
    add_includes
    write_machine "$(m_sources)" "$(recommended_items)" ""
    say "kit：設定好 $(m_sources | wc -l | tr -d ' ') 個來源"
    apply_claude
    seen_all
    say "kit：完成。打  kit list  看有哪些"
}

seen_all() { for i in $(available); do state_set seen "$i" 1; done; }

wanted_version() { # the newest kit_version the sources ask for, when it is newer than this kit
    # x.y.z compared as numbers, "+build" ignored; a dev build (no VERSION) is never told
    src_dirs | while IFS= read -r d; do yget "$d/kit.yaml" kit_version; done | awk -v have="$KIT_VERSION" '
        function num(v,   p, n, i) {
            sub(/\+.*/, "", v); n = split(v, p, ".")
            if (n < 1 || n > 3) return ""
            for (i = 1; i <= n; i++) if (p[i] !~ /^[0-9]+$/) return ""
            return sprintf("%09d%09d%09d", p[1], p[2], p[3])
        }
        BEGIN { best = num(have); if (best == "") exit }
        { n = num($0); if (n != "" && n > best) { best = n; need = $0 } }
        END { if (need != "") print need }'
}
version_nag() { # tell once when a source's kit.yaml wants a newer kit (not in the background, not when quiet)
    [ -z "${QUIET:-}${NO_NAG:-}" ] || return 0
    local need
    need=$(wanted_version)
    if [ -z "$need" ]; then [ -z "$(state_get nag kit_version)" ] || state_del nag kit_version; return 0; fi
    [ "$(state_get nag kit_version)" = "$need $KIT_VERSION" ] && return 0
    say "kit：團隊要 kit ${need} 以上，你的是 ${KIT_VERSION}。請打  kit self-update"
    state_set nag kit_version "$need $KIT_VERSION"
}

includes() { # include: entries of every source; a local path is relative to the source that lists it
    local d i
    src_dirs | while IFS= read -r d; do
        yget "$d/kit.yaml" include | while IFS= read -r i; do
            [ -n "$i" ] || continue
            if is_url "$i"; then printf '%s\n' "$i"; continue; fi
            case $i in /*) ;; *) i="$d/$i";; esac
            real_dir "$i" || printf '%s\n' "$i"
        done
    done | awk 'NF && !seen[$0]++'
}
add_includes() { # add sources that a source includes but machine.yaml does not list yet (also chains)
    local more s n
    for n in 1 2 3 4 5; do
        # skip includes that are already a source (same URL, or the same folder as a clone)
        more=$(includes | while IFS= read -r s; do src_dirs | grep -qxF "$(src_dir "$s")" || printf '%s\n' "$s"; done | grep -vxF -f <(m_sources; echo '##none##'))
        [ -n "$more" ] || return 0
        write_machine "$(m_sources; printf '%s\n' "$more")" "$(m_added)" "$(m_removed)"
        while IFS= read -r s; do
            fetch_source "$s"
            [ -n "${KIT_INIT:-}" ] || say "kit：加了來源 ${s}（某個來源的 kit.yaml 引用它）"
        done <<EOF
$more
EOF
    done
}

plan_in() { skills_plan "$1" "$2" | while IFS="$TAB" read -r a n s _; do [ -z "$a" ] || printf '%s\t%s\t%s\t%s\n' "$1" "$a" "$n" "$s"; done; }   # plan_in DIR KIND : skills_plan's rows with DIR in front
plan_all() { # what kit sync will do with skills, everywhere it puts them: rows DIR<TAB>ACTION<TAB>NAME<TAB>SUM (skills_plan)
    local skills d agent tool kd
    while IFS= read -r d; do                                 # the folders' own first, as kit sync does
        [ -n "$d" ] && [ -d "$d" ] || continue
        agent=$(dir_mark "$d" agent); tool=$(dir_mark "$d" tool)
        if [ -n "$agent" ]; then placed_file "$d" >/dev/null; [ $? != 1 ] || continue; fi
        skills=$(dir_items "$d" | sed -n 's/^skill://p')
        plan_in "$d/.claude/skills" "$(dir_kind "$d" skill)" <<< "$skills"
        kd=$(dir_kind "$d" skill.agents)
        if has_codex || has_omp || [ "$tool" = codex ] || [ "$tool" = omp ] || [ -n "$(state_list "$kd")" ]; then plan_in "$d/.agents/skills" "$kd" <<< "$skills"; fi
    done <<EOF
$(dirs_registered)
EOF
    skills=$(wanted | sed -n 's/^skill://p')
    plan_in "$CLAUDE_DIR/skills" skill <<< "$skills"
    if has_codex || has_omp; then plan_in "$AGENTS_SKILLS" skill.agents <<< "$skills"; fi
}
plan_hash() { printf '%s\n' "$1" | cksum | awk '{ print $1 }'; }   # plan_hash ROWS : the number kit sync --expect checks

sync_dry_run() { # kit sync --dry-run [--force] : the sources brought up to date (as kit sync does), then what it would do with skills
    local rows a d n s shown=0 what
    rows=$(plan_all)
    say "kit sync$([ -z "${FORCE:-}" ] || printf ' --force') 會這樣改 skill（只看 skill；rule、MCP 等照常更新）："
    while IFS="$TAB" read -r d a n s; do
        case $a in
            add) what="新增";; update) what="更新";; replace) what="你改過的先備份，再換新的";; remove) what="拿掉";;
            drop) what="你改過的先備份，再拿掉";; keep) what="不再要了，但你改過：留著，之後歸你";;
            modified) what="你改過：跳過（--force 會先備份再換）";; foreign) what="不是 kit 放的（git 有記錄）：跳過";; missing) what="來源裡找不到：跳過";;
            takeover) what="不是 kit 放的：先備份，再換成 kit 的";;
            *) continue;;
        esac
        say "  $(here_short "$PWD" "$d")/${n}：${what}"; shown=1
    done <<EOF
$rows
EOF
    [ $shown = 1 ] || say "  （沒有要改的）"
    say "清單的雜湊：$(plan_hash "$rows")。要照這份做：kit sync$([ -z "${FORCE:-}" ] || printf ' --force') --expect $(plan_hash "$rows")（到時候清單變了就什麼都不改）"
}

cmd_sync() { # kit sync [--force] [--dry-run | --expect HASH]
    need_init
    local s dry=${1:-} expect=${2:-}
    while IFS= read -r s; do [ -z "$s" ] || fetch_source "$s"; done <<< "$(m_sources)"
    add_includes
    [ "$dry" = dry ] && { sync_dry_run; return 0; }
    if [ -n "$expect" ] && [ "$(plan_hash "$(plan_all)")" != "$expect" ]; then
        die_c plan-changed "skill 的清單跟 --dry-run 那時候不一樣了（來源更新了，或你改了某個 skill）：什麼都沒改。再打一次  kit sync$([ -z "${FORCE:-}" ] || printf ' --force') --dry-run  看新的清單"
    fi
    apply_dirs                                               # first: a folder that is gone leaves the list Codex's trust comes from
    apply_claude
    local new=""
    for i in $(available); do [ -n "$(state_get seen "$i")" ] || new="$new $i"; done
    [ -n "$new" ] && say "kit：新：$new  （要用就 kit add <種類> <名字>）"
    seen_all
    version_nag
}

json_s() { # a JSON string: \ " TAB LF CR escaped, other control characters dropped (the same as kit.ps1)
    local s=$1
    s=${s//\\/\\\\}; s=${s//\"/\\\"}
    s=${s//$TAB/\\t}; s=${s//$'\n'/\\n}; s=${s//$'\r'/\\r}
    case $s in *[$'\001'-$'\037']*) s=$(printf '%s' "$s" | LC_ALL=C tr -d '\000-\037');; esac
    printf '"%s"' "$s"
}
item_desc() { # item_desc KIND FILE : the description of a skill or agent (frontmatter), of an MCP yaml, or a rule's first "# " heading
    local l
    case $1 in
        rule) grep -m 1 '^# ' "$2" 2>/dev/null | sed 's/^# *//' | tr -d '\r';;
        skill|agent) fm_starts "$2" && { l=$(fm_val "$(fm_of "$2")" description); printf '%s\n' "${l%%"$LF"*}"; };;
        mcp) yget "$2" description 2>/dev/null | head -n 1;;
        plugin) unjs "$(json_get "$2" description | sed 's/^"//; s/"$//')";;
    esac
}
# Chinese descriptions for the panel (kit describe): descriptions-zh.txt in each source, one line per item:
# "<kind>:<name> TAB <hash of the description it translates> TAB <中文>". Only the panel reads them; agents keep reading
# the item's own description. A changed description makes its line stale (not shown) until it is translated again.
DESC_ZH=descriptions-zh.txt
desc_hash() { local h; h=$(printf '%s' "$1" | git hash-object --stdin 2>/dev/null); printf '%s\n' "${h:0:12}"; }   # the same as kit.ps1's Desc-Hash
has_cjk() { LC_ALL=C grep -q "$(printf '[\343-\351]')" <<< "$1"; }   # already Chinese (or Japanese): nothing to translate
desc_zh() { # desc_zh SOURCE_DIR KIND:NAME DESCRIPTION : its Chinese description, when written for this very description
    local l r
    [ -n "$3" ] && [ -f "$1/$DESC_ZH" ] || return 0
    while IFS= read -r l || [ -n "$l" ]; do case $l in "$2$TAB"*) break;; esac; l=""; done < "$1/$DESC_ZH"
    l=${l//$'\r'/}; r=${l#*"$TAB"}                           # r: HASH TAB 中文
    [ -n "$l" ] && [ "${r%%"$TAB"*}" = "$(desc_hash "$3")" ] && case $r in *"$TAB"*) printf '%s\n' "${r#*"$TAB"}";; esac
    return 0
}
cmd_describe() { # kit describe --todo | kit describe KIND NAME "<中文說明>"
    local i k n p d t orig f tmp
    if [ "${1:-}" = --todo ] && [ $# -eq 1 ]; then
        for i in $(available); do
            k=${i%%:*}; n=${i#*:}
            p=$(find_item "$k" "$n") || continue
            t=$(item_desc "$k" "$p"); [ -n "$t" ] && ! has_cjk "$t" || continue
            d=${p%"$(item_path "" "$k" "$n")"}
            [ -n "$(desc_zh "$d" "$i" "$t")" ] || printf '%s\t%s\n' "$i" "$(printf '%s' "$t" | tr '\t' ' ')"
        done
        return 0
    fi
    [ $# -eq 3 ] || die_c usage "用法：kit describe --todo（還沒有中文說明的，一行一個：種類:名字 TAB 原本的說明）；kit describe <種類> <名字> \"<中文說明>\""
    k=$1; n=$2
    case $k in rule|skill|mcp|agent|plugin) ;; *) die_c usage "種類要是 rule、skill、mcp、agent、plugin";; esac
    p=$(find_item "$k" "$n") || die "找不到 ${k}:${n}（kit 的來源裡沒有）"
    orig=$(item_desc "$k" "$p"); [ -n "$orig" ] || die "${k}:${n} 沒有說明可以翻"
    t=$(printf '%s' "$3" | tr '\t\r\n' '   ' | sed 's/^ *//; s/ *$//'); [ -n "$t" ] || die "中文說明是空的"
    d=${p%"$(item_path "" "$k" "$n")"}; f="$d/$DESC_ZH"; tmp="$f.kit-tmp"
    { [ -f "$f" ] && awk -F'\t' -v k="$k:$n" '$1 != k' "$f" | tr -d '\r'
      printf '%s\t%s\t%s\n' "$k:$n" "$(desc_hash "$orig")" "$t"; } | LC_ALL=C sort > "$tmp" && mv "$tmp" "$f" || { rm -f "$tmp"; die "寫不進 $f"; }
    say "已寫好 ${k}:${n} 的中文說明（${f}；只給面板看，agent 還是讀原本的說明）。要給別台用：kit push --to $(basename "$d")"
}
json_keys() { # json_keys FILE PATH : the keys of the object at PATH (keys joined by TAB), one per line
    LC_ALL=C awk -f "$KIT_LIB/json.awk" -v keys="$2" -v sep="$TAB" "$1" 2>/dev/null
}
here_short() { # a path as the panel shows it: inside DIR relative to it, else with ~ for the home folder
    case $2 in
        "$1"/*) printf '%s' "${2#"$1"/}";;
        "$HOME"/*) printf '~/%s' "${2#"$HOME"/}";;
        *) printf '%s' "$2";;
    esac
}
kit_only() { # kit_only FILE : FILE has nothing but kit's block (kit made it for a folder's own)
    [ -z "$(awk -v b="$BEGIN_MARK" -v e="$END_MARK" '{ sub(/\r$/, "") } $0 == b { s = 1 } !s && NF { print; exit } $0 == e { s = 0 }' "$1")" ]
}
omp_levels() { # omp_levels DIR : the folders omp looks in for a folder's AGENTS.md / CLAUDE.md, DIR first (omp's own rule:
    # up to the git root; under the home folder on up to it, the home folder itself only when there is no git root; outside
    # the home folder with no git root, up to /)
    local a=$1 git="" under="" list=""
    case $1/ in "$HOME"/*) under=1;; esac
    while :; do
        if [ -n "$under" ] && [ "$a" = "$HOME" ]; then [ -n "$git" ] || list="$list$a$LF"; break; fi
        list="$list$a$LF"
        [ -e "$a/.git" ] && { git=1; [ -n "$under" ] || break; }
        [ "$a" = / ] && break
        a=$(dirname "$a")
    done
    printf '%s' "$list"
}
omp_nat() { # omp_nat DIR : the nearest folder (from DIR up) whose .omp has something in it: omp reads .omp/AGENTS.md and
    # .omp/RULES.md only there (kit's own .omp/hooks counts too)
    local d
    while IFS= read -r d; do
        [ -n "$d" ] && [ "$d/.omp" != "$HOME/.omp" ] && [ -n "$(ls -A "$d/.omp" 2>/dev/null)" ] && { printf '%s\n' "$d"; return 0; }
    done <<EOF
$(omp_levels "$1")
EOF
    return 1
}
omp_pick() { # omp_pick FOLDER DIR NAT : the one file omp reads at FOLDER's level (omp keeps one per level: the first that
    # is there and not empty of .omp/AGENTS.md (NAT only), .claude/CLAUDE.md (DIR only), .agents/AGENTS.md, AGENTS.md, CLAUDE.md)
    local f
    for f in "$( [ "$1" = "$3" ] && printf '%s' "$1/.omp/AGENTS.md")" "$( [ "$1" = "$2" ] && printf '%s' "$1/.claude/CLAUDE.md")" \
             "$1/.agents/AGENTS.md" "$1/AGENTS.md" "$1/CLAUDE.md"; do
        [ -n "$f" ] && [ -s "$f" ] && { printf '%s\n' "$f"; return 0; }
    done
    return 1
}
toml_mcp_names() { # toml_mcp_names FILE : the [mcp_servers.x] names in a Codex config.toml outside kit's block
    awk -v b="$TOML_BEGIN" -v e="$TOML_END" '{ sub(/\r$/, "") } $0 == b { s = 1 } $0 == e { s = 0; next } s { next }
        /^[ \t]*\[mcp_servers\.[^].]*\][ \t]*$/ { n = $0; sub(/^[ \t]*\[mcp_servers\./, "", n); sub(/\][ \t]*$/, "", n); gsub(/"/, "", n); print n }' "$1" 2>/dev/null
}
here_rows() { # here_rows DIR : what an agent started in DIR gets that kit does not manage
    # lines: scope<TAB>kind<TAB>name<TAB>path<TAB>tools   (scope dir = DIR and the folders above it, user = this account)
    # (the folder's own that kit put there, kit add --dir, are not listed: the panel shows them as kit's)
    # tools: the agents that read it. omp: only the one file it keeps for each folder level (omp_pick), its skills and
    # .omp files only in the folders it looks in (omp_levels, omp_nat)
    local dir=$1 a f n mine root lev nat ow om LC_ALL=C
    root=$(dir_root "$dir" 2>/dev/null); mine=$(dir_items "$root")
    lev=$(omp_levels "$dir"); nat=$(omp_nat "$dir")
    a=$dir
    while :; do
        ow=""; om=""; printf '%s\n' "$lev" | grep -qxF "$a" && { om=" omp"; ow=$(omp_pick "$a" "$dir" "$nat"); }
        for f in "$a/CLAUDE.md" "$a/CLAUDE.local.md" "$a/.claude/CLAUDE.md"; do
            [ -f "$f" ] && [ "$f" != "$CLAUDE_DIR/CLAUDE.md" ] && ! kit_only "$f" && printf 'dir\trule\t%s\t%s\tclaude%s\n' "$(here_short "$dir" "$f")" "$f" "$( [ "$f" = "$ow" ] && echo " omp")"
        done
        if [ "$a/.claude" != "$CLAUDE_DIR" ]; then
            for f in "$a"/.claude/rules/*.md; do [ -f "$f" ] && printf 'dir\trule\t%s\t%s\tclaude\n' "$(here_short "$dir" "$f")" "$f"; done
            for f in "$a"/.claude/skills/*/SKILL.md; do
                [ -f "$f" ] || continue; n=$(basename "$(dirname "$f")")
                [ "$a" = "$root" ] && printf '%s\n' "$mine" | grep -qxF "skill:$n" && continue
                printf 'dir\tskill\t%s\t%s\tclaude%s\n' "$n" "$f" "$om"
            done
        fi
        [ -f "$a/AGENTS.md" ] && ! kit_only "$a/AGENTS.md" && printf 'dir\trule\t%s\t%s\tcodex%s\n' "$(here_short "$dir" "$a/AGENTS.md")" "$a/AGENTS.md" "$( [ "$a/AGENTS.md" = "$ow" ] && echo " omp")"
        if [ "$a/.agents/skills" != "$AGENTS_SKILLS" ]; then
            [ "$a/.agents/AGENTS.md" = "$ow" ] && printf 'dir\trule\t%s\t%s\tomp\n' "$(here_short "$dir" "$ow")" "$ow"
            for f in "$a"/.agents/skills/*/SKILL.md; do
                [ -f "$f" ] || continue; n=$(basename "$(dirname "$f")")
                [ "$a" = "$root" ] && printf '%s\n' "$mine" | grep -qxF "skill:$n" && continue
                printf 'dir\tskill\t%s\t%s\tcodex%s\n' "$n" "$f" "$om"
            done
        fi
        if [ -n "$nat" ] && [ "$a" = "$nat" ]; then
            [ "$a/.omp/AGENTS.md" = "$ow" ] && printf 'dir\trule\t%s\t%s\tomp\n' "$(here_short "$dir" "$ow")" "$ow"
            [ -s "$a/.omp/RULES.md" ] && printf 'dir\trule\t%s\t%s\tomp\n' "$(here_short "$dir" "$a/.omp/RULES.md")" "$a/.omp/RULES.md"
            for f in "$a"/.omp/skills/*/SKILL.md; do [ -f "$f" ] && printf 'dir\tskill\t%s\t%s\tomp\n' "$(basename "$(dirname "$f")")" "$f"; done
        fi
        [ "$a" = / ] && break
        a=$(dirname "$a")
    done
    for f in "$dir/.mcp.json" "$dir/mcp.json" "$dir/.omp/mcp.json" "$dir/.claude/mcp.json" "$dir/.claude/.mcp.json"; do
        [ -f "$f" ] && [ "$f" != "$OMP_DIR/mcp.json" ] || continue
        json_keys "$f" mcpServers | while IFS= read -r n; do
            [ "$f" = "$dir/.mcp.json" ] && [ "$dir" = "$root" ] && printf '%s\n' "$mine" | grep -qxF "mcp:$n" && continue
            printf 'dir\tmcp\t%s\t%s\t%s\n' "$n" "$f" "$( [ "$f" = "$dir/.mcp.json" ] && echo "claude omp" || echo omp)"; done
    done
    [ -f "$dir/.codex/config.toml" ] && [ "$dir/.codex" != "$CODEX_DIR" ] && toml_mcp_names "$dir/.codex/config.toml" | while IFS= read -r n; do
        printf 'dir\tmcp\t%s\t%s\tcodex omp\n' "$n" "$dir/.codex/config.toml"; done
    [ -f "$CLAUDE_JSON" ] && json_keys "$CLAUDE_JSON" "projects$TAB$dir${TAB}mcpServers" | while IFS= read -r n; do
        printf 'dir\tmcp\t%s\t%s\tclaude\n' "$n" "$CLAUDE_JSON"; done
    for f in "$CLAUDE_DIR"/skills/*/SKILL.md; do
        [ -f "$f" ] || continue; n=$(basename "$(dirname "$f")")
        [ -n "$(state_get skill "$n")" ] || printf 'user\tskill\t%s\t%s\tclaude\n' "$n" "$f"
    done
    [ -f "$CLAUDE_JSON" ] && json_keys "$CLAUDE_JSON" mcpServers | while IFS= read -r n; do
        [ -n "$(state_get mcp "$n")" ] || printf 'user\tmcp\t%s\t%s\tclaude\n' "$n" "$CLAUDE_JSON"; done
    for f in "$AGENTS_SKILLS"/*/SKILL.md; do
        [ -f "$f" ] || continue; n=$(basename "$(dirname "$f")")
        [ -n "$(state_get skill "$n")" ] || printf 'user\tskill\t%s\t%s\tcodex omp\n' "$n" "$f"
    done
    for f in "$OMP_DIR"/skills/*/SKILL.md; do [ -f "$f" ] && printf 'user\tskill\t%s\t%s\tomp\n' "$(basename "$(dirname "$f")")" "$f"; done
    [ -s "$OMP_DIR/RULES.md" ] && printf 'user\trule\t%s\t%s\tomp\n' "$(here_short "$dir" "$OMP_DIR/RULES.md")" "$OMP_DIR/RULES.md"
    [ -f "$OMP_DIR/mcp.json" ] && json_keys "$OMP_DIR/mcp.json" mcpServers | while IFS= read -r n; do
        [ -n "$(state_get mcp.omp "$n")" ] || printf 'user\tmcp\t%s\t%s\tomp\n' "$n" "$OMP_DIR/mcp.json"; done
    return 0
}
other_user() { # other_user PID : the user of a process under PID that is not me (an agent started with sudo -i), if any
    local me; me=$(id -un 2>/dev/null) || return 0
    # (ps itself may run as root on macOS: not counted)
    { ps -A -o user= -o pid= -o ppid= -o comm= 2>/dev/null || ps -o user,pid,ppid,comm 2>/dev/null; } | awk -v top="$1" -v me="$me" '
        $2 ~ /^[0-9]+$/ && $4 !~ /(^|\/)ps$/ { u[$2] = $1; p[$2] = $3 }
        END { for (x in p) { y = x; for (i = 0; i < 64 && y != top && (y in p); i++) y = p[y]
                             if (y == top && x != top && u[x] != me) { print u[x]; exit } } }'
}
pid_tree() { # pid_tree PID : PID and every process under it
    { ps -A -o pid= -o ppid= 2>/dev/null || ps -o pid,ppid 2>/dev/null; } | awk -v top="$1" '
        $1 ~ /^[0-9]+$/ { p[$1] = $2 }
        END { print top; for (x in p) { y = x; for (i = 0; i < 64 && y != top && (y in p); i++) y = p[y]
                                        if (y == top && x != top) print x } }'
}
run_agent() { # run_agent PID : the agent that kit run started at or under PID (kit run leaves a marker), if any
    local d="$KIT_CONF/run" f p tree found=""
    [ -d "$d" ] || return 0
    tree=$(pid_tree "$1")
    for f in "$d"/*; do
        [ -f "$f" ] || continue
        p=${f##*/}
        case $p in *[!0-9]*) continue;; esac
        ps -p "$p" >/dev/null 2>&1 || { rm -f "$f"; continue; }       # that kit run has ended
        [ -z "$found" ] && printf '%s\n' "$tree" | grep -qxF "$p" && found=$f
    done
    [ -z "$found" ] || head -n 1 "$found"
    return 0
}
agent_json() { # agent_json NAME : {"name", "source", "rules", "skills", "mcp"} of a kit agent
    local f fm="" src=""
    f=$(find_item agent "$1") && { fm=$(fm_of "$f"); src=$(basename "${f%/agents/*}"); }
    printf '{"name": %s, "source": %s, "rules": %s, "skills": %s, "mcp": %s}' "$(json_s "$1")" "$(json_s "$src")" \
        "$(fm_val "$fm" rules | json_arr)" "$(fm_val "$fm" skills | json_arr)" "$(fm_val "$fm" mcp | json_arr)"
}
here_json() { # here_json DIR PID : the "here" part of kit list --json --dir
    local dir=$1 user="" agent="" first=1 sc k n f t d
    [ -n "$2" ] && { user=$(other_user "$2"); agent=$(run_agent "$2"); }
    printf ',\n  "here": {"dir": %s, "user": %s, "agent": %s' "$(json_s "$dir")" "$( [ -n "$user" ] && json_s "$user" || echo null)" \
        "$( [ -n "$agent" ] && agent_json "$agent" || echo null)"
    if [ -n "$user" ]; then printf ', "items": []}'; return; fi
    if [ ! -d "$dir" ]; then printf ', "error": %s, "items": []}' "$(json_s "找不到這個資料夾")"; return; fi
    local froot; froot=$(dir_root "$dir")
    local fa; fa=$(dir_mark "$froot" agent)
    local fp="" pn; for pn in $(dir_items "$froot" | sed -n 's/^plugin://p'); do   # which tools have each folder plugin
        fp="$fp${fp:+, }{\"name\": $(json_s "$pn"), \"tools\": $(for t in claude omp; do [ -z "$(state_get "$(dir_kind "$froot" "plugin.$t")" "$pn")" ] || echo $t; done | json_arr), \"note\": $(json_s "Codex 只能整個帳號裝")}"
    done
    printf ', "folder": {"dir": %s, "why": %s, "items": %s, "agent": %s, "plugins": [%s]}' "$(json_s "$froot")" "$(json_s "$(dir_why_not "$froot")")" "$(dir_items "$froot" | json_arr)" \
        "$( [ -n "$fa" ] && json_s "$fa" || echo null)" "$fp"
    printf ', "items": ['
    while IFS="$TAB" read -r sc k n f t; do
        [ -n "$k" ] || continue
        d=""
        case $k in
            skill|rule) d=$(item_desc "$k" "$f");;
        esac
        [ $first = 1 ] || printf ','; first=0
        printf '\n    {"scope": %s, "kind": %s, "name": %s, "path": %s, "tools": %s, "description": %s}' \
            "$(json_s "$sc")" "$(json_s "$k")" "$(json_s "$n")" "$(json_s "$f")" "$(json_s "$t")" "$(json_s "$d")"
    done <<EOF
$(here_rows "$dir")
EOF
    printf '\n  ]}'
}
# ---------- versions (kit list --json: version, upstream, installed, loaded) ----------
# An item's version id: the first 8 hex digits of a git blob hash, so the same content has the same id on every machine
# and in every source. A rule, MCP or agent: the file's own blob. A skill or plugin: the blob of its listing, one line
# "<the file's blob> <its path in the item's folder>" per file, sorted bytewise by path, without .DS_Store and Python's
# caches. kit.ps1 does the same.
VER_DIRS="rules skills mcp agents plugins"
VER_KEY='
function key(p,   a, n) { # K: kind:name, REL: the path in its folder ("" for a one-file item); 0: not part of an item
    n = split(p, a, "/"); REL = ""
    if (n == 2 && a[1] == "rules" && a[2] ~ /\.md$/) K = "rule:" substr(a[2], 1, length(a[2]) - 3)
    else if (n == 2 && a[1] == "agents" && a[2] ~ /\.md$/) K = "agent:" substr(a[2], 1, length(a[2]) - 3)
    else if (n == 2 && a[1] == "mcp" && a[2] ~ /\.yaml$/) K = "mcp:" substr(a[2], 1, length(a[2]) - 5)
    else if (n >= 3 && (a[1] == "skills" || a[1] == "plugins")) { K = (a[1] == "skills" ? "skill:" : "plugin:") a[2]; REL = substr(p, length(a[1]) + length(a[2]) + 3) }
    else return 0
    return REL !~ /(^|\/)\.DS_Store$/ && REL !~ /(^|\/)__pycache__\// && REL !~ /\.py[co]$/
}'
ver_scan() { # ver_scan DIR : a line per item of the source DIR: DIR TAB kind:name TAB id TAB wtid TAB date TAB n TAB commit TAB dirty TAB message
    # id: the latest version: the remote branch as kit sync last fetched it (HEAD when the clone is ahead of it or has
    # none), or, when the item has changes not committed (dirty), the working tree's. wtid: the working tree's (what kit
    # sync copies, and what Claude's @import reads). date, n, commit, message: the last commit that changed the item
    # (n: how many changed it that day). Not a git repo: both ids from the files, no commit. One git pass per source.
    local d=$1 t ref="" g="" dp
    t=$(mktemp -d "${TMPDIR:-/tmp}/kit-ver.XXXXXX") || return 0
    if git -C "$d" rev-parse -q --verify HEAD >/dev/null 2>&1; then
        g=1
        ref=$(git -C "$d" rev-parse -q --verify '@{upstream}' 2>/dev/null) && git -C "$d" merge-base --is-ancestor HEAD "$ref" 2>/dev/null || ref=HEAD
        { git -C "$d" -c core.quotePath=false ls-tree -r "$ref" -- $VER_DIRS | awk -F'\t' '{ split($1, a, " "); print "R\t" a[3] "\t" $2 }'
          git -C "$d" -c core.quotePath=false ls-files -s -- $VER_DIRS | awk -F'\t' '{ split($1, a, " "); print "I\t" a[2] "\t" $2 }'
        } > "$t/rows"
        { git -C "$d" -c core.quotePath=false diff --name-only --relative HEAD -- $VER_DIRS
          git -C "$d" -c core.quotePath=false ls-files -o --exclude-standard -- $VER_DIRS; } | awk "$VER_KEY"' key($0) { print K }' | sort -u > "$t/dirty"
        # the working tree of the changed items: their folders (a rule: its file) as git sees them
        dp=$(awk -F: '{ print ($1 == "rule" ? "rules/" $2 ".md" : $1 == "agent" ? "agents/" $2 ".md" : $1 == "mcp" ? "mcp/" $2 ".yaml" : $1 "s/" $2) }' "$t/dirty")
        [ -z "$dp" ] || git -C "$d" -c core.quotePath=false ls-files -co --exclude-standard -- $dp | awk '!seen[$0]++' > "$t/wt"
        git -C "$d" log --format='%x01%H%x09%cd%x09%s' --date=short --name-only --relative "$ref" -- $VER_DIRS > "$t/log" 2>/dev/null
    else
        : > "$t/dirty"; : > "$t/log"
        ( cd "$d" 2>/dev/null && find $VER_DIRS -type f 2>/dev/null | LC_ALL=C sort ) > "$t/wt"
    fi
    if [ -s "$t/wt" ]; then
        while IFS= read -r dp; do [ -f "$d/$dp" ] && printf '%s\n' "$dp"; done < "$t/wt" > "$t/wt2"
        ( cd "$d" && git hash-object --stdin-paths < "$t/wt2" ) 2>/dev/null | paste - "$t/wt2" | awk -F'\t' '{ print "W\t" $1 "\t" $2 }' >> "$t/rows"
    fi
    # a listing per skill or plugin (each a file, hashed with one git call); a one-file item's id is its blob's
    LC_ALL=C awk -F'\t' -v t="$t" "$VER_KEY"'
        key($3) { if (REL == "") print "O\t" $1 "\t" K "\t" substr($2, 1, 8); else { if (!(($1, K) in l)) o[++n] = $1 SUBSEP K; l[$1, K] = l[$1, K] $2 " " REL "\n" } }
        END { for (i = 1; i <= n; i++) { split(o[i], a, SUBSEP); f = t "/l" i; printf "%s", l[o[i]] > f; close(f); print "H\t" a[1] "\t" a[2] "\t" f } }' "$t/rows" > "$t/ids"
    awk -F'\t' '$1 == "H" { print $4 }' "$t/ids" | git hash-object --no-filters --stdin-paths > "$t/h" 2>/dev/null
    LC_ALL=C awk -F'\t' -v src="$d" -v g="$g" -v hf="$t/h" -v df="$t/dirty" -v lf="$t/log" "$VER_KEY"'
        BEGIN { while ((getline x < df) > 0) dt[x] = 1
                while ((getline x < lf) > 0) {
                    if (substr(x, 1, 1) == "\001") { split(substr(x, 2), c, "\t"); cm = c[1]; cd = c[2]; ms = substr(x, length(cm) + length(cd) + 4); continue }
                    if (x == "" || !key(x) || seen[K] == cm) continue
                    seen[K] = cm
                    if (!(K in lc)) { lc[K] = cm; ld[K] = cd; lm[K] = ms; ln[K] = 1 } else if (cd == ld[K]) ln[K]++
                } }
        $1 == "H" { getline x < hf; $4 = substr(x, 1, 8) }
        { id[$2, $3] = $4; ks[$3] = 1 }
        END { for (k in ks) {
                  if (!g) { v = id["W", k]; w = v; d = 0 }
                  else { d = (k in dt); v = d ? id["W", k] : id["R", k]; w = d ? id["W", k] : id["I", k] }
                  print src "\t" k "\t" v "\t" w "\t" ld[k] "\t" (ln[k] + 0) "\t" (d ? "" : lc[k]) "\t" (d ? "true" : "false") "\t" lm[k] } }' "$t/ids"
    rm -rf "$t"
}
ver_all() { # a line per item, as ver_scan, of the source kit takes it from (the first that has it)
    local d; while IFS= read -r d; do [ -n "$d" ] && ver_scan "$d"; done <<EOF | awk -F'\t' '!seen[$2]++'
${SRC_DIRS_LIST:-$(src_dirs)}
EOF
}
mtimes() { # mtimes FILE... : "FILE TAB seconds since 1970" of each (its last change)
    [ $# -gt 0 ] || return 0
    if stat -c %Y / >/dev/null 2>&1; then stat -c '%Y %n' "$@"; else stat -f '%m %N' "$@"; fi 2>/dev/null | awk '{ t = $1; sub(/^[^ ]* /, ""); print $0 "\t" t }'
}
proc_epoch() { # proc_epoch PID : when the process started (seconds since 1970), or nothing
    local s; s=$(LC_ALL=C ps -o lstart= -p "$1" 2>/dev/null | tr -s ' ' | sed 's/^ //; s/ $//')
    [ -n "$s" ] || return 0
    LC_ALL=C date -d "$s" +%s 2>/dev/null || LC_ALL=C date -j -f '%a %b %d %T %Y' "$s" +%s 2>/dev/null
    return 0
}
# state.tsv "ver" lines (a folder's own: "dir:<folder>:ver"): for each item a tool has from kit, "<tool>:<kind>:<name>"
# and "<id> <at> <mark>": its version id and since when (seconds since 1970) this machine has it. mark: kit's own hash of
# what it put there for skills and plugins (a copy kit skipped keeps its version), "=" for rules (Codex, omp) and MCP,
# which every sync writes again from the source. Claude's rules are not kept: Claude reads the source's file itself
# (installed: that file's version and time). The first sync that keeps them (kit 0.9.0) takes the time from the file
# kit wrote it to, as the time it last changed.
ver_targets() { # what each tool has from kit: "verkind TAB tool:kind:name TAB mark TAB file" (verkind: ver or dir:<folder>:ver)
    local cx="" om="" n d k w
    has_codex && cx=1; has_omp && om=1; w=$(wanted)
    [ -f "$STATE" ] && awk -F'\t' -v cx="$cx" -v om="$om" -v cd="$CLAUDE_DIR" -v as="$AGENTS_SKILLS" -v cj="$CLAUDE_JSON" -v od="$OMP_DIR" -v pr="$(plugin_root)" '
        function out(t, k, m, p) { print v "\t" t ":" k ":" $2 "\t" m "\t" p }
        { k = $1; s = ""; if (k ~ /^dir:/) { s = substr(k, 5); i = match(s, /:[^:]*$/); k = substr(s, i + 1); s = substr(s, 1, i - 1) }
          v = s == "" ? "ver" : "dir:" s ":ver" }
        k == "skill" { out("claude", "skill", $3, (s == "" ? cd "/skills" : s "/.claude/skills") "/" $2) }
        k == "skill.agents" { p = (s == "" ? as : s "/.agents/skills") "/" $2; if (cx) out("codex", "skill", $3, p); if (om) out("omp", "skill", $3, p) }
        k == "mcp" { out("claude", "mcp", "=", s == "" ? cj : s "/.mcp.json"); if (s != "" && om) out("omp", "mcp", "=", s "/.mcp.json") }
        k == "mcp.omp" && s == "" { out("omp", "mcp", "=", od "/mcp.json") }
        k ~ /^plugin\.(claude|codex|omp)$/ { out(substr(k, 8), "plugin", $3, pr "/" $2) }' "$STATE"
    for n in $(printf '%s\n' "$w" | sed -n 's/^rule://p'); do
        [ -z "$cx" ] || printf 'ver\tcodex:rule:%s\t=\t%s\n' "$n" "$CODEX_DIR/AGENTS.md"
        [ -z "$om" ] || printf 'ver\tomp:rule:%s\t=\t%s\n' "$n" "$OMP_DIR/AGENTS.md"
    done
    [ -z "$cx" ] || for n in $(printf '%s\n' "$w" | sed -n 's/^mcp://p'); do printf 'ver\tcodex:mcp:%s\t=\t%s\n' "$n" "$CODEX_DIR/config.toml"; done
    while IFS= read -r d; do                                 # a folder's rules (Codex, omp) and Codex MCP: in kit's blocks
        [ -n "$d" ] && [ -d "$d" ] || continue
        for k in $(dir_items "$d"); do
            n=${k#*:}
            case $k in
                rule:*) grep -qF -- "$BEGIN_MARK" "$d/AGENTS.md" 2>/dev/null || continue
                    [ -z "$cx" ] || printf 'dir:%s:ver\tcodex:rule:%s\t=\t%s\n' "$d" "$n" "$d/AGENTS.md"
                    [ -z "$om" ] || printf 'dir:%s:ver\tomp:rule:%s\t=\t%s\n' "$d" "$n" "$d/AGENTS.md";;
                mcp:*) grep -qF -- "$TOML_BEGIN" "$d/.codex/config.toml" 2>/dev/null && printf 'dir:%s:ver\tcodex:mcp:%s\t=\t%s\n' "$d" "$n" "$d/.codex/config.toml";;
            esac
        done
    done <<EOF
$(dirs_registered)
EOF
    return 0
}
ver_record() { # ver_record : after kit wrote the tools' files, the "ver" lines of state.tsv for what each tool has now
    local t first="" rows
    [ -f "$STATE" ] || return 0
    t=$(mktemp -d "${TMPDIR:-/tmp}/kit-verrec.XXXXXX") || return 0
    awk -F'\t' '$1 == "ver" || $1 ~ /^dir:.*:ver$/ { print $1 "\t" $2 "\t" $3 }' "$STATE" > "$t/old"
    [ -s "$t/old" ] || first=1
    ver_targets > "$t/rows"
    ver_all | cut -f 2,4 > "$t/map"
    if [ -n "$first" ]; then rows=$(cut -f 4 "$t/rows" | awk '!seen[$0]++'); ( IFS=$LF; mtimes $rows ) > "$t/mt"; else : > "$t/mt"; fi
    LC_ALL=C awk -F'\t' -v now="$(date +%s)" -v first="$first" -v mf="$t/mt" -v of="$t/old" -v vf="$t/map" '
        BEGIN { while ((getline x < mf) > 0) { split(x, a, "\t"); mt[a[1]] = a[2] }
                while ((getline x < of) > 0) { split(x, a, "\t"); old[a[1], a[2]] = a[3] }
                while ((getline x < vf) > 0) { split(x, a, "\t"); w[a[1]] = a[2] } }
        !(($1, $2) in done) {
            done[$1, $2] = 1; k = substr($2, index($2, ":") + 1); if (w[k] == "") next
            if (($1, $2) in old) { split(old[$1, $2], o, " ")
                if (($3 == "=" && o[1] == w[k]) || ($3 != "=" && o[3] == $3)) { print $1 "\t" $2 "\t" old[$1, $2]; next } }
            print $1 "\t" $2 "\t" w[k] " " (first && mt[$4] != "" ? mt[$4] : now) " " $3 }' "$t/rows" > "$t/new"
    rows=$(mktemp "$STATE.XXXXXX") || die "沒辦法寫 $STATE"
    { awk -F'\t' '!($1 == "ver" || $1 ~ /^dir:.*:ver$/)' "$STATE"; cat "$t/new"; } > "$rows" && mv -f "$rows" "$STATE"
    rm -rf "$t"
}
used_first() { # used_first TOOL LOG : "skill TAB seconds since 1970" of the first time that conversation read each skill
    # (Codex and omp log no time for it: the start of its turn)
    files_rows "$1" "$2" used | LC_ALL=C awk -F'\t' '
        function ep(x,   y, m, d, era, yoe, doe) {
            gsub(/[^0-9]/, "", x); if (length(x) < 14 || x ~ /^0+$/) return ""
            y = substr(x, 1, 4) + 0; m = substr(x, 5, 2) + 0; d = substr(x, 7, 2) + 0
            y -= (m <= 2); era = int(y / 400); yoe = y - era * 400                    # (days from 1970-01-01: H. Hinnant)
            doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + int((153 * (m > 2 ? m - 3 : m + 9) + 2) / 5) + d - 1
            return (era * 146097 + doe - 719468) * 86400 + substr(x, 9, 2) * 3600 + substr(x, 11, 2) * 60 + substr(x, 13, 2)
        }
        $5 == "turn" { ta = ep($6); next }
        $5 == "skill" { e = ep($1); if (e == "") e = ta; if (e != "" && (!($6 in f) || e < f[$6])) f[$6] = e }
        END { for (n in f) print n "\t" f[n] }'
}
ver_list_prep() { # (cmd_list_json's, before its loop over ALL) the ', "version" …' part of every item, all worked out by one
    # awk (bash looking things up in long strings is slow): "kind:name TAB part" lines, in the order of the items of ALL
    # a source has, read on fd 5 by ver_item_json. With --pid also "loaded" (L: that agent's tool, start, skill uses).
    local d n i k rel t froot="" lt="" ls="" nouse=""
    t=$(mktemp -d "${TMPDIR:-/tmp}/kit-verl.XXXXXX") || return 0
    ver_all > "$t/ver"
    : > "$t/fitems"; : > "$t/inst"; : > "$t/use"
    [ -n "${HERE_DIR:-}" ] && [ -d "$HERE_DIR" ] && froot=$(dir_root "$HERE_DIR") && dir_items "$froot" > "$t/fitems"
    [ -f "$STATE" ] && awk -F'\t' -v f="dir:$froot:ver" '$1 == "ver" { print "A" $2 "\t" $3 } $1 == f { print "F" $2 "\t" $3 }' "$STATE" > "$t/inst"
    while IFS= read -r d; do
        [ -f "$d/third_party.lock" ] && awk -F'\t' -v d="$d" '{ sub(/\r$/, "") } !/^#/ && NF { print d "\t" $1 "\t" $5 "\t" $7 "\t" $9 }' "$d/third_party.lock"
    done <<< "$SRC_DIRS_LIST" > "$t/locks"
    for i in $ALL; do                                        # each one's source, as find_item finds it (no program run)
        k=${i%%:*}; n=${i#*:}
        case $k in rule) rel=/rules/$n.md;; skill) rel=/skills/$n/SKILL.md;; mcp) rel=/mcp/$n.yaml;; agent) rel=/agents/$n.md;;
                   plugin) rel=/plugins/$n/.claude-plugin/plugin.json;; *) continue;; esac
        while IFS= read -r d; do [ -f "$d$rel" ] && { printf '%s\t%s\t%s\n' "$i" "$d" "$d$rel"; break; }; done <<< "$SRC_DIRS_LIST"
    done > "$t/items"
    ( IFS=$LF; mtimes $(awk -F'\t' 'index($1, "rule:") == 1 { print $3 }' "$t/items") ) > "$t/mt"   # Claude reads the rule's file itself
    printf '%s\n' "$want" > "$t/want"
    if [ -n "${HERE_PID:-}" ]; then
        agent_guess "$HERE_PID" "${HERE_TOOL:-}" "${HERE_DIR:-}"
        case $A_TOOL in claude|codex|omp)
            lt=$A_TOOL; ls=$(proc_epoch "$HERE_PID")
            # the conversation's log (can be big) only when a skill changed after the agent started
            if awk -F'\t' -v p="A$lt:skill:" -v q="F$lt:skill:" -v s="$ls" '
                   index($1, p) == 1 || index($1, q) == 1 { split($2, r, " "); if (s == "" || r[2] + 0 > s + 0) f = 1 } END { exit !f }' "$t/inst"; then
                agent_log "$HERE_PID" "$lt" "$A_DIR"
                if [ -n "$A_LOG" ]; then used_first "$lt" "$A_LOG" > "$t/use"; else nouse=1; fi
            fi;;
        esac
    fi
    LC_ALL=C awk -F'\t' -v t="$t" -v pid="${HERE_PID:-}" -v lt="$lt" -v ls="$ls" -v nouse="$nouse" '
        function js(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); gsub(/\t/, "\\t", s); gsub(/\r/, "\\r", s); gsub(/[\001-\037]/, "", s); return "\"" s "\"" }
        function jn(s) { return s == "" || s == "-" ? "null" : js(s) }
        BEGIN { while ((getline x < (t "/ver")) > 0) { split(x, a, "\t"); ver[a[1], a[2]] = x }
                while ((getline x < (t "/inst")) > 0) { split(x, a, "\t"); inst[a[1]] = a[2] }
                while ((getline x < (t "/locks")) > 0) { split(x, a, "\t"); lk[a[1], a[2]] = a[3] "\t" a[4] "\t" a[5] }
                while ((getline x < (t "/mt")) > 0) { split(x, a, "\t"); mt[a[1]] = a[2] }
                while ((getline x < (t "/use")) > 0) { split(x, a, "\t"); use[a[1]] = a[2] }
                while ((getline x < (t "/want")) > 0) want[x] = 1
                while ((getline x < (t "/fitems")) > 0) fit[x] = 1
                tl[1] = "claude"; tl[2] = "codex"; tl[3] = "omp" }
        {   i = $1; d = $2; p = $3; k = substr(i, 1, index(i, ":") - 1); n = substr(i, index(i, ":") + 1)
            vid = vw = vdate = vn = vcm = vmsg = ""; vdirty = "false"
            if ((d, i) in ver) { m = split(ver[d, i], a, "\t"); vid = a[3]; vw = a[4]; vdate = a[5]; vn = a[6]; vcm = a[7]; vdirty = a[8]
                                 vmsg = a[9]; for (j = 10; j <= m; j++) vmsg = vmsg "\t" a[j] }
            o = ", \"version\": {\"id\": " jn(vid) ", \"date\": " jn(vdate) ", \"n\": " (vdate == "" ? "null" : vn) ", \"commit\": " jn(vcm) \
                ", \"message\": " jn(vmsg) ", \"dirty\": " vdirty "}, \"upstream\": "
            if ((k == "skill" || k == "plugin") && ((d, n) in lk)) { split(lk[d, n], u, "\t"); o = o "{\"commit\": " jn(u[1]) ", \"date\": " jn(u[3]) ", \"collected\": " jn(u[2]) "}" }
            else o = o "null"
            o = o ", \"installed\": {"; lgot = 0; lat = ""
            for (j = 1; j <= 3; j++) {         # the folder s own first (--dir), then the account s; Claude s rules: the source s file
                got = 0; id = ""; at = ""
                if (k == "agent") got = 0
                else if (tl[j] == "claude" && k == "rule") { if ((i in want) || (i in fit)) { got = 1; id = vw; at = mt[p] } }
                else if ((i in fit) && (("F" tl[j] ":" i) in inst)) { got = 1; split(inst["F" tl[j] ":" i], r, " "); id = r[1]; at = r[2] }
                else if (("A" tl[j] ":" i) in inst) { got = 1; split(inst["A" tl[j] ":" i], r, " "); id = r[1]; at = r[2] }
                o = o (j > 1 ? ", " : "") "\"" tl[j] "\": " (got ? "{\"id\": " jn(id) ", \"at\": " (at == "" ? "null" : at) "}" : "null")
                if (got && tl[j] == lt) { lgot = 1; lat = at }
            }
            o = o "}, \"held\": null"
            if (pid != "") {                   # rules, MCP and plugins are read when the conversation starts, a skill when it is used
                if (lt == "") l = "unknown"; else if (!lgot) l = ""; else if (ls == "" || lat == "") l = "unknown"
                else if (ls + 0 >= lat + 0) l = "new"; else if (k != "skill") l = "old"; else if (nouse != "") l = "unknown"
                else l = ((n in use) && use[n] + 0 < lat + 0) ? "old" : "new"
                o = o ", \"loaded\": " jn(l)
            }
            print i "\t" o
        }' "$t/items" > "$t/out"
    exec 5< "$t/out"; rm -rf "$t"                            # (read on fd 5 after the folder is gone)
}
ver_item_json() { # (cmd_list_json's, for item $i) its line from ver_list_prep
    local x; IFS= read -r x <&5 || return 0
    [ "${x%%"$TAB"*}" = "$i" ] && printf '%s' "${x#*"$TAB"}"
    return 0
}
sign_json() { # ,"sign": the approvals repo this computer signs with (kit approve remembered it): its serial and what it
    # approved ({name, commit}); nothing when this computer hasn't signed
    local d f; d=$(state_get sign approvals); f="$d/approved.txt"
    [ -n "$d" ] && [ -f "$f" ] || return 0
    printf ',\n  "sign": {"approvals": %s, "serial": %s, "approved": [%s]}' "$(json_s "$d")" "$(json_uint "$(awk '$1 == "serial:" { print $2; exit }' "$f")")" \
        "$(awk 'NF == 2 && $1 !~ /^#/ && $1 != "serial:" { print $1 "\t" $2 }' "$f" | while IFS="$TAB" read -r n s; do printf '%s{"name": %s, "commit": %s}' "${c:+, }" "$(json_s "$n")" "$(json_s "$s")"; c=1; done)"
}
cmd_list_json() { # what kit list shows, as JSON for programs (a screen like a kit panel); kit.ps1 prints the same
    local want req i k n p d status new first s tools sf chg="" changed rel f desc zh seen SRC_DIRS_LIST KIT_REQS KIT_FM
    # each item below without a program run for what is the same for all of them (a slow machine: seconds per fork)
    want=$LF$(wanted)$LF; req=$LF$(required_items)$LF; SRC_DIRS_LIST=$(src_dirs)
    seen=$LF$([ -f "$STATE" ] && awk -F'\t' '$1 == "seen" && $3 != "" { print $2 }' "$STATE")$LF
    KIT_REQS=$(while IFS= read -r d; do [ -f "$d/kit.yaml" ] && yaml "$d/kit.yaml" | awk -v f="$d/kit.yaml:" '/^requires\./ { print f $0 }'; done <<< "$SRC_DIRS_LIST")
    tool_cache                                               # each program looked at once, not once per skill
    local ALL; ALL=$(available)
    ver_list_prep
    printf '{\n  "kit": %s,\n  "sources": [' "$(json_s "$KIT_VERSION")"
    first=1
    while IFS= read -r s; do
        [ -n "$s" ] || continue
        [ $first = 1 ] || printf ','; first=0
        d=$(src_dir "$s"); sf=$(cd "$d" 2>/dev/null && send_files)    # what kit push would send from it
        [ -z "$sf" ] || while IFS= read -r f; do chg="$chg$TAB$d/$f$LF"; done <<< "$sf"
        printf '\n    {"name": %s, "source": %s, "dir": %s, "push": %s, "changed": %s}' "$(json_s "$(src_name "$s")")" "$(json_s "$(url_safe "$s")")" "$(json_s "$d")" "$(json_s "$(push_mode "$d")")" "$(printf '%s\n' "$sf" | json_arr)"
    done <<EOF
$(m_sources)
EOF
    tools='"claude"'; has_codex && tools="$tools, \"codex\""; has_omp && tools="$tools, \"omp\""
    printf '\n  ],\n  "tools": [%s],\n  "items": [' "$tools"
    first=1
    for i in $ALL; do
        k=${i%%:*}; n=${i#*:}
        p=$(find_item "$k" "$n") || continue
        status=unused
        case $want in *"$LF$i$LF"*) status=used;; esac
        case $req in *"$LF$i$LF"*) status=required;; esac
        [ "$k" = agent ] && status=agent
        case $seen in *"$LF$i$LF"*) new=false;; *) new=true;; esac
        rel=$(item_path "" "$k" "$n"); d=${p%"$rel"}            # the source folder that has it
        # changed: kit push would send it (a skill: any file in its folder)
        changed=false
        case $k in skill) case $chg in *"$TAB$d${rel%/*}/"*) changed=true;; esac;;
                   plugin) case $chg in *"$TAB$d/plugins/$n/"*) changed=true;; esac;;
                   *) case $chg in *"$TAB$d$rel$LF"*) changed=true;; esac;; esac
        if [ "$k" = skill ]; then                            # its frontmatter read once (skill_needs reads KIT_FM)
            KIT_FM=$(fm_of "$p"); desc=""; fm_starts "$p" && desc=$(fm_val "$KIT_FM" description) && desc=${desc%%"$LF"*}
        else desc=$(item_desc "$k" "$p"); fi
        [ $first = 1 ] || printf ','; first=0
        printf '\n    {"kind": '; json_s "$k"; printf ', "name": '; json_s "$n"; printf ', "status": '; json_s "$status"
        printf ', "new": %s, "changed": %s, "source": ' "$new" "$changed"; json_s "${d##*/}"; printf ', "description": '; json_s "$desc"
        zh=$(desc_zh "$d" "$i" "$desc"); [ -z "$zh" ] || { printf ', "description_zh": '; json_s "$zh"; }
        printf ', "path": '; json_s "$p"
        case $k in
            skill) printf ', "needs": '; needs_json "${p%/*}" "$d"; packages_json "${p%/*}" "$n";;
            plugin) printf ', "needs": '; needs_json "${p%/.claude-plugin/plugin.json}" "$d"; printf ', "parts": '; parts_json "${p%/.claude-plugin/plugin.json}";;
            mcp) mcp_list_json "$p" "$n";;
        esac
        ver_item_json
        printf '}'
    done
    exec 5<&-
    printf '\n  ],\n  "blocked": ['
    first=1
    [ -f "$BLOCKED" ] && while IFS="$TAB" read -r i k n s d p _; do   # (tool kind name scope dir path: kit sync wrote them)
        [ -n "$i" ] || continue
        [ $first = 1 ] || printf ','; first=0
        printf '\n    {"kind": %s, "name": %s, "tool": %s, "path": %s, "scope": %s%s}' "$(json_s "$k")" "$(json_s "$n")" "$(json_s "$i")" \
            "$(json_s "$p")" "$( [ "$s" = folder ] && echo '"folder"' || echo '"account"')" "$( [ "$d" = - ] || printf ', "dir": %s' "$(json_s "$d")")"
    done < "$BLOCKED"
    printf '\n  ],\n  "kit_version_wanted": %s' "$(json_s "$(wanted_version)")"
    sign_json
    [ -n "${HERE_DIR:-}" ] && here_json "$HERE_DIR" "${HERE_PID:-}"
    printf '\n}\n'
}

cmd_list() {
    case ${1:-} in
        --json) shift
            HERE_DIR=""; HERE_PID=""; HERE_TOOL=""
            while [ $# -gt 0 ]; do
                case $1 in
                    --dir) [ $# -ge 2 ] || die_c usage "--dir 後面要接資料夾"; HERE_DIR=$2; shift 2
                        [ -d "$HERE_DIR" ] && HERE_DIR=$(cd "$HERE_DIR" && pwd -P);;
                    --pid) [ $# -ge 2 ] || die_c usage "--pid 後面要接數字"; HERE_PID=$2; shift 2
                        case $HERE_PID in ""|*[!0-9]*) die_c usage "--pid 後面要接數字";; esac;;
                    --tool) [ $# -ge 2 ] || die_c usage "--tool 後面要接 claude、codex 或 omp"; HERE_TOOL=$2; shift 2;;
                    *) die_c usage "用法：kit list --json [--dir 資料夾] [--pid 程式編號]";;
                esac
            done
            need_init; cmd_list_json >&3; return;;
        "") ;;
        *) die_c usage "用法：kit list [--json [--dir 資料夾] [--pid 程式編號]]";;
    esac
    need_init
    local want req i mark
    want=$(wanted); req=$(required_items)
    for i in $(available); do
        mark="  "
        printf '%s\n' "$want" | grep -qxF "$i" && mark="* "
        printf '%s\n' "$req" | grep -qxF "$i" && mark="R "
        case $i in agent:*) mark="  ";; esac
        [ -n "$(state_get seen "$i")" ] || mark="${mark%% }N"
        printf '%s %s\n' "$mark" "$i"
    done
    # an MCP in use whose package is downloaded at each start (kit can install it once)
    local n p kind pkg ver argno bin first bad
    for n in $(printf '%s\n' "$want" | sed -n 's/^mcp://p'); do
        p=$(find_item mcp "$n") || continue
        IFS=$US read -r kind pkg ver argno bin first bad <<EOF
$(mcp_pkg "$p")
EOF
        [ -n "$kind" ] && ! mcp_installed "$n" "$kind" "$pkg" "$ver" "$bin" >/dev/null || continue
        if [ -n "$ver" ] && [ -z "$bad" ]; then say "   mcp:$n 每次啟動時下載 ${pkg}（先裝好：kit install-deps mcp ${n}）"
        else say "   mcp:$n 每次啟動時下載 ${pkg:-它的套件}"; fi
    done
    say ""
    say "* 在用   R 團隊必備   N 新的   agent 用  kit run <名字>  開"
    say "寫到：$(targets)"
    version_nag
}

cmd_add_rm() {
    local verb=$1; shift
    local dir=""
    if [ "${1:-}" = --dir ]; then [ $# -ge 2 ] || die "--dir 後面要接資料夾"; dir=$2; shift 2; fi
    [ $# -ge 2 ] && { [ -z "$dir" ] || [ $# -eq 2 ]; } || die "用法：kit $verb [--dir 資料夾] rule|skill|mcp|plugin <名字>（整個帳號可以一次給好幾個名字）"
    need_init
    local k=$1 n i added removed; shift
    case " rule skill mcp plugin " in *" $k "*) ;; *) die "種類只能是 rule、skill、mcp、plugin";; esac
    if [ -n "$dir" ]; then dir_add_rm "$verb" "$dir" "$k" "$1"; return; fi
    local acct; acct=$(wanted)
    for n in "$@"; do
        # taking one out: one the account has goes even when no source has it any more
        [ "$verb" = rm ] && printf '%s\n' "$acct" | grep -qxF "$k:$n" && continue
        # the account hasn't it but a folder has: say how to take it out there
        [ "$verb" = rm ] && i=$(dirs_with "$k:$n") && [ -n "$i" ] &&
            die "整個帳號沒有 $k:${n}，是這些資料夾的清單有：$(printf '%s\n' "$i" | paste -sd ' ' -)。要拿掉打 kit rm --dir <資料夾> $k $n"
        find_item "$k" "$n" > /dev/null || die "找不到 $k:${n}（打 kit list 看有哪些）"
    done
    [ "$verb" = add ] || for n in "$@"; do required_items | grep -qxF "$k:$n" && die "$k:$n 是團隊必備，拿不掉"; done
    added=$(m_added); removed=$(m_removed)
    for n in "$@"; do
        i="$k:$n"
        if [ "$verb" = add ]; then
            added=$(printf '%s\n%s\n' "$added" "$i" | awk 'NF && !seen[$0]++')
            removed=$(printf '%s\n' "$removed" | grep -vxF "$i")
        else
            added=$(printf '%s\n' "$added" | grep -vxF "$i")
            removed=$(printf '%s\n%s\n' "$removed" "$i" | awk 'NF && !seen[$0]++')
        fi
    done
    write_machine "$(m_sources)" "$added" "$removed"
    apply_claude
}

dir_add_rm() { # dir_add_rm add|rm DIR KIND NAME : only that folder (and below it) gets it, or no longer
    # (a placed folder: taking out one of its agent's is kept as not:KIND:NAME, adding it again takes that away)
    local verb=$1 k=$3 n=$4 i="$3:$4" root why own nots ag items
    [ -d "$2" ] || die "找不到資料夾 $2"
    root=$(dir_root "$2") || die "找不到資料夾 $2"
    why=$(dir_why_not "$root"); [ -z "$why" ] || die "${root}：$why"
    own=$(dir_own "$root"); nots=$(dir_nots "$root"); ag=$(dir_agent_items "$root")
    if [ "$verb" = add ]; then
        find_item "$k" "$n" > /dev/null || die "找不到 ${i}（打 kit list 看有哪些）"
        dir_items "$root" | grep -qxF "$i" && { say "kit：$root 已經有 $i"; return 0; }
        nots=$(printf '%s\n' "$nots" | grep -vxF "$i")
        printf '%s\n' "$ag" | grep -qxF "$i" || own=$(printf '%s\n%s\n' "$own" "$i" | awk 'NF')
    else
        dir_items "$root" | grep -qxF "$i" || die "$root 沒有加 ${i}（這個資料夾自己加的才拿得掉）"
        own=$(printf '%s\n' "$own" | grep -vxF "$i")
        printf '%s\n' "$ag" | grep -qxF "$i" && nots=$(printf '%s\n%s\n' "$nots" "$i" | awk 'NF')
    fi
    items=$(printf '%s\n' "$own"; printf '%s\n' "$nots" | awk 'NF { print "not:" $0 }')
    items=$(printf '%s\n' "$items" | awk 'NF')
    dir_write "$root" "$items"
    if [ -n "$items$(dir_mark "$root" agent)" ]; then dirs_set "$root" add; else dirs_set "$root" rm; fi
    apply_dir "$root"
    # Codex: the folder's trust and the root marker; a plugin: kit's copy and what is blocked (a folder's plugin is kit's)
    if has_codex || [ "$k" = plugin ]; then apply_claude; else ver_record; fi
    if [ "$verb" = add ]; then say "kit：$i 加到 ${root}（只有在這裡和子資料夾開的 agent 讀得到，開新的才會讀到）"
        [ "$k" != plugin ] || say "     Codex 只能整個帳號裝：在這裡開的 Codex 沒有外掛 ${n}（Codex 也要的話：kit add plugin ${n}，整個帳號都有）"
    else say "kit：$i 從 $root 拿掉了"; fi
}

toml_str() { # quote a string for TOML (a basic string; newlines escaped)
    local s=$1
    s=${s//\\/\\\\}; s=${s//\"/\\\"}
    s=${s//$TAB/\\t}; s=${s//$'\r'/\\r}; s=${s//$'\n'/\\n}
    printf '"%s"' "$s"
}

mcp_toml_inline() { # mcp_toml_inline FILE NAME -> {command="..", args=[..], env={..}} or {url="..", ...} (kit run --tool codex)
    local f=$1 n=$2 fields out="" env="" k v
    fields=$(codex_mcp_fields "$f" "$n" toml_str) || return 1
    while IFS="$TAB" read -r k v; do
        case $k in "") ;; env.*) env="${env:+$env, }$(toml_key "${k#env.}")=$v";; *) out="${out:+$out, }$k=$v";; esac
    done <<EOF
$fields
EOF
    [ -n "$env" ] && out="$out, env={$env}"
    printf '{%s, default_tools_approval_mode="approve"}' "$out"
}

cmd_run() {
    [ $# -ge 1 ] || die "用法：kit run <agent> [--tool claude|codex|omp] [工具的參數...]"
    need_init
    local name=$1; shift
    local tool=claude
    if [ "${1:-}" = --tool ]; then tool=${2:-}; shift 2 || die "--tool 後面要接 claude、codex 或 omp"; fi
    case $tool in claude|codex|omp) ;; *) die "--tool 只能是 claude、codex 或 omp";; esac
    local f; f=$(find_item agent "$name") || die "找不到 agent ${name}（打 kit list 看有哪些）"
    if take_lock soft; then ( QUIET=1 cmd_sync ) 2>/dev/null; release_lock; fi   # busy (another kit is syncing): start as it is

    # the agent's folder, gone when kit ends (also on Ctrl-C); a dry run keeps it to look at, without kit's links in it.
    # Folders of runs that were killed (their kit is gone) go now.
    local d; for d in "${TMPDIR:-/tmp}"/kit-run.*; do
        [ -f "$d/.kit-pid" ] && ! kill -0 "$(cat "$d/.kit-pid")" 2>/dev/null && rm -rf "$d"
    done
    local tmp; tmp=$(mktemp -d "${TMPDIR:-/tmp}/kit-run.XXXXXX") || die "沒辦法建立暫存資料夾"
    [ -n "${KIT_DRY_RUN:-}" ] || { KIT_RUN_TMP=$tmp; echo $$ > "$tmp/.kit-pid"; }
    local n p k
    local fm; fm=$(LC_ALL=C awk -f "$KIT_LIB/yaml.awk" -v frontmatter=1 "$f") || die "bad header in $f"
    fmget() { printf '%s\n' "$fm" | awk -F'\t' -v p="$1" '$1 == p || $1 == p "[]" { sub(/^[^\t]*\t/, ""); print }'; }

    # the agent's skills, each in its own folder
    local skdir="$tmp/skills"; [ $tool = claude ] && skdir="$tmp/.claude/skills"
    mkdir -p "$skdir"
    for n in $(fmget skills); do
        p=$(find_item skill "$n") || { warn "skill $n not found"; continue; }
        cp -R "$(dirname "$p")" "$skdir/$n"; drop_caches "$skdir/$n"; [ -n "${KIT_DRY_RUN:-}" ] || link_deps "$n" "$skdir/$n"
    done
    # the agent's rules + its prompt
    {
        for n in $(fmget rules); do
            p=$(find_item rule "$n") || { warn "rule $n not found"; continue; }
            cat "$p"; echo
        done
        py_hint $(fmget skills)
        fm_body "$f"
        if [ $tool = codex ] && [ -n "$(ls "$skdir")" ]; then
            # Codex cannot load skills from an extra folder: list them, it reads one when needed
            echo; echo "## Skills"
            echo "Skills you have. Before doing a task one of them covers, read its SKILL.md and follow it."
            for d in "$skdir"/*/; do
                n=$(basename "$d")
                printf -- '- %s: %s (%sSKILL.md)\n' "$n" "$(LC_ALL=C awk -f "$KIT_LIB/yaml.awk" -v frontmatter=1 "$d/SKILL.md" 2>/dev/null | awk -F'\t' '$1 == "description" { print $2 }')" "$d"
            done
        fi
    } > "$tmp/prompt.md"
    local only deny; only=$(fmget tools.only | paste -sd, -); deny=$(fmget tools.deny)

    local args=()
    if [ $tool != codex ]; then                              # Claude: --mcp-config; omp: a plugin folder's .mcp.json
        local mcps="" first=1
        for n in $(fmget mcp); do
            p=$(find_item mcp "$n") || { warn "mcp $n not found"; continue; }
            k=$(mcp_json "$p") || continue
            [ $first = 1 ] || mcps="$mcps,"; first=0
            mcps="$mcps$(json_str "$n"):$k"
        done
        printf '{"mcpServers":{%s}}\n' "$mcps" > "$tmp/mcp.json"
    fi
    case $tool in
    claude)
        args=(--add-dir "$tmp" --append-system-prompt-file "$tmp/prompt.md" --mcp-config "$tmp/mcp.json")
        [ -n "$only" ] && args+=(--tools "$only")
        while IFS= read -r d; do [ -n "$d" ] && args+=(--disallowedTools "$d"); done <<EOF
$deny
EOF
        ;;
    codex)
        args=(-c "developer_instructions=$(toml_str "$(cat "$tmp/prompt.md")")")
        for n in $(fmget mcp); do
            p=$(find_item mcp "$n") || { warn "mcp $n not found"; continue; }
            k=$(mcp_toml_inline "$p" "$n") || continue
            local t="" first=1
            while IFS= read -r d; do case $d in "mcp__${n}__"*) [ $first = 1 ] || t="$t, "; first=0; t="$t$(toml_str "${d#mcp__${n}__}")";; esac; done <<EOF
$deny
EOF
            [ -n "$t" ] && k="${k%\}}, disabled_tools=[$t]}"
            args+=(-c "mcp_servers.$(toml_key "$n")=$k")
        done
        # tools.only, tools.deny: kit codex-guard (Codex's PreToolUse hook) reads them from this Codex's environment
        codex_limits_warn "$only" "$deny" | while IFS= read -r a; do warn "$a"; done
        ;;
    omp)
        printf 'skills:\n  customDirectories:\n    - %s\n' "$(toml_str "$skdir")" > "$tmp/omp.yml"
        args=(--config "$tmp/omp.yml" --append-system-prompt "$tmp/prompt.md")
        [ -n "$only" ] && args+=(--tools "$(omp_tool_names "$only")")
        if [ -n "$mcps" ]; then                              # omp loads a plugin folder's .mcp.json (--plugin-dir): its tools are kit:<name>
            mkdir -p "$tmp/omp-plugin/.claude-plugin" && printf '{"name": "kit", "version": "0.0.0"}\n' > "$tmp/omp-plugin/.claude-plugin/plugin.json" &&
                cp "$tmp/mcp.json" "$tmp/omp-plugin/.mcp.json" && args+=(--plugin-dir "$tmp/omp-plugin")
        fi
        if [ -n "$deny" ]; then                               # tools.deny: kit's hook module, --extension
            omp_hook_js "" "" "$deny" > "$tmp/kit-tools.js" && args+=(--extension "$tmp/kit-tools.js")
            omp_limits_warn "" "$deny" | while IFS= read -r a; do warn "$a"; done
        fi
        ;;
    esac
    set -- "${args[@]}" "$@"
    [ -n "${KIT_DRY_RUN:-}" ] && { printf '%s\n' "$tool" "$@"; printf 'tmp=%s\n' "$tmp"; return 0; }
    # a marker (this process -> agent name), so a program showing the pane can tell which agent runs in it
    mkdir -p "$KIT_CONF/run" 2>/dev/null && printf '%s\n' "$name" > "$KIT_CONF/run/$$"
    trap : INT                                               # Ctrl-C is the agent's; kit cleans up when it ends
    if [ $tool = codex ]; then KIT_CODEX_ONLY=$only KIT_CODEX_DENY=$deny "$tool" "$@"; else "$tool" "$@"; fi
    local rc=$?
    trap 'exit 130' INT
    rm -rf "$tmp"; rm -f "$KIT_CONF/run/$$"; KIT_RUN_TMP=
    return $rc
}

cmd_place() { # kit place <agent> <dir> [--tool claude|codex|omp] [--json] : DIR becomes that agent's own folder
    # Built on a folder's own (kit add --dir): .agentkit lists the agent's rules, skills and MCP, and says which agent it is
    # (agent:NAME, tool:TOOL); kit sync puts the agent's prompt and tool limits in. Afterwards claude / codex / omp started
    # there is that agent, and kit add|rm --dir changes only this folder.
    local name="" dir="" tool=claude json="" a n k f fm d parent old items marks warns="" only deny
    while [ $# -gt 0 ]; do
        case $1 in
            --tool) [ $# -ge 2 ] || die_c usage "--tool 後面要接 claude、codex 或 omp"; tool=$2; shift 2;;
            --json) json=1; shift;;
            -*) die_c usage "用法：kit place <agent> <資料夾> [--tool claude|codex|omp] [--json]";;
            *) if [ -z "$name" ]; then name=$1; elif [ -z "$dir" ]; then dir=$1
               else die_c usage "用法：kit place <agent> <資料夾> [--tool claude|codex|omp] [--json]"; fi; shift;;
        esac
    done
    [ -n "$name" ] && [ -n "$dir" ] || die_c usage "用法：kit place <agent> <資料夾> [--tool claude|codex|omp] [--json]"
    case $tool in claude|codex|omp) ;; *) die_c usage "--tool 只能是 claude、codex 或 omp";; esac
    need_init
    f=$(find_item agent "$name") || die_c no_agent "找不到 agent ${name}（打 kit list 看有哪些）"
    case $dir in /) ;; *) while [ "${dir%/}" != "$dir" ]; do dir=${dir%/}; done;; esac
    if [ -d "$dir" ]; then d=$(cd "$dir" && pwd -P)
    else
        [ -e "$dir" ] && die_c bad_dir "$dir 不是資料夾"
        parent=$(dirname "$dir")
        [ -d "$parent" ] || die_c no_parent "上一層資料夾不在：${parent}（kit 只建最後一層）"
        d="$(cd "$parent" && pwd -P)/$(basename "$dir")"; d=${d#/}; d="/$d"
    fi
    a=$(dir_why_not "$d"); [ -z "$a" ] || die_c bad_dir "${d}：$a"
    if [ -d "$d" ]; then
        old=$(dir_mark "$d" agent)
        [ -z "$old" ] || [ "$old" = "$name" ] || die_c other_agent "$d 已經是 agent ${old}：換一個資料夾，或先把它的 .agentkit 拿掉"
        [ -n "$old" ] || [ -z "$(ls -A "$d" 2>/dev/null)" ] || die_c not_empty "$d 已經有東西（不是 kit place 放的）：kit 只放在新的或空的資料夾"
    else
        mkdir "$d" || die "沒辦法建立資料夾 $d"
    fi
    fm=$(fm_of "$f") || die "bad header in $f"
    # .agentkit: which agent, and what you changed there before (placed again); the agent's own come from it each time
    items=$(dir_lines "$d")
    for a in rule:rules skill:skills mcp:mcp; do
        k=${a%%:*}
        for n in $(fm_val "$fm" "${a#*:}"); do find_item "$k" "$n" >/dev/null || warns="$warns$k $n 不在任何來源裡：沒有放進來$LF"; done
    done
    marks="agent:$name${LF}tool:$tool"
    dir_write "$d" "$items" "$marks"
    dirs_set "$d" add
    apply_dir "$d"
    if has_codex; then apply_claude; else ver_record; fi      # Codex: the folder's trust and the root marker
    # what this tool cannot take from the agent in a folder (the README's table)
    only=$(fm_val "$fm" tools.only); deny=$(fm_val "$fm" tools.deny)
    case $tool in
    claude) ;;                                               # tools.only: deny for the others (kit check tells the author)
    codex)
        local cw; cw=$(codex_limits_warn "$only" "$deny"); [ -z "$cw" ] || warns="$warns$cw$LF";;
    omp)
        local ow; ow=$(omp_limits_warn "$only" "$deny"); [ -z "$ow" ] || warns="$warns$ow$LF";;
    esac
    [ -z "$warns" ] || printf '%s' "$warns" | while IFS= read -r a; do warn "$a"; done
    if [ -n "$json" ]; then
        printf '{"dir": %s, "agent": %s, "tool": %s, "command": %s, "warnings": %s}\n' "$(json_s "$d")" "$(json_s "$name")" "$(json_s "$tool")" \
            "$(printf '%s\n' "$tool" | json_arr)" "$(printf '%s' "$warns" | json_arr)" >&3
    else
        say "kit：$d 是 agent $name 了（在這裡打 $tool 開的就是它；之後用 kit add|rm --dir 改這個資料夾）"
    fi
}

cmd_uninstall() {
    local self=0; [ "${1:-}" = "--self" ] && self=1
    local n ops k v
    local f
    local left=0 d
    while IFS= read -r d; do                                 # the folders' own: kit's files out, .agentkit gone
        [ -n "$d" ] || continue
        [ -d "$d" ] && { rm -f "$d/$DIR_FILE"; QUIET=1 apply_dir "$d"; }
        dirs_set "$d" rm
    done <<EOF
$(dirs_registered)
EOF
    for f in "$CLAUDE_DIR/CLAUDE.md" "$CODEX_DIR/AGENTS.md" "$OMP_DIR/AGENTS.md"; do KIT_BLOCK= replace_block "$f" "$BEGIN_MARK" "$END_MARK" || left=1; done
    codex_block "" || left=1
    KIT_BLOCK= replace_top_block "$CODEX_DIR/config.toml" "$TOP_BEGIN" "$TOP_END" || left=1
    QUIET=1
    sync_blocks ""                                           # every entry kit wrote to turn something off, out again
    sync_skills "$CLAUDE_DIR/skills" skill < /dev/null
    sync_skills "$AGENTS_SKILLS" skill.agents < /dev/null
    sync_mcp_json "$CLAUDE_JSON" mcp < /dev/null           # stops kit (state.tsv kept) when the file cannot be written
    sync_mcp_json "$OMP_DIR/mcp.json" mcp.omp < /dev/null
    sync_plugins < /dev/null
    if [ -d "$(plugin_root)" ]; then                          # kit's marketplace, once nothing of it is installed
        for k in $(plugin_tools); do [ -n "$(plugin_kits "$k")" ] || "$k" plugin marketplace remove kit >/dev/null 2>&1; done
        [ -n "$(state_list plugin)" ] || rm -rf "$(plugin_root)"
    fi
    QUIET=
    ops=$(mktemp "${TMPDIR:-/tmp}/kit-ops.XXXXXX"); : > "$ops"
    while IFS="$TAB" read -r k n v; do
        [ "$k" = deny ] && printf 'rmstr\tpermissions.deny\t%s\n' "$n" >> "$ops"
        [ "$k" = hook ] && printf 'rmjson\thooks.%s\t%s\n' "$n" "$v" >> "$ops"
        [ "$k" = statusline ] && [ "$(json_get "$CLAUDE_DIR/settings.json" statusLine | tr -d ' \t\r\n')" = "$(printf '%s' "$v" | tr -d ' \t\r\n')" ] && printf 'del\tstatusLine\n' >> "$ops"
    done < "${STATE:-/dev/null}" 2>/dev/null
    [ -s "$ops" ] && { json_edit "$CLAUDE_DIR/settings.json" "$ops"; prune_deny; }
    : > "$ops"                                               # Codex's hooks.json, omp's hook module
    while IFS="$TAB" read -r k n v; do [ "$k" = hook.codex ] && printf 'rmjson\thooks.%s\t%s\n' "$n" "$v" >> "$ops"; done < "${STATE:-/dev/null}" 2>/dev/null
    [ -s "$ops" ] && [ -f "$CODEX_DIR/hooks.json" ] && { json_edit "$CODEX_DIR/hooks.json" "$ops"; prune_empty "$CODEX_DIR/hooks.json" hooks.SessionStart hooks.UserPromptSubmit hooks.PreToolUse hooks; drop_made "$CODEX_DIR/hooks.json"; }
    rm -f "$ops"
    f="$OMP_DIR/hooks/pre/kit.js"; [ -f "$f" ] && [ "$(head -n 1 "$f")" = "$OMP_HOOK_HEAD" ] && rm -f "$f"
    [ $left = 0 ] || die "有的檔案 kit 沒辦法改（看上面），其他的已經拿掉；修好後再打一次  kit uninstall"
    rm -f "$STATE" "$MACHINE" "$BLOCKED"; rm -rf "$KIT_CONF/deps" "$KIT_CONF/pydeps" "$KIT_CONF/mcp-deps" "$KIT_CONF/placed" "$CTX_DIR"
    say "kit：已移除 kit 放進 Claude、Codex、omp 的東西（你自己的檔案沒動）"
    say "     來源的 clone 還留在 $KIT_SRC"
    if [ $self = 1 ]; then
        rm -f "$HOME/.local/bin/kit"; rm -rf "$HOME/.local/share/agentkit"
        say "kit：kit 本身也移除了"
    fi
}

cmd_self_update() { # pull the clone kit was installed from, then reinstall
    local repo; repo=$(cat "$KIT_LIB/.repo" 2>/dev/null) || die "不知道 kit 是從哪個 clone 裝的；請到 clone 裡 git pull 後重跑 unix/install.sh"
    [ -d "$repo/.git" ] || die "找不到 clone：$repo"
    local url; url=$(git -C "$repo" remote get-url origin 2>/dev/null) && check_host "$url"
    local before; before=$(git -C "$repo" rev-parse --short=12 HEAD 2>/dev/null)
    if [ -n "$M_APPROVALS" ]; then
        [ -n "$url" ] || die "$repo 沒有 origin"
        local sha; sha=$(approved_sha "$(src_name "$url")") || die "kit 本身（$(src_name "$url")）沒有有效的核准，不更新"
        git_safe -C "$repo" fetch -q --no-recurse-submodules origin || die "沒辦法 fetch $repo"
        git -C "$repo" -c advice.detachedHead=false checkout -q -f --detach "$sha" || die "找不到核准的版本 $sha"
    else
        git_safe -C "$repo" pull --ff-only -q || die "沒辦法更新 ${repo}（沒網路，或 clone 裡有自己的改動？）"
    fi
    sh "$repo/unix/install.sh" --quiet || die "重新安裝失敗"
    local now; now=$(git -C "$repo" rev-parse --short=12 HEAD 2>/dev/null)
    if [ -n "$before" ] && [ "$before" = "$now" ]; then say "kit：已經是最新（$(cat "$KIT_LIB/VERSION" 2>/dev/null)，${now}）"
    else say "kit：已更新到 $(cat "$KIT_LIB/VERSION" 2>/dev/null)（${now}）"; fi
}

# ---------- authoring: new / diff / update (local folders only, never the network) ----------
valid_name() { case $1 in ""|-*|*[!a-z0-9-]*) return 1;; *) return 0;; esac; }
target_dir() { # where new/update write: --to <source name|folder>, else the folder you are in if it has kit.yaml, else the first source
    local d
    if [ -n "$1" ]; then
        while IFS= read -r d; do [ -n "$d" ] && [ "$(basename "$d")" = "$1" ] && { printf '%s\n' "$d"; return 0; }; done <<EOF
$( [ -f "$MACHINE" ] && src_dirs )
EOF
        [ -d "$1" ] || die_c no_source "找不到 --to $1（要是來源名字或資料夾）"
        real_dir "$1"; return 0
    fi
    [ -f ./kit.yaml ] && { pwd -P; return 0; }        # links resolved, as src_dir names it
    need_init
    src_dirs | head -n 1
}
item_hash() { # item_hash KIND PATH(the item file)
    if [ "$1" = skill ]; then dir_hash "$(dirname "$2")"; else cksum < "$2" | awk '{print $1}'; fi
}
stage_from() { # stage_from KIND NAME FROM OUTDIR : copy what kit accepts from a local folder/file into OUTDIR; prints the item file
    local kind=$1 name=$2 from=$3 out=$4 f rel scripts=0 skipped=0 ext
    is_url "$from" && die "--from 只吃本機的資料夾或檔案（先自己 git clone 到暫存資料夾）"
    [ -e "$from" ] || die "找不到 $from"
    [ -d "$from" ] && from=$(cd "$from" && pwd -P)
    case $kind in
    skill)
        [ -d "$from" ] && [ -f "$from/SKILL.md" ] || die "$from 要是有 SKILL.md 的資料夾"
        grep -q 'scripts/' "$from/SKILL.md" && scripts=1
        mkdir -p "$out/$name"
        while IFS= read -r f; do
            rel=${f#"$from"/}
            case /$rel in */.git/*|*/.DS_Store) continue;; esac
            case $(basename "$rel") in LICENSE*|LICENCE*|COPYING*|README*|CHANGELOG*) skipped=$((skipped+1)); continue;; esac
            if [ -L "$f" ]; then skipped=$((skipped+1)); continue; fi
            case $rel in
                scripts/*) [ $scripts = 1 ] || { skipped=$((skipped+1)); continue; };;
                *.md) ;;
                *) skipped=$((skipped+1)); continue;;
            esac
            mkdir -p "$(dirname "$out/$name/$rel")"; cp "$f" "$out/$name/$rel"
        done <<EOF
$(cd "$from" && find "$(pwd -P)" -name .git -prune -o \( -type f -o -type l \) -print | not_cache | LC_ALL=C sort)
EOF
        [ $skipped -gt 0 ] && warn "跳過 $skipped 個檔案（只帶 .md$( [ $scripts = 1 ] && echo '、scripts/')；不帶 LICENSE、README、.git）"
        printf '%s\n' "$out/$name/SKILL.md";;
    rule|agent|mcp)
        ext=md; [ $kind = mcp ] && ext=yaml
        f=$from; [ -d "$f" ] && f="$from/$name.$ext"
        [ -f "$f" ] && [ ! -L "$f" ] || die "$from 要是一個 .$ext 檔（或有 $name.$ext 的資料夾）"
        case $f in *.$ext) ;; *) die "$f 要是 .$ext 檔";; esac
        cp "$f" "$out/$name.$ext"; printf '%s\n' "$out/$name.$ext";;
    esac
}
put_item() { # put_item KIND NAME STAGED_FILE TARGET_DIR : replace the item in the target with the staged copy
    local dst; dst=$(item_path "$4" "$1" "$2")
    mkdir -p "$(dirname "$dst")"
    if [ "$1" = skill ]; then rm -rf "$(dirname "$dst")"; cp -R "$(dirname "$3")" "$(dirname "$dst")"; else cp "$3" "$dst"; fi
    printf '%s\n' "$dst"
}
MCP_SKELETON='# 一個 MCP server。兩種寫法選一種，另一種刪掉。
# 密碼、token 不要寫在這裡：寫成 ${變數名}，值放在每台電腦自己的環境變數。
# 別人給的設定（JSON、claude mcp add …）：存成檔案，用  kit new mcp --config 檔案  帶進來比較快。

description: （這個 MCP 做什麼：Kit 面板會顯示這一行）

# 1. 在這台電腦跑一個程式：
command: （啟動 MCP server 的程式，例如 npx 或 uvx）
args: []
# env:
#   API_TOKEN: ${API_TOKEN}

# 2. 連到一個網址（把上面的 command、args、env 刪掉，打開下面幾行）：
# type: http          # 或 sse
# url: https://mcp.example.com/mcp
# headers:
#   Authorization: Bearer ${API_TOKEN}'
skeleton() { # skeleton KIND NAME FILE
    case $1 in
    rule)  printf '# %s\n\n（在這裡寫規則，一條一行。）\n' "$2";;
    skill) printf -- '---\nname: %s\ndescription: （什麼時候用這個 skill，一句話）\n---\n\n（在這裡寫步驟。）\n' "$2";;
    mcp)   printf '%s\n' "$MCP_SKELETON";;
    agent) printf -- '---\nname: %s\ndescription: （這個 agent 做什麼）\nrules: []\nskills: []\nmcp: []\n# tools:\n#   only: [Read, Grep, Glob]\n#   deny: []\n---\n（在這裡寫 agent 的角色和做法。）\n' "$2";;
    esac > "$3"
}
parse_item_args() { # sets KIND NAME FROM TO FORCE_IT from: [KIND] NAME [--from P] [--to T] [--force]
    KIND=; NAME=; FROM=; TO=; FORCE_IT=; CONFIG=; LOOK=
    while [ $# -gt 0 ]; do
        case $1 in
            --from) FROM=${2:-}; shift 2 || die "--from 後面要接資料夾";;
            --config) [ $# -ge 2 ] || die_c usage "--config 後面要接檔案（或 - 從標準輸入讀）"; CONFIG=$2; shift 2;;
            --look) LOOK=1; shift;;
            --to)   TO=${2:-}; shift 2 || die "--to 後面要接來源";;
            --force) FORCE_IT=1; shift;;
            *) if [ -z "$NAME" ] && [ -z "$KIND" ] && printf '%s\n' $KINDS | grep -qxF "$1"; then KIND=$1; elif [ -z "$NAME" ]; then NAME=$1; else die_c usage "多了一個參數：$1"; fi; shift;;
        esac
    done
}
guess_kind() { # guess_kind DIR NAME
    local k found=""
    for k in $KINDS; do [ -f "$(item_path "$1" "$k" "$2")" ] && found="$found $k"; done
    set -- $found
    [ $# = 1 ] || { [ $# = 0 ] && die "$(basename "$1") 裡沒有 ${NAME}"; die "$NAME 有好幾種（$*），請寫出種類，例：kit diff skill $NAME"; }
    printf '%s\n' "$1"
}

mcp_latest() { # mcp_latest npm|pip PACKAGE[@RANGE] -> its newest version (that matches RANGE: npm view; PyPI's JSON API),
    # empty when kit cannot tell
    local v="" u h hosts
    case $1 in
    npm) command -v npm >/dev/null 2>&1 || return 0
         # (not in a project: its .npmrc) a range that matches several prints "pkg@1.2.3 '1.2.3'" lines: the highest one
         v=$(cd "$KIT_STAGE" && ctx_capped 30 npm view "$2" version 2>/dev/null | ver_top);;
    pip) command -v curl >/dev/null 2>&1 || return 0
         u=${KIT_PYPI_URL:-https://pypi.org/pypi}; u="${u%/}/${2%%\[*}/json"; h=$(url_host "$u")
         hosts=$(allowed_hosts)
         if [ -n "$hosts" ] && ! printf '%s\n' "$hosts" | grep -qxF "$h"; then warn "$h 不在 allowed_hosts：不查最新版本"; return 0; fi
         curl -fsSL --max-time 20 "$u" > "$KIT_STAGE/pypi.json" 2>/dev/null && v=$(json_get "$KIT_STAGE/pypi.json" info.version | tr -d '"');;
    esac
    printf '%s\n' "$v" | grep -E '^[0-9][0-9A-Za-z.+!-]*$' | head -n 1
}
ver_top() { # version lines on stdin (1.2.3, or pkg@1.2.3 '1.2.3') -> the highest (a release before its pre-releases)
    LC_ALL=C awk '{ v = $NF; gsub(/'"'"'/, "", v) }
        v ~ /^[0-9]+\.[0-9]+\.[0-9]+/ {
            k = v; p = ""; if (match(k, /[-+]/)) { p = substr(k, RSTART); k = substr(k, 1, RSTART - 1) }
            split(k, n, "."); key = sprintf("%09d.%09d.%09d.%s", n[1], n[2], n[3], (p ~ /^-/) ? "0" p : "1")
            if (top == "" || key > top) { top = key; best = v } }
        END { if (best != "") print best }'
}
mcp_paste_err() { # mcp_paste_err OUT : mcp.awk stopped (an E line): stop kit with its code (the servers' names too)
    local code msg names
    case $1 in E"$TAB"*) ;; *) return 0;; esac
    code=$(printf '%s\n' "$1" | awk -F'\t' 'NR == 1 { print $2 }'); msg=$(printf '%s\n' "$1" | awk -F'\t' 'NR == 1 { sub(/^E\t[^\t]*\t/, ""); print }')
    names=$(printf '%s\n' "$1" | awk -F'\t' '$1 == "L" { print $2 }')
    if [ -n "$names" ]; then DIE_EXTRA=", \"servers\": $(printf '%s\n' "$names" | json_arr)"; msg="${msg}：$(printf '%s\n' "$names" | paste -sd'|' - | sed 's/|/、/g')"; fi
    die_c "$code" "$msg"
}
mcp_lines() { printf '%s\n' "$1" | awk -F'\t' -v t="$2" '$1 == t { sub(/^[^\t]*\t/, ""); print }'; }   # mcp_lines OUT TYPE -> those lines, without the type
mcp_new_config() { # kit new mcp [NAME] --config FILE|- [--to SOURCE] [--look] : a pasted setup -> mcp/<name>.yaml, secrets as ${VAR}
    local tmp form out n t dir dst f kind pkg ver argno bin first bad v exists=false notes="" w x
    [ -z "$NAME" ] || valid_name "$NAME" || die_c bad_name "名字只能用小寫英文、數字和 -：$NAME"
    # the paste may hold secrets: a folder only you can read, gone when kit ends (also on Ctrl-C); never printed
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/kit-mcp.XXXXXX") && chmod 700 "$tmp" || die "沒辦法建立暫存資料夾"; KIT_STAGE=$tmp
    if [ "$CONFIG" = - ]; then LC_ALL=C awk 'NR == 1 { sub(/^\357\273\277/, "") } { print }' > "$tmp/paste"
    else
        [ -f "$CONFIG" ] || die_c usage "找不到 $CONFIG"
        LC_ALL=C awk 'NR == 1 { sub(/^\357\273\277/, "") } { print }' "$CONFIG" > "$tmp/paste"
    fi
    case $(LC_ALL=C awk '/^[ \t\r]*#/ { next } { gsub(/[ \t\r]/, ""); printf "%s", $0 }' "$tmp/paste" | head -c 1) in   # (# lines: comments)
        "") die_c bad_config "貼上的內容是空的";;
        "{") form=json
             LC_ALL=C awk -f "$KIT_LIB/json.awk" -v leaves=1 "$tmp/paste" > "$tmp/in" 2>/dev/null || die_c bad_config "JSON 讀不懂（是不是少了括號、逗號或引號？）";;
        "[") form=toml; cp "$tmp/paste" "$tmp/in";;
        *) form=cmd; cp "$tmp/paste" "$tmp/in";;
    esac
    out=$(mcp_awk -v mode=$form -v name="$NAME" "$tmp/in"); mcp_paste_err "$out"
    # a package without a version: pinned to today's newest (the same version on every machine, until you change it)
    IFS=$US read -r kind pkg ver argno bin first bad <<EOF
$(mcp_lines "$out" P | head -n 1 | tr '\t' "$US")
EOF
    # (a range or tag: the newest that matches it; mcp.awk says what it was pinned from)
    if [ -n "$kind" ] && [ -n "$pkg" ] && [ -z "$ver" ] && [ -z "$bad" ]; then
        w=$(mcp_lines "$out" G | head -n 1)
        v=$(mcp_latest "$kind" "$pkg${w:+@$w}")
        if [ -n "$v" ]; then out=$(mcp_awk -v mode=$form -v name="$NAME" -v pin="$v" "$tmp/in"); mcp_paste_err "$out"
        elif [ -n "$w" ]; then notes="查不到 $pkg 符合 $w 的版本（沒網路，或沒有 npm？）：先不固定版本，照原本寫的 @$w 在每次啟動時下載"
        else notes="查不到 $pkg 的最新版本（沒網路，或沒有 $( [ "$kind" = npm ] && echo npm || echo curl )？）：先不固定版本，每次啟動時下載最新的"; fi
    fi
    n=$(mcp_lines "$out" N | head -n 1); t=$(mcp_lines "$out" T | head -n 1)
    dir=$(target_dir "$TO") || exit 1; dst=$(item_path "$dir" mcp "$n")
    [ -e "$dst" ] && exists=true
    if [ -f "$MACHINE" ] && f=$(find_item mcp "$n"); then exists=true; dst=$f; fi
    if [ -n "$LOOK" ]; then
        printf '{"name": %s, "source": %s, "path": %s, "exists": %s, "type": %s, "yaml": %s, "secrets": [%s], "vars": %s, "requires": %s, "packages": [%s], "warnings": %s}\n' \
            "$(json_s "$n")" "$(json_s "$(basename "$(dirname "$(dirname "$dst")")")")" "$(json_s "$dst")" "$exists" "$(json_s "$t")" \
            "$(json_s "$(mcp_lines "$out" Y)$LF")" \
            "$(mcp_lines "$out" X | while IFS="$TAB" read -r w x; do printf '%s{"where": %s, "var": %s}' "${sep:-}" "$(json_s "$w")" "$(json_s "$x")"; sep=", "; done)" \
            "$(mcp_lines "$out" V | json_arr)" "$(mcp_lines "$out" R | json_arr)" \
            "$(mcp_lines "$out" P | tr '\t' "$US" | while IFS=$US read -r kind pkg ver argno bin first bad; do printf '{"kind": %s, "package": %s, "version": %s, "bad": %s}' "$(json_s "$kind")" "$(json_s "$pkg")" "$(json_s "$ver")" "$(json_s "$bad")"; done)" \
            "$( { mcp_lines "$out" W; [ -z "$notes" ] || printf '%s\n' "$notes"; } | json_arr)" >&3
        return 0
    fi
    [ $exists = false ] || die_c exists "已經有 mcp:${n}（${dst}）：換個名字（kit new mcp 新名字 --config …），或先刪掉它"
    { mkdir -p "$(dirname "$dst")" && mcp_lines "$out" Y > "$dst"; } 2>/dev/null || { rm -f "$dst"; die "沒辦法寫 $dst"; }
    say "已建立 ${dst#"$dir"/}（在 $(basename "$dir")）"
    mcp_lines "$out" X | while IFS="$TAB" read -r w x; do say "  $w 像是密碼或 token：檔案裡寫成 \${$x}（值沒有寫進去）"; done
    v=$(mcp_lines "$out" V | paste -sd'|' - | sed 's/|/、/g')
    [ -z "$v" ] || say "  每台電腦要先設定環境變數：$v"
    mcp_lines "$out" W | while IFS= read -r w; do warn "$w"; done
    [ -z "$notes" ] || warn "$notes"
    IFS=$US read -r kind pkg ver argno bin first bad <<EOF
$(mcp_lines "$out" P | head -n 1 | tr '\t' "$US")
EOF
    if [ -n "$kind" ] && [ -n "$ver" ] && [ -z "$bad" ]; then
        say "  套件 $pkg 固定在 $ver 版。先裝好（不然每次啟動時下載）：kit install-deps mcp $n"
    fi
    say "要用它：kit add mcp $n"
    check_dirs "$dir" >/dev/null 2>&1 || warn "kit check 有問題，送出前請先打  kit check  看看"
    return 0
}
cmd_new() {
    parse_item_args "$@"
    if [ -n "$CONFIG" ]; then
        [ "$KIND" = mcp ] && [ -z "$FROM" ] || die_c usage "用法：kit new mcp [名字] --config 檔案|- [--to 來源] [--look]"
        mcp_new_config; return
    fi
    [ -z "$LOOK" ] || die_c usage "--look 要和 --config 一起用：kit new mcp [名字] --config 檔案 --look"
    [ -n "$KIND" ] && [ -n "$NAME" ] || die "用法：kit new rule|skill|mcp|agent <名字> [--from 本機資料夾] [--to 來源]"
    valid_name "$NAME" || die "名字只能用小寫英文、數字和 -：$NAME"
    local dir dst tmp f; dir=$(target_dir "$TO") || exit 1
    dst=$(item_path "$dir" "$KIND" "$NAME")
    [ -e "$dst" ] && die "$(basename "$dir") 已經有 $KIND:${NAME}（要更新用 kit update）"
    if [ -f "$MACHINE" ] && f=$(find_item "$KIND" "$NAME"); then die "名字重複：別的來源已經有 $KIND:${NAME}（${f}）"; fi
    if [ -n "$FROM" ]; then
        tmp=$(mktemp -d "${TMPDIR:-/tmp}/kit-new.XXXXXX")
        f=$(stage_from "$KIND" "$NAME" "$FROM" "$tmp") || { rm -rf "$tmp"; exit 1; }
        dst=$(put_item "$KIND" "$NAME" "$f" "$dir"); rm -rf "$tmp"
        state_set from "$KIND:$NAME@$dir" "$(item_hash "$KIND" "$dst")"
        say "已從 $FROM 帶進 ${dst#"$dir"/}（在 $(basename "$dir")）"
        say "記得刪掉暫存的資料夾：$FROM"
    else
        { mkdir -p "$(dirname "$dst")" && skeleton "$KIND" "$NAME" "$dst"; } 2>/dev/null || { rm -f "$dst"; die "沒辦法寫 $dst"; }
        say "已建立 ${dst#"$dir"/}（在 $(basename "$dir")），打開它寫內容"
    fi
    check_dirs "$dir" >/dev/null 2>&1 || warn "kit check 有問題，送出前請先打  kit check  看看"
    return 0
}

cmd_diff_update() { # cmd_diff_update diff|update ARGS...
    local mode=$1; shift
    parse_item_args "$@"
    [ -n "$NAME" ] && [ -n "$FROM" ] || die "用法：kit $mode [種類] <名字> --from 本機資料夾 [--to 來源]"
    local dir dst tmp f old now
    dir=$(target_dir "$TO") || exit 1
    [ -n "$KIND" ] || KIND=$(guess_kind "$dir" "$NAME") || exit 1
    dst=$(item_path "$dir" "$KIND" "$NAME")
    [ -f "$dst" ] || die "$(basename "$dir") 裡沒有 $KIND:${NAME}（新的用 kit new）"
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/kit-diff.XXXXXX")
    f=$(stage_from "$KIND" "$NAME" "$FROM" "$tmp") || { rm -rf "$tmp"; exit 1; }
    if [ "$mode" = diff ]; then
        if [ "$KIND" = skill ]; then diff -ru -x __pycache__ -x '*.py[co]' "$(dirname "$dst")" "$(dirname "$f")"; else diff -u "$dst" "$f"; fi
        [ $? = 0 ] && say "一樣，沒有要更新的"
        rm -rf "$tmp"; return 0
    fi
    old=$(state_get from "$KIND:$NAME@$dir"); [ -n "$old" ] || old=$(state_from_old "$KIND:$NAME" "$dir"); now=$(item_hash "$KIND" "$dst")
    if [ -z "$FORCE_IT" ] && [ "$old" != "$now" ]; then
        rm -rf "$tmp"
        if [ -z "$old" ]; then die "$KIND:$NAME 不是這台用 kit new --from 帶進來的，不知道有沒有人改過。先 kit diff 看清楚，確定要蓋掉再加 --force"; fi
        die "$KIND:$NAME 在 $(basename "$dir") 被改過（跟上次帶進來的不一樣）。先 kit diff 看差在哪；要保留別人的修改就手動合併，確定要蓋掉再加 --force"
    fi
    if [ "$KIND" = skill ]; then diff -rq -x __pycache__ -x '*.py[co]' "$(dirname "$dst")" "$(dirname "$f")" >/dev/null; else cmp -s "$dst" "$f"; fi && { rm -rf "$tmp"; say "一樣，沒有要更新的"; return 0; }
    dst=$(put_item "$KIND" "$NAME" "$f" "$dir"); rm -rf "$tmp"
    state_set from "$KIND:$NAME@$dir" "$(item_hash "$KIND" "$dst")"
    say "已更新 ${dst#"$dir"/}（在 $(basename "$dir")）。記得刪掉暫存的資料夾：$FROM"
}

# ---------- check ----------
problem() { printf '%s\n' "$*" >> "$PROBLEM_FILE"; printf '%s: %s\n' "${PROBLEM_TAG:-kit check}" "$*" >&2; }
fm_of() { LC_ALL=C awk -f "$KIT_LIB/yaml.awk" -v frontmatter=1 "$1" 2>/dev/null; }
fm_starts() { local l=""; IFS= read -r l 2>/dev/null < "$1"; [ "${l//$'\r'/}" = --- ]; }   # the file starts with a --- line
fm_body() { awk '{ l = $0; sub(/\r$/, "", l) } c >= 2 { print l; next } l == "---" { c++ }' "$1"; }   # the lines after the frontmatter
push_mode() { local m; m=$(yget "$1/kit.yaml" push); printf '%s\n' "${m:-pr}"; }   # push_mode DIR : pr (the default) or direct
fm_val() { local l; while IFS= read -r l; do case $l in "$2$TAB"*|"$2[]$TAB"*) printf '%s\n' "${l#*"$TAB"}";; esac; done <<< "$1"; }
private_words() { # private_words OUT [DIR...] : nonblank lines of the private word lists (this machine, sources, DIRs) into OUT
    local out=$1 d; shift
    { cat "$KIT_CONF/private-words.txt" 2>/dev/null
      [ -f "$MACHINE" ] && src_dirs | while IFS= read -r d; do cat "$d/private-words.txt" 2>/dev/null; done
      for d in "$@"; do cat "$d/private-words.txt" 2>/dev/null; done
    } | sed 's/#.*//; s/^[[:space:]]*//; s/[[:space:]]*$//' | awk 'NF && !seen[$0]++' > "$out"
}
check_dirs() { # check_dirs DIR... : print problems, return 1 if any
    local d f n k v hosts mhosts names pw rel line h ref fm range
    names=$(mktemp "${TMPDIR:-/tmp}/kit-check.XXXXXX"); pw="$names.pw"
    PROBLEM_FILE="$names.problems"; : > "$PROBLEM_FILE"
    # every item name, from the folders checked and the configured sources
    for d in "$@" $( [ -f "$MACHINE" ] && src_dirs ); do
        [ -d "$d" ] || continue
        for f in "$d"/rules/*.md "$d"/skills/*/SKILL.md "$d"/mcp/*.yaml "$d"/agents/*.md "$d"/plugins/*/.claude-plugin/plugin.json; do
            [ -f "$f" ] || continue
            case $f in */.claude-plugin/plugin.json) f=${f%/.claude-plugin/plugin.json}; printf 'plugin:%s\t%s\n' "$(basename "$f")" "$d";; */rules/*) printf 'rule:%s\t%s\n' "$(basename "$f" .md)" "$d";; */skills/*) printf 'skill:%s\t%s\n' "$(basename "$(dirname "$f")")" "$d";;
                        */mcp/*) printf 'mcp:%s\t%s\n' "$(basename "$f" .yaml)" "$d";; *) printf 'agent:%s\t%s\n' "$(basename "$f" .md)" "$d";; esac
        done
    done | awk -F'\t' '!seen[$0]++' > "$names"
    # the same name in two places
    awk -F'\t' '{ c[$1]++; w[$1] = w[$1] " " $2 } END { for (k in c) if (c[k] > 1) print k "\t" w[k] }' "$names" | while IFS="$TAB" read -r k v; do
        problem "名字重複：$k 在$v"
    done
    private_words "$pw"
    for d in "$@"; do
        [ -d "$d" ] || { problem "找不到資料夾 $d"; continue; }
        mhosts=$( { yget "$d/kit.yaml" allowed_hosts; yget "$d/kit.yaml" content_hosts
                    [ -f "$MACHINE" ] && src_dirs | while IFS= read -r v; do yget "$v/kit.yaml" allowed_hosts; yget "$v/kit.yaml" content_hosts; done; } | tr 'A-Z' 'a-z' | awk 'NF && !seen[$0]++')
        # format of each item
        for f in "$d"/skills/*/SKILL.md "$d"/agents/*.md; do
            [ -f "$f" ] || continue
            rel=${f#"$d"/}
            case $f in */SKILL.md) n=$(basename "$(dirname "$f")");; *) n=$(basename "$f" .md);; esac
            valid_name "$n" || problem "$rel: 名字只能用小寫英文、數字和 -"
            fm_starts "$f" && fm=$(fm_of "$f") || { problem "$rel: 開頭要有 --- 包起來的 name、description"; continue; }
            [ "$(fm_val "$fm" name)" = "$n" ] || problem "$rel: name 要寫 $n"
            [ -n "$(fm_val "$fm" description)" ] || problem "$rel: 少了 description"
            case $f in */agents/*)
                for k in rule skill mcp; do      # the keys: rules, skills, mcp
                    v=${k}s; [ $k = mcp ] && v=mcp
                    for ref in $(fm_val "$fm" "$v"); do grep -q "^$k:$ref$TAB" "$names" || problem "$rel: 找不到 $k:$ref"; done
                done
                # for whoever writes it, not a problem: what tools.only can't do in Claude Code
                [ -z "$(fm_val "$fm" tools.only)" ] || warn "$rel: tools.only 在 Claude 是把其他內建工具寫進 deny：Claude 之後新加的內建工具擋不到（要擋就寫進 tools.deny）";;
            esac
        done
        for f in "$d"/plugins/*/; do [ -f "$f.claude-plugin/plugin.json" ] || continue; rel=${f#"$d"/}; valid_name "$(basename "$f")" || problem "${rel%/}: 名字只能用小寫英文、數字和 -"; done
        for f in "$d"/rules/*.md; do [ -f "$f" ] || continue; valid_name "$(basename "$f" .md)" || problem "${f#"$d"/}: 名字只能用小寫英文、數字和 -"; [ -s "$f" ] || problem "${f#"$d"/}: 是空的"; done
        for f in "$d"/mcp/*.yaml; do
            [ -f "$f" ] || continue; rel=${f#"$d"/}
            valid_name "$(basename "$f" .yaml)" || problem "$rel: 名字只能用小寫英文、數字和 -"
            case $(mcp_type "$f") in
                stdio) [ -n "$(yget "$f" command)" ] || problem "$rel: 少了 command";;
                http|sse) [ -n "$(yget "$f" url)" ] || problem "$rel: 少了 url"
                    [ -z "$(yget "$f" command)" ] || problem "$rel: 有 type: http 或 sse（網址的 MCP）就不要 command";;
                *) problem "$rel: type 只能是 stdio、http 或 sse";;
            esac
            # a secret written in the source (the value is never printed): it goes in an environment variable
            mcp_info "$f" 2>/dev/null | awk -F'\t' '$1 == "X" { print $2 "\t" $3 }' | while IFS="$TAB" read -r w v; do
                problem "$rel: $w 看起來是密碼或 token，不能寫在來源裡：改成 \${$v}，值放在每台電腦自己的環境變數"
            done
            for v in $(yget "$f" command) $(yget "$f" args); do
                case $v in
                    git+*|github:*|git@*) problem "$rel: MCP 只能從公司允許的套件來源裝，不能用 $v 這種寫法";;
                    *://*)    # a package index etc.: only a host the sources list (allowed_hosts or content_hosts)
                        h=$(printf '%s' "${v#*://}" | sed -E 's#^[^@/]*@##; s#[:/?#].*$##' | tr 'A-Z' 'a-z')
                        printf '%s\n' "$mhosts" | grep -qxF "$h" || problem "$rel: MCP 只能從公司允許的套件來源裝：$h 不在 allowed_hosts 或 content_hosts";;
                esac
            done
        done
        if [ -f "$d/kit.yaml" ]; then
            case $(push_mode "$d") in pr|direct) ;; *) problem "kit.yaml: push 只能是 pr 或 direct";; esac
            for k in rule skill mcp plugin; do
                for ref in $(yget "$d/kit.yaml" "required.${k}s") $(yget "$d/kit.yaml" "recommended.${k}s"); do
                    grep -q "^$k:$ref$TAB" "$names" || { if [ -n "${CHECK_CI:-}" ] && [ -n "$(yget "$d/kit.yaml" include)" ]; then warn "kit.yaml: $k:$ref 不在這個 repo（應該在 include 的來源）"; else problem "kit.yaml: 找不到 $k:$ref"; fi; }
                done
            done
        fi
        # files: no git inside, no links, text only
        ( cd "$d" && find . -mindepth 1 \( -name .git -prune -o -print \) ) | not_cache | while IFS= read -r f; do
            rel=${f#./}
            if [ -L "$d/$rel" ]; then echo "$rel: 不能放捷徑（symlink）"
            elif [ -f "$d/$rel" ]; then
                case $rel in .gitmodules|*/.gitmodules) echo "$rel: 不能用 git submodule";; esac
                [ -s "$d/$rel" ] && ! LC_ALL=C grep -qI . "$d/$rel" 2>/dev/null && [ "$(LC_ALL=C tr -d '\n' < "$d/$rel" | wc -c)" -gt 0 ] && echo "$rel: 只能放文字檔"
            fi
        done > "$names.files"
        ( cd "$d" && find . -mindepth 2 -name .git | sed 's#^\./##; s#$#: 裡面不能有別的 git repo#' ) >> "$names.files"
        while IFS= read -r line; do problem "$line"; done < "$names.files"
        # URLs only to content_hosts (when the source lists them)
        hosts=$( { yget "$d/kit.yaml" content_hosts; [ -f "$MACHINE" ] && src_dirs | while IFS= read -r v; do yget "$v/kit.yaml" content_hosts; done; } | tr 'A-Z' 'a-z' | awk 'NF && !seen[$0]++')
        if [ -n "$hosts" ]; then
            LC_ALL=C grep -rnIoE --exclude-dir=.git --exclude-dir=__pycache__ --exclude='*.py[co]' '(https?|ssh|git)://[^][ "<>()`'"'"']+|git@[A-Za-z0-9.-]+:' "$d" 2>/dev/null | while IFS= read -r line; do
                v=${line#*:*:}; h=$(url_host "$v")
                printf '%s\n' "$hosts" | grep -qxF "$h" || echo "${line%%:*}" "$(printf '%s' "$line" | cut -d: -f2)" "$h"
            done | while read -r f n h; do problem "${f#"$d"/}:$n: 網址 $h 不在 content_hosts"; done
        fi
        # private words (only the place, never the word); not in a source its kit.yaml calls private (private: true:
        # never made public, so it may name the private things; kit export-self still checks)
        if [ -s "$pw" ] && [ "$(yget "$d/kit.yaml" private 2>/dev/null)" != true ]; then
            LC_ALL=C grep -rnIiF -f "$pw" --exclude-dir=.git --exclude-dir=__pycache__ --exclude='*.py[co]' --exclude=private-words.txt "$d" 2>/dev/null | cut -d: -f1,2 | while IFS= read -r line; do problem "${line#"$d"/}: 有不該公開的字"; done
            ( cd "$d" && find . -mindepth 1 -name .git -prune -o -print ) | not_cache | sed 's#^\./##' | grep -iF -f "$pw" | while IFS= read -r line; do problem "$line: 檔名有不該公開的字"; done
        fi
        # --ci: commit author emails
        if [ -n "${CHECK_CI:-}" ] && [ -d "$d/.git" ]; then
            v=$(yget "$d/kit.yaml" author_domains)
            if [ -n "$v" ]; then
                if [ -n "${KIT_CI_BASE:-}" ]; then range="$KIT_CI_BASE..HEAD"; else range="-1"; fi
                git -C "$d" log --format='%h %ae' "$range" 2>/dev/null | while read -r h line; do
                    printf '%s\n' "$v" | grep -qixF "${line##*@}" || problem "commit $h: 作者 email 不是公司網域"
                done
            fi
        fi
    done
    PROBLEMS=$(wc -l < "$PROBLEM_FILE" | tr -d ' ')
    rm -f "$names" "$names.files" "$pw" "$PROBLEM_FILE"
    [ "$PROBLEMS" = 0 ]
}

cmd_check() {
    local dirs=() a
    for a in "$@"; do
        case $a in --ci) CHECK_CI=1;; -*) die "不認得 $a";; *) dirs+=("$(real_dir "$a" || echo "$a")");; esac
    done
    if [ ${#dirs[@]} = 0 ]; then
        if [ -f ./kit.yaml ] || [ -n "${CHECK_CI:-}" ]; then dirs=("$(pwd -P)")
        else need_init; while IFS= read -r a; do dirs+=("$a"); done <<EOF
$(src_dirs)
EOF
        fi
    fi
    if check_dirs "${dirs[@]}"; then say "kit check：沒問題（${#dirs[@]} 個來源）"; else printf 'kit check：%s 個問題\n' "$PROBLEMS" >&2; exit 1; fi
}

# ---------- export-self: a clean copy of kit's own source, for a company git server ----------
kit_repo() { # the clone kit was installed from, else the repo this kit runs from
    local d
    d=$(cat "$KIT_LIB/.repo" 2>/dev/null)
    if [ -n "$d" ] && [ -f "$d/unix/kit" ] && [ -f "$d/windows/kit.ps1" ]; then printf '%s\n' "$d"; return 0; fi
    d=$KIT_LIB
    while [ -n "$d" ] && [ "$d" != / ] && [ "$d" != . ]; do
        [ -f "$d/unix/kit" ] && [ -f "$d/windows/kit.ps1" ] && { printf '%s\n' "$d"; return 0; }
        d=$(dirname "$d")
    done
    return 1
}
export_skip() { # files that stay out of the export (README goes along: it is the manual; the scan below still checks it)
    case /$1 in */.github/*) return 0;; esac
    case $(basename "$1" | tr 'A-Z' 'a-z') in changelog*|license*|licence*|private-words.txt) return 0;; esac
    return 1
}
mask_paths() { # mask_paths WORDFILE : paths on stdin -> those with a word in them, each such part shown as <不公開>
    awk 'NR == FNR { if (NF) w[++n] = tolower($0); next }
         { k = split($0, p, "/"); s = ""; hit = 0
           for (i = 1; i <= k; i++) {
               q = p[i]
               for (j = 1; j <= n; j++) if (index(tolower(q), w[j])) { q = "<不公開>"; hit = 1; break }
               s = s (i > 1 ? "/" : "") q
           }
           if (hit) print s }' "$1" -
}
install_md() { # INSTALL.md of the export (no URLs; the same text as kit.ps1 writes)
    cat <<'EOF'
# 安裝 kit

先把公司的 agentkit repo clone 下來（網址問管理這個 repo 的人），再照你的系統做。
第一次用（特別是 Windows）：照 docs/company.md 從頭做一次，從安裝到第一次送出修改都有。

## Windows

在 clone 的資料夾裡打：

    powershell -NoProfile -ExecutionPolicy Bypass -File windows\install.ps1

不用管理員權限。開新的終端機後，在 cmd 和 PowerShell 都能打 `kit`。

## Linux / Mac

需要 bash、awk、git。Mac 還沒有 git 的話，先打 `xcode-select --install`。
在 clone 的資料夾裡打：

    sh unix/install.sh

開新的終端機後就能打 `kit`。

## 裝好以後

    kit init <團隊來源的網址>
    kit help

每個指令的用法看 README.md，各版改了什麼看 docs/changes.md。
EOF
}
cmd_export_self() {
    local out="" ver="" repo line mode rel f n probs
    while [ $# -gt 0 ]; do
        case $1 in
            --version) ver=${2:-}; [ -n "$ver" ] || die "--version 後面要接版本，例：0.2.0+gitea.1"; shift 2;;
            -*) die "不認得 $1";;
            *) [ -z "$out" ] || die "多了一個參數：$1"; out=$1; shift;;
        esac
    done
    [ -n "$out" ] || die "用法：kit export-self <資料夾> [--version <版本>]"
    case $ver in *[!A-Za-z0-9.+_-]*) die "版本只能用英文、數字和 . + - _：$ver";; esac
    repo=$(kit_repo) || die "找不到 kit 的原始碼（有 unix/kit 和 windows/kit.ps1 的 git clone）"
    git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || die "$repo 不是 git repo"
    if [ -e "$out" ] || [ -L "$out" ]; then
        [ -d "$out" ] && [ ! -L "$out" ] && [ -z "$(ls -A "$out")" ] || die "$out 已經存在而且不是空的；請給一個新的資料夾"
    fi
    mkdir -p "$out" || die "沒辦法建立 $out"
    out=$(cd "$out" && pwd)
    [ -z "$(git -C "$repo" status --porcelain --untracked-files=no 2>/dev/null)" ] || warn "$repo 有還沒 commit 的改動，匯出的是資料夾裡現在的檔案"

    PROBLEM_TAG="kit export-self"; PROBLEM_FILE=$(mktemp "${TMPDIR:-/tmp}/kit-export.XXXXXX")
    # only files git tracks (the index), taken from the working folder
    while IFS= read -r -d '' line; do
        mode=${line%% *}; rel=${line#*"$TAB"}
        export_skip "$rel" && continue
        case $mode in
            120000) problem "$rel: 不能放捷徑（symlink）"; continue;;
            160000) problem "$rel: 不能用 git submodule"; continue;;
        esac
        f="$repo/$rel"
        [ -f "$f" ] && [ ! -L "$f" ] || { warn "$rel 在 git 裡有、資料夾裡沒有，跳過"; continue; }
        mkdir -p "$(dirname "$out/$rel")" && cp "$f" "$out/$rel" || { rm -rf "$out" "$PROBLEM_FILE"; die "沒辦法複製 $rel"; }
        [ "$mode" = 100755 ] && chmod 755 "$out/$rel"
    done < <(git -C "$repo" -c core.quotepath=off ls-files -s -z)
    install_md > "$out/INSTALL.md"
    [ -n "$ver" ] && printf '%s\n' "$ver" > "$out/VERSION"

    # nothing that points back to GitHub or names private things; text files only
    printf '%s\n' 'github''.com' 'github''usercontent' 'noreply''.github' > "$PROBLEM_FILE.gh"   # split so the export does not flag itself
    private_words "$PROBLEM_FILE.pw" "$repo"
    ( cd "$out" && find . -type f | sed 's#^\./##' | LC_ALL=C sort ) > "$PROBLEM_FILE.files"
    while IFS= read -r rel; do
        f="$out/$rel"
        case $(printf '%s' "$rel" | tr 'A-Z' 'a-z') in
            *.exe|*.dll|*.so|*.dylib|*.msi|*.bin|*.jar|*.class|*.pyc|*.o|*.a|*.lib|*.zip|*.gz|*.tgz|*.7z|*.rar) problem "$rel: 不能放執行檔或壓縮檔"; continue;;
        esac
        [ -s "$f" ] && ! LC_ALL=C grep -qI . "$f" 2>/dev/null && [ "$(LC_ALL=C tr -d '\n' < "$f" | wc -c)" -gt 0 ] && problem "$rel: 只能放文字檔"
    done < "$PROBLEM_FILE.files"
    ( cd "$out" && LC_ALL=C grep -rnIiF -f "$PROBLEM_FILE.gh" . 2>/dev/null ) | cut -d: -f1,2 | sed 's#^\./##' | while IFS= read -r line; do problem "${line}: 有 GitHub 的字"; done
    mask_paths "$PROBLEM_FILE.gh" < "$PROBLEM_FILE.files" | while IFS= read -r line; do problem "${line}: 檔名有 GitHub 的字"; done
    if [ -s "$PROBLEM_FILE.pw" ]; then
        ( cd "$out" && LC_ALL=C grep -rnIiF -f "$PROBLEM_FILE.pw" . 2>/dev/null ) | cut -d: -f1,2 | sed 's#^\./##' | while IFS= read -r line; do problem "${line}: 有不該公開的字"; done
        mask_paths "$PROBLEM_FILE.pw" < "$PROBLEM_FILE.files" | while IFS= read -r line; do problem "${line}: 檔名有不該公開的字"; done
    fi
    n=$(wc -l < "$PROBLEM_FILE.files" | tr -d ' ')
    probs=$(wc -l < "$PROBLEM_FILE" | tr -d ' ')
    rm -f "$PROBLEM_FILE" "$PROBLEM_FILE.gh" "$PROBLEM_FILE.pw" "$PROBLEM_FILE.files"
    if [ "$probs" != 0 ]; then
        rm -rf "$out"
        die "匯出失敗：${probs} 個問題，已刪掉 ${out}。在 kit 的 repo 改好再匯出一次"
    fi
    [ -n "$ver" ] || ver=$(cat "$out/VERSION" 2>/dev/null) || ver=""
    [ -n "$ver" ] || ver="（沒有 VERSION）"
    say "kit：已匯出 ${n} 個檔案到 ${out}（版本 ${ver}）"
    say "下一步（在公司）：在 Gitea 的 agentkit repo clone 裡，刪掉 .git 以外的舊檔案，"
    say "  放進這個資料夾的內容後 commit，訊息只寫：kit ${ver}"
}
