#!/usr/bin/env bash
# kit - manage rules, skills, MCP servers, tool permissions and agents
# for AI coding tools. Linux and macOS version (bash 3.2+, POSIX awk).
#
# No network access except the git URLs you give it, and only to hosts
# allowed by the sources' kit.yaml (allowed_hosts).

set -u
KIT_LIB=$(cd "$(dirname "$0")" && pwd)
[ -f "$KIT_LIB/json.awk" ] || KIT_LIB=$(cd "$(dirname "$(readlink "$0" 2>/dev/null || echo "$0")")" && pwd)
KIT_VERSION=$(cat "$KIT_LIB/VERSION" 2>/dev/null || cat "$KIT_LIB/../VERSION" 2>/dev/null || echo dev)
# what programs read (kit api): MAJOR.MINOR; MAJOR +1 when something changes incompatibly, MINOR +1 when fields or
# commands are added. kit.ps1 has the same.
KIT_API=1.4
KIT_CONF=${AGENTKIT_CONFIG:-$HOME/.config/agentkit}
KIT_SRC=${AGENTKIT_SOURCES:-$HOME/agentkit}
MACHINE="$KIT_CONF/machine.yaml"
STATE="$KIT_CONF/state.tsv"
FORCE=   # only kit sync --force sets it (never taken from the environment)
if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    CLAUDE_DIR=$CLAUDE_CONFIG_DIR; CLAUDE_JSON=$CLAUDE_CONFIG_DIR/.claude.json
else
    CLAUDE_DIR=$HOME/.claude; CLAUDE_JSON=$HOME/.claude.json
fi
CODEX_DIR=${CODEX_HOME:-$HOME/.codex}
OMP_DIR=${PI_CODING_AGENT_DIR:-$HOME/.omp/agent}
AGENTS_SKILLS=$HOME/.agents/skills          # read by Codex and omp
TAB=$(printf '\t')
LF=$'\n'
BEGIN_MARK='<!-- agentkit:begin (managed by kit, do not edit) -->'
END_MARK='<!-- agentkit:end -->'
TOML_BEGIN='# agentkit:begin (managed by kit, do not edit)'
TOML_END='# agentkit:end'
KINDS="rule skill mcp agent"
TOP_BEGIN='# agentkit:top:begin (managed by kit, do not edit)'
TOP_END='# agentkit:top:end'
DIRS_LIST="$KIT_CONF/dirs"                  # the folders that have their own (kit add --dir), one per line
DIR_FILE=.agentkit                          # in such a folder: what it has; Codex also takes it as the project root

# ---------- small helpers ----------
# With --json (list, agents, push) or collect --look, stdout carries only JSON: kit's words go to stderr, and a stop is
# also told on stdout as {"error": {"code": CODE, "message": the same words}} (kit.ps1 prints the same).
JSON_OUT=""; DIE_CODE=""
json_mode() { JSON_OUT=1; exec 3>&1 1>&2; }      # the JSON goes to fd 3 (stdout); everything else to stderr
die()  {
    printf 'kit: %s\n' "$*" >&2
    [ -z "$JSON_OUT" ] || printf '{"error": {"code": %s, "message": %s%s}}\n' "$(json_s "${DIE_CODE:-error}")" "$(json_s "$*")" "${DIE_EXTRA:-}" >&3
    exit 1
}
die_c() { DIE_CODE=$1; shift; die "$@"; }       # die_c CODE MESSAGE : the code programs read (README: 給程式讀的介面)
# on the way out (also after die or Ctrl-C): the temp folder (a token in it, or npm packages half installed), kit run's
# folder and marker, the venv a stopped pip install had replaced, and the lock if this kit took it
on_exit() {
    [ -z "${KIT_TMPDIR:-}" ] || rm -rf "$KIT_TMPDIR"
    [ -z "${KIT_STAGE:-}" ] || rm -rf "$KIT_STAGE"
    [ -z "${KIT_RUN_TMP:-}" ] || { rm -rf "$KIT_RUN_TMP"; rm -f "$KIT_CONF/run/$$"; }
    [ -z "${KIT_PIP_STORE:-}" ] || pip_back "$KIT_PIP_STORE"
    [ -z "${KIT_LOCK_MINE:-}" ] || rmdir "$KIT_CONF/sync.lock" 2>/dev/null
}
trap on_exit EXIT
trap 'exit 130' INT TERM HUP
take_lock() { # take_lock [soft] : one kit at a time changes state.tsv and the tools' files (the background sync takes the same lock)
    # soft: give up quietly after a few seconds (return 1) instead of stopping
    [ -z "${KIT_LOCKED:-}" ] || return 0
    local lock="$KIT_CONF/sync.lock" i=0 max=${KIT_LOCK_WAIT:-60}
    [ "${1:-}" = soft ] && max=5
    mkdir -p "$KIT_CONF" 2>/dev/null || return 0
    until mkdir "$lock" 2>/dev/null; do
        # left by a kit that was killed: older than 10 minutes
        [ -n "$(find "$lock" -maxdepth 0 -mmin +10 2>/dev/null)" ] && rmdir "$lock" 2>/dev/null && continue
        i=$((i + 1))
        if [ $i -gt "$max" ]; then
            [ "${1:-}" = soft ] && return 1
            die_c busy "另一個 kit 正在跑（${lock}），等它跑完再試一次"
        fi
        [ $i = 3 ] && [ "${1:-}" != soft ] && warn "等另一個 kit 跑完…"
        sleep 1
    done
    KIT_LOCK_MINE=1; KIT_LOCKED=1
}
release_lock() { [ -z "${KIT_LOCK_MINE:-}" ] || rmdir "$KIT_CONF/sync.lock" 2>/dev/null; KIT_LOCK_MINE=; KIT_LOCKED=; }
say()  { [ -n "${QUIET:-}" ] || printf '%s\n' "$*"; }
warn() { printf 'kit: %s\n' "$*" >&2; }

yaml()     { LC_ALL=C awk -f "$KIT_LIB/yaml.awk" "$@"; }
# yget FILE PATH -> values (one per line) for PATH or PATH[]
yget() { [ -f "$1" ] || return 0; yaml "$1" | awk -F'\t' -v p="$2" '$1 == p || $1 == p "[]" { sub(/^[^\t]*\t/, ""); print }'; }

json_edit() { # json_edit FILE OPSFILE : edit FILE, keep a backup
    # Other programs (a running Claude) may write FILE at any time, so:
    # edit a snapshot, and only swap the result in (atomic rename) if FILE did
    # not change meanwhile; otherwise try again.
    local f=$1 ops=$2 snap tmp try new=0
    [ -f "$f" ] || { mkdir -p "$(dirname "$f")"; printf '{}\n' > "$f"; new=1; }
    snap=$(mktemp "$f.kit.XXXXXX") || die "cannot write next to $f"
    tmp=$(mktemp "$f.kit.XXXXXX") || { rm -f "$snap"; die "cannot write next to $f"; }
    for try in 1 2 3 4 5; do
        cp -p "$f" "$snap" && cp -p "$f" "$tmp" || break     # tmp gets f's permissions
        if ! { LC_ALL=C awk -f "$KIT_LIB/json.awk" -v ops="$ops" "$snap" > "$tmp" &&
               LC_ALL=C awk -f "$KIT_LIB/json.awk" "$tmp" > /dev/null; }; then
            rm -f "$snap" "$tmp"; die "沒辦法更新 ${f}（檔案沒有被改動）"
        fi
        if cmp -s "$snap" "$f"; then
            # the backup is the file as it was before kit first changed it (later edits do not replace it)
            [ $new = 1 ] || [ -e "$f.kit-backup" ] || cp -p "$snap" "$f.kit-backup" 2>/dev/null
            if [ -L "$f" ]; then cat "$tmp" > "$f"; rm -f "$tmp"; else mv -f "$tmp" "$f"; fi
            rm -f "$snap"; return 0
        fi
        sleep 1                                             # someone else wrote it; retry
    done
    rm -f "$snap" "$tmp"; die "沒辦法更新 ${f}：別的程式一直在寫它（檔案沒有被改動）"
}
prune_empty() { # prune_empty FILE PATH... : delete each PATH whose value is [] or {} (in order)
    local f=$1 p v ops; shift
    [ -f "$f" ] || return 0
    ops=$(mktemp "${TMPDIR:-/tmp}/kit-ops.XXXXXX")
    for p in "$@"; do
        v=$(json_get "$f" "$p" | tr -d ' \n')
        if [ "$v" = "[]" ] || [ "$v" = "{}" ]; then printf 'del\t%s\n' "$p" > "$ops"; json_edit "$f" "$ops"; fi
    done
    rm -f "$ops"
}
prune_deny() { prune_empty "$CLAUDE_DIR/settings.json" permissions.deny permissions hooks.SessionStart hooks; }

json_get() { LC_ALL=C awk -f "$KIT_LIB/json.awk" -v get="$2" "$1" 2>/dev/null; }
json_strs() { # json_strs FILE A.B : the strings in the array at A.B, as JSON text ("..."), one per line (json_str NAME is one)
    [ -f "$1" ] || return 0
    LC_ALL=C awk -f "$KIT_LIB/json.awk" -v leaves=1 "$1" 2>/dev/null | awk -F'\t' -v p="$2" '
        BEGIN { n = split(p, K, ".") } NF == n + 2 { for (i = 1; i <= n; i++) if ($i != K[i]) next; if ($NF ~ /^"/) print $NF }'
}

json_str() { # quote a string for JSON
    local s=$1
    s=${s//\\/\\\\}; s=${s//\"/\\\"}
    s=${s//$TAB/\\t}
    printf '"%s"' "$s"
}

dir_hash() { # content hash of a directory (portable: cksum)
    ( cd "$1" && find . -type f ! -name '.DS_Store' | LC_ALL=C sort | while IFS= read -r f; do printf '%s ' "$f"; cksum < "$f"; done ) | cksum | awk '{print $1}'
}

# ---------- state ----------
# state.tsv lines: kind<TAB>name<TAB>detail
state_get() { [ -f "$STATE" ] && awk -F'\t' -v k="$1" -v n="$2" '$1 == k && $2 == n { print $3; exit }' "$STATE"; }
state_list() { [ -f "$STATE" ] && awk -F'\t' -v k="$1" '$1 == k { print $2 }' "$STATE"; }
state_set() {
    local t
    mkdir -p "$KIT_CONF"; touch "$STATE"
    t=$(mktemp "$STATE.XXXXXX") || die "沒辦法寫 $STATE"
    awk -F'\t' -v k="$1" -v n="$2" '!($1 == k && $2 == n)' "$STATE" > "$t"
    [ $# -ge 3 ] && printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$t"
    mv -f "$t" "$STATE"
}
state_from_old() { # state_from_old KIND:NAME DIR : a "from" entry written before 0.3.0 with the folder as typed (links in it)
    [ -f "$STATE" ] || return 0
    awk -F'\t' -v p="$1@" '$1 == "from" && index($2, p) == 1 { print substr($2, length(p) + 1) "\t" $3 }' "$STATE" |
        while IFS="$TAB" read -r d h; do [ "$(real_dir "$d")" = "$2" ] && { printf '%s\n' "$h"; break; }; done
}
state_del() {
    local t
    [ -f "$STATE" ] || return 0
    t=$(mktemp "$STATE.XXXXXX") || die "沒辦法寫 $STATE"
    awk -F'\t' -v k="$1" -v n="$2" '!($1 == k && $2 == n)' "$STATE" > "$t"; mv -f "$t" "$STATE"
}

# ---------- machine.yaml ----------
m_sources() { yget "$MACHINE" sources; }
M_APPROVALS=$(yget "$MACHINE" approvals 2>/dev/null); M_SIGNERS=$(yget "$MACHINE" signers 2>/dev/null)
m_added()   { yget "$MACHINE" added; }
m_removed() { yget "$MACHINE" removed; }

write_machine() { # write_machine SOURCES ADDED REMOVED (newline separated lists)
    local t
    mkdir -p "$KIT_CONF"
    t=$(mktemp "$MACHINE.XXXXXX") || die "沒辦法寫 $MACHINE"
    {
        echo "# written by kit - use kit add / kit rm instead of editing"
        echo "sources:            # earlier sources win when names repeat"
        printf '%s\n' "$1" | awk 'NF { print "  - " $0 }'
        printf 'added: [%s]\n'   "$(printf '%s\n' "$2" | awk 'NF' | paste -sd, - | sed 's/,/, /g')"
        printf 'removed: [%s]    # kit rm; sync will not add these back\n' "$(printf '%s\n' "$3" | awk 'NF' | paste -sd, - | sed 's/,/, /g')"
        if [ -n "${M_APPROVALS:-}" ]; then
            echo "# only signed, approved versions of the sources are used (kit approve)"
            printf 'approvals: %s\nsigners: %s\n' "$M_APPROVALS" "$M_SIGNERS"
        fi
    } > "$t" && mv -f "$t" "$MACHINE"
}

# ---------- sources ----------
is_url() { # a git URL: scheme://..., user@host:path, or host:path (git's scp form; a drive letter C: is a folder)
    case $1 in
        *://*|*@*:*) return 0;;
        [A-Za-z]:|[A-Za-z]:[\\/]*|/*|./*|../*|~*) return 1;;
        *:*) case ${1%%:*} in ""|*/*) return 1;; *) return 0;; esac;;
        *) return 1;;
    esac
}
url_host() { printf '%s\n' "$1" | sed -E 's#^[A-Za-z][A-Za-z0-9+.-]*://##; s#^[^@/]*@##; s#[:/].*$##' | tr 'A-Z' 'a-z'; }
url_safe() { printf '%s\n' "$1" | sed -E 's#^([A-Za-z][A-Za-z0-9+.-]*://)[^/@]*@#\1#'; }   # a URL without user:password@ (never printed or kept)
has_creds() { # an http(s) URL with user[:password]@ in it (a token in the URL)
    local a
    case $1 in [Hh][Tt][Tt][Pp]://*|[Hh][Tt][Tt][Pp][Ss]://*) a=${1#*://}; a=${a%%/*}; case $a in *@*) return 0;; esac;; esac
    return 1
}
src_name() { basename "$1" .git; }
real_dir() { (CDPATH= cd "$1" 2>/dev/null && pwd -P); }   # real_dir DIR : DIR with links resolved; fails when it is not there
src_dir() { # local checkout of a source, links resolved: the same folder always has the same name (kit.ps1: Canon-Dir)
    local d; if is_url "$1"; then d="$KIT_SRC/$(src_name "$1")"; else d=$1; fi
    real_dir "$d" || printf '%s\n' "$d"
}
src_dirs() { m_sources | while IFS= read -r s; do src_dir "$s"; done; }

allowed_hosts() { # kit push: the source's own list when it has one; else every configured source's (+ the source kit push sends from)
    local own=""
    [ -n "${PUSH_DIR:-}" ] && own=$(yget "$PUSH_DIR/kit.yaml" allowed_hosts | awk 'NF')
    if [ -n "$own" ]; then printf '%s\n' "$own"
    else { [ -f "$MACHINE" ] && src_dirs; [ -n "${PUSH_DIR:-}" ] && printf '%s\n' "$PUSH_DIR"; } | while IFS= read -r d; do yget "$d/kit.yaml" allowed_hosts; done
    fi | tr 'A-Z' 'a-z' | awk 'NF && !seen[$0]++'
}

check_host() { # refuse URLs whose host is not allowed
    local url=$1 hosts h
    is_url "$url" || return 0
    hosts=$(allowed_hosts)
    [ -n "$hosts" ] || return 0
    case $url in
        [Ff][Ii][Ll][Ee]:///*) ;;     # file:///path: a folder on this machine, no host to ask
        *) h=$(url_host "$url")
           printf '%s\n' "$hosts" | grep -qxF "$h" || die_c host_not_allowed "$h 不在允許的主機清單：$(printf '%s' "$hosts" | paste -sd' ' -)";;
    esac
    # git config "insteadOf" rules can rewrite a URL; check where git really goes
    local real; real=$(git ls-remote --get-url "$url" 2>/dev/null)
    [ -z "$real" ] || [ "$real" = "$url" ] || ! is_url "$real" || { h=$(url_host "$real"); printf '%s\n' "$hosts" | grep -qxF "$h" || die_c host_not_allowed "git 設定把網址改到 ${h}，不在允許的主機清單"; }
    return 0
}
push_urls() { # push_urls REMOTE : every URL git may push REMOTE to (pushurl else url, insteadOf applied; pushInsteadOf too)
    local u k v
    git remote get-url --push --all "$1" 2>/dev/null | while IFS= read -r u; do
        [ -n "$u" ] || continue
        printf '%s\n' "$u"
        git config --get-regexp '^url\..*\.pushinsteadof$' 2>/dev/null | while read -r k v; do
            [ -n "$v" ] || continue
            case $u in "$v"*) k=${k#url.}; printf '%s%s\n' "${k%.[pP][uU][sS][hH][iI][nN][sS][tT][eE][aA][dD][oO][fF]}" "${u#"$v"}";; esac
        done
    done
}
check_push_urls() { # check_push_urls REMOTE : refuse when git would push REMOTE to a host that is not allowed
    local u
    while IFS= read -r u; do [ -z "$u" ] || check_host "$u"; done <<EOF
$(push_urls "$1")
EOF
    return 0
}

git_safe() { # git without prompts (no password question, no sign-in window, no ssh question), submodules or LFS downloads
    if [ -z "${GIT_SSH_COMMAND:-}" ] && [ -z "$(git config core.sshCommand 2>/dev/null)" ]; then
        GIT_SSH_COMMAND='ssh -o BatchMode=yes' GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never GIT_LFS_SKIP_SMUDGE=1 git "$@"
    else
        GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never GIT_LFS_SKIP_SMUDGE=1 git "$@"
    fi
}
git_err() { # git_err FILE : the last lines git wrote there, for the message (no user:password@)
    [ -s "$1" ] && sed -E 's#(://)[^/@ ]*@#\1#g' "$1" | tail -n 3 | sed 's/^/    /' >&2
    rm -f "$1"
}

# ---------- signed approvals (for accounts, like root, that must not follow sources blindly) ----------
# approved.txt (in the approvals repo) lists "<repo name> <commit>" lines and "serial: N";
# approved.txt.sig is an ssh signature (namespace agentkit) checked against the signers file.
APPROVED=""; APPROVED_READ=""
approvals_dir() { printf '%s/.approvals\n' "$KIT_SRC"; }
read_approvals() { # sets APPROVED ("name sha" lines); returns 1 when there is no valid signed list
    [ -n "$APPROVED_READ" ] && { [ -n "$APPROVED" ]; return; }
    APPROVED_READ=1
    local d f serial old
    d=$(approvals_dir)
    if is_url "$M_APPROVALS"; then
        check_host "$M_APPROVALS"
        if [ -d "$d/.git" ]; then git_safe -C "$d" pull --ff-only -q --no-recurse-submodules || warn "沒辦法更新核准紀錄（沒網路？）"
        else mkdir -p "$KIT_SRC"; git_safe clone -q --no-recurse-submodules "$M_APPROVALS" "$d" || { warn "沒辦法 clone 核准紀錄 $M_APPROVALS"; return 1; }; fi
    else d=$M_APPROVALS; fi
    f="$d/approved.txt"
    [ -f "$f" ] && [ -f "$f.sig" ] || { warn "核准紀錄裡沒有 approved.txt 和 approved.txt.sig"; return 1; }
    [ -f "$M_SIGNERS" ] || { warn "找不到 signers 檔：$M_SIGNERS"; return 1; }
    approvals_sig_ok "$f" || { warn "核准紀錄的簽章不對，不換版本（有人改過 approved.txt？）"; return 1; }
    serial=$(awk '$1 == "serial:" { print $2; exit }' "$f"); old=$(state_get approvals serial)
    case $serial in ""|*[!0-9]*) warn "核准紀錄沒有 serial"; return 1;; esac
    if [ -n "$old" ] && [ "$serial" -lt "$old" ]; then warn "核准紀錄比上次用的舊（serial ${serial} < ${old}），不換版本"; return 1; fi
    state_set approvals serial "$serial"
    APPROVED=$(awk 'NF == 2 && $1 !~ /^#/ && $1 != "serial:"' "$f")
    [ -n "$APPROVED" ]
}
approvals_sig_ok() { # approvals_sig_ok FILE : FILE.sig is a good signature of FILE by the signers file (only reads files)
    local p
    p=$(ssh-keygen -Y find-principals -s "$1.sig" -f "$M_SIGNERS" 2>/dev/null | head -n 1)
    [ -n "$p" ] && ssh-keygen -Y verify -f "$M_SIGNERS" -I "$p" -n agentkit -s "$1.sig" < "$1" >/dev/null 2>&1
}
approved_sha() { # approved_sha NAME
    read_approvals || return 1
    printf '%s\n' "$APPROVED" | awk -v n="$1" '$1 == n { print $2; exit }' | grep .
}
fetch_approved() { # fetch_approved URL DIR : check out the approved commit of a source, never anything else
    local s=$1 d=$2 n sha cur
    n=$(src_name "$s")
    if ! sha=$(approved_sha "$n"); then
        [ -d "$d/.git" ] && { warn "$n 沒有有效的核准，繼續用現在的版本"; return 0; }
        die "$n 還沒核准，不能用（先在簽核的機器上 kit approve）"
    fi
    if [ -d "$d/.git" ]; then git_safe -C "$d" fetch -q --no-recurse-submodules origin || warn "沒辦法更新 ${n}（沒網路？）"
    else mkdir -p "$KIT_SRC"; git_safe clone -q --no-checkout --no-recurse-submodules "$s" "$d" || die "沒辦法 clone $s"; fi
    cur=$(git -C "$d" rev-parse -q --verify HEAD 2>/dev/null)
    [ "$cur" = "$sha" ] && [ -z "$(git -C "$d" status --porcelain 2>/dev/null)" ] && return 0
    git -C "$d" -c advice.detachedHead=false checkout -q -f --detach "$sha" 2>/dev/null || { warn "$n 找不到核准的版本 $(printf %.12s "$sha")（還沒 push？），繼續用現在的版本"; return 0; }
    git -C "$d" clean -qfdx
    say "kit：$n 換到核准的版本 $(printf %.12s "$sha")"
}

pull_why() { # pull_why DIR : why git pull --ff-only did not work there
    local n
    git_safe -C "$1" fetch --quiet --no-recurse-submodules 2>/dev/null || { echo "沒網路？"; return; }
    [ -z "$(git -C "$1" status --porcelain 2>/dev/null)" ] || { echo "$1 裡有自己改過、還沒送出的檔案；先送出或拿掉"; return; }
    n=$(git -C "$1" rev-list --count '@{u}..HEAD' 2>/dev/null) || n=0
    [ "$n" = 0 ] || { echo "$1 有 $n 個來源沒有的 commit，跟來源分岔了"; return; }
    echo "到 $1 打 git pull 看原因"
}
fetch_source() { # clone or fast-forward one source
    local s=$1 d
    is_url "$s" || { [ -d "$s" ] || die "找不到來源資料夾：$s"; return 0; }
    check_host "$s"
    d=$(src_dir "$s")
    [ -n "$M_APPROVALS" ] && { fetch_approved "$s" "$d"; return 0; }
    local err; err=$(mktemp "${TMPDIR:-/tmp}/kit-git.XXXXXX")
    if [ -d "$d/.git" ]; then
        git_safe -C "$d" pull --ff-only --quiet --no-recurse-submodules 2>"$err" || { warn "沒辦法更新 $(src_name "$s")（$(pull_why "$d")）"; git_err "$err"; }
    else
        mkdir -p "$KIT_SRC"
        git_safe clone --quiet --no-recurse-submodules "$s" "$d" 2>"$err" || { warn "沒辦法 clone $(url_safe "$s")，git 說："; git_err "$err"; exit 1; }
    fi
    rm -f "$err"
}

item_path() { # item_path DIR KIND NAME
    case $2 in
        rule)  printf '%s/rules/%s.md\n' "$1" "$3";;
        skill) printf '%s/skills/%s/SKILL.md\n' "$1" "$3";;
        mcp)   printf '%s/mcp/%s.yaml\n' "$1" "$3";;
        agent) printf '%s/agents/%s.md\n' "$1" "$3";;
    esac
}
find_item() { # find_item KIND NAME -> path of the first source that has it
    local d p
    while IFS= read -r d; do
        p=$(item_path "$d" "$1" "$2")
        [ -f "$p" ] && { printf '%s\n' "$p"; return 0; }
    done <<EOF
$(src_dirs)
EOF
    return 1
}
available() { # all kind:name in all sources
    src_dirs | while IFS= read -r d; do
        for f in "$d"/rules/*.md;          do [ -f "$f" ] && echo "rule:$(basename "$f" .md)"; done
        for f in "$d"/skills/*/SKILL.md;   do [ -f "$f" ] && echo "skill:$(basename "$(dirname "$f")")"; done
        for f in "$d"/mcp/*.yaml;          do [ -f "$f" ] && echo "mcp:$(basename "$f" .yaml)"; done
        for f in "$d"/agents/*.md;         do [ -f "$f" ] && echo "agent:$(basename "$f" .md)"; done
    done | awk '!seen[$0]++'
}
required_items() {
    src_dirs | while IFS= read -r d; do
        for k in rule skill mcp; do yget "$d/kit.yaml" "required.${k}s" | sed "s/^/$k:/"; done
    done | awk 'NF && !seen[$0]++'
}
recommended_items() {
    src_dirs | while IFS= read -r d; do
        for k in rule skill mcp; do yget "$d/kit.yaml" "recommended.${k}s" | sed "s/^/$k:/"; done
    done | awk 'NF && !seen[$0]++'
}
required_deny() { src_dirs | while IFS= read -r d; do yget "$d/kit.yaml" required.tools.deny; done | awk 'NF && !seen[$0]++'; }

wanted() { # required + added - removed(non-required)
    { required_items; m_added | grep -vxF -f <(m_removed; echo '##none##'); } | awk 'NF && !seen[$0]++'
}

# ---------- MCP yaml -> what the tools read ----------
# An MCP yaml runs a program (command, args, env) or names a URL (type: http or sse, url, headers). ${VAR} in it is an
# environment variable each machine sets itself (never the secret in the source): Claude Code and omp fill it in
# themselves; Codex takes it only as a whole value (env_vars, bearer_token_env_var, env_http_headers: codex_mcp_fields).
# mcp.awk reads it (mode yaml): the type, values that look like secrets, the variables, the package (npx, uvx).
# A package kit installed (kit install-deps mcp <name>: $KIT_CONF/mcp-deps/<name>) runs from there, else npx/uvx
# downloads it when the agent starts the server.
mcp_awk() { LC_ALL=C awk -f "$KIT_LIB/mcp.awk" "$@"; }
mcp_name() { local n=${1##*/}; printf '%s\n' "${n%.yaml}"; }
mcp_info() { yaml "$1" | mcp_awk -v mode=yaml -v name="$(mcp_name "$1")"; }   # mcp.awk's T X V R P lines for a yaml kit has
mcp_type() { local t; t=$(yget "$1" type | head -n 1); printf '%s\n' "${t:-stdio}"; }
mcp_store() { printf '%s\n' "$KIT_CONF/mcp-deps/$1"; }
mcp_pkg() { # mcp_pkg FILE -> its package: kind, package, version, argno, bin, first, bad, joined by $US (empty fields kept)
    mcp_info "$1" | awk -F'\t' '$1 == "P" { sub(/^P\t/, ""); print; exit }' | tr '\t' "$US"
}
US=$(printf '\037')
mcp_pkgjson() { printf '{"name": "kit-mcp-%s", "private": true, "dependencies": {%s: %s}}\n' "$1" "$(json_str "$2")" "$(json_str "$3")"; }
mcp_npm_bin() { # mcp_npm_bin PKGDIR [BIN] -> the file its package.json "bin" names (BIN, or its own name, or the only one)
    local s
    s=$(LC_ALL=C awk -f "$KIT_LIB/json.awk" -v leaves=1 "$1/package.json" 2>/dev/null | LC_ALL=C awk -F'\t' -v want="$2" -v own="${1##*/}" '
        $1 == "bin" && NF == 2 { s = $2 } $1 == "bin" && NF == 3 { n++; k[n] = $2; v[n] = $3 }
        END { if (s == "") { for (i = 1; i <= n; i++) if (k[i] == want || (want == "" && k[i] == own)) s = v[i]; if (s == "" && n == 1 && want == "") s = v[1] }
              if (s !~ /^"[^"\\]+"$/) exit 1; s = substr(s, 2, length(s) - 2); sub(/^\.\//, "", s)
              if (s ~ /(^|\/)\.\.(\/|$)/ || s ~ /^\//) exit 1; print s }') || return 1
    [ -f "$1/$s" ] && printf '%s\n' "$1/$s"
}
mcp_installed() { # mcp_installed NAME KIND PACKAGE VERSION BIN -> the program to run, when kit installed exactly this
    local s; s=$(mcp_store "$1")
    [ -n "$4" ] || return 1
    case $2 in
        npm) [ -d "$s/node_modules" ] && [ "$(cat "$s/.kit-src/package.json" 2>/dev/null)" = "$(mcp_pkgjson "$1" "$3" "$4")" ] &&
                 mcp_npm_bin "$s/node_modules/$3" "$5";;
        pip) [ -x "$s/venv/bin/python" ] && [ "$(cat "$s/.kit-src/requirements.txt" 2>/dev/null)" = "$3==$4" ] &&
                 [ -x "$s/venv/bin/$5" ] && printf '%s\n' "$s/venv/bin/$5";;
        *) return 1;;
    esac
}
mcp_run() { # mcp_run FILE -> the program, then its arguments, one per line (the package kit installed, when it did)
    local f=$1 kind pkg ver argno bin first bad x i a
    IFS=$US read -r kind pkg ver argno bin first bad <<EOF
$(mcp_pkg "$f")
EOF
    if [ -n "$kind" ] && x=$(mcp_installed "$(mcp_name "$f")" "$kind" "$pkg" "$ver" "$bin"); then
        [ "$kind" = npm ] && printf 'node\n'
        printf '%s\n' "$x"
        i=0
        while IFS= read -r a; do i=$((i + 1)); [ $i -lt "$first" ] || printf '%s\n' "$a"; done <<EOF
$(yget "$f" args)
EOF
        return 0
    fi
    yget "$f" command | head -n 1; yget "$f" args
}
mcp_map() { yaml "$1" | awk -F'\t' -v p="$2." 'index($1, p) == 1 { k = substr($1, length(p) + 1); sub(/^[^\t]*\t/, ""); print k "\t" $0 }'; }   # mcp_map FILE env|headers -> KEY<TAB>VALUE
mcp_map_json() { # mcp_map_json FILE KEY -> ,"KEY":{..} when the yaml has that map
    local m k v first=1 out
    m=$(mcp_map "$1" "$2"); [ -n "$m" ] || return 0
    out=",\"$2\":{"
    while IFS="$TAB" read -r k v; do [ $first = 1 ] || out="$out,"; first=0; out="$out$(json_str "$k"):$(json_str "$v")"; done <<EOF
$m
EOF
    printf '%s}' "$out"
}
mcp_json() { # mcp_json FILE -> {"command":..,"args":[..],"env":{..}} or {"type":"http","url":..,"headers":{..}} (Claude Code, omp)
    local f=$1 t out first a cmd run
    t=$(mcp_type "$f")
    case $t in
        http|sse)
            a=$(yget "$f" url | head -n 1); [ -n "$a" ] || { warn "$f has no url"; return 1; }
            printf '{"type":"%s","url":%s%s}\n' "$t" "$(json_str "$a")" "$(mcp_map_json "$f" headers)"; return 0;;
        stdio) ;;
        *) warn "${f}：type 只能是 stdio、http 或 sse"; return 1;;
    esac
    run=$(mcp_run "$f"); cmd=${run%%"$LF"*}
    [ -n "$cmd" ] || { warn "$f has no command"; return 1; }
    out="{\"command\":$(json_str "$cmd"),\"args\":["
    first=1
    while IFS= read -r a; do
        [ -n "$a" ] || continue
        [ $first = 1 ] || out="$out,"; first=0; out="$out$(json_str "$a")"
    done <<EOF
$(printf '%s\n' "$run" | sed 1d)
EOF
    printf '%s]%s}\n' "$out" "$(mcp_map_json "$f" env)"
}
mcp_vars_warn() { # wanted MCP names on stdin: tell once about each ${VAR} they need that this machine has not set
    local n p v
    for n in $(cat); do
        p=$(find_item mcp "$n") || continue
        for v in $(mcp_info "$p" | awk -F'\t' '$1 == "V" { print $2 }'); do
            if [ -n "$(printenv "$v" 2>/dev/null)" ]; then
                [ -z "$(state_get told "var:$v")" ] || state_del told "var:$v"
            elif [ -z "$(state_get told "var:$v")" ]; then
                warn "MCP $n 要用環境變數 ${v}，這台電腦還沒設定：設定好再重開 agent（只提醒這一次）"; state_set told "var:$v" 1
            fi
        done
    done
}

# ---------- apply to Claude Code ----------
has_codex() { [ -d "$CODEX_DIR" ] || command -v codex >/dev/null 2>&1; }
has_omp()   { [ -d "$OMP_DIR" ] || [ -d "$HOME/.omp" ] || command -v omp >/dev/null 2>&1; }
targets()   { printf 'Claude'; has_codex && printf '、Codex'; has_omp && printf '、omp'; echo; }

replace_block() { # replace_block FILE BEGIN END : put $KIT_BLOCK between the markers, at the end of FILE
    # The block has newlines, which "awk -v" refuses on BSD awk; it comes in via the environment.
    # A file with CRLF line ends keeps them; a linked file (dotfiles) is written where the link points.
    local f=$1 tmp rc=0
    if [ ! -f "$f" ]; then [ -n "${KIT_BLOCK:-}" ] || return 0; mkdir -p "$(dirname "$f")"; : > "$f"; fi
    tmp=$(mktemp "$f.kit.XXXXXX") || { warn "沒辦法在 $f 旁邊寫暫存檔"; return 1; }
    cp -p "$f" "$tmp"                                         # keep the file's permissions
    awk -v b="$2" -v e="$3" '
        { l = $0; if (sub(/\r$/, "", l)) crlf = 1 }
        l == b { skip = 1; next }
        l == e { skip = 0; next }
        !skip { lines[++n] = $0; plain[n] = l }
        END {
            if (skip) exit 3                                  # a begin without an end: never guess where the block stops
            cr = crlf ? "\r" : ""
            body = ENVIRON["KIT_BLOCK"]
            gsub(/\r\n/, "\n", body)
            if (body != "" && substr(body, length(body)) != "\n") body = body "\n"
            if (cr != "") gsub(/\n/, "\r\n", body)
            while (n > 0 && plain[n] == "") n--
            for (i = 1; i <= n; i++) print lines[i]
            if (body != "") { if (n > 0) print cr; print b cr; printf "%s", body; print e cr }
        }' "$f" > "$tmp" || rc=$?
    if [ $rc != 0 ]; then
        rm -f "$tmp"
        [ $rc = 3 ] && warn "$f 裡有 kit 的開始標記，但找不到結束標記（$3）：kit 不動這個檔案，請手動修好（刪掉開始那行，或補上結束那行）"
        return 1
    fi
    if cmp -s "$tmp" "$f"; then rm -f "$tmp"
    elif [ -L "$f" ]; then cat "$tmp" > "$f"; rm -f "$tmp"   # keep the link
    elif [ -s "$tmp" ]; then mv -f "$tmp" "$f"
    else rm -f "$tmp" "$f"                                    # nothing left: kit made it
    fi
}

rules_body() { # rules_body import|inline : rule names on stdin -> text for the instructions file
    local n p
    while IFS= read -r n; do
        [ -n "$n" ] || continue
        p=$(find_item rule "$n") || { warn "rule $n not found in any source"; continue; }
        if [ "$1" = import ]; then printf '@%s\n' "${p// /\\ }"
        else printf '<!-- rule: %s -->\n' "$n"; cat "$p"; [ -z "$(tail -c1 "$p")" ] || echo; fi
    done
}

set_rules() { # set_rules FILE import|inline [MORE] : rule names on stdin; MORE (text) goes after the rules
    local f=$1 body
    body=$(rules_body "$2"; [ -z "${3:-}" ] || printf '%s\n' "$3")
    KIT_BLOCK="$body" replace_block "$f" "$BEGIN_MARK" "$END_MARK"
}
apply_rules() { # apply_rules WANTED : the account's instructions (Claude, Codex, omp): the rules, and the python line
    # when one of the skills has kit's venv (a folder's own instructions never get it: kit only adds what it was asked to)
    local rules hint
    rules=$(printf '%s\n' "$1" | sed -n 's/^rule://p')
    hint=$(py_hint $(printf '%s\n' "$1" | sed -n 's/^skill://p'))
    set_rules "$CLAUDE_DIR/CLAUDE.md" import "$hint" <<< "$rules"
    if has_codex; then set_rules "$CODEX_DIR/AGENTS.md" inline "$hint" <<< "$rules"; fi
    if has_omp; then set_rules "$OMP_DIR/AGENTS.md" inline "$hint" <<< "$rules"; fi
    return 0
}

sync_skills() { # sync_skills DIR STATEKIND : copy wanted skills (names on stdin) into DIR
    local dir=$1 kind=$2 names n p dst h old b
    names=$(cat)
    [ -n "$names" ] && mkdir -p "$dir"
    for n in $names; do
        p=$(find_item skill "$n") || { warn "skill $n not found in any source"; continue; }
        p=$(dirname "$p"); dst="$dir/$n"; h=$(dir_hash "$p")
        old=$(state_get "$kind" "$n")
        if [ -e "$dst" ] && [ -z "$old" ]; then
            # someone else's folder: say it once, not at every sync
            [ -n "$(state_get skipped "$dst")" ] || { warn "$dst 已經存在，不是 kit 放的，跳過（只提醒這一次）"; state_set skipped "$dst" 1; }
            continue
        fi
        state_del skipped "$dst"
        if [ -n "$old" ] && [ -d "$dst" ] && [ "$(dir_hash "$dst")" != "$old" ]; then
            [ -n "${FORCE:-}" ] || { warn "skill ${n}（${dir}）被手動改過，跳過（kit sync --force 會蓋掉，你改的會先備份）"; continue; }
            b=$(backup_skill "$dst" "$n") || { warn "沒辦法備份你改過的 skill ${n}（${dir}），沒有蓋掉"; continue; }
            say "  你改過的 skill $n 備份在 $b"
        fi
        [ "$h" = "$old" ] && [ -d "$dst" ] && { link_deps "$n" "$dst"; continue; }
        rm -rf "$dst"; cp -R "$p" "$dst" || { warn "沒辦法複製 skill $n 到 $dir"; rm -rf "$dst"; continue; }
        state_set "$kind" "$n" "$h"; say "  skill $n → $dir"
        link_deps "$n" "$dst"
    done
    for n in $(state_list "$kind"); do
        printf '%s\n' "$names" | grep -qxF "$n" && continue
        dst="$dir/$n"; old=$(state_get "$kind" "$n")
        if [ -d "$dst" ] && [ "$(dir_hash "$dst")" != "$old" ]; then
            # you changed it: never deleted. --force keeps a backup; without it the copy stays and is yours from now on
            if [ -n "${FORCE:-}" ]; then
                b=$(backup_skill "$dst" "$n") || { warn "沒辦法備份你改過的 skill ${n}（${dir}），沒有刪"; continue; }
                say "  removed skill $n ← ${dir}（你改過的那份備份在 ${b}）"
            else
                warn "skill ${n}（${dir}）被手動改過，沒有刪；kit 之後不再管它，不要了請自己刪"
            fi
            state_del "$kind" "$n"; continue
        fi
        rm -rf "$dst"; state_del "$kind" "$n"; say "  removed skill $n ← $dir"
    done
}

backup_skill() { # backup_skill DST NAME : move a hand-edited skill copy to kit's backups (not a skills folder); prints where
    local d="$KIT_CONF/backups/skills" t b x i=1
    t=$(date +%Y%m%d-%H%M%S); b="$d/$2-$t"
    while [ -e "$b" ]; do b="$d/$2-$t-$i"; i=$((i + 1)); done
    for x in node_modules .venv; do [ -L "$1/$x" ] && rm -f "$1/$x"; done   # kit's links, not your files
    mkdir -p "$d" && mv "$1" "$b" && printf '%s\n' "$b"
}

sync_mcp_json() { # sync_mcp_json FILE STATEKIND : wanted MCP names on stdin -> FILE's mcpServers
    # A server the user already has under that name (not kit's) is never replaced, so never removed either.
    # state.tsv changes only after FILE was written: if that fails, the next sync tries again.
    local f=$1 kind=$2 names n p k sum ops old sets="" dels=""
    names=$(cat); ops=$(mktemp "${TMPDIR:-/tmp}/kit-ops.XXXXXX")
    for n in $names; do
        p=$(find_item mcp "$n") || { warn "mcp $n not found in any source"; continue; }
        k=$(mcp_json "$p") || continue
        sum=$(printf '%s' "$k" | cksum | awk '{print $1}')
        old=$(state_get "$kind" "$n")
        [ "$old" = "$sum" ] && continue
        if [ -z "$old" ] && [ -f "$f" ] && json_get "$f" "mcpServers.$n" >/dev/null; then
            [ -n "$(state_get skipped "$f#mcp.$n")" ] || { warn "$f 已經有自己的 MCP ${n}，不是 kit 放的，kit 不動它（只提醒這一次）"; state_set skipped "$f#mcp.$n" 1; }
            continue
        fi
        printf 'set\tmcpServers.%s\t%s\n' "$n" "$k" >> "$ops"; sets="$sets$n $sum
"; say "  mcp $n → $f"
    done
    for n in $(state_list "$kind"); do
        printf '%s\n' "$names" | grep -qxF "$n" && continue
        printf 'del\tmcpServers.%s\n' "$n" >> "$ops"; dels="$dels$n
"; say "  removed mcp $n ← $f"
    done
    if [ -s "$ops" ]; then
        mkdir -p "$(dirname "$f")"; json_edit "$f" "$ops"; prune_empty "$f" mcpServers
        while read -r n sum; do [ -z "$n" ] || { state_set "$kind" "$n" "$sum"; state_del skipped "$f#mcp.$n"; }; done <<EOF
$sets
EOF
        for n in $dels; do state_del "$kind" "$n"; done
    fi
    rm -f "$ops"
}

toml_user() { # toml_user FILE : FILE without kit's blocks (what the user wrote)
    awk -v b="$TOML_BEGIN" -v e="$TOML_END" -v tb="$TOP_BEGIN" -v te="$TOP_END" \
        '$0 == b || $0 == tb { s = 1 } !s { print } $0 == e || $0 == te { s = 0 }' "$1" 2>/dev/null
}
toml_key() { case $1 in *[!A-Za-z0-9_-]*|"") json_str "$1";; *) printf '%s' "$1";; esac; }

codex_told() { [ -n "$(state_get told "codex-mcp:$1")" ] || { warn "$2（只提醒這一次）"; state_set told "codex-mcp:$1" 1; }; }
codex_mcp_fields() { # codex_mcp_fields FILE NAME QUOTE -> Codex's fields for it, KEY<TAB>VALUE (env.K: its env), strings quoted by QUOTE
    # Returns 1 when Codex cannot use it (SSE; a URL with ${VAR}). Codex never fills in ${VAR} itself: a whole ${VAR} goes
    # as env_vars (an env of the same name, passed through), bearer_token_env_var (Authorization: Bearer ${VAR}) or
    # env_http_headers; ${VAR} inside other values stays as it is (told once); a header like that is left out.
    local f=$1 n=$2 q=$3 t run a first out k v bear="" lit="" envh="" vars=""
    t=$(mcp_type "$f")
    case $t in
    sse) codex_told "$n:sse" "Codex 不能用 SSE 的 MCP：$n 不放進 Codex（Claude Code 和 omp 照樣有）"; return 1;;
    http)
        a=$(yget "$f" url | head -n 1); [ -n "$a" ] || { warn "$f has no url"; return 1; }
        case $a in *'${'*) codex_told "$n:url" "Codex 的網址不能用 \${…}：$n 不放進 Codex"; return 1;; esac
        printf 'url\t%s\n' "$($q "$a")"
        while IFS="$TAB" read -r k v; do
            [ -n "$k" ] || continue
            if [ "$(printf '%s' "$k" | tr 'A-Z' 'a-z')" = authorization ] && printf '%s' "$v" | grep -qE '^Bearer \$\{[A-Za-z_][A-Za-z0-9_]*\}$'; then
                v=${v#'Bearer ${'}; bear=${v%\}}
            elif printf '%s' "$v" | grep -qE '^\$\{[A-Za-z_][A-Za-z0-9_]*\}$'; then
                v=${v#'${'}; envh="${envh:+$envh, }$(toml_key "$k") = $($q "${v%\}}")"
            else
                case $v in
                    *'${'*) codex_told "$n:header:$k" "Codex 的 header 只能整個是 \${變數}：$n 的 $k 不放進 Codex";;
                    *) lit="${lit:+$lit, }$(toml_key "$k") = $($q "$v")";;
                esac
            fi
        done <<EOF
$(mcp_map "$f" headers)
EOF
        [ -z "$bear" ] || printf 'bearer_token_env_var\t%s\n' "$($q "$bear")"
        [ -z "$lit" ] || printf 'http_headers\t{ %s }\n' "$lit"
        [ -z "$envh" ] || printf 'env_http_headers\t{ %s }\n' "$envh"
        return 0;;
    stdio) ;;
    *) warn "${f}：type 只能是 stdio、http 或 sse"; return 1;;
    esac
    run=$(mcp_run "$f"); a=${run%%"$LF"*}
    [ -n "$a" ] || { warn "$f has no command"; return 1; }
    printf 'command\t%s\n' "$($q "$a")"
    out=""; first=1
    while IFS= read -r a; do [ -n "$a" ] || continue; [ $first = 1 ] || out="$out, "; first=0; out="$out$($q "$a")"; done <<EOF
$(printf '%s\n' "$run" | sed 1d)
EOF
    [ -z "$out" ] || printf 'args\t[%s]\n' "$out"
    case $out in *'${'*) codex_told "$n:args" "Codex 不會展開參數裡的 \${…}：$n 的參數照字面放進 Codex";; esac
    out=""
    while IFS="$TAB" read -r k v; do
        [ -n "$k" ] || continue
        if [ "$v" = "\${$k}" ]; then vars="${vars:+$vars, }$($q "$k")"; continue; fi
        case $v in *'${'*) codex_told "$n:env:$k" "Codex 不會展開 env 裡的 \${…}：$n 的 $k 照字面放進 Codex";; esac
        out="${out}env.$k$TAB$($q "$v")$LF"
    done <<EOF
$(mcp_map "$f" env)
EOF
    [ -z "$vars" ] || printf 'env_vars\t[%s]\n' "$vars"
    printf '%s' "$out"
}
codex_mcp_toml() { # wanted MCP names on stdin -> [mcp_servers.x] tables for Codex
    local names n p fields tools t first user k v envs
    names=$(cat)
    user=$(toml_user "${CODEX_USER_TOML:-$CODEX_DIR/config.toml}")
    for n in $names; do
        p=$(find_item mcp "$n") || { warn "mcp $n not found in any source"; continue; }
        if printf '%s\n' "$user" | grep -qE "^[[:space:]]*\[mcp_servers\.\"?$n\"?[]. ]"; then
            warn "Codex 的 config.toml 已經有自己的 mcp_servers.${n}，kit 不動它"; continue
        fi
        fields=$(codex_mcp_fields "$p" "$n" json_str) || continue
        printf '[mcp_servers.%s]\n' "$(toml_key "$n")"
        envs=""
        while IFS="$TAB" read -r k v; do
            case $k in "") ;; env.*) envs="$envs$(toml_key "${k#env.}") = $v$LF";; *) printf '%s = %s\n' "$k" "$v";; esac
        done <<EOF
$fields
EOF
        # team deny rules for this server's tools (mcp__<server>__<tool>) become disabled_tools
        tools=""; first=1
        for t in $( { required_deny; printf '%s\n' "${DENY_MORE:-}"; } | awk 'NF && !seen[$0]++' | sed -n "s/^mcp__${n}__//p"); do [ $first = 1 ] || tools="$tools, "; first=0; tools="$tools$(json_str "$t")"; done
        [ -n "$tools" ] && printf 'disabled_tools = [%s]\n' "$tools"
        [ -z "$envs" ] || printf '\n[mcp_servers.%s.env]\n%s' "$(toml_key "$n")" "$envs"
        echo
    done
}

apply_claude() {
    local want n p dst h old ops k rules skills mcps
    want=$(wanted)
    rules=$(printf '%s\n' "$want" | sed -n 's/^rule://p')
    skills=$(printf '%s\n' "$want" | sed -n 's/^skill://p')
    mcps=$(printf '%s\n' "$want" | sed -n 's/^mcp://p')

    # (no pipelines here: a file kit cannot write stops kit, before state.tsv says it was done)
    # Claude: rules as @imports (Codex and omp: AGENTS.md gets the rule text itself), skills, MCP in ~/.claude.json
    apply_rules "$want"
    sync_skills "$CLAUDE_DIR/skills" skill <<< "$skills"
    sync_mcp_json "$CLAUDE_JSON" mcp <<< "$mcps"; mcp_vars_warn <<< "$mcps"

    # Codex and omp share ~/.agents/skills
    if has_codex || has_omp; then sync_skills "$AGENTS_SKILLS" skill.agents <<< "$skills"; fi
    if has_codex; then
        KIT_BLOCK="$(codex_mcp_toml <<< "$mcps"; codex_trust)" replace_block "$CODEX_DIR/config.toml" "$TOML_BEGIN" "$TOML_END"
        KIT_BLOCK=$(codex_top) replace_top_block "$CODEX_DIR/config.toml" "$TOP_BEGIN" "$TOP_END"
    fi
    if has_omp; then
        sync_mcp_json "$OMP_DIR/mcp.json" mcp.omp <<< "$mcps"
    fi

    ops=$(mktemp "${TMPDIR:-/tmp}/kit-ops.XXXXXX")
    # tool deny rules -> ~/.claude/settings.json
    # (one you already have is yours: kit does not count it as its own, so never takes it out)
    local deny add="" del="" have; deny=$(required_deny); have=$(json_strs "$CLAUDE_DIR/settings.json" permissions.deny)
    while IFS= read -r n; do
        [ -n "$n" ] || continue
        [ -n "$(state_get deny "$n")" ] && continue
        printf '%s\n' "$have" | grep -qxF -- "$(json_str "$n")" && continue
        printf 'addstr\tpermissions.deny\t%s\n' "$n" >> "$ops"; add="$add$n
"; say "  deny $n"
    done <<EOF
$deny
EOF
    for n in $(state_list deny); do
        printf '%s\n' "$deny" | grep -qxF "$n" && continue
        printf 'rmstr\tpermissions.deny\t%s\n' "$n" >> "$ops"; del="$del$n
"; say "  removed deny $n"
    done
    # update automatically when Claude starts -> settings.json hooks.SessionStart
    local hj old; hj=$(hook_json); old=$(state_get hook SessionStart)
    if [ "$hj" != "$old" ]; then
        [ -n "$old" ] && printf 'rmjson\thooks.SessionStart\t%s\n' "$old" >> "$ops"
        printf 'addjson\thooks.SessionStart\t%s\n' "$hj" >> "$ops"
    fi
    # Claude's status line: kit statusline keeps the numbers kit context shows (only when there is no status line of
    # your own; kit's is replaced when its command changes). Taken out by you: kit leaves it out (kit sync --force
    # puts it back).
    local sj sold scur snew=""; sj=$(statusline_json); sold=$(state_get statusline claude)
    scur=$(json_get "$CLAUDE_DIR/settings.json" statusLine | tr -d ' \t\r\n')
    if [ -z "$scur" ] && [ -n "$sold" ] && [ -z "${FORCE:-}" ]; then
        state_del statusline claude; state_set told statusline-removed 1
        warn "你拿掉了 kit 放的 statusLine：kit 不會再加回來，畫面程式看 Claude 的 context 用量改從對話紀錄估（要加回來：kit sync --force）"
    elif [ -z "$scur" ] && [ -n "$(state_get told statusline-removed)" ] && [ -z "${FORCE:-}" ]; then
        :
    elif [ -z "$scur" ] || { [ -n "$sold" ] && [ "$scur" = "$(printf '%s' "$sold" | tr -d ' \t\r\n')" ]; }; then
        [ -n "$scur" ] && [ "$sj" = "$sold" ] || { printf 'set\tstatusLine\t%s\n' "$sj" >> "$ops"; snew=1; }
    elif [ -z "$(state_get told statusline)" ]; then
        warn "Claude 已經有自己的 statusLine：kit 不動它，畫面程式看 Claude 的 context 用量改從對話紀錄估（只提醒這一次）"; state_set told statusline 1
    fi
    if [ -s "$ops" ]; then
        json_edit "$CLAUDE_DIR/settings.json" "$ops"; prune_deny
        [ -z "$snew" ] || { state_set statusline claude "$sj"; state_del told statusline-removed; }
        while IFS= read -r n; do [ -z "$n" ] || state_set deny "$n" 1; done <<EOF
$add
EOF
        while IFS= read -r n; do [ -z "$n" ] || state_del deny "$n"; done <<EOF
$del
EOF
        [ "$hj" = "$old" ] || state_set hook SessionStart "$hj"
    fi
    rm -f "$ops"
}

hook_json() { # the SessionStart hook entry kit adds to settings.json
    local k="$HOME/.local/bin/kit"
    [ -x "$k" ] || k="$KIT_LIB/kit"
    printf '{"hooks":[{"type":"command","command":%s,"timeout":10}]}' "$(json_str "'$k' sync --hook")"
}

statusline_json() { # the statusLine kit puts in settings.json
    local k="$HOME/.local/bin/kit"
    [ -x "$k" ] || k="$KIT_LIB/kit"
    printf '{"type":"command","command":%s,"padding":0}' "$(json_str "'$k' statusline")"
}

# Is this Claude saving its transcript? A Claude Code started from inside another Claude's shell inherits
# CLAUDE_CODE_CHILD_SESSION=1 and then writes no ~/.claude/projects/.../<session>.jsonl (no /resume);
# CLAUDE_CODE_FORCE_SESSION_PERSISTENCE=1 makes it save again. Claude gives its hooks CHILD_SESSION=1 too, so this
# reads the start environment of the claude process (the nearest parent named claude), not kit's own.
# Codex and omp only skip their session log when told to (codex exec --ephemeral, omp --no-session): nothing to check.
proc_env() { # the start environment of pid $1, one VAR=value per line
    if [ -r "/proc/$1/environ" ]; then tr '\0' '\n' < "/proc/$1/environ"; return; fi
    local a e   # macOS: ps -E prints the command line, then the environment
    a=$(ps -ww -p "$1" -o command= 2>/dev/null); e=$(ps -E -ww -p "$1" -o command= 2>/dev/null)
    printf '%s\n' "${e#"$a"}" | tr ' ' '\n'
}
transcript_check() { # print Claude's SessionStart JSON (a warning) when the claude above us saves no transcript
    [ "${KIT_TRANSCRIPT_CHECK:-}" != 0 ] || return 0
    grep -q 'transcript-check' "$CLAUDE_DIR/settings.json" 2>/dev/null && return 0  # your own hook does it: one warning
    local p=$PPID i=0 c="" e
    while [ $i -lt 6 ] && [ -n "$p" ] && [ "$p" -gt 1 ] 2>/dev/null; do
        c=$(ps -o comm= -p "$p" 2>/dev/null); c=${c##*/}
        [ "$c" = claude ] && break
        p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' '); i=$((i+1))
    done
    [ "$c" = claude ] || return 0
    e=$(proc_env "$p")
    printf '%s\n' "$e" | grep -qx 'CLAUDE_CODE_CHILD_SESSION=1' || return 0
    printf '%s\n' "$e" | grep -qx 'CLAUDE_CODE_FORCE_SESSION_PERSISTENCE=1' && return 0
    cat <<'JSON'
{"systemMessage":"⚠ 這個 session 沒有在存對話紀錄：關掉之後 /resume 找不回來。請先叫它寫交接檔，再用會存檔的方式重開（env -u CLAUDE_CODE_CHILD_SESSION CLAUDE_CODE_FORCE_SESSION_PERSISTENCE=1 claude）。","hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"WARNING: transcript saving is OFF for this session (the claude process was started with CLAUDE_CODE_CHILD_SESSION=1 and without CLAUDE_CODE_FORCE_SESSION_PERSISTENCE=1). If the user closes it, the conversation is lost and cannot be resumed. Tell the user this in your first reply (in Traditional Chinese), commit work often, and before the user closes it write a HANDOFF.md. Any Claude you launch yourself (in a new terminal or pane) must be started with: env -u CLAUDE_CODE_CHILD_SESSION CLAUDE_CODE_FORCE_SESSION_PERSISTENCE=1 claude ..."}}
JSON
}

sync_hook() { # run by Claude at start: warn when it saves no transcript; sync in the background, at most every 10 minutes
    transcript_check
    [ -f "$MACHINE" ] || exit 0
    local stamp="$KIT_CONF/last-sync" lock="$KIT_CONF/sync.lock" log="$KIT_CONF/sync.log"
    [ -f "$stamp" ] && [ -z "$(find "$stamp" -mmin +10 2>/dev/null)" ] && exit 0
    [ -d "$lock" ] && [ -n "$(find "$lock" -maxdepth 0 -mmin +10 2>/dev/null)" ] && rmdir "$lock" 2>/dev/null
    mkdir "$lock" 2>/dev/null || exit 0                      # another sync is running
    touch "$stamp"
    [ -f "$log" ] && [ "$(wc -c < "$log")" -gt 100000 ] && mv -f "$log" "$log.old"
    (
        trap 'rmdir "$lock" 2>/dev/null' EXIT
        printf '== %s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
        KIT_LOCKED=1
        GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=20 NO_NAG=1 cmd_sync
    ) </dev/null >>"$log" 2>&1 &
    exit 0
}

replace_top_block() { # replace_block, but at the top of FILE: TOML keys outside any table must come before the tables
    # Kit's block is followed by one empty line, which goes with it again: without the block the file is as it was.
    local f=$1 tmp rc=0
    if [ ! -f "$f" ]; then [ -n "${KIT_BLOCK:-}" ] || return 0; mkdir -p "$(dirname "$f")"; : > "$f"; fi
    tmp=$(mktemp "$f.kit.XXXXXX") || { warn "沒辦法在 $f 旁邊寫暫存檔"; return 1; }
    cp -p "$f" "$tmp"
    awk -v b="$2" -v e="$3" '
        { l = $0; if (sub(/\r$/, "", l)) crlf = 1 }
        l == b { skip = 1; next }
        l == e { skip = 0; after = 1; next }
        after { after = 0; if (l == "") next }
        !skip { lines[++n] = $0 }
        END {
            if (skip) exit 3
            cr = crlf ? "\r" : ""
            body = ENVIRON["KIT_BLOCK"]
            gsub(/\r\n/, "\n", body)
            if (body != "" && substr(body, length(body)) != "\n") body = body "\n"
            if (cr != "") gsub(/\n/, "\r\n", body)
            if (body != "") { print b cr; printf "%s", body; print e cr; if (n > 0) print cr }
            for (i = 1; i <= n; i++) print lines[i]
        }' "$f" > "$tmp" || rc=$?
    if [ $rc != 0 ]; then
        rm -f "$tmp"
        [ $rc = 3 ] && warn "$f 裡有 kit 的開始標記，但找不到結束標記（$3）：kit 不動這個檔案，請手動修好"
        return 1
    fi
    if cmp -s "$tmp" "$f"; then rm -f "$tmp"
    elif [ -L "$f" ]; then cat "$tmp" > "$f"; rm -f "$tmp"
    elif [ -s "$tmp" ]; then mv -f "$tmp" "$f"
    else rm -f "$tmp" "$f"
    fi
}

# ---------- a folder's own (kit add --dir) ----------
# Only agents started in that folder (or below it) get these; the account and other folders do not.
# The folder's .agentkit lists them; kit puts them where each tool looks in a project:
#   Claude: CLAUDE.md, .claude/skills, .mcp.json (+ .claude/settings.local.json so it does not ask each time)
#   Codex:  AGENTS.md, .agents/skills, .codex/config.toml (Codex reads it only in a trusted folder: kit trusts it)
#   omp:    reads Claude's and Codex's; its MCP only from the account (kit does not turn on omp's project MCP)
home_real() { (cd "$HOME" 2>/dev/null && pwd -P) || printf '%s' "$HOME"; }
dir_why_not() { # dir_why_not DIR : why DIR cannot have its own (empty when it can)
    local h; h=$(home_real)
    case $1 in
        /|"$h") printf '這是家目錄（或根目錄）：放在這裡等於整個帳號，請用「加到整個帳號」，或換一個資料夾';;
        *) case $h in "$1"/*) printf '家目錄在這個資料夾裡面：放在這裡等於整個帳號，請換一個資料夾';; esac;;
    esac
}
dir_root() { # dir_root DIR : the folder kit uses for DIR: the nearest one at or above it with .agentkit, else DIR
    local d a h; h=$(home_real)
    d=$(cd "$1" 2>/dev/null && pwd -P) || return 1
    a=$d
    while [ "$a" != / ] && [ "$a" != "$h" ]; do
        [ -f "$a/$DIR_FILE" ] && { printf '%s\n' "$a"; return 0; }
        a=$(dirname "$a")
    done
    printf '%s\n' "$d"
}
# A placed folder (kit place) gets its agent's rules, skills and MCP from the agent file each time (kit sync), so a
# change to the agent reaches it. .agentkit keeps only what you changed: kind:name you added (kit add --dir), and
# not:kind:name, one of the agent's you took out (kit rm --dir; it stays out until you kit add --dir it again).
# Kit keeps a copy of the agent file ($KIT_CONF/placed/): when the agent cannot be found or read (renamed, its source
# gone, an approved commit without it), the folder stays as it was, the prompt and tool limits too.
dir_lines() { [ -f "$1/$DIR_FILE" ] && awk '{ sub(/\r$/, "") } /^(not:)?(rule|skill|mcp):[^ ]+$/' "$1/$DIR_FILE" | awk '!seen[$0]++'; }
dir_own() { dir_lines "$1" | grep -v '^not:'; }            # dir_own DIR : what you added
dir_nots() { dir_lines "$1" | sed -n 's/^not://p'; }       # dir_nots DIR : the agent's you took out
placed_copy() { printf '%s/placed/%s.md\n' "$KIT_CONF" "$(printf '%s' "$1" | cksum | awk '{ print $1 }')"; }
placed_file() { # placed_file DIR : the agent file of a placed folder; return 2: kit's copy (the agent cannot be read now), 1: none
    local a f c; a=$(dir_mark "$1" agent); [ -n "$a" ] || return 1
    if f=$(find_item agent "$a") && fm_of "$f" >/dev/null; then printf '%s\n' "$f"; return 0; fi
    c=$(placed_copy "$1"); [ -f "$c" ] || return 1
    printf '%s\n' "$c"; return 2
}
agent_items() { # agent_items FILE : the agent's rules, skills and MCP that a source has, kind:name
    local fm a n; fm=$(fm_of "$1")
    for a in rule:rules skill:skills mcp:mcp; do
        for n in $(fm_val "$fm" "${a#*:}"); do find_item "${a%%:*}" "$n" >/dev/null && printf '%s:%s\n' "${a%%:*}" "$n"; done
    done
    return 0
}
dir_agent_items() { local f; f=$(placed_file "$1"); [ $? = 1 ] || agent_items "$f"; }   # dir_agent_items DIR : the placed agent's
dir_items() { # dir_items DIR : what the folder has: the placed agent's (less the ones you took out), then what you added
    local nots; nots=$(dir_nots "$1")
    { dir_agent_items "$1" | grep -vxF -- "${nots:-$LF}"; dir_own "$1"; } | awk 'NF && !seen[$0]++'
}
dir_marks() { [ -f "$1/$DIR_FILE" ] && awk '{ sub(/\r$/, "") } /^(agent|tool):[^ ]+$/' "$1/$DIR_FILE"; return 0; }   # kit place's lines
dir_mark() { dir_marks "$1" | sed -n "s/^$2://p" | head -n 1; }   # dir_mark DIR agent|tool : the agent kit place put there, its tool
dir_kind() { printf 'dir:%s:%s' "$1" "$2"; }       # dir_kind DIR KIND : state.tsv kind for a folder's own (kit keeps it with the rest)
dirs_registered() { [ -f "$DIRS_LIST" ] && awk 'NF && !seen[$0]++' "$DIRS_LIST"; }
dirs_set() { # dirs_set DIR add|rm : the list of folders kit has to keep up to date
    local t; mkdir -p "$KIT_CONF"; touch "$DIRS_LIST"
    [ "$2" = add ] || rm -f "$(placed_copy "$1")"
    t=$(mktemp "$DIRS_LIST.XXXXXX") || die "沒辦法寫 $DIRS_LIST"
    { grep -vxF -- "$1" "$DIRS_LIST"; [ "$2" = add ] && printf '%s\n' "$1"; } > "$t"
    if [ -s "$t" ]; then mv -f "$t" "$DIRS_LIST"; else rm -f "$t" "$DIRS_LIST"; fi
}
dir_write() { # dir_write DIR ITEMS [MARKS] : the folder's .agentkit (gone when nothing is left); kit place's lines kept
    local marks; if [ $# -ge 3 ]; then marks=$3; else marks=$(dir_marks "$1"); fi
    if [ -z "$2" ] && [ -z "$marks" ]; then rm -f "$1/$DIR_FILE"; return; fi
    { printf '# kit：這個資料夾自己的規則、skill、MCP。只有在這裡（含子資料夾）開的 agent 會讀到，整個帳號和別的資料夾不受影響。\n'
      printf '# 用  kit add --dir <資料夾> 種類 名字  /  kit rm --dir …  改。\n'
      [ -z "$marks" ] || { printf '# kit place：這個資料夾就是下面這個 agent（在這裡開的 claude、codex、omp 都是它）。\n'
                           printf '# agent 的規則、skill、MCP 每次 kit sync 照 agent 檔放；下面的 種類:名字 是你另外加的，not:種類:名字 是你拿掉的 agent 的。\n'
                           printf '%s\n' "$marks"; }
      [ -z "$2" ] || printf '%s\n' "$2"; } > "$1/$DIR_FILE"
}
drop_made() { # drop_made FILE : a JSON file kit made that is empty again goes away
    [ -n "$(state_get made "$1")" ] || return 0
    [ -f "$1" ] && [ "$(tr -d ' \t\r\n' < "$1")" = "{}" ] && { rm -f "$1" "$1.kit-backup"; state_del made "$1"; }
    [ -f "$1" ] || state_del made "$1"
}
dir_claude_allow() { # dir_claude_allow DIR : MCP names on stdin -> .claude/settings.local.json enabledMcpjsonServers
    local dir=$1 f="$1/.claude/settings.local.json" names n ops add="" del="" km ka
    km=$(dir_kind "$dir" mcp); ka=$(dir_kind "$dir" allow)
    names=$(cat); ops=$(mktemp "${TMPDIR:-/tmp}/kit-ops.XXXXXX")
    for n in $names; do
        [ -n "$(state_get "$km" "$n")" ] || continue        # only the servers kit put in .mcp.json
        [ -n "$(state_get "$ka" "$n")" ] && continue
        printf 'addstr\tenabledMcpjsonServers\t%s\n' "$n" >> "$ops"; add="$add $n"
    done
    for n in $(state_list "$ka"); do
        printf '%s\n' "$names" | grep -qxF "$n" && [ -n "$(state_get "$km" "$n")" ] && continue
        printf 'rmstr\tenabledMcpjsonServers\t%s\n' "$n" >> "$ops"; del="$del $n"
    done
    if [ -s "$ops" ]; then
        [ -f "$f" ] || state_set made "$f" 1
        json_edit "$f" "$ops"; prune_empty "$f" enabledMcpjsonServers
        for n in $add; do state_set "$ka" "$n" 1; done
        for n in $del; do state_del "$ka" "$n"; done
    fi
    rm -f "$ops"; drop_made "$f"
}
dir_claude_deny() { # dir_claude_deny DIR : deny rules on stdin -> .claude/settings.local.json permissions.deny (kit place)
    # (one the file already has is yours: kit does not count it as its own, so never takes it out)
    local dir=$1 f="$1/.claude/settings.local.json" names n ops add="" del="" kd have
    kd=$(dir_kind "$dir" deny)
    names=$(cat); ops=$(mktemp "${TMPDIR:-/tmp}/kit-ops.XXXXXX"); have=$(json_strs "$f" permissions.deny)
    while IFS= read -r n; do
        [ -n "$n" ] || continue
        [ -n "$(state_get "$kd" "$n")" ] && continue
        printf '%s\n' "$have" | grep -qxF -- "$(json_str "$n")" && continue
        printf 'addstr\tpermissions.deny\t%s\n' "$n" >> "$ops"; add="$add$n$LF"
    done <<EOF
$names
EOF
    while IFS= read -r n; do
        [ -n "$n" ] || continue
        printf '%s\n' "$names" | grep -qxF -- "$n" && continue
        printf 'rmstr\tpermissions.deny\t%s\n' "$n" >> "$ops"; del="$del$n$LF"
    done <<EOF
$(state_list "$kd")
EOF
    if [ -s "$ops" ]; then
        [ -f "$f" ] || state_set made "$f" 1
        json_edit "$f" "$ops"; prune_empty "$f" permissions.deny permissions
        [ -z "$(state_get made "$f")" ] || rm -f "$f.kit-backup"   # kit made the file: nothing of yours to keep
        while IFS= read -r n; do [ -z "$n" ] || state_set "$kd" "$n" 1; done <<EOF
$add
EOF
        while IFS= read -r n; do [ -z "$n" ] || state_del "$kd" "$n"; done <<EOF
$del
EOF
    fi
    rm -f "$ops"; drop_made "$f"
}
# Claude Code's own tools that kit knows: a placed agent's tools.only becomes deny rules for the others (Claude's settings
# have no "only these"; a tool Claude adds later is not in the list). kit.ps1 has the same list. No MultiEdit: newer
# Claude Code has none (a deny rule for it is warned about), and in one that has it, denying Edit covers it.
CLAUDE_TOOLS="Agent Bash Edit Glob Grep NotebookEdit Read Task TodoWrite WebFetch WebSearch Write"
place_deny() { # place_deny ONLY DENY : the deny rules of a placed agent's folder (Claude): DENY, and with ONLY the other built-in tools
    local t
    { printf '%s\n' "$2"
      [ -z "$1" ] || for t in $CLAUDE_TOOLS; do printf '%s\n' "$1" | grep -qxF "$t" || printf '%s\n' "$t"; done
    } | awk 'NF && !seen[$0]++'
}
place_more() { # place_more NAME FILE RULES : the agent's prompt, after the folder's rules in its CLAUDE.md / AGENTS.md
    local b; b=$(fm_body "$2" | awk 'NF { p = 1 } p')
    [ -n "$b" ] || return 0
    [ -z "$3" ] || echo
    printf '<!-- agent: %s -->\n%s\n' "$1" "$b"
}
apply_dir() { # apply_dir DIR : the folder's .agentkit (and its agent) -> the tools' files in it
    local dir=$1 want rules skills mcps d agent tool af="" rc fm more="" deny="" cdeny="" c
    # kit place: the agent's rules, skills, MCP, its prompt after the rules, its tool limits into the tools' settings
    # (read from the agent each time, so kit sync brings a change). An agent kit cannot read: kit's copy from the last
    # time (the folder stays as it was), said once; no copy either: kit leaves the folder alone.
    agent=$(dir_mark "$dir" agent); tool=$(dir_mark "$dir" tool)
    if [ -n "$agent" ]; then
        af=$(placed_file "$dir"); rc=$?; c=$(placed_copy "$dir")
        if [ $rc = 0 ]; then
            cmp -s "$af" "$c" 2>/dev/null || { mkdir -p "${c%/*}" && cp "$af" "$c"; }
            state_del told "placed:$dir"
        elif [ -z "$(state_get told "placed:$dir")" ]; then
            warn "agent $agent 找不到或讀不懂（改了名字、來源不在、或核准的版本沒有它）：${dir} 先照上次的樣子不動，修好後 kit sync（只提醒這一次）"
            state_set told "placed:$dir" 1
        fi
        [ $rc != 1 ] || return 0
    fi
    want=$(dir_items "$dir")
    rules=$(printf '%s\n' "$want" | sed -n 's/^rule://p')
    skills=$(printf '%s\n' "$want" | sed -n 's/^skill://p')
    mcps=$(printf '%s\n' "$want" | sed -n 's/^mcp://p')
    if [ -n "$af" ]; then
        fm=$(fm_of "$af"); more=$(place_more "$agent" "$af" "$rules")
        deny=$(fm_val "$fm" tools.deny); cdeny=$(place_deny "$(fm_val "$fm" tools.only)" "$deny")
    fi
    local DENY_MORE=$deny                                    # codex_mcp_toml: the agent's MCP tool denies too
    set_rules "$dir/CLAUDE.md" import "$more" <<< "$rules"
    sync_skills "$dir/.claude/skills" "$(dir_kind "$dir" skill)" <<< "$skills"
    [ -f "$dir/.mcp.json" ] || [ -z "$mcps" ] || state_set made "$dir/.mcp.json" 1
    sync_mcp_json "$dir/.mcp.json" "$(dir_kind "$dir" mcp)" <<< "$mcps"; mcp_vars_warn <<< "$mcps"
    drop_made "$dir/.mcp.json"
    dir_claude_allow "$dir" <<< "$mcps"
    dir_claude_deny "$dir" <<< "$cdeny"
    # kit's backups of the user's own files go when kit has nothing left in them
    [ -n "$(state_list "$(dir_kind "$dir" mcp)")" ] || rm -f "$dir/.mcp.json.kit-backup"
    [ -n "$(state_list "$(dir_kind "$dir" allow)")$(state_list "$(dir_kind "$dir" deny)")" ] || rm -f "$dir/.claude/settings.local.json.kit-backup"
    if has_codex || has_omp || [ "$tool" = codex ] || [ "$tool" = omp ] || [ -n "$(state_list "$(dir_kind "$dir" skill.agents)")" ]; then
        set_rules "$dir/AGENTS.md" inline "$more" <<< "$rules"
        sync_skills "$dir/.agents/skills" "$(dir_kind "$dir" skill.agents)" <<< "$skills"
    elif [ -f "$dir/AGENTS.md" ] && grep -qF -- "$BEGIN_MARK" "$dir/AGENTS.md"; then
        set_rules "$dir/AGENTS.md" inline "$more" <<< "$rules"      # kit wrote it before (kit place --tool codex): keep it up to date
    fi
    if has_codex || [ "$tool" = codex ] || [ -f "$dir/.codex/config.toml" ]; then
        local CODEX_USER_TOML="$dir/.codex/config.toml"
        KIT_BLOCK=$(codex_mcp_toml <<< "$mcps") replace_block "$dir/.codex/config.toml" "$TOML_BEGIN" "$TOML_END"
    fi
    if [ -n "$mcps" ] && has_omp && [ -z "$(state_get told omp-mcp)" ]; then
        warn "omp 只讀整個帳號的 MCP：資料夾自己的 MCP 只有 Claude Code 和 Codex 會用"; state_set told omp-mcp 1
    fi
    for d in .claude/skills .agents/skills .claude .agents .codex; do rmdir "$dir/$d" 2>/dev/null; done
    return 0
}
apply_dirs() { # kit sync: every folder with its own; a folder that is gone (or has no .agentkit any more) leaves the list
    local d
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        if [ -d "$d" ]; then apply_dir "$d"; fi
        [ -n "$(dir_items "$d")$(dir_mark "$d" agent)" ] || dirs_set "$d" rm
    done <<EOF
$(dirs_registered)
EOF
}
codex_trust() { # [projects."DIR"] trust for each folder with its own MCP (Codex reads a folder's config.toml only then)
    local d user
    user=$(toml_user "$CODEX_DIR/config.toml")
    while IFS= read -r d; do
        [ -n "$d" ] && dir_items "$d" | grep -q '^mcp:' || continue
        printf '%s\n' "$user" | grep -qF "[projects.$(json_str "$d")]" && continue
        printf '[projects.%s]\ntrust_level = "trusted"\n\n' "$(json_str "$d")"
    done <<EOF
$(dirs_registered)
EOF
}
codex_top() { # project_root_markers with .agentkit, so Codex started in a sub-folder still finds the folder's own
    [ -n "$(dirs_registered)" ] || return 0
    if toml_user "$CODEX_DIR/config.toml" | grep -q '^[[:space:]]*project_root_markers[[:space:]]*='; then
        [ -n "$(state_get told codex-markers)" ] || { warn "Codex 的 config.toml 已經有自己的 project_root_markers：請自己加上 \".agentkit\"，不然在子資料夾開 Codex 讀不到資料夾自己的"; state_set told codex-markers 1; }
        return 0
    fi
    printf 'project_root_markers = [".git", "%s"]\n' "$DIR_FILE"
}

# ---------- the programs a skill needs (node, python, ...) and how to install them ----------
# A recipe is kit's own tools/<name>.yaml (node, python, git: a source cannot replace these) or tools/<name>.yaml in a
# source, for other programs. It names the program (bin) and, per system, "manager package" pairs; kit tries them in
# order, the ones this machine can use. The command itself is always kit's own: a recipe can only pick a manager kit
# knows (brew, apt as root, winget, scoop, pip) and a plain package name (no path, file, tap, URL or option).
# Only programs with a recipe are looked at (their --version run, at most 4 KB of it, for a few seconds).
tool_os() { [ -n "${KIT_OS:-}" ] || case $(uname -s 2>/dev/null) in Darwin) KIT_OS=mac;; MINGW*|MSYS*|CYGWIN*) KIT_OS=windows;; *) KIT_OS=linux;; esac; echo "$KIT_OS"; }
tool_ok_name() { case $1 in ""|-*|*[!a-z0-9-]*) return 1;; *) return 0;; esac; }
bin_ok() { case $1 in ""|[!A-Za-z0-9]*|*[!A-Za-z0-9._+-]*) return 1;; *) return 0;; esac; }   # a program name, never a path
pkg_ok() { # pkg_ok MANAGER PACKAGE : a plain package name for that manager
    # (brew: no tap/formula path, so node@20 but not user/tap/node; scoop: name or main|extras|versions/name)
    local p=$2
    [ "$1" = scoop ] && case $p in main/*|extras/*|versions/*) p=${p#*/};; esac
    case $p in ""|[!A-Za-z0-9]*) return 1;; esac
    case $1:$p in brew:*[!A-Za-z0-9@._+-]*) return 1;; brew:*) return 0;; *:*[!A-Za-z0-9._+-]*) return 1;; esac
    return 0
}
clt_stub() { # clt_stub PATH : a Mac without the Command Line Tools, where /usr/bin/git and python3 only open an install window
    [ "$(tool_os)" = mac ] || return 1
    case $1 in /usr/bin/git|/usr/bin/python3) ;; *) return 1;; esac
    [ -n "${KIT_CLT:-}" ] || { if xcode-select -p >/dev/null 2>&1; then KIT_CLT=yes; else KIT_CLT=no; fi; }
    [ "$KIT_CLT" = no ]
}
prog_path() { # prog_path NAME : the program NAME on PATH (a file, not a shell function), not the Mac's install stub
    local p; p=$(command -v "$1" 2>/dev/null) || return 1
    case $p in /*) ;; *) return 1;; esac
    ! clt_stub "$p" && printf '%s\n' "$p"
}
tool_file() { # tool_file NAME -> its recipe: kit's own first, else a source's tools/NAME.yaml
    local d
    tool_ok_name "$1" || return 1
    for d in "$KIT_LIB/tools" "$KIT_LIB/../tools"; do [ -f "$d/$1.yaml" ] && { printf '%s\n' "$d/$1.yaml"; return 0; }; done
    while IFS= read -r d; do [ -n "$d" ] && [ -f "$d/tools/$1.yaml" ] && { printf '%s\n' "$d/tools/$1.yaml"; return 0; }; done <<EOF
$( [ -f "$MACHINE" ] && src_dirs)
EOF
    return 1
}
tool_names() { # every program kit has a recipe for
    { [ -f "$MACHINE" ] && src_dirs | while IFS= read -r d; do for f in "$d"/tools/*.yaml; do [ -f "$f" ] && basename "$f" .yaml; done; done
      for f in "$KIT_LIB"/tools/*.yaml "$KIT_LIB"/../tools/*.yaml; do [ -f "$f" ] && basename "$f" .yaml; done; } | awk '!seen[$0]++' | while IFS= read -r n; do tool_ok_name "$n" && echo "$n"; done
}
tool_title() { local f t; f=$(tool_file "$1") && t=$(yget "$f" title | head -n 1); printf '%s' "${t:-$1}"; }
tool_version() { # tool_version PROGRAM : what PROGRAM --version says: at most 4 KB, given up after KIT_PROBE_WAIT seconds
    # (set -m: it runs in a process group of its own, so what it started goes too and nothing keeps the pipe open)
    ( set -m
      "$1" --version </dev/null 2>&1 & p=$!
      { sleep "${KIT_PROBE_WAIT:-5}"; kill -TERM -- -"$p"; } >/dev/null 2>&1 & w=$!
      wait "$p"; kill -TERM -- -"$p" -"$w" ) 2>/dev/null | head -c 4096
}
tool_have() { # tool_have NAME -> the version this machine has (empty: not there, or kit has no recipe for NAME)
    local f b bins v p
    f=$(tool_file "$1") || return 0
    bins=$(yget "$f" bin); [ -n "$bins" ] || bins=$1
    for b in $bins; do
        bin_ok "$b" && p=$(prog_path "$b") || continue
        v=$(tool_version "$p" | grep -oE '[0-9]+(\.[0-9]+)+' | head -n 1)
        [ -n "$v" ] && { printf '%s\n' "$v"; return 0; }
    done
    return 0
}
ver_ge() { # ver_ge HAVE MIN : HAVE is MIN or newer (numbers compared part by part)
    awk -v a="$1" -v b="$2" 'BEGIN { n = split(a, x, "."); m = split(b, y, "."); if (m > n) n = m
        for (i = 1; i <= n; i++) { if (x[i] + 0 > y[i] + 0) exit 0; if (x[i] + 0 < y[i] + 0) exit 1 } exit 0 }'
}
tool_picks() { # tool_picks NAME -> "manager package" lines: the ones in the recipe this machine can use, in order
    local f m p rest
    f=$(tool_file "$1") || return 1
    while read -r m p rest; do
        [ -n "$m" ] && [ -z "$rest" ] && pkg_ok "$m" "$p" || continue
        case $m in
            brew|scoop|winget) command -v "$m" >/dev/null 2>&1 || continue;;
            apt) [ "$(id -u 2>/dev/null)" = 0 ] && command -v apt-get >/dev/null 2>&1 || continue;;
            pip) prog_path python3 >/dev/null || continue;;
            *) continue;;
        esac
        printf '%s %s\n' "$m" "$p"
    done <<EOF
$(yget "$f" "install.$(tool_os)")
EOF
}
tool_argv() { # tool_argv install|upgrade|machine MANAGER PACKAGE -> the command, one word per line (kit's own, never the recipe's)
    # (machine: winget again without --scope user, for a package that only has an installer for the whole machine)
    case $1:$2 in
        install:brew) printf '%s\n' brew install "$3";;
        upgrade:brew) printf '%s\n' brew upgrade "$3";;
        *:apt) printf '%s\n' apt-get install -y "$3";;                # installs or upgrades
        install:pip) printf '%s\n' python3 -m pip install --user --only-binary=:all: "$3";;   # wheels only: no setup.py runs
        upgrade:pip) printf '%s\n' python3 -m pip install --user --only-binary=:all: --upgrade "$3";;
        install:winget) printf '%s\n' winget install --id "$3" -e --scope user --accept-source-agreements --accept-package-agreements;;
        machine:winget) printf '%s\n' winget install --id "$3" -e --accept-source-agreements --accept-package-agreements;;
        upgrade:winget) printf '%s\n' winget upgrade --id "$3" -e --accept-source-agreements --accept-package-agreements;;
        install:scoop) printf '%s\n' scoop install "$3";;
        upgrade:scoop) printf '%s\n' scoop update "$3";;
    esac
}
words() { local w s=""; while IFS= read -r w; do s="${s:+$s }$w"; done; printf '%s' "$s"; }   # lines -> one line
tool_cmd() { local mp; mp=$(tool_picks "$1" | head -n 1); [ -z "$mp" ] || tool_argv "${2:-install}" $mp | words; }
skill_needs() { # skill_needs SKILLDIR [SOURCEDIR] -> name<TAB>min per program the skill needs (min may be empty)
    # written: SKILL.md "requires: [node>=18, python]", or the source's kit.yaml "requires: {<skill>: [...]}"
    # seen: what SKILL.md tells the agent to run (node x.mjs, npx, python3 x.py, pip install ...), requirements.txt /
    # pyproject.toml; package.json's engines.node gives the lowest Node (files alone say nothing: often only for the author)
    local d=$1 src=${2:-} v
    {
        [ -f "$d/SKILL.md" ] && fm_val "$(fm_of "$d/SKILL.md")" requires
        [ -n "$src" ] && yget "$src/kit.yaml" "requires.$(basename "$d")"
        if [ -f "$d/SKILL.md" ]; then
            LC_ALL=C grep -qE '(^|[^A-Za-z0-9_-])(node[ 	]+(-[A-Za-z-]+[ 	]+)*[./A-Za-z0-9_-]+\.(mjs|cjs|js)([^A-Za-z0-9]|$)|npx[ 	]+[A-Za-z@]|npm[ 	]+(run|install|ci|exec)([^A-Za-z]|$))' "$d/SKILL.md" && echo node
            LC_ALL=C grep -qE '(^|[^A-Za-z0-9_-])(python3?[ 	]+(-m[ 	]+[A-Za-z]|[./A-Za-z0-9_-]+\.py([^A-Za-z0-9]|$))|pip3?[ 	]+install|uv[ 	]+run)' "$d/SKILL.md" && echo python
        fi
        if [ -f "$d/package.json" ]; then
            v=$(json_get "$d/package.json" engines.node | tr -d '"' | grep -oE '[0-9]+(\.[0-9]+)*' | head -n 1)
            [ -n "$v" ] && echo "node>=$v.min"
        fi
        if [ -f "$d/requirements.txt" ] || [ -f "$d/pyproject.toml" ]; then echo python; fi
    } | awk -F'>=' '{ n = $1; gsub(/[ \t]/, "", n); m = $2; gsub(/[ \t]/, "", m)
            if (n !~ /^[a-z0-9][a-z0-9-]*$/) next
            only = sub(/\.min$/, "", m)                       # package.json: only a lowest version, not a need by itself
            if (only) { if (m != "") low[n] = m; next }
            if (!(n in seen)) { seen[n] = 1; ord[++k] = n }
            if (m ~ /^[0-9]+(\.[0-9]+)*$/ && (min[n] == "" || newer(m, min[n]))) min[n] = m }
        function newer(a, b,   x, y, i, p, q) { p = split(a, x, "."); q = split(b, y, "."); if (q > p) p = q
            for (i = 1; i <= p; i++) { if (x[i] + 0 > y[i] + 0) return 1; if (x[i] + 0 < y[i] + 0) return 0 } return 0 }
        END { for (i = 1; i <= k; i++) { n = ord[i]; m = min[n]
                  if ((n in low) && (m == "" || newer(low[n], m))) m = low[n]
                  print n "\t" m } }'
}
tool_cache() { # every program kit has a recipe for: its title, what this machine has, kit's install and upgrade
    # commands, kept in TC_*_<name> (looked at once per run, here, not in the subshells that print each skill)
    local n c h t mp
    for n in $(tool_names); do
        c=${n//-/_}; h=$(tool_have "$n"); t=$(yget "$(tool_file "$n")" title | head -n 1); mp=$(tool_picks "$n" | head -n 1)
        eval "TC_HAVE_$c=\$h; TC_TITLE_$c=\${t:-\$n}; TC_INST_$c=; TC_UPG_$c="
        [ -z "$mp" ] || eval "TC_INST_$c=\$(tool_argv install \$mp | words); TC_UPG_$c=\$(tool_argv upgrade \$mp | words)"
    done
    TC_DONE=1
}
needs_json() { # needs_json SKILLDIR SOURCEDIR -> [{"tool", "title", "min", "have", "ok", "install"}] (after tool_cache)
    local n m h t i ok first=1 c
    printf '['
    while IFS="$TAB" read -r n m; do
        [ -n "$n" ] || continue
        c=${n//-/_}; eval "h=\${TC_HAVE_$c-}; t=\${TC_TITLE_$c:-\$n}; i=\${TC_INST_$c-}"   # no recipe: not looked at
        ok=false; [ -n "$h" ] && { [ -z "$m" ] || ver_ge "$h" "$m"; } && ok=true
        if [ $ok = true ]; then i=""; elif [ -n "$h" ]; then eval "i=\${TC_UPG_$c-}"; fi
        [ $first = 1 ] || printf ', '; first=0
        printf '{"tool": %s, "title": %s, "min": %s, "have": %s, "ok": %s, "install": %s}' "$(json_s "$n")" "$(json_s "$t")" \
            "$(json_s "$m")" "$(json_s "$h")" "$ok" "$(json_s "$i")"
    done <<EOF
$(if [ "$1" = - ]; then cat; else skill_needs "$1" "$2"; fi)
EOF
    printf ']'
}
mcp_list_json() { # mcp_list_json FILE NAME -> ', "type": .., "vars": [..], "needs": [..], "packages": [..]' (after tool_cache)
    local f=$1 n=$2 info t v kind pkg ver argno bin first bad s ok had c out=""
    info=$(mcp_info "$f"); t=$(mcp_lines "$info" T | head -n 1)
    printf ', "type": %s, "vars": [' "$(json_s "${t:-stdio}")"
    first=1
    for v in $(mcp_lines "$info" V); do
        [ $first = 1 ] || printf ', '; first=0
        ok=false; [ -z "$(printenv "$v" 2>/dev/null)" ] || ok=true
        printf '{"name": %s, "set": %s}' "$(json_s "$v")" "$ok"
    done
    printf '], "needs": %s' "$( { mcp_lines "$info" R | sed "s/\$/$TAB/"; yget "$f" requires | awk -F'>=' '{ n = $1; gsub(/[ \t]/, "", n); m = $2; gsub(/[ \t]/, "", m); print n "\t" m }'; } |
        awk -F'\t' '$1 ~ /^[a-z0-9][a-z0-9-]*$/ && !seen[$1]++' | needs_json -)"
    IFS=$US read -r kind pkg ver argno bin first bad <<EOF
$(mcp_lines "$info" P | head -n 1 | tr '\t' "$US")
EOF
    if [ -n "$kind" ]; then
        s=$(mcp_store "$n"); ok=false; had=false; c=""
        mcp_installed "$n" "$kind" "$pkg" "$ver" "$bin" >/dev/null && ok=true
        [ -d "$s/node_modules" ] || [ -d "$s/venv" ] && had=true
        [ -n "$bad" ] || [ -n "$ver" ] || bad="沒有固定版本：kit 只裝固定的版本（寫成 $pkg@版本）"
        if [ "$kind" = npm ]; then command -v npm >/dev/null 2>&1 && c="npm install --ignore-scripts --omit=dev --no-audit --no-fund"
        else prog_path python3 >/dev/null && c="python3 -m venv venv; venv/bin/python $PIP_ARGS"; fi
        out=$(printf '{"kind": %s, "package": %s, "version": %s, "ok": %s, "had": %s, "install": %s, "bad": %s}' "$(json_s "$kind")" "$(json_s "$pkg")" \
            "$(json_s "$ver")" "$ok" "$had" "$(json_s "$c")" "$(json_s "$bad")")
    fi
    printf ', "packages": [%s]' "$out"
}
cmd_tools() { # kit tools : the programs kit knows how to install, what this machine has
    local n h c
    for n in $(tool_names); do
        h=$(tool_have "$n"); c=$(tool_cmd "$n")
        printf '%-8s %-12s %s\n' "$n" "${h:-（沒有）}" "${c:-（這台沒有可以用的安裝方式）}"
    done
}
cmd_install_tool() { # kit install-tool <name> [--min VERSION] : install (or, too old, upgrade) with kit's recipe (the panel's 安裝)
    local n="" min="" f h mp mode=install
    while [ $# -gt 0 ]; do
        case $1 in
            --min) [ $# -ge 2 ] || die "--min 後面要接版本"; min=$2; shift 2
                   case $min in *[!0-9.]*|"") die "--min 後面要接版本（像 18 或 3.10）";; esac;;
            -*) die "用法：kit install-tool <程式名> [--min 版本]";;
            *) [ -z "$n" ] || die "用法：kit install-tool <程式名> [--min 版本]"; n=$1; shift;;
        esac
    done
    [ -n "$n" ] || die "用法：kit install-tool <程式名> [--min 版本]（打 kit tools 看有哪些）"
    f=$(tool_file "$n") || die "kit 不知道怎麼裝 ${n}（打 kit tools 看有哪些；要加就在來源倉放 tools/${n}.yaml）"
    h=$(tool_have "$n")
    if [ -n "$h" ]; then
        { [ -z "$min" ] || ver_ge "$h" "$min"; } && { say "kit：這台已經有 $(tool_title "$n") $h"; return 0; }
        mode=upgrade
    fi
    mp=$(tool_picks "$n")
    [ -n "$mp" ] || die "這台沒有可以用的安裝方式：請自己裝 $(tool_title "$n")${min:+ $min 以上}（$(tool_os) 的裝法寫在 ${f}）"
    # each way in the recipe in turn, until one works (fd 3: an installer may read the terminal)
    local m p ok="" last=""
    while read -r m p <&3; do
        [ -n "$m" ] || continue
        set -- $(tool_argv $mode "$m" "$p")
        say "kit：執行 $*"
        [ -n "${KIT_DRY_RUN:-}" ] && return 0
        "$@" && { ok=1; break; }
        if [ "$m:$mode" = winget:install ]; then
            set -- $(tool_argv machine "$m" "$p")
            say "kit：winget 沒有只裝給這個帳號的版本，改成一般安裝：$*"
            "$@" && { ok=1; break; }
        fi
        last=$m; warn "用 $m 裝失敗（上面是它說的原因）"
    done 3<<EOF
$mp
EOF
    [ -n "$ok" ] || die "安裝失敗：$(tool_title "$n") 的每一種裝法都沒有成功（最後是 ${last}）"
    hash -r 2>/dev/null
    h=$(tool_have "$n")
    [ -n "$h" ] || die "裝完了，但還是找不到 $(tool_title "$n")：開一個新的終端機再試，或檢查 PATH"
    [ -z "$min" ] || ver_ge "$h" "$min" || die "裝完了，但 $(tool_title "$n") 還是 ${h}，不到 ${min}：可能有別的舊版排在 PATH 前面"
    say "kit：$(tool_title "$n") $h 裝好了"
}

# ---------- a skill's own packages (npm, pip) ----------
# Some skills run their own scripts with packages: npm (package.json "dependencies") or pip (requirements.txt).
# kit installs them only when you ask (kit install-deps, the panel's 安裝), into its own folders, never in the source:
#   npm: $KIT_CONF/deps/<skill>/node_modules, npm ci (with a lock) or npm install, always --ignore-scripts --omit=dev,
#        without the skill's .npmrc. package.json may only ask for versions from the registry (no git, URL, file,
#        link, workspace: npm runs code while fetching a git package, --ignore-scripts or not), and a lock must
#        point every package at a registry tarball with its integrity. Each copy of the skill gets node_modules
#        linked there (Node finds it by itself).
#   pip: $KIT_CONF/pydeps/<skill>/venv, a venv of its own; pip install --only-binary=:all: (wheels only: nothing
#        is built, so no setup.py runs), and requirements.txt may only name packages and versions (no -r, -e,
#        --index-url, URLs, options ...). Each copy gets .venv linked there; the account's instructions block tells
#        agents to run the skill's .py with that .venv's python.
# .kit-src keeps the files they were installed for: when the skill changes them, it needs 更新 again.
deps_store() { printf '%s\n' "$KIT_CONF/deps/$1"; }
pydeps_store() { printf '%s\n' "$KIT_CONF/pydeps/$1"; }
pkgs_need() { # pkgs_need SKILLDIR : it has npm packages to install (and does not bring them itself)
    local v
    [ -f "$1/package.json" ] && [ ! -d "$1/node_modules" ] || return 1
    v=$(json_get "$1/package.json" dependencies | tr -d ' \t\r\n')
    [ -n "$v" ] && [ "$v" != "{}" ]
}
pypkgs_need() { # pypkgs_need SKILLDIR : it has a requirements.txt naming something (and no .venv of its own)
    [ -f "$1/requirements.txt" ] || return 1
    [ -d "$1/.venv" ] && [ ! -L "$1/.venv" ] && return 1
    grep -qvE '^[[:space:]]*(#.*)?$' "$1/requirements.txt"
}
py_reqs_bad() { # py_reqs_bad FILE -> the first line that is not a plain requirement (name[extras] versions ; markers)
    # Markers only with marker characters, and no option anywhere (pip takes "--no-binary" and such on a line too)
    LC_ALL=C awk -v q="'" '{ l = $0; sub(/\r$/, "", l); sub(/(^|[ \t])#.*$/, "", l); gsub(/^[ \t]+|[ \t]+$/, "", l)
        if (l == "") next
        v = "(===|==|>=|<=|~=|!=|<|>)[ \t]*[A-Za-z0-9.*+!_-]+"
        if (l ~ /(^|[ \t])-/ || l !~ ("^[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?[ \t]*(\\[[A-Za-z0-9._, -]*\\])?[ \t]*(" v "([ \t]*,[ \t]*" v ")*)?[ \t]*(;[A-Za-z0-9_.<>=!~\"() \t" q "]*)?$")) { print NR ": " $0; exit } }' "$1"
}
npm_registry() { # the registry in your own ~/.npmrc (an https URL, ending in /), if you set one
    [ -f "$HOME/.npmrc" ] || return 0
    LC_ALL=C awk '{ sub(/\r$/, "") } /^[ \t]*registry[ \t]*=/ { r = $0; sub(/^[^=]*=[ \t]*/, "", r); sub(/[ \t]+$/, "", r) }
        END { if (r ~ /^https:\/\/[A-Za-z0-9.-]+(:[0-9]+)?(\/[A-Za-z0-9._~%\/-]*)?$/) { if (r !~ /\/$/) r = r "/"; print r } }' "$HOME/.npmrc"
}
npm_bad() { # npm_bad SKILLDIR -> why kit does not install its npm packages (the first reason; empty: fine)
    local d=$1 o
    o=$(LC_ALL=C awk -f "$KIT_LIB/json.awk" -v leaves=1 "$d/package.json" 2>/dev/null) || { echo "package.json: 讀不懂"; return 0; }
    # dependencies, optionalDependencies, peerDependencies (npm 7+ installs them) and overrides: versions or dist-tags
    # from the registry only (an alias npm:name@version too); never git, github:, user/repo, a URL, file:, link:,
    # workspace: or a path
    o=$(printf '%s\n' "$o" | LC_ALL=C awk -F'\t' '
        function unq(v) { return (v ~ /^".*"$/) ? substr(v, 2, length(v) - 2) : v }
        function spec_ok(v,   s, i, nm) {
            if (v !~ /^".*"$/) return 0
            s = unq(v)
            if (s ~ /^npm:/) {
                s = substr(s, 5); i = index(substr(s, 2), "@")
                if (i == 0) { nm = s; s = "" } else { nm = substr(s, 1, i); s = substr(s, i + 2) }
                if (nm !~ /^(@[A-Za-z0-9._~-]+\/)?[A-Za-z0-9._~-]+$/ || nm ~ /^[._]/) return 0
            }
            return s ~ /^[A-Za-z0-9 .*^~<>=|+-]*$/ && s !~ /^[.]/
        }
        { val = $NF }
        ($1 == "dependencies" || $1 == "optionalDependencies" || $1 == "peerDependencies") && !(NF == 2 && val ~ /^(\{\}|\[\])$/) {
            if (NF != 3 || !spec_ok(val)) { print "package.json: " $1 "." $2 " = " unq(val); exit } }
        $1 == "overrides" && NF >= 3 && !spec_ok(val) && unq(val) !~ /^\$[A-Za-z0-9@._\/~-]+$/ {
            k = $1; for (i = 2; i < NF; i++) k = k "." $i; print "package.json: " k " = " unq(val); exit }')
    [ -z "$o" ] || { printf '%s\n' "$o"; return 0; }
    [ -f "$d/package-lock.json" ] || return 0
    o=$(LC_ALL=C awk -f "$KIT_LIB/json.awk" -v leaves=1 "$d/package-lock.json" 2>/dev/null) || { echo "package-lock.json: 讀不懂"; return 0; }
    # every package (lockfile v2/v3 "packages", or v1 "dependencies"): a tarball on registry.npmjs.org (or your
    # ~/.npmrc registry), with integrity; never a link; bundled ones come inside their parent's tarball
    printf '%s\n' "$o" | LC_ALL=C awk -F'\t' -v reg="$(npm_registry)" '
        function unq(v) { return (v ~ /^".*"$/) ? substr(v, 2, length(v) - 2) : v }
        function tarball_ok(v,   s) {
            if (v !~ /^".*"$/) return 0
            s = unq(v)
            if (index(s, "https://registry.npmjs.org/") == 1) s = substr(s, 28)
            else if (reg != "" && index(s, reg) == 1) s = substr(s, length(reg) + 1)
            else return 0
            return s ~ /^[A-Za-z0-9@._~%+\/-]+\.tgz$/ && index(s, "/-/") > 0
        }
        $1 == "packages" && NF >= 3 {
            p = "p" SUBSEP $2; if ($2 == "") next
            if (!(p in lab)) { lab[p] = $2; ord[++n] = p }
            if (NF == 4) f[p, $3] = $4
            has = 1; next }
        $1 == "dependencies" && NF >= 4 {
            l = "node_modules/" $2; i = 3
            while (i + 2 < NF && $i == "dependencies") { l = l "/node_modules/" $(i + 1); i += 2 }
            p = "v" SUBSEP l
            if (!(p in lab)) { lab[p] = l; ord[++n] = p }
            if (i == NF - 1) f[p, $i] = $NF }
        END {
            for (j = 1; j <= n; j++) {
                p = ord[j]; v1 = (substr(p, 1, 1) == "v")
                if (has == v1) continue                       # a lock with "packages": only those count
                if (f[p, "link"] == "true") { print "package-lock.json: " lab[p] ": link"; exit }
                if (f[p, v1 ? "bundled" : "inBundle"] == "true") continue
                if (!tarball_ok(f[p, "resolved"])) { r = f[p, "resolved"]; print "package-lock.json: " lab[p] ": resolved " (r == "" ? "（沒有）" : unq(r)); exit }
                if (f[p, "integrity"] !~ /^"sha[0-9]+-/) { print "package-lock.json: " lab[p] ": 沒有 integrity"; exit }
            } }'
}
deps_fresh() { # deps_fresh SKILLDIR STORE : the store has this skill's npm packages, for this package.json (and lock)
    [ -d "$2/node_modules" ] && cmp -s "$1/package.json" "$2/.kit-src/package.json" || return 1
    if [ -f "$1/package-lock.json" ]; then cmp -s "$1/package-lock.json" "$2/.kit-src/package-lock.json"; else [ ! -f "$2/.kit-src/package-lock.json" ]; fi
}
pydeps_fresh() { [ -x "$2/venv/bin/python" ] && cmp -s "$1/requirements.txt" "$2/.kit-src/requirements.txt"; }
pkgs_cmd() { # the npm command, one word per line: npm ci with a lock (the exact versions), else npm install
    if [ -f "$1/package-lock.json" ]; then printf '%s\n' npm ci; else printf '%s\n' npm install; fi
    printf '%s\n' --ignore-scripts --omit=dev --no-audit --no-fund
}
PIP_ARGS="-m pip install --only-binary=:all: --no-input --disable-pip-version-check -r requirements.txt"
link_deps() { # link_deps NAME DST : the packages kit installed for skill NAME show in its copy DST
    local s
    s=$(deps_store "$1")
    if [ -f "$2/package.json" ] && deps_fresh "$2" "$s" && { [ ! -e "$2/node_modules" ] || [ -L "$2/node_modules" ]; }; then
        ln -sfn "$s/node_modules" "$2/node_modules"
    fi
    s=$(pydeps_store "$1")
    if [ -f "$2/requirements.txt" ] && pydeps_fresh "$2" "$s" && { [ ! -e "$2/.venv" ] || [ -L "$2/.venv" ]; }; then
        ln -sfn "$s/venv" "$2/.venv"
    fi
    return 0
}
py_hint() { # py_hint SKILL... : the line for the instructions block, when kit has a venv for one of these skills
    local n p
    for n in "$@"; do
        [ -d "$KIT_CONF/pydeps/$n/venv" ] && p=$(find_item skill "$n") || continue
        [ -f "${p%/*}/requirements.txt" ] && pydeps_fresh "${p%/*}" "$(pydeps_store "$n")" || continue
        printf '%s\n' '- skill 資料夾裡有 `.venv`（kit 裝的 Python 套件）時，執行那個 skill 的 Python 程式要用它自己的 python：`<skill 資料夾>/.venv/bin/python`（Windows：`<skill 資料夾>\.venv\Scripts\python.exe`），不要另外 pip install。'
        return 0
    done
}
packages_json() { # packages_json SKILLDIR NAME -> ', "packages": [...]' when the skill has packages to install
    local d=$1 s ok had c bad items=""
    if pkgs_need "$d"; then
        s=$(deps_store "$2"); ok=false; had=false; c=""; bad=""
        deps_fresh "$d" "$s" && ok=true
        [ -d "$s/node_modules" ] && had=true
        command -v npm >/dev/null 2>&1 && c=$(pkgs_cmd "$d" | words)
        [ $ok = true ] || bad=$(npm_bad "$d")              # (installed: it was looked at then)
        items='{"kind": "npm", "ok": '$ok', "had": '$had', "install": '$(json_s "$c")', "bad": '$(json_s "$bad")'}'
    fi
    if pypkgs_need "$d"; then
        s=$(pydeps_store "$2"); ok=false; had=false; c=""
        pydeps_fresh "$d" "$s" && ok=true
        [ -d "$s/venv" ] && had=true
        prog_path python3 >/dev/null && c="python3 -m venv venv; venv/bin/python $PIP_ARGS"
        items="${items:+$items, }"'{"kind": "pip", "ok": '$ok', "had": '$had', "install": '$(json_s "$c")', "bad": '$(json_s "$(py_reqs_bad "$d/requirements.txt")")'}'
    fi
    [ -z "$items" ] || printf ', "packages": [%s]' "$items"
}
install_npm() { # install_npm SKILLDIR STORE
    local d=$1 s=$2 new bad
    bad=$(npm_bad "$d")
    [ -z "$bad" ] || die "kit 不裝這些 npm 套件（只能裝 npm registry 上的版本，不能是 git、網址、檔案或連結）：$bad"
    command -v npm >/dev/null 2>&1 || die "要先有 Node.js（npm）：Kit 清單上按 Node.js 的「安裝」，或打 kit install-tool node"
    set -- $(pkgs_cmd "$d")
    say "kit：在 $s 執行 $*（不跑套件自己的安裝程式）"
    [ -n "${KIT_DRY_RUN:-}" ] && return 0
    # built in a folder of its own next to the store (gone again when npm fails or kit is stopped), then swapped in
    mkdir -p "${s%/*}" && new=$(mktemp -d "$s.new.XXXXXX") || die "沒辦法在 ${s%/*} 建立暫存資料夾"
    KIT_TMPDIR=$new
    mkdir -p "$new/.kit-src" && cp "$d/package.json" "$new/" || die "沒辦法寫 $new"
    [ ! -f "$d/package-lock.json" ] || cp "$d/package-lock.json" "$new/"
    ( cd "$new" && "$@" ) || die "裝套件失敗（上面是 npm 說的原因）"
    cp "$d/package.json" "$new/.kit-src/"
    [ ! -f "$d/package-lock.json" ] || cp "$d/package-lock.json" "$new/.kit-src/"
    rm -rf "$s"; mv "$new" "$s" || die "沒辦法把套件放到 $s"
    KIT_TMPDIR=
}
pip_back() { # pip_back STORE : a pip install that did not finish: the venv kit had before goes back in its place
    rm -rf "$1"; [ ! -e "$1.old" ] || mv "$1.old" "$1"
}
install_pip() { # install_pip SKILLDIR STORE
    local d=$1 s=$2 bad
    bad=$(py_reqs_bad "$d/requirements.txt")
    [ -z "$bad" ] || die "requirements.txt 有 kit 不接受的寫法（只能寫套件名和版本）：第 $bad"
    prog_path python3 >/dev/null || die "要先有 Python：Kit 清單上按 Python 的「安裝」，或打 kit install-tool python"
    say "kit：在 $s 執行 python3 -m venv venv，再用它的 python ${PIP_ARGS}（只裝現成的 wheel，不跑套件的安裝程式）"
    [ -n "${KIT_DRY_RUN:-}" ] && return 0
    # a venv remembers its own path (its scripts start with it): built where it stays, the old one kept until it works;
    # failing or stopped (Ctrl-C), the old one goes back (on_exit). An .old left over: that install never finished.
    [ ! -e "$s.old" ] || pip_back "$s"
    [ ! -e "$s" ] || mv "$s" "$s.old" || die "沒辦法搬開舊的 $s"
    KIT_PIP_STORE=$s
    mkdir -p "$s/.kit-src" && cp "$d/requirements.txt" "$s/" || die "沒辦法建立 $s"
    ( cd "$s" && python3 -m venv venv ) || die "沒辦法建立 Python 的 venv（上面是原因；Debian/Ubuntu 可能要先裝 python3-venv）"
    ( cd "$s" && venv/bin/python $PIP_ARGS ) || die "裝套件失敗（上面是 pip 說的原因；只能裝有現成 wheel 的套件）"
    cp "$d/requirements.txt" "$s/.kit-src/" || die "沒辦法寫 $s"
    KIT_PIP_STORE=; rm -rf "$s.old"
}
link_copies() { # link_copies NAME : every copy of skill NAME kit put (the account, Codex and omp, each folder's own) gets the links
    local d
    [ -z "$(state_get skill "$1")" ] || link_deps "$1" "$CLAUDE_DIR/skills/$1"
    [ -z "$(state_get skill.agents "$1")" ] || link_deps "$1" "$AGENTS_SKILLS/$1"
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        [ -z "$(state_get "$(dir_kind "$d" skill)" "$1")" ] || link_deps "$1" "$d/.claude/skills/$1"
        [ -z "$(state_get "$(dir_kind "$d" skill.agents)" "$1")" ] || link_deps "$1" "$d/.agents/skills/$1"
    done <<EOF
$(dirs_registered)
EOF
}
mcp_install() { # kit install-deps mcp <name> : its npm or Python package, the pinned version, in $KIT_CONF/mcp-deps/<name>
    # (the same rules as a skill's: npm --ignore-scripts from the registry, pip wheels only in a venv of its own); then
    # every tool's MCP setup runs it from there instead of npx/uvx downloading it at each start
    local n=$1 p kind pkg ver argno bin first bad s stage
    p=$(find_item mcp "$n") || die "找不到 mcp ${n}（打 kit list 看有哪些）"
    IFS=$US read -r kind pkg ver argno bin first bad <<EOF
$(mcp_pkg "$p")
EOF
    [ -n "$kind" ] || { say "kit：mcp $n 不用另外裝套件"; return 0; }
    [ -z "$bad" ] || die "kit 不幫 mcp $n 裝套件：${bad}（它照樣在啟動時下載）"
    [ -n "$ver" ] || die "mcp $n 的套件 $pkg 沒有固定版本：kit 只裝固定的版本（在 mcp/$n.yaml 寫成 $pkg@版本）"
    s=$(mcp_store "$n")
    if mcp_installed "$n" "$kind" "$pkg" "$ver" "$bin" >/dev/null; then say "kit：mcp $n 的套件已經裝好了（$pkg ${ver}）"
    else
        stage=$(mktemp -d "${TMPDIR:-/tmp}/kit-mcp.XXXXXX") || die "沒辦法建立暫存資料夾"; KIT_STAGE=$stage
        if [ "$kind" = npm ]; then mcp_pkgjson "$n" "$pkg" "$ver" > "$stage/package.json"; install_npm "$stage" "$s"
        else printf '%s==%s\n' "$pkg" "$ver" > "$stage/requirements.txt"; install_pip "$stage" "$s"; fi
        rm -rf "$stage"; KIT_STAGE=
        [ -z "${KIT_DRY_RUN:-}" ] || return 0
        mcp_installed "$n" "$kind" "$pkg" "$ver" "$bin" >/dev/null || die "裝好了，但找不到 $pkg 要跑的程式（${bin:-package.json 的 bin}）：照樣在啟動時下載"
        say "kit：mcp $n 的套件裝好了（$pkg ${ver}）"
    fi
    [ -f "$MACHINE" ] || return 0
    apply_dirs; apply_claude
}
cmd_install_deps() { # kit install-deps [skill] <skill> [npm|pip] | mcp <name> : packages in kit's folders, no package scripts
    # (it holds kit's lock the whole time: one install at a time, and no sync in between)
    case ${1:-} in
        mcp) if [ $# = 2 ] && [ "$2" != npm ] && [ "$2" != pip ]; then mcp_install "$2"; return; fi;;
        skill) [ $# -lt 2 ] || shift;;
    esac
    local n="" only="" p d did=0 a
    for a in "$@"; do
        case $a in
            npm|pip) [ -z "$only" ] && [ -n "$n" ] || die "用法：kit install-deps <skill 名字> [npm|pip]"; only=$a;;
            -*|"") die "用法：kit install-deps <skill 名字> [npm|pip]";;
            *) [ -z "$n" ] || die "用法：kit install-deps <skill 名字> [npm|pip]"; n=$a;;
        esac
    done
    [ -n "$n" ] || die "用法：kit install-deps <skill 名字> [npm|pip]"
    p=$(find_item skill "$n") || die "找不到 skill ${n}（打 kit list 看有哪些）"
    d=$(dirname "$p")
    if [ "$only" != pip ] && pkgs_need "$d"; then
        did=1
        if deps_fresh "$d" "$(deps_store "$n")"; then say "kit：$n 的 npm 套件已經裝好了"
        else install_npm "$d" "$(deps_store "$n")"; [ -n "${KIT_DRY_RUN:-}" ] || say "kit：$n 的 npm 套件裝好了"; fi
    fi
    if [ "$only" != npm ] && pypkgs_need "$d"; then
        did=1
        if pydeps_fresh "$d" "$(pydeps_store "$n")"; then say "kit：$n 的 Python 套件已經裝好了"
        else install_pip "$d" "$(pydeps_store "$n")"; [ -n "${KIT_DRY_RUN:-}" ] || say "kit：$n 的 Python 套件裝好了"; fi
    fi
    [ $did = 1 ] || { say "kit：$n 不用另外裝套件"; return 0; }
    [ -z "${KIT_DRY_RUN:-}" ] || return 0
    # every copy kit put gets the links, and the account's instructions the python line
    [ -f "$MACHINE" ] || return 0
    link_copies "$n"
    apply_rules "$(wanted)"
}

# ---------- how full an agent's context is (kit context; kit statusline keeps Claude's) ----------
# Claude: its statusLine (kit puts `kit statusline` there when there is none) hands kit the exact numbers on every
# update; kit keeps them in $KIT_CONF/ctx/claude-<pid>.json. Without that, the newest transcript in the folder's
# project dir. Codex: the newest rollout of that folder (~/.codex/sessions), its last token_count. omp: the
# session its terminal points at (~/.omp/agent/terminal-sessions/<tty>) or the newest of that folder, its last
# assistant message. Only numbers are read, never what was said.
CTX_DIR="$KIT_CONF/ctx"
num_of() { # num_of KEY TEXT -> the first number after "KEY": in TEXT (JSON)
    printf '%s' "$2" | grep -oE "\"$1\"[[:space:]]*:[[:space:]]*[0-9]+(\.[0-9]+)?" | head -n 1 | grep -oE '[0-9]+(\.[0-9]+)?$' | sed 's/\..*//'
}
str_of() { printf '%s' "$2" | grep -oE "\"$1\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" | head -n 1 | sed 's/^[^:]*:[[:space:]]*"//; s/"$//'; }
after_key() { printf '%s' "$2" | sed "s/.*\"$1\"[[:space:]]*:[[:space:]]*//"; }   # the text after the last "KEY":
setting_window() { # the window Claude Code is told to use for a model (autoCompactWindow: modelSettings.<model>, else
    # the top-level one), as its own /context shows it; nothing when not set
    local m=${1%\[1m\]} w=""
    [ -f "$CLAUDE_DIR/settings.json" ] || return 0
    w=$(json_get "$CLAUDE_DIR/settings.json" "modelSettings.$m.autoCompactWindow" | tr -d '" ')
    [ -n "$w" ] || w=$(json_get "$CLAUDE_DIR/settings.json" autoCompactWindow | tr -d '" ')
    case $w in ""|auto|*[!0-9]*) ;; *) echo "$w";; esac
}
model_window() { # the context window Claude Code uses for a model: a setting (autoCompactWindow), else the model's own
    local w
    w=$(setting_window "$1")
    [ -n "$w" ] && { echo "$w"; return; }
    case $1 in
        *\[1m\]|*opus-5*|*opus-4-7*|*opus-4-8*|*sonnet-5*|*fable*|*mythos*|*haiku-5*) echo 1000000;;
        claude-*|anthropic/*) echo 200000;;
    esac
}
proc_args() { ps -o args= -p "$1" 2>/dev/null; }
proc_cwd() { # a process's folder (Linux /proc, else lsof)
    if [ -d "/proc/$1" ]; then readlink "/proc/$1/cwd" 2>/dev/null; return; fi
    command -v lsof >/dev/null 2>&1 && lsof -a -p "$1" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -n 1
}
claude_pid() { # the Claude process above this one (Claude runs the status line through a shell): one look at every process
    { ps -A -o pid= -o ppid= -o args= 2>/dev/null || ps -o pid,ppid,args 2>/dev/null; } | awk -v p="$PPID" '
        $1 ~ /^[0-9]+$/ { a = $3; b = $4; sub(/^.*\//, "", a); sub(/^.*\//, "", b); up[$1] = $2 + 0; w1[$1] = a; w2[$1] = b }
        END { p += 0
              for (i = 0; i < 8 && p > 1 && (p in up); i++) {
                  if (w1[p] == "claude" || w1[p] == "claude.exe" || w2[p] == "claude" || w2[p] == "claude.js" || w2[p] == "cli.js") { print p; exit }
                  p = up[p] } }'
}
ctx_json() { # ctx_json TOOL USED WINDOW SOURCE MODEL [PCT] -> the answer (PCT: the tool's own way of counting)
    local pct=null u=${2:-} w=${3:-}
    [ -n "$u" ] && [ -n "$w" ] && [ "$w" -gt 0 ] 2>/dev/null && pct=$(( (u * 100 + w / 2) / w ))
    [ -z "${6:-}" ] || pct=$6
    [ "$pct" != null ] && [ "$pct" -gt 100 ] 2>/dev/null && pct=100      # an estimate past the window: full
    printf '{"tool": %s, "used": %s, "window": %s, "pct": %s, "source": %s, "model": %s}\n' "$(json_s "$1")" "${u:-null}" "${w:-null}" "$pct" "$(json_s "$4")" "$(json_s "$5")"
}
cmd_statusline() { # what Claude's statusLine runs: keep the numbers for kit context, print a short status line
    # (it runs on every update of Claude's status line: one awk for what Claude hands over, one ps for the Claude process;
    # the window set in settings.json, autoCompactWindow, only when settings.json has one)
    local w pct u sid model name tp cwd pid tmp us sw st=""
    us=$(printf '\037')
    IFS=$us read -r w pct u sid model name tp cwd <<EOF
$(LC_ALL=C awk -v us="$us" '
    function after(s, k,   p) { p = 0; while (match(substr(s, p + 1), "\"" k "\"[ \t\r\n]*:[ \t\r\n]*")) p += RSTART + RLENGTH - 1; return p ? substr(s, p + 1) : s }
    function num(s, k) { if (!match(s, "\"" k "\"[ \t\r\n]*:[ \t\r\n]*[0-9]+")) return ""; s = substr(s, RSTART, RLENGTH); sub(/^.*:[ \t\r\n]*/, "", s); return s }
    function str(s, k) { if (!match(s, "\"" k "\"[ \t\r\n]*:[ \t\r\n]*\"[^\"]*\"")) return ""; s = substr(s, RSTART, RLENGTH); sub(/^[^:]*:[ \t\r\n]*"/, "", s); return substr(s, 1, length(s) - 1) }
    { j = j $0 "\n" }
    END {
        pct = ""; if (match(j, /"used_percentage"[ \t\r\n]*:[ \t\r\n]*[0-9]+(\.[0-9]+)?/)) { v = substr(j, RSTART, RLENGTH); sub(/^[^:]*:[ \t\r\n]*/, "", v); pct = sprintf("%d", v + 0.5) }
        u = ""; if (match(j, /"current_usage"/) && index(substr(j, RSTART), "{")) {
            c = after(j, "current_usage"); if (c !~ /^null/) u = sprintf("%d", num(c, "input_tokens") + num(c, "cache_creation_input_tokens") + num(c, "cache_read_input_tokens")) }
        d = str(j, "project_dir"); if (d == "") d = str(j, "cwd")
        printf "%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s\n", num(j, "context_window_size"), us, pct, us, u, us, str(j, "session_id"), us, str(after(j, "model"), "id"), us, str(j, "display_name"), us, str(j, "transcript_path"), us, d
    }')
EOF
    pid=$(claude_pid)
    if [ -n "$pid" ]; then
        { [ -d "$CTX_DIR" ] || mkdir -p "$CTX_DIR"; } 2>/dev/null && tmp="$CTX_DIR/.claude-$pid.$$" && {
            # the paths as Claude wrote them (already JSON text)
            printf '{"pid": %s, "session": %s, "used": %s, "window": %s, "pct": %s, "model": %s, "transcript": "%s", "cwd": "%s"}\n' "$pid" "$(json_s "$sid")" "${u:-null}" "${w:-null}" "${pct:-null}" "$(json_s "$model")" "$tp" "$cwd" > "$tmp" && mv -f "$tmp" "$CTX_DIR/claude-$pid.json"; } 2>/dev/null
    fi
    [ -f "$CLAUDE_DIR/settings.json" ] && st=$(< "$CLAUDE_DIR/settings.json") 2>/dev/null
    case $st in *autoCompactWindow*) sw=$(setting_window "$model")
        [ -n "$sw" ] && [ "$sw" != "$w" ] && [ -n "$u" ] && { w=$sw; pct=$(( (u * 100 + w / 2) / w )); };;
    esac
    [ -n "$pct" ] || { [ -n "$u" ] && [ -n "$w" ] && [ "$w" -gt 0 ] && pct=$(( (u * 100 + w / 2) / w )); }
    if [ -n "$pct" ] && [ -n "$w" ]; then printf '%s · context %s%%（%sk / %sk）\n' "${name:-Claude}" "$pct" "$(( ${u:-0} / 1000 ))" "$(( w / 1000 ))"
    else printf '%s\n' "${name:-Claude}"; fi
}
# A log can be hundreds of MB: kit reads its last 8 MB (all of it only when those have nothing to go by), in one awk
# pass. Each pass prints what it found, first "more" when it found nothing in a part of the file.
CTX_TAIL=${KIT_CTX_TAIL:-8388608}
ctx_scan() { # ctx_scan FILE AWKPROG [BYTES] : AWKPROG over the whole lines in the last BYTES of FILE (0: all; cut=1 when partial)
    local n=${3:-$CTX_TAIL} size
    size=$(wc -c < "$1" 2>/dev/null | tr -d ' ')
    if [ "$n" -gt 0 ] && [ "${size:-0}" -gt "$n" ]; then tail -c "$n" "$1" | LC_ALL=C awk -v cut=1 "$2"
    else LC_ALL=C awk -v cut=0 "$2" "$1"; fi
}
ctx_read() { local o; o=$(ctx_scan "$1" "$2"); case $o in more*) ctx_scan "$1" "$2" 0;; *) printf '%s\n' "$o";; esac; }
newest_files() { # newest_files DIR NAME : files called NAME under DIR changed in the last 7 days, newest first (40 at most)
    [ -d "$1" ] || return 0
    find "$1" -type f -name "$2" -mtime -7 -print0 2>/dev/null | xargs -0 -r ls -t 2>/dev/null | head -n 40
}
claude_ctx() { # claude_ctx PID CWD
    local f="$CTX_DIR/claude-$1.json" j d t which line cb u w m post
    if [ -n "$1" ] && [ -f "$f" ]; then
        # the window: what settings.json tells Claude Code (autoCompactWindow, as its own /context shows), else Claude's
        j=$(cat "$f"); u=$(num_of used "$j"); m=$(str_of model "$j"); w=$(setting_window "$m")
        [ -n "$w" ] || w=$(num_of window "$j")
        ctx_json claude "$u" "$w" statusline "$m"; return
    fi
    [ -n "$2" ] || { ctx_json claude "" "" "" ""; return; }
    d="$CLAUDE_DIR/projects/$(printf '%s' "$2" | sed 's|[^A-Za-z0-9]|-|g')"
    t=$(ls -t "$d"/*.jsonl 2>/dev/null | head -n 1)
    [ -n "$t" ] || { ctx_json claude "" "" "" ""; return; }
    # the last reply with its usage (not one Claude Code made itself: "<synthetic>", usage 0) and the last compaction
    { IFS= read -r which; IFS= read -r line; IFS= read -r cb; } <<EOF
$(ctx_read "$t" 'cut && NR == 1 { next }
    index($0, "\"type\":\"assistant\"") && index($0, "\"usage\"") && !index($0, "\"model\":\"<synthetic>\"") { a = $0; an = NR }
    index($0, "\"compact_boundary\"") { c = $0; cn = NR }
    END { print (cn > an ? "cut" : an ? "reply" : cut ? "more" : ""); print a; print c }')
EOF
    m=$(str_of model "$line"); w=$(model_window "$m")
    if [ "$which" = cut ]; then post=$(num_of postTokens "$cb"); ctx_json claude "$post" "$w" transcript "$m"; return; fi
    [ -n "$line" ] || { ctx_json claude "" "" transcript ""; return; }
    j=$(after_key usage "$line")
    u=$(( $(num_of input_tokens "$j")0 / 10 + $(num_of cache_creation_input_tokens "$j")0 / 10 + $(num_of cache_read_input_tokens "$j")0 / 10 ))
    ctx_json claude "$u" "$w" transcript "$m"
}
codex_pct() { # codex_pct USED WINDOW : Codex's own "% context left" turned into % used (12000 tokens are its baseline)
    local u=$1 w=$2 b=12000 e used rem
    [ "$w" -gt $b ] 2>/dev/null || { echo 100; return; }
    e=$((w - b)); used=$((u > b ? u - b : 0)); rem=$((e > used ? e - used : 0))
    echo $(( 100 - (rem * 100 + e / 2) / e ))
}
codex_ctx() { # codex_ctx CWD : the newest rollout started in that folder, its last token_count and turn_context
    local f want which line m u w
    [ -n "$1" ] && [ -d "$CODEX_DIR/sessions" ] || { ctx_json codex "" "" "" ""; return; }
    want="\"cwd\":$(json_s "$1")"
    while IFS= read -r f; do
        [ -n "$f" ] && head -n 1 "$f" | grep -qF "$want" || continue
        { IFS= read -r which; IFS= read -r line; IFS= read -r m; } <<EOF
$(ctx_read "$f" 'cut && NR == 1 { next }
    index($0, "\"token_count\"") && index($0, "\"last_token_usage\"") { t = $0 }
    index($0, "\"turn_context\"") { c = $0 }
    END { print ((t == "" || c == "") && cut ? "more" : "ok"); print t; print c }')
EOF
        m=$(str_of model "$m")
        [ -n "$line" ] || { ctx_json codex "" "" rollout "$m"; return; }
        u=$(num_of total_tokens "$(after_key last_token_usage "$line")"); w=$(num_of model_context_window "$line")
        ctx_json codex "$u" "$w" rollout "$m" "$( [ -n "$u" ] && [ -n "$w" ] && codex_pct "$u" "$w")"; return
    done <<EOF
$(newest_files "$CODEX_DIR/sessions" 'rollout-*.jsonl')
EOF
    ctx_json codex "" "" "" ""
}
omp_window() { # omp_window provider/model -> the window omp's model list has for it (needs sqlite3), else kit's guess
    local db="$OMP_DIR/models.db" w=""
    if [ -f "$db" ] && command -v sqlite3 >/dev/null 2>&1; then
        case ${1%%/*}${1#*/} in *"'"*) ;; *)
            w=$(sqlite3 -readonly "file:$db?mode=ro" "select json_extract(m.value,'\$.contextWindow') from model_cache, json_each(models) m where (provider_id = '${1%%/*}' or provider_id like '${1%%/*}:%') and json_extract(m.value,'\$.id') = '${1#*/}' limit 1" 2>/dev/null);;
        esac
    fi
    case $w in ""|*[!0-9]*) model_window "${1#*/}";; *) echo "$w";; esac
}
omp_ctx() { # omp_ctx PID CWD
    local f="" x tty want which a c m tb im u w j rm
    tty=$(ps -o tty= -p "$1" 2>/dev/null | tr -d ' ' | sed 's|^/dev/||; s|/|-|g')
    case $tty in ""|"?"|"??") ;; *) [ -f "$OMP_DIR/terminal-sessions/$tty" ] && f=$(sed -n 2p "$OMP_DIR/terminal-sessions/$tty");; esac
    if [ -z "$f" ] || [ ! -f "$f" ]; then
        f=""; want="\"cwd\":$(json_s "$2")"
        [ -n "$2" ] && while IFS= read -r x; do
            [ -n "$x" ] && head -n 3 "$x" | grep '"type":"session"' | grep -qF "$want" && { f=$x; break; }
        done <<EOF
$(newest_files "$OMP_DIR/sessions" '*.jsonl')
EOF
    fi
    [ -n "$f" ] || { ctx_json omp "" "" "" ""; return; }
    # the last finished reply, the last compaction, the last model change; and like omp's own footer, what came after
    # that reply (tool results, your next message): their text at about 4 bytes a token, each image about 1600 tokens
    # (only the message itself: what omp keeps for its screen, "details", is not sent to the model)
    { IFS= read -r which; IFS= read -r a; IFS= read -r c; IFS= read -r m; IFS= read -r tb; IFS= read -r im; } <<EOF
$(ctx_read "$f" 'cut && NR == 1 { next }
    index($0, "\"role\":\"assistant\"") && !index($0, "\"stopReason\":\"aborted\"") && !index($0, "\"stopReason\":\"error\"") { a = $0; an = NR; tb = 0; im = 0; next }
    index($0, "\"type\":\"compaction\"") || index($0, "\"type\":\"reset_boundary\"") { c = $0; cn = NR }
    index($0, "\"type\":\"model_change\"") { m = $0 }
    an && index($0, "\"type\":\"message\"") {
        s = $0; i = index(s, ",\"details\":"); if (i) s = substr(s, 1, i - 1)
        x = s; while ((i = index(x, "\"type\":\"image\"")) > 0) { im++; x = substr(x, i + 14) }
        while (match(s, /"text":"([^"\\]|\\.)*"/)) { tb += RLENGTH - 9; s = substr(s, RSTART + RLENGTH) } }
    END { print (cn > an ? "cut" : an ? "reply" : cut ? "more" : ""); print a; print c; print m; print tb + 0; print im + 0 }')
EOF
    m=$(str_of model "$m")
    [ -n "$a" ] && [ -z "$m" ] && m="$(str_of provider "$a")/$(str_of model "$a")"
    w=$( [ -n "$m" ] && omp_window "$m")
    [ "$which" = cut ] && { ctx_json omp "$(num_of tokensAfter "$c")" "$w" session "$m"; return; }
    [ -n "$a" ] || { ctx_json omp "" "$w" session "$m"; return; }
    u=$(num_of promptTokens "$(after_key contextSnapshot "$a")")
    if [ -z "$u" ]; then j=$(after_key usage "$a"); u=$(( $(num_of input "$j")0 / 10 + $(num_of cacheRead "$j")0 / 10 + $(num_of cacheWrite "$j")0 / 10 )); fi
    rm=$(num_of historyRewriteTokensRemoved "$a"); [ -z "$rm" ] || u=$(( u > rm ? u - rm : 0 ))
    u=$(( u + ${tb:-0} / 4 + ${im:-0} * 1600 ))
    ctx_json omp "$u" "$w" session "$m"
}
agent_guess() { # agent_guess PID TOOL DIR : A_TOOL (TOOL, else guessed from the process: claude|codex|omp) and A_DIR (DIR, else
    # the process's folder), for kit context and kit files
    local a p=$1; A_TOOL=$2; A_DIR=$3
    if [ -z "$A_TOOL" ]; then
        a=$(proc_args "$p"); set -- $a
        case ${1##*/}:${2:-} in claude*|*:*claude*) A_TOOL=claude;; codex*|*:*codex*) A_TOOL=codex;; omp*|*:*omp*) A_TOOL=omp;; esac
    fi
    case $A_TOOL in claude-code) A_TOOL=claude;; pi) A_TOOL=omp;; esac
    [ -n "$A_DIR" ] || A_DIR=$(proc_cwd "$p")
}
cmd_context() { # kit context --pid PID [--tool claude|codex|omp] [--dir DIR] [--detail [--fresh]] : how full that agent's context is (JSON)
    local pid="" tool="" dir="" detail="" fresh="" f p use="用法：kit context --pid <pid> [--tool claude|codex|omp] [--dir 資料夾] [--detail [--fresh]]"
    while [ $# -gt 0 ]; do
        case $1 in
            --pid|--tool|--dir) [ $# -ge 2 ] || die "$use"
                case $1 in --pid) pid=$2;; --tool) tool=$2;; *) dir=$2;; esac; shift 2;;
            --detail) detail=1; shift;;
            --fresh) fresh=1; shift;;
            *) die "$use";;
        esac
    done
    case $pid in ""|*[!0-9]*) die "$use";; esac
    agent_guess "$pid" "$tool" "$dir"; tool=$A_TOOL; dir=$A_DIR
    # the kept numbers (and details) of processes that are gone
    for f in "$CTX_DIR"/claude-*.json "$CTX_DIR"/detail-*.json; do
        [ -f "$f" ] || continue; p=${f##*/}; p=${p#*-}; p=${p%.json}
        case $p in ""|*[!0-9]*) continue;; esac
        [ "$p" = "$pid" ] || kill -0 "$p" 2>/dev/null || rm -f "$f"
    done
    [ -z "$detail" ] || { ctx_detail "$pid" "$tool" "$dir" "$fresh"; return 0; }
    case $tool in
        claude) claude_ctx "$pid" "$dir";;
        codex) codex_ctx "$dir";;
        omp) omp_ctx "$pid" "$dir";;
        *) ctx_json "" "" "" "" "";;
    esac
}

# ---------- kit context --detail: where the tokens go ----------
# One JSON line (kit.ps1 prints the same), for programs that show an agent's context use:
#   {"tool", "used", "window", "pct", "source", "model", "at", "exact", "session", "compact_at",
#    "commands": {"compact", "with_text", "clear"}, "note", "error",
#    "categories": [{"id", "name", "tokens", "kind": used|deferred|buffer|free, "est"}],
#    "groups": [{"id", "name", "tokens", "est", "items": [{"name", "tokens", "note", "path"[, "items": [...]]}]}]}
# Claude: Claude Code's own count (get_context_usage), asked of a fresh `claude -p --resume <its session>
#   --no-session-persistence` with every hook off: it writes no transcript, runs no hook, asks no model. What was said,
#   by kind and by tool, is estimated from the transcript (bytes / 4, an image 1600) and scaled to Claude's own number.
# Codex, omp: their own files. The total is the tool's own count (Codex's last token_count, omp's context snapshot);
#   the parts are estimated the same way and scaled to it ("est": true). Only sizes are read, never what was said.
# The producers print rows (a TAB between fields), ctx_assemble makes the JSON:
#   H key value | C id name tokens kind est | G id name est | I group name tokens note path parent
# Kept a minute per process ($KIT_CONF/ctx/detail-<pid>.json); --fresh asks again.
CTX_DETAIL_TAIL=${KIT_CTX_DETAIL_TAIL:-33554432}
CTX_PROBE_INIT='{"type":"control_request","request_id":"i1","request":{"subtype":"initialize"}}'
CTX_PROBE_ASK='{"type":"control_request","request_id":"c1","request":{"subtype":"get_context_usage"}}'
# shared awk: the text of "KEY":"..." (still JSON-escaped), JSON escapes undone, a whole number, a piece's tokens
CTX_AWK='
function strv(s, k,   re) { re = "\"" k "\":\"([^\"\\\\]|\\\\.)*\""; if (!match(s, re)) return ""; return substr(s, RSTART + length(k) + 4, RLENGTH - length(k) - 5) }
function unesc(s) { gsub(/\\\\/, "\001", s); gsub(/\\"/, "\"", s); gsub(/\\\//, "/", s); gsub(/\\[nrtbf]/, " ", s); gsub(/\001/, "\\", s); gsub(/[\001-\037]/, " ", s); return s }
function rnd(x) { return int(x + 0.5) }
function jblocks(s, P, F,   q, m, i, j, L, seg, c, d, n, pos, ins, ss, sv, key, b0) { # the objects right inside the JSON array S starts
    # with -> how many; P[i]: the i-th one, F[i, KEY]: its own string fields (still escaped), whatever order its keys come in
    split("", P); split("", F)
    m = split(s, q, "\""); d = n = ins = 0; pos = 1; key = ""
    for (i = 1; i <= m; i++) {
        seg = q[i]; L = length(seg)
        if (ins) {   # in a string: the quote after SEG ends it unless SEG ends in an odd number of backslashes
            if (i < m && match(seg, /\\+$/) && RLENGTH % 2) { pos += L + 1; continue }
            ins = 0; sv = substr(s, ss + 1, pos + L - ss - 1)
            if (d == 2 && n) { if (i < m && q[i + 1] ~ /^[ \t\r\n]*:/) key = sv; else if (key != "") { F[n, key] = sv; key = "" } }
            pos += L + 1; continue
        }
        for (j = 1; j <= L; j++) {
            c = substr(seg, j, 1)
            if (c == "{" || c == "[") { key = ""; if (++d == 2 && c == "{") { n++; b0 = pos + j - 1 } }
            else if (c == "}" || c == "]") { if (d == 2 && c == "}" && n) P[n] = substr(s, b0, pos + j - b0); if (--d <= 0) return n }
        }
        if (i < m) { ins = 1; ss = pos + L }
        pos += L + 1
    }
    return n
}
function imgs(s,   n, i) { n = 0; while ((i = index(s, "\"type\":\"image\"")) > 0 || (i = index(s, "\"type\":\"input_image\"")) > 0) { n++; s = substr(s, i + 12) }; return n }
function datalen(s,   d) { d = 0; while (match(s, /"(data|image_url)":"[^"]*"/)) { d += RLENGTH; s = substr(s, RSTART + RLENGTH) }; return d }
function wt(s) { return (length(s) - datalen(s)) / 4 + imgs(s) * 1600 }
function texts(s,   n) { n = 0; while (match(s, /"text":"([^"\\]|\\.)*"/)) { n += RLENGTH - 9; s = substr(s, RSTART + RLENGTH) }; return n }
function short(p) { if (home != "" && index(p, home) == 1 && (length(p) == length(home) || substr(p, length(home) + 1, 1) ~ /[\/\\]/)) return "~" substr(p, length(home) + 1); return p }
'
ctx_capped() { # ctx_capped SECS CMD... : CMD, stopped after SECS seconds (with everything it started)
    local s=$1; shift
    if command -v perl >/dev/null 2>&1; then
        perl -e '$t = shift; $p = fork; die unless defined $p; if (!$p) { setpgrp(0, 0); exec @ARGV or exit 127 }
            $SIG{ALRM} = sub { kill "TERM", -$p; sleep 1; kill "KILL", -$p; exit 124 }; alarm $t; waitpid($p, 0); exit($? >> 8)' "$s" "$@"
    elif command -v timeout >/dev/null 2>&1; then timeout "$s" "$@"
    else "$@"; fi
}
ctx_stream() { # ctx_stream FILE : a log for a detail look: all of it, or its first line and the last KIT_CTX_DETAIL_TAIL bytes
    local size
    size=$(wc -c < "$1" 2>/dev/null | tr -d ' ')
    if [ "${size:-0}" -gt "$CTX_DETAIL_TAIL" ]; then head -n 1 "$1"; tail -c "$CTX_DETAIL_TAIL" "$1" | tail -n +2
    else cat "$1"; fi
}
ctx_big() { local size; size=$(wc -c < "$1" 2>/dev/null | tr -d ' '); [ "${size:-0}" -gt "$CTX_DETAIL_TAIL" ]; }
unjs() { printf '%s' "$1" | sed 's/\\\\/\\/g; s/\\"/"/g; s/\\\//\//g'; }   # a JSON string's text as it is
ctx_files() { # ctx_files NOTE FILE... : "path TAB bytes TAB note" for each file that is there and not empty
    local n=$1 f b; shift
    for f in "$@"; do
        [ -f "$f" ] || continue; b=$(wc -c < "$f" 2>/dev/null | tr -d ' ')
        [ "${b:-0}" -gt 0 ] && printf '%s\t%s\t%s\n' "$f" "$b" "$n"
    done
}
ctx_up() { # ctx_up DIR : DIR and the folders above it up to its git root (or only DIR when it is in none), root first
    local a=$1 list="" top=""
    while :; do
        list="$a
$list"
        [ -e "$a/.git" ] && { top=1; break; }
        [ "$a" = / ] || [ "$a" = "$HOME" ] && break
        a=$(dirname "$a")
    done
    [ -n "$top" ] && printf '%s' "$list" || printf '%s\n' "$1"
}

ctx_assemble() { # ctx_assemble NOW : rows (stdin) -> the JSON line
    LC_ALL=C awk -F '\t' -v now="$1" '
    BEGIN {
        nm["system_prompt"] = "系統提示"; nm["system_tools"] = "系統工具"; nm["system_tools_deferred"] = "系統工具（延後載入）"
        nm["mcp_tools"] = "MCP 工具"; nm["mcp_tools_deferred"] = "MCP 工具（延後載入）"; nm["mcp_instructions"] = "MCP 伺服器說明"
        nm["custom_agents"] = "自訂 agents"; nm["memory_files"] = "記憶檔"; nm["skills"] = "Skills"; nm["messages"] = "對話訊息"
        nm["slash_commands"] = "斜線指令"; nm["other"] = "其他／自上次更新以來"; nm["autocompact_buffer"] = "自動壓縮保留區"
        nm["free_space"] = "可用空間"; nm["instructions"] = "指示檔"; nm["compaction"] = "壓縮後的摘要"
        nm["memory"] = "記憶檔"; nm["mcp"] = "MCP（依伺服器）"; nm["tools"] = "工具（依類別）"; nm["agents"] = "自訂 agents"
        nm["commands"] = "斜線指令"; nm["tool_results"] = "工具（呼叫＋結果，依工具）"; nm["attachments"] = "附加內容（依種類）"
        nm["msgs"] = "對話內容（依種類）"
    }
    function q(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); gsub(/[\001-\037]/, "", s); return "\"" s "\"" }
    function n(v) { return v == "" ? "null" : v }
    function b(v) { return v == "1" ? "true" : "false" }
    function before(a, c) { # more tokens first (none last), then by name (bytes), then as listed
        if (itk[a] == "" && itk[c] != "") return 0; if (itk[c] == "" && itk[a] != "") return 1
        if (itk[a] != "" && itk[a] + 0 != itk[c] + 0) return itk[a] + 0 > itk[c] + 0
        return inm[a] < inm[c] }
    function items(g, par,   i, k, m, list, out, t, kids) {
        m = 0
        for (i = 1; i <= ni; i++) if (ig[i] == g && ipar[i] == par) { k = ++m; while (k > 1 && before(i, list[k - 1])) { list[k] = list[k - 1]; k-- }; list[k] = i }
        out = ""
        for (k = 1; k <= m; k++) {
            i = list[k]
            t = "{\"name\": " q(inm[i]) ", \"tokens\": " n(itk[i]) ", \"note\": " q(inote[i]) ", \"path\": " q(ipath[i])
            if (par == "" && inm[i] != "") { kids = items(g, inm[i]); if (kids != "") t = t ", \"items\": [" kids "]" }
            out = out (k > 1 ? ", " : "") t "}"
            if (par == "" && itk[i] != "") { gsum[g] += itk[i]; gknown[g] = 1 }
        }
        return out
    }
    $1 == "H" { h[$2] = $3; next }
    function name(id, x) { if (substr(x, 1, 1) == "=") return substr(x, 2); if (id in nm) return nm[id]; return x != "" ? x : id }
    $1 == "C" { if (($4 == "" || $4 + 0 == 0) && $5 != "free") next; nc++; cid[nc] = $2; cnm[nc] = name($2, $3); ctk[nc] = $4 + 0; ckd[nc] = $5; ces[nc] = $6; next }
    $1 == "G" { ng++; gid[ng] = $2; gnm[ng] = name($2, $3); ges[ng] = $4; next }
    $1 == "I" { ni++; ig[ni] = $2; inm[ni] = $3; itk[ni] = $4; inote[ni] = $5; ipath[ni] = $6; ipar[ni] = $7; next }
    END {
        u = h["used"]; w = h["window"]; p = h["pct"]
        if (p == "" && u != "" && w + 0 > 0) p = int((u * 100 + int(w / 2)) / w)
        if (p != "" && p + 0 > 100) p = 100
        o = "{\"tool\": " q(h["tool"]) ", \"used\": " n(u) ", \"window\": " n(w) ", \"pct\": " n(p) ", \"source\": " q(h["source"]) ", \"model\": " q(h["model"])
        o = o ", \"at\": " now ", \"exact\": " b(h["exact"]) ", \"session\": " q(h["session"]) ", \"compact_at\": " n(h["compact_at"])
        o = o ", \"commands\": {\"compact\": " q(h["compact"]) ", \"with_text\": " b(h["with_text"]) ", \"clear\": " q(h["clear"]) "}"
        o = o ", \"note\": " q(h["note"]) ", \"error\": " (h["error"] == "" ? "null" : q(h["error"])) ", \"categories\": ["
        for (i = 1; i <= nc; i++) o = o (i > 1 ? ", " : "") "{\"id\": " q(cid[i]) ", \"name\": " q(cnm[i]) ", \"tokens\": " ctk[i] ", \"kind\": " q(ckd[i]) ", \"est\": " b(ces[i]) "}"
        o = o "], \"groups\": ["; k = 0
        for (i = 1; i <= ng; i++) {
            t = items(gid[i], ""); if (t == "") continue
            o = o (k++ ? ", " : "") "{\"id\": " q(gid[i]) ", \"name\": " q(gnm[i]) ", \"tokens\": " (gknown[gid[i]] ? gsum[gid[i]] : "null") ", \"est\": " b(ges[i]) ", \"items\": [" t "]}"
        }
        print o "]}"
    }'
}

# ---------- Claude ----------
claude_session() { # claude_session PID DIR -> "id TAB folder TAB transcript" of the Claude Code in PID (the id checked)
    # what the status line kept; else ~/.claude/sessions/<pid>.json (older Claude Code); else the daemon's roster
    # (only pid / replPid / sessionId / cwd are read: it holds tokens too); else the newest transcript of its folder
    # changed since it started
    local pid=$1 dir=$2 f j sid="" cwd="" tp="" d e mins
    f="$CTX_DIR/claude-$pid.json"
    [ -f "$f" ] && { j=$(cat "$f"); sid=$(str_of session "$j"); cwd=$(unjs "$(str_of cwd "$j")"); tp=$(unjs "$(str_of transcript "$j")"); }
    if [ -z "$sid" ] && [ -f "$CLAUDE_DIR/sessions/$pid.json" ]; then
        j=$(cat "$CLAUDE_DIR/sessions/$pid.json"); sid=$(str_of sessionId "$j"); cwd=$(unjs "$(str_of cwd "$j")")
    fi
    if [ -z "$sid" ] && [ -f "$CLAUDE_DIR/daemon/roster.json" ]; then
        { IFS=$TAB read -r sid cwd; } <<EOF
$(LC_ALL=C awk -f "$KIT_LIB/json.awk" -v leaves=1 "$CLAUDE_DIR/daemon/roster.json" 2>/dev/null | LC_ALL=C awk -F '\t' -v p="$pid" '
    $1 == "workers" && NF == 4 && ($3 == "pid" || $3 == "replPid" || $3 == "sessionId" || $3 == "cwd") { v = $4; gsub(/^"|"$/, "", v); w[$2, $3] = v; k[$2] = 1 }
    END { for (x in k) if (w[x, "pid"] == p || w[x, "replPid"] == p) { print w[x, "sessionId"] "\t" w[x, "cwd"]; exit } }')
EOF
        cwd=$(unjs "$cwd")
    fi
    [ -n "$cwd" ] || cwd=$dir
    if [ -z "$sid" ] && [ -n "$cwd" ]; then
        d="$CLAUDE_DIR/projects/$(printf '%s' "$cwd" | sed 's|[^A-Za-z0-9]|-|g')"
        e=$(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ')
        mins=$(printf '%s' "$e" | awk -F '[-:]' '{ s = 0; if (NF == 4) s = $1 * 86400 + $2 * 3600 + $3 * 60 + $4; else if (NF == 3) s = $1 * 3600 + $2 * 60 + $3; else if (NF == 2) s = $1 * 60 + $2; print int(s / 60) + 2 }')
        [ -d "$d" ] && [ -n "$e" ] && f=$(find "$d" -maxdepth 1 -name '*.jsonl' -mmin "-$mins" -print0 2>/dev/null | xargs -0 -r ls -t 2>/dev/null | head -n 1) && [ -n "$f" ] && { sid=$(basename "$f" .jsonl); tp=$f; }
    fi
    case $sid in ""|*[!A-Za-z0-9_-]*) return 1;; esac
    printf '%s\t%s\t%s\n' "$sid" "$cwd" "$tp"
}
claude_where() { # claude_where PID DIR -> "id TAB folder TAB transcript" (transcript: only one under ~/.claude/projects that
    # is there, else empty); fails when there is no session
    local s sid cwd tp
    s=$(claude_session "$1" "$2") || return 1
    sid=${s%%"$TAB"*}; s=${s#*"$TAB"}; cwd=${s%%"$TAB"*}; tp=${s#*"$TAB"}
    [ -n "$cwd" ] || cwd=$2
    case $tp in "$CLAUDE_DIR"/projects/*.jsonl) [ -f "$tp" ] || tp="";; *) tp="";; esac
    [ -n "$tp" ] || tp="$CLAUDE_DIR/projects/$(printf '%s' "$cwd" | sed 's|[^A-Za-z0-9]|-|g')/$sid.jsonl"
    [ -f "$tp" ] || tp=""
    printf '%s\t%s\t%s\n' "$sid" "$cwd" "$tp"
}
claude_probe() { # claude_probe ID DIR : Claude Code's own get_context_usage answer for that session (one line), else nothing
    local bin t=${KIT_CTX_PROBE_TIMEOUT:-30}
    bin=$(command -v claude 2>/dev/null) || bin="$HOME/.local/bin/claude"
    [ -x "$bin" ] || return 1
    # every hook off (a SessionStart hook must not run), no transcript written; only the c1 line is kept (the
    # initialize answer, which names the account, is never stored)
    printf '%s\n%s\n' "$CTX_PROBE_INIT" "$CTX_PROBE_ASK" |
        ( cd "$2" 2>/dev/null || exit 1; ctx_capped "$t" "$bin" -p --input-format stream-json --output-format stream-json --verbose \
            --resume "$1" --no-session-persistence --settings '{"disableAllHooks":true}' 2>/dev/null ) |
        LC_ALL=C awk 'index($0, "\"request_id\":\"c1\"") { print; exit }'
}
claude_probe_rows() { # what Claude Code said (stdin: the c1 line) -> rows, and H total / max / msgs / buffer / threshold
    LC_ALL=C awk -f "$KIT_LIB/json.awk" -v leaves=1 2>/dev/null | LC_ALL=C awk -F '\t' -v home="$HOME" "$CTX_AWK"'
    function v(s) { if (substr(s, 1, 1) == "\"") return unesc(substr(s, 2, length(s) - 2)); return s == "null" ? "" : s }
    function top(i, a) { return i + 0 > a + 0 ? i + 0 : a }   # (json.awk counts items from 1)
    $1 == "response" && $2 == "error" && NF == 3 { err = v($3) }
    $1 != "response" || $2 != "response" { next }
    { k = $3; x = v($NF) }
    NF == 4 { t[k] = x; next }
    k == "categories" && NF == 6 { nc = top($4, nc); c[$4, $5] = x; next }
    k == "memoryFiles" && NF == 6 { nm = top($4, nm); mf[$4, $5] = x; next }
    k == "mcpTools" && NF == 6 { nt = top($4, nt); mt[$4, $5] = x; next }
    k == "agents" && NF == 6 { na = top($4, na); ag[$4, $5] = x; next }
    k == "slashCommands" && NF == 5 { sc[$4] = x; next }
    k == "skills" && $4 == "skillFrontmatter" && NF == 7 { ns = top($5, ns); sk[$5, $6] = x; next }
    END {
        if (err != "" || t["totalTokens"] == "") { print "H\tprobe_error\t" (err != "" ? err : "Claude Code 沒有給 context 的細項"); exit }
        print "H\tprobe_total\t" t["totalTokens"]; print "H\tprobe_max\t" t["maxTokens"]; print "H\tprobe_model\t" t["model"]
        if (t["isAutoCompactEnabled"] == "true") print "H\tthreshold\t" t["autoCompactThreshold"]
        for (i = 1; i <= nc; i++) {
            kind = c[i, "kind"]; if (kind == "") kind = c[i, "isDeferred"] == "true" ? "deferred" : "used"
            if (kind == "free") continue
            if (c[i, "id"] == "messages") print "H\tmsgs\t" c[i, "tokens"]
            if (kind == "buffer") print "H\tbuffer\t" c[i, "tokens"]
            else print "C\t" c[i, "id"] "\t" c[i, "name"] "\t" c[i, "tokens"] "\t" kind "\t0"
        }
        print "G\tmemory\t\t0"
        for (i = 1; i <= nm; i++) print "I\tmemory\t" short(mf[i, "path"]) "\t" mf[i, "tokens"] "\t" mf[i, "type"] "\t" mf[i, "path"] "\t"
        print "G\tskills\t\t0"
        for (i = 1; i <= ns; i++) print "I\tskills\t" sk[i, "name"] "\t" sk[i, "tokens"] "\t" sk[i, "source"] "\t" sk[i, "path"] "\t"
        print "G\tmcp\t\t0"
        for (i = 1; i <= nt; i++) { s = mt[i, "serverName"]; if (!(s in sv)) { sv[s] = 1; so[++nso] = s }; st[s] += mt[i, "tokens"]; sn[s]++ }
        for (i = 1; i <= nso; i++) print "I\tmcp\t" so[i] "\t" st[so[i]] "\t" sn[so[i]] " 個工具\t\t"
        for (i = 1; i <= nt; i++) print "I\tmcp\t" mt[i, "name"] "\t" mt[i, "tokens"] "\t" (mt[i, "isLoaded"] == "true" ? "已載入" : "延後載入") "\t\t" mt[i, "serverName"]
        print "G\tagents\t\t0"
        for (i = 1; i <= na; i++) print "I\tagents\t" (ag[i, "agentType"] != "" ? ag[i, "agentType"] : ag[i, "name"]) "\t" ag[i, "tokens"] "\t" ag[i, "source"] "\t\t"
        if (sc["tokens"] + 0 > 0) { print "G\tcommands\t\t0"; print "I\tcommands\t" sc["includedCommands"] " 個指令\t" sc["tokens"] "\t\t\t" }
    }'
}
claude_msg_rows() { # claude_msg_rows TARGET : what was said since the last compaction (stdin: the transcript), scaled to TARGET
    # (thinking from earlier turns is not counted: the API drops it; attachments Claude Code counts elsewhere neither)
    LC_ALL=C awk -v target="$1" "$CTX_AWK"'
    function reset() { user = meta = reply = summ = 0; split("", tc); split("", tr); split("", tn); split("", at) }
    function content(s,   i, j) { i = index(s, "\"content\":"); if (i) s = substr(s, i); j = index(s, "},\"uuid\":\""); if (j) s = substr(s, 1, j); return s }
    BEGIN { reset(); split("skill_listing instructions deferred_tools_delta deferred_tools_record mcp_instructions_delta agent_listing_delta prompt_snapshot thinking_drop credential_org", sk, " "); for (i in sk) skip[sk[i]] = 1 }
    index($0, "\"isSidechain\":true") { next }
    index($0, "\"type\":\"system\"") && index($0, "\"compact_boundary\"") { reset(); next }
    index($0, "\"type\":\"attachment\"") {
        if (!(i = index($0, "\"rendered\":["))) next
        a = strv(substr($0, index($0, "\"attachment\":{")), "type"); if (a == "" || (a in skip)) next
        s = substr($0, i); j = index(s, ",\"renderedRole\""); if (j) s = substr(s, 1, j)
        at[a] += wt(s); next }
    index($0, "\"type\":\"assistant\"") {
        if (!(i = index($0, "\"content\":["))) next
        m = jblocks(substr($0, i + 10), JB, JF)   # (some gateways send the keys in a different order: "id" before "type")
        for (i = 1; i <= m; i++) {
            ty = JF[i, "type"]
            if (ty == "text") reply += length(JF[i, "text"]) / 4
            else if (ty == "tool_use" || ty == "server_tool_use") { nm = unesc(JF[i, "name"]); idn[JF[i, "id"]] = nm; tc[nm] += wt(JB[i]); tn[nm]++ }
        }
        next }
    index($0, "\"type\":\"user\"") {
        s = content($0)
        if (index($0, "\"isCompactSummary\":true")) { summ += wt(s); next }
        if (index(s, "\"tool_use_id\":\"") && (i = index(s, "\"content\":["))) {
            m = jblocks(substr(s, i + 10), JB, JF); hit = 0
            for (i = 1; i <= m; i++) if (JF[i, "type"] == "tool_result") { id = JF[i, "tool_use_id"]; nm = (id in idn) ? idn[id] : "?"; tr[nm] += wt(JB[i]); hit = 1 }
            if (hit) next }
        if (index($0, "\"isMeta\":true")) meta += wt(s); else user += wt(s)
        next }
    END {
        tcs = trs = ats = 0
        for (k in tc) tcs += tc[k]; for (k in tr) trs += tr[k]; for (k in at) ats += at[k]
        all = user + meta + reply + summ + tcs + trs + ats
        f = (target > 0 && all > 0) ? target / all : 1
        print "H\tmsgs_raw\t" rnd(all)
        print "G\tmsgs\t\t1"
        print "I\tmsgs\t你的訊息\t" rnd(user * f) "\t\t\t"; print "I\tmsgs\t系統附加的提示\t" rnd(meta * f) "\t\t\t"
        print "I\tmsgs\t回覆\t" rnd(reply * f) "\t\t\t"; print "I\tmsgs\t工具呼叫\t" rnd(tcs * f) "\t\t\t"
        print "I\tmsgs\t工具結果\t" rnd(trs * f) "\t\t\t"; print "I\tmsgs\t附加內容\t" rnd(ats * f) "\t\t\t"
        if (summ > 0) print "I\tmsgs\t壓縮後的摘要\t" rnd(summ * f) "\t\t\t"
        print "G\ttool_results\t\t1"
        for (k in tc) seen[k] = 1; for (k in tr) seen[k] = 1
        for (k in seen) print "I\ttool_results\t" k "\t" rnd((tc[k] + tr[k]) * f) "\t" (tn[k] + 0) " 次\t\t"
        print "G\tattachments\t\t1"
        for (k in at) print "I\tattachments\t" k "\t" rnd(at[k] * f) "\t\t\t"
    }'
}
claude_detail() { # claude_detail PID DIR -> rows
    local pid=$1 dir=$2 s sid="" cwd="" tp="" live lu lw lm probe rows tot max mdl msgs buf thr w used other free why=""
    live=$(claude_ctx "$pid" "$dir"); lu=$(num_of used "$live"); lw=$(num_of window "$live"); lm=$(str_of model "$live")
    printf 'H\ttool\tclaude\nH\tcompact\t/compact\nH\twith_text\t1\nH\tclear\t/clear\n'
    if s=$(claude_where "$pid" "$dir"); then sid=${s%%"$TAB"*}; s=${s#*"$TAB"}; cwd=${s%%"$TAB"*}; tp=${s#*"$TAB"}; fi
    [ -n "$cwd" ] || cwd=$dir
    printf 'H\tsession\t%s\n' "$sid"
    if [ -z "$sid" ]; then why="找不到這個 Claude 的 session"
    elif [ "${KIT_CTX_PROBE:-1}" = 0 ]; then why="沒有問 Claude Code（KIT_CTX_PROBE=0）"
    else
        probe=$(claude_probe "$sid" "$cwd")
        if [ -z "$probe" ]; then why="Claude Code 沒有回答（太舊、沒裝在 PATH 上，或超過 ${KIT_CTX_PROBE_TIMEOUT:-30} 秒）"
        else
            rows=$(printf '%s\n' "$probe" | claude_probe_rows)
            why=$(printf '%s\n' "$rows" | sed -n 's/^H	probe_error	//p' | head -n 1)
        fi
    fi
    if [ -n "$why" ]; then
        # Claude Code's own split is not there: the live total, and what was said estimated from the transcript
        printf 'H\terror\t%s\nH\tsource\t%s\nH\tmodel\t%s\nH\texact\t0\n' "$why" "$(str_of source "$live")" "$lm"
        rows=$( [ -n "$tp" ] && ctx_stream "$tp" | claude_msg_rows "")
        msgs=$(printf '%s\n' "$rows" | sed -n 's/^H	msgs_raw	//p'); msgs=${msgs:-0}
        [ -n "$lu" ] && [ "$msgs" -gt "$lu" ] && msgs=$lu
        rows=$( [ -n "$tp" ] && ctx_stream "$tp" | claude_msg_rows "$msgs")
        printf '%s\n' "$rows" | grep -v '^H	'
        printf 'H\tused\t%s\nH\twindow\t%s\n' "$lu" "$lw"
        if [ -n "$lu" ]; then
            printf 'C\tsystem_prompt\t=系統提示、工具、記憶檔、Skills（估算）\t%s\tused\t1\nC\tmessages\t\t%s\tused\t1\n' "$(( lu - msgs ))" "$msgs"
            [ -n "$lw" ] && [ "$lw" -gt "$lu" ] && printf 'C\tfree_space\t\t%s\tfree\t0\n' "$(( lw - lu ))"
        fi
        printf 'H\tnote\t%s\n' "細項是從對話紀錄估的（大小 ÷ 4），只看得出對話裡各種內容大概佔多少。"
        return 0
    fi
    tot=$(printf '%s\n' "$rows" | sed -n 's/^H	probe_total	//p'); max=$(printf '%s\n' "$rows" | sed -n 's/^H	probe_max	//p')
    mdl=$(printf '%s\n' "$rows" | sed -n 's/^H	probe_model	//p'); msgs=$(printf '%s\n' "$rows" | sed -n 's/^H	msgs	//p')
    buf=$(printf '%s\n' "$rows" | sed -n 's/^H	buffer	//p'); thr=$(printf '%s\n' "$rows" | sed -n 's/^H	threshold	//p')
    [ -n "$mdl" ] || mdl=$lm
    w=$(setting_window "$mdl"); [ -n "$w" ] || w=$max; [ -n "$w" ] || w=$lw
    # the live number (status line / transcript) is what the agent really has; a fresh process may not see all of it
    # (MCP servers it did not start, what came since): the difference is its own row
    used=$tot; other=0
    if [ -n "$lu" ] && [ "$lu" -gt "$tot" ]; then used=$lu; other=$(( lu - tot )); fi
    printf 'H\tsource\tget_context_usage\nH\tmodel\t%s\nH\texact\t1\nH\tused\t%s\nH\twindow\t%s\n' "$mdl" "$used" "$w"
    [ -n "$thr" ] && printf 'H\tcompact_at\t%s\n' "$thr"
    printf '%s\n' "$rows" | grep -v '^H	'
    [ "$other" -gt 0 ] && printf 'C\tother\t\t%s\tused\t0\n' "$other"
    [ -n "$buf" ] && printf 'C\tautocompact_buffer\t\t%s\tbuffer\t0\n' "$buf"
    free=$(( ${w:-0} - used - ${buf:-0} )); [ "$free" -gt 0 ] || free=0
    printf 'C\tfree_space\t\t%s\tfree\t0\n' "$free"
    [ -n "$tp" ] && ctx_stream "$tp" | claude_msg_rows "${msgs:-0}" | grep -v '^H	'
    printf 'H\tnote\t%s\n' "分類是 Claude Code 自己算的；「對話內容」「工具」「附加內容」的細項是從對話紀錄估的（大小 ÷ 4，一張圖約 1600），照比例對到 Claude 算的總數。"
}

# ---------- Codex ----------
codex_rollout() { # codex_rollout DIR : the newest rollout started in that folder
    local f want
    [ -n "$1" ] && [ -d "$CODEX_DIR/sessions" ] || return 1
    want="\"cwd\":$(json_s "$1")"
    while IFS= read -r f; do
        [ -n "$f" ] && head -n 1 "$f" | grep -qF "$want" && { printf '%s\n' "$f"; return 0; }
    done <<EOF
$(newest_files "$CODEX_DIR/sessions" 'rollout-*.jsonl')
EOF
    return 1
}
codex_instr_files() { # the AGENTS.md files Codex reads for DIR: its own (~/.codex), then each folder from the git root down
    local d n=0
    if [ -s "$CODEX_DIR/AGENTS.override.md" ]; then ctx_files "Codex 帳號" "$CODEX_DIR/AGENTS.override.md"; else ctx_files "Codex 帳號" "$CODEX_DIR/AGENTS.md"; fi
    [ -n "$1" ] || return 0
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        if [ -s "$d/AGENTS.override.md" ]; then ctx_files "資料夾" "$d/AGENTS.override.md"; else ctx_files "資料夾" "$d/AGENTS.md"; fi
    done <<EOF
$(ctx_up "$1")
EOF
}
codex_detail() { # codex_detail DIR -> rows
    local f c m u w files mcp
    printf 'H\ttool\tcodex\nH\tcompact\t/compact\nH\twith_text\t0\nH\tclear\t/new\nH\tsource\trollout\nH\texact\t0\n'
    f=$(codex_rollout "$1") || { printf 'H\terror\t%s\n' "找不到這個資料夾的 Codex 對話紀錄（~/.codex/sessions）"; return 0; }
    c=$(codex_ctx "$1"); u=$(num_of used "$c"); w=$(num_of window "$c"); m=$(str_of model "$c")
    printf 'H\tmodel\t%s\nH\tused\t%s\nH\twindow\t%s\nH\tpct\t%s\n' "$m" "$u" "$w" "$(num_of pct "$c")"
    ctx_big "$f" && printf 'H\tbig\t1\n'
    files=$(codex_instr_files "$1")
    mcp=$( [ -f "$CODEX_DIR/config.toml" ] && sed -n 's/^[[:space:]]*\[mcp_servers\.\([^].]*\)\][[:space:]]*$/\1/p' "$CODEX_DIR/config.toml" | tr -d '"')
    ctx_stream "$f" | CTX_FILES=$files CTX_MCP=$mcp LC_ALL=C awk -v total="$u" -v window="$w" -v home="$HOME" "$CTX_AWK"'
    function reset() { sysd = instr = skills = mcpl = user = reply = other = comp = 0; split("", tc); split("", tr); split("", tn); split("", skn); split("", skw); split("", skp); split("", skr); nsk = 0; split("", dln); split("", dlw); ndl = 0 }
    function tools(s,   m, i, p, ty, nm, part) {
        split("", nsw); split("", tw); split("", tl); split("", tlo); split("", tln); split("", nso); nns = 0; ns = ""
        s = substr(s, index(s, "\"tools\":["))
        gsub(/\{"type":"[a-z_]+","name":"/, "\001&", s); m = split(s, part, "\001")
        for (i = 2; i <= m; i++) {
            p = part[i]; ty = strv(p, "type"); nm = unesc(strv(p, "name"))
            if (ty == "namespace") { ns = nm; if (!(ns in nsw)) nso[++nns] = ns; nsw[ns] += length(p) / 4 }
            else if (ns != "") { tw[ns, nm] += length(p) / 4; if (!((ns, nm) in tl)) { tl[ns, nm] = 1; tlo[ns, ++tln[ns]] = nm } }
            else { if (!(nm in nsw)) nso[++nns] = nm; nsw[nm] += length(p) / 4 }
        }
    }
    function skillsof(v,   x, i, m, e, nm, rel, k, part) {
        x = v; while (match(x, /- `r[0-9]+` = `[^`]*`/)) { e = substr(x, RSTART + 3, RLENGTH - 4); k = substr(e, 1, index(e, "`") - 1); root[k] = substr(e, index(e, "= `") + 3); x = substr(x, RSTART + RLENGTH) }
        i = index(v, "### Available skills"); if (!i) return
        m = split(substr(v, i), part, /\\n- /)
        for (i = 2; i <= m; i++) {
            e = part[i]; k = index(e, "\\n</skills_instructions>"); if (k) e = substr(e, 1, k - 1)
            nm = substr(e, 1, index(e, ": ") - 1); rel = ""
            if (match(e, /\(file: [^)]*\)/)) rel = substr(e, RSTART + 7, RLENGTH - 8)
            k = substr(rel, 1, index(rel, "/") - 1); if (k in root) rel = root[k] substr(rel, index(rel, "/"))
            skn[++nsk] = unesc(nm); skw[nsk] = length(e) / 4; skp[nsk] = unesc(rel); skr[nsk] = (k in root) ? short(unesc(root[k])) : ""
        }
    }
    function listof(v,   m, i, e, part) { m = split(v, part, /\\n- /); for (i = 2; i <= m; i++) { e = part[i]; dln[++ndl] = unesc(substr(e, 1, index(e, ":") - 1)); dlw[ndl] = length(e) / 4 } }
    BEGIN { reset(); m = split(ENVIRON["CTX_MCP"], x, "\n"); for (i = 1; i <= m; i++) if (x[i] != "") conf[x[i]] = 1 }
    {
        tt = ""; if (match($0, /"type":"[a-z_]+"/)) tt = substr($0, RSTART + 8, RLENGTH - 9)
        pt = ""; if ((i = index($0, "\"payload\":{\"type\":\"")) > 0) { pt = substr($0, i + 19); pt = substr(pt, 1, index(pt, "\"") - 1) }
    }
    tt == "session_meta" { i = index($0, "\"base_instructions\":"); if (i) { b = substr($0, i); bt = (index(b, "\"base_instructions\":{") == 1) ? strv(b, "text") : strv(b, "base_instructions"); base = length(bt) / 4; bstart = substr(bt, 1, 80) } next }
    tt == "compacted" { reset(); comp = length($0) / 4; next }
    tt != "response_item" { next }
    pt == "message" {
        role = strv($0, "role"); s = $0
        if (role == "user") user += imgs(s) * 1600
        while (match(s, /"text":"([^"\\]|\\.)*"/)) {
            v = substr(s, RSTART + 8, RLENGTH - 9); n = length(v) / 4; s = substr(s, RSTART + RLENGTH)
            if (role == "developer") {
                if (bstart != "" && substr(v, 1, 80) == bstart) { sysd += n; dup = 1 }
                else if (index(v, "<skills_instructions>") == 1) { skills += n; skillsof(v) }
                else if (index(v, "<tools>") == 1) { mcpl += n; listof(v) }
                else sysd += n
            } else if (role == "user") {
                if (index(v, "# AGENTS.md instructions") == 1 || index(v, "<user_instructions>") == 1) instr += n
                else if (index(v, "<environment_context>") == 1) sysd += n
                else user += n
            } else if (role == "assistant") reply += n
            else other += n
        }
        next }
    pt == "reasoning" { next }
    pt == "function_call" || pt == "custom_tool_call" { nm = unesc(strv($0, "name")); cn[strv($0, "call_id")] = nm; tc[nm] += length(strv($0, pt == "function_call" ? "arguments" : "input")) / 4; tn[nm]++; next }
    pt == "function_call_output" || pt == "custom_tool_call_output" { id = strv($0, "call_id"); nm = (id in cn) ? cn[id] : "?"; s = substr($0, index($0, "\"output\":")); tr[nm] += wt(s); next }
    pt == "local_shell_call" || pt == "web_search_call" || pt == "tool_search_call" { nm = pt; sub(/_call$/, "", nm); tc[nm] += length($0) / 4; tn[nm]++; next }
    pt == "additional_tools" { tools($0); next }
    pt == "compaction" || pt == "compaction_summary" { reset(); comp = length($0) / 4; next }
    { other += length($0) / 4 }
    END {
        tcs = trs = 0; for (k in tc) tcs += tc[k]; for (k in tr) trs += tr[k]
        stl = mcp = 0
        for (i = 1; i <= nns; i++) { ns = nso[i]; t = nsw[ns]; for (j = 1; j <= tln[ns]; j++) t += tw[ns, tlo[ns, j]]; nst[ns] = t; ism[ns] = (index(ns, "mcp__") == 1 || (ns in conf)); if (ism[ns]) mcp += t; else stl += t }
        mcp += mcpl
        sp = (dup ? 0 : base) + sysd; msg = user + reply + tcs + trs + other
        raw["system_prompt"] = sp; raw["instructions"] = instr; raw["skills"] = skills; raw["system_tools"] = stl; raw["mcp_tools"] = mcp; raw["messages"] = msg; raw["compaction"] = comp
        split("system_prompt instructions skills system_tools mcp_tools messages compaction", order, " ")
        all = 0; for (k in raw) all += raw[k]
        f = (total > 0 && all > 0) ? total / all : 1
        big = ""; sum = 0
        for (i = 1; i <= 7; i++) { k = order[i]; sc[k] = rnd(raw[k] * f); sum += sc[k]; if (big == "" || sc[k] > sc[big]) big = k }
        if (total > 0 && all > 0) sc[big] += total - sum
        if (total == "") print "H\tused\t" rnd(all)
        for (i = 1; i <= 7; i++) { k = order[i]; print "C\t" k "\t\t" sc[k] "\tused\t1" }
        if (window > 0) { fr = window - (total > 0 ? total : rnd(all)); print "C\tfree_space\t\t" (fr > 0 ? fr : 0) "\tfree\t0" }
        # the AGENTS.md files: their sizes, scaled to what the instructions came to
        m = split(ENVIRON["CTX_FILES"], x, "\n"); fs = 0
        for (i = 1; i <= m; i++) if (split(x[i], y, "\t") >= 3) fs += y[2] / 4
        print "G\tinstructions\t\t1"
        for (i = 1; i <= m; i++) if (split(x[i], y, "\t") >= 3) print "I\tinstructions\t" short(y[1]) "\t" (instr > 0 && fs > 0 ? rnd(y[2] / 4 * sc["instructions"] / fs) : "") "\t" (instr > 0 ? y[3] : "這次對話沒讀到") "\t" y[1] "\t"
        print "G\tskills\t\t1"
        for (i = 1; i <= nsk; i++) print "I\tskills\t" skn[i] "\t" (skills > 0 ? rnd(skw[i] * sc["skills"] / skills) : "") "\t" skr[i] "\t" skp[i] "\t"
        print "G\ttools\t\t1"; print "G\tmcp\t\t1"
        for (i = 1; i <= nns; i++) {
            ns = nso[i]; g = ism[ns] ? "mcp" : "tools"
            print "I\t" g "\t" ns "\t" rnd(nst[ns] * f) "\t" (tln[ns] + 0) " 個工具\t\t"
            for (j = 1; j <= tln[ns]; j++) print "I\t" g "\t" tlo[ns, j] "\t" rnd(tw[ns, tlo[ns, j]] * f) "\t\t\t" ns
            seen[ns] = 1
        }
        for (i = 1; i <= ndl; i++) { print "I\tmcp\t" dln[i] "\t" rnd(dlw[i] * f) "\t延後載入（只放名字和說明）\t\t"; seen[dln[i]] = 1 }
        for (k in conf) if (!(k in seen) && !(("mcp__" k) in seen)) print "I\tmcp\t" k "\t\t設定裡有，這次對話沒看到它的工具\t\t"
        print "G\tmsgs\t\t1"
        print "I\tmsgs\t你的訊息\t" rnd(user * f) "\t\t\t"; print "I\tmsgs\t回覆\t" rnd(reply * f) "\t\t\t"
        print "I\tmsgs\t工具呼叫\t" rnd(tcs * f) "\t\t\t"; print "I\tmsgs\t工具結果\t" rnd(trs * f) "\t\t\t"; print "I\tmsgs\t其他\t" rnd(other * f) "\t\t\t"
        print "G\ttool_results\t\t1"
        for (k in tc) seen2[k] = 1; for (k in tr) seen2[k] = 1
        for (k in seen2) print "I\ttool_results\t" k "\t" rnd((tc[k] + tr[k]) * f) "\t" (tn[k] + 0) " 次\t\t"
    }'
    printf 'H\tnote\t%s\n' "總數是 Codex 自己記的（最後一次 token_count）；分到各類是從對話紀錄估的（大小 ÷ 4），照比例對到總數。Codex 自己顯示的 % 會先扣掉 12000（它的基本用量）。"
}

# ---------- omp ----------
omp_session() { # omp_session PID DIR : the session its terminal points at, else the newest of that folder
    local f="" x tty want
    tty=$(ps -o tty= -p "$1" 2>/dev/null | tr -d ' ' | sed 's|^/dev/||; s|/|-|g')
    case $tty in ""|"?"|"??") ;; *) [ -f "$OMP_DIR/terminal-sessions/$tty" ] && f=$(sed -n 2p "$OMP_DIR/terminal-sessions/$tty");; esac
    if [ -z "$f" ] || [ ! -f "$f" ]; then
        f=""; want="\"cwd\":$(json_s "$2")"
        [ -n "$2" ] && while IFS= read -r x; do
            [ -n "$x" ] && head -n 3 "$x" | grep '"type":"session"' | grep -qF "$want" && { f=$x; break; }
        done <<EOF
$(newest_files "$OMP_DIR/sessions" '*.jsonl')
EOF
    fi
    [ -n "$f" ] && printf '%s\n' "$f"
}
omp_instr_files() { # the instruction files omp may read for DIR (omp reads several tools' ones; a guess from what is there)
    local d
    ctx_files "omp 帳號" "$OMP_DIR/AGENTS.md"
    ctx_files "Claude 帳號" "$CLAUDE_DIR/CLAUDE.md"
    [ -n "$1" ] || return 0
    while IFS= read -r d; do
        [ -n "$d" ] && [ "$d" != "$HOME" ] && ctx_files "資料夾" "$d/AGENTS.md" "$d/CLAUDE.md" "$d/.omp/AGENTS.md" "$d/.claude/CLAUDE.md"
    done <<EOF
$(ctx_up "$1")
EOF
}
omp_skill_files() { # "name TAB bytes TAB path TAB where" for the skills omp may list: their name and description
    local d f
    for d in "$OMP_DIR/skills" "$AGENTS_SKILLS" "$CLAUDE_DIR/skills" ${1:+"$1/.omp/skills" "$1/.agents/skills" "$1/.claude/skills"}; do
        for f in "$d"/*/SKILL.md; do [ -f "$f" ] && printf '%s\n' "$f"; done
    done | LC_ALL=C awk -v home="$HOME" "$CTX_AWK"'
        { f = $0; n = ""; d = ""; c = 0; nm = f; sub(/\/SKILL\.md$/, "", nm); sub(/.*\//, "", nm); w = nm; sub(/\/[^\/]*\/SKILL\.md$/, "", w)
          while ((getline l < f) > 0) { if (l == "---") { if (++c == 2) break; continue }; if (c == 1 && l ~ /^name:/) { n = l; sub(/^name:[ \t]*/, "", n) }; if (c == 1 && l ~ /^description:/) { d = l; sub(/^description:[ \t]*/, "", d) } }
          close(f); if (n != "") nm = n; if (nm in seen) next; seen[nm] = 1
          printf "%s\t%d\t%s\t%s\n", nm, length(nm) + length(d) + 20, f, short(w) }'
}
omp_detail() { # omp_detail PID DIR -> rows
    local f c u w m mcp x files skills
    printf 'H\ttool\tomp\nH\tcompact\t/compact\nH\twith_text\t1\nH\tclear\t/new\nH\tsource\tsession\nH\texact\t0\n'
    f=$(omp_session "$1" "$2"); [ -n "$f" ] || { printf 'H\terror\t%s\n' "找不到這個 omp 的 session（~/.omp/agent/sessions）"; return 0; }
    c=$(omp_ctx "$1" "$2"); u=$(num_of used "$c"); w=$(num_of window "$c"); m=$(str_of model "$c")
    printf 'H\tmodel\t%s\nH\tused\t%s\nH\twindow\t%s\n' "$m" "$u" "$w"
    mcp=$(for x in "$OMP_DIR/mcp.json" ${2:+"$2/.omp/mcp.json" "$2/.mcp.json"}; do [ -f "$x" ] && json_keys "$x" mcpServers; done)
    files=$(omp_instr_files "$2"); skills=$(omp_skill_files "$2")
    ctx_stream "$f" | CTX_FILES=$files CTX_SKILLS=$skills CTX_MCP=$mcp LC_ALL=C awk -v total="$u" -v window="$w" -v home="$HOME" "$CTX_AWK"'
    function add(k, nm, x) { ne++; ek[ne] = k; en[ne] = nm; ew[ne] = x; el[ne] = NR }
    function msgtext(s,   i) { i = index(s, ",\"details\":"); if (i) s = substr(s, 1, i - 1); return s }
    { id = strv(substr($0, 1, 200), "id"); if (id != "") lid[id] = NR }
    index($0, "{\"type\":\"compaction\"") == 1 { cl = NR; keep = strv($0, "firstKeptEntryId"); summ = length(strv($0, "summary")) / 4; rb = 0; next }
    index($0, "{\"type\":\"reset_boundary\"") == 1 { cl = NR; keep = ""; summ = 0; rb = 1; next }
    index($0, "{\"type\":\"custom_message\"") == 1 { add("at", strv($0, "customType"), wt(msgtext($0))); next }
    index($0, "{\"type\":\"message\"") != 1 { next }
    {
        role = strv($0, "role"); s = msgtext($0)
        if (role == "assistant") {
            if (index($0, "\"stopReason\":\"aborted\"") || index($0, "\"stopReason\":\"error\"")) next
            if ((i = index($0, "\"contextSnapshot\":{")) > 0) { cs = substr($0, i); nmt = num(cs, "nonMessageTokens"); tst = num(cs, "toolSchemaTokens") }
            gsub(/\{"type":"(text|thinking|toolCall|redactedThinking)"/, "\001&", s); m = split(s, part, "\001")
            for (j = 2; j <= m; j++) {
                p = part[j]
                if (index(p, "{\"type\":\"text\"") == 1) add("reply", "", length(strv(p, "text")) / 4)
                else if (index(p, "{\"type\":\"toolCall\"") == 1) { nm = unesc(strv(p, "name")); idn[strv(p, "id")] = nm; add("tc", nm, wt(p)) }
            }
        } else if (role == "toolResult") { nm = unesc(strv($0, "toolName")); if (nm == "") nm = "?"; add("tr", nm, wt(s)) }
        else if (role == "user") add("user", "", wt(s))
        else add("other", role, wt(s))
    }
    function num(s, k) { if (!match(s, "\"" k "\":[0-9]+")) return ""; return substr(s, RSTART + length(k) + 3, RLENGTH - length(k) - 3) }
    END {
        start = 1
        if (cl) { start = cl + 1; if (keep != "" && (keep in lid) && lid[keep] < cl) start = lid[keep] }
        for (e = 1; e <= ne; e++) {
            if (el[e] < start || el[e] == cl) continue
            k = ek[e]; wv = ew[e]
            if (k == "tc") { tc[en[e]] += wv; tn[en[e]]++; tcs += wv }
            else if (k == "tr") { tr[en[e]] += wv; trs += wv }
            else if (k == "at") { at[en[e]] += wv; ats += wv }
            else raw[k] += wv
        }
        if (cl && !rb) raw["summ"] = summ
        msg = raw["user"] + raw["reply"] + tcs + trs + ats + raw["other"]; all = msg + raw["summ"]
        m = split(ENVIRON["CTX_FILES"], fl, "\n"); fsz = 0; for (i = 1; i <= m; i++) if (split(fl[i], y, "\t") >= 3) fsz += y[2] / 4
        ms = split(ENVIRON["CTX_SKILLS"], sl, "\n"); ssz = 0; for (i = 1; i <= ms; i++) if (split(sl[i], y, "\t") >= 4) ssz += y[2] / 4
        if (nmt != "" && total != "") {
            # the numbers omp keeps: what is not the conversation, and of that the tools
            tools = tst + 0; rest = nmt - tools; if (rest < 0) rest = 0
            fi = fsz; sk = ssz; if (fi + sk > rest) { if (fi + sk > 0) { fi = rnd(fsz * rest / (fsz + ssz)); sk = rest - fi } }
            fi = rnd(fi); sk = rnd(sk); sp = rest - fi - sk
            mt = total - nmt; if (mt < 0) mt = 0
            print "C\tsystem_prompt\t\t" sp "\tused\t1"; print "C\tsystem_tools\t\t" tools "\tused\t0"
            print "C\tinstructions\t\t" fi "\tused\t1"; print "C\tskills\t\t" sk "\tused\t1"
        } else {
            mt = total != "" ? total : rnd(all); if (mt > rnd(all)) mt = rnd(all); sp = (total != "" ? total : rnd(all)) - mt; fi = 0; sk = 0
            print "C\tsystem_prompt\t=系統提示、工具、指示檔、Skills（估算）\t" sp "\tused\t1"
        }
        f = all > 0 ? mt / all : 1
        cm = rnd(raw["summ"] * f); print "C\tmessages\t\t" (mt - cm) "\tused\t1"; print "C\tcompaction\t\t" cm "\tused\t1"
        if (window > 0 && total != "") { fr = window - total; print "C\tfree_space\t\t" (fr > 0 ? fr : 0) "\tfree\t0" }
        print "G\tinstructions\t\t1"
        for (i = 1; i <= m; i++) if (split(fl[i], y, "\t") >= 3) print "I\tinstructions\t" short(y[1]) "\t" (fsz > 0 && fi > 0 ? rnd(y[2] / 4 * fi / fsz) : "") "\t" y[3] "\t" y[1] "\t"
        print "G\tskills\t\t1"
        for (i = 1; i <= ms; i++) if (split(sl[i], y, "\t") >= 4) print "I\tskills\t" y[1] "\t" (ssz > 0 && sk > 0 ? rnd(y[2] / 4 * sk / ssz) : "") "\t" y[4] "\t" y[3] "\t"
        print "G\tmcp\t\t1"
        n = split(ENVIRON["CTX_MCP"], x, "\n"); for (i = 1; i <= n; i++) if (x[i] != "" && !(x[i] in seen)) { seen[x[i]] = 1; print "I\tmcp\t" x[i] "\t\t設定的 MCP（它的工具算在「系統工具」）\t\t" }
        print "G\tmsgs\t\t1"
        print "I\tmsgs\t你的訊息\t" rnd(raw["user"] * f) "\t\t\t"; print "I\tmsgs\t回覆\t" rnd(raw["reply"] * f) "\t\t\t"
        print "I\tmsgs\t工具呼叫\t" rnd(tcs * f) "\t\t\t"; print "I\tmsgs\t工具結果\t" rnd(trs * f) "\t\t\t"
        print "I\tmsgs\t附加內容\t" rnd(ats * f) "\t\t\t"; print "I\tmsgs\t其他\t" rnd(raw["other"] * f) "\t\t\t"
        if (cm > 0) print "I\tmsgs\t壓縮後的摘要\t" cm "\t\t\t"
        print "G\ttool_results\t\t1"
        for (k in tc) seen2[k] = 1; for (k in tr) seen2[k] = 1
        for (k in seen2) print "I\ttool_results\t" k "\t" rnd((tc[k] + tr[k]) * f) "\t" (tn[k] + 0) " 次\t\t"
        print "G\tattachments\t\t1"
        for (k in at) print "I\tattachments\t" k "\t" rnd(at[k] * f) "\t\t\t"
    }'
    printf 'H\tnote\t%s\n' "總數和「系統工具」是 omp 自己記的（最後一次回覆的 context 快照）；其他分類和細項是從檔案和對話紀錄估的（大小 ÷ 4），照比例對到 omp 的數字。指示檔和 skills 是照現在的檔案估的。"
}

ctx_rows() { # ctx_rows PID TOOL DIR : the rows for one agent
    case $2 in
        claude) claude_detail "$1" "$3";;
        codex) codex_detail "$3";;
        omp) omp_detail "$1" "$3";;
        *) printf 'H\terror\t%s\n' "不是 Claude Code、Codex 或 omp";;
    esac
}
ctx_detail() { # ctx_detail PID TOOL DIR FRESH : the detail JSON, kept a minute
    local pid=$1 tool=$2 dir=$3 f="$CTX_DIR/detail-$1.json" j now at
    now=$(date +%s)
    if [ -z "$4" ] && [ -f "$f" ]; then
        j=$(cat "$f"); at=$(num_of at "$j")
        if [ -n "$at" ] && [ $(( now - at )) -lt "${KIT_CTX_DETAIL_TTL:-60}" ] && [ $(( now - at )) -ge 0 ] && [ "$(str_of tool "$j")" = "$tool" ]; then
            printf '%s\n' "$j"; return 0
        fi
    fi
    j=$(ctx_rows "$pid" "$tool" "$dir" | ctx_assemble "$now")
    { [ -d "$CTX_DIR" ] || mkdir -p "$CTX_DIR"; } 2>/dev/null && { printf '%s\n' "$j" > "$f.$$" && mv -f "$f.$$" "$f"; } 2>/dev/null
    printf '%s\n' "$j"
}

# ---------- kit note: one or two lines an agent writes about where it is ----------
# The agent runs `kit note "<what just happened; next step>"` in its own shell: kit finds the agent above it (claude,
# codex, omp), keeps the text under that process ($KIT_CONF/notes/<pid>: start, tool, folder, time, then the text) and
# adds it to the folder's history (notes/history.tsv: time pid tool folder text, a line break kept as \037), which
# outlives the agent (a new one in that folder reads it with kit note --history). Programs read
# kit note --pid <pid> --json (README: 給程式讀的介面).
NOTE_DIR="$KIT_CONF/notes"
NOTE_MAX=1000          # bytes; one or two lines
NOTE_KEEP=500          # history lines kept
agent_pid() { # the agent process above this kit (claude, codex, omp: the program's own name, or a script by that name)
    { ps -A -o pid= -o ppid= -o args= 2>/dev/null || ps -o pid,ppid,args 2>/dev/null; } | awk -v p="$$" '
        $1 ~ /^[0-9]+$/ { a = $3; b = $4; sub(/^.*\//, "", a); sub(/^.*\//, "", b); up[$1] = $2 + 0; w1[$1] = a; w2[$1] = b }
        function tool(x) { return x == "claude" || x == "claude.exe" || x == "claude.js" || x == "cli.js" ? "claude" : x == "codex" || x == "codex.exe" || x == "codex.js" ? "codex" : x == "omp" || x == "omp.exe" ? "omp" : "" }
        END { p = up[p + 0]
              for (i = 0; i < 12 && p > 1 && (p in up); i++) {
                  t = tool(w1[p]); if (t == "") t = tool(w2[p])
                  if (t != "") { print p " " t; exit }
                  p = up[p] } }'
}
proc_start() { ps -o lstart= -p "$1" 2>/dev/null | tr -s ' ' | sed 's/^ //; s/ $//'; }
note_read() { # note_read PID : N_TOOL N_DIR N_AT N_TEXT of that process's note (1 when it has none or the pid was reused)
    local f="$NOTE_DIR/$1" st
    N_TOOL=; N_DIR=; N_AT=; N_TEXT=
    [ -f "$f" ] || return 1
    st=$(proc_start "$1")
    [ -z "$st" ] || [ "$(sed -n 1p "$f")" = "$st" ] || return 1     # another process now has that pid
    N_TOOL=$(sed -n 2p "$f"); N_DIR=$(sed -n 3p "$f"); N_AT=$(sed -n 4p "$f"); N_TEXT=$(sed -n '5,$p' "$f")
    [ -n "$N_TEXT" ]
}
note_json() { # note_json PID : that process's note as JSON (text null: none)
    if note_read "$1"; then
        printf '{"pid": %s, "tool": %s, "dir": %s, "at": %s, "text": %s}' "$1" "$(json_s "$N_TOOL")" "$(json_s "$N_DIR")" "${N_AT:-null}" "$(json_s "$N_TEXT")"
    else printf '{"pid": %s, "tool": null, "dir": null, "at": null, "text": null}' "$1"; fi
}
note_ago() { # note_ago EPOCH : 剛剛 / N 分鐘前 / N 小時前 / N 天前
    local d=$(( $(date +%s) - ${1:-0} ))
    if [ "$d" -lt 60 ]; then echo 剛剛; elif [ "$d" -lt 3600 ]; then echo "$((d / 60)) 分鐘前"
    elif [ "$d" -lt 86400 ]; then echo "$((d / 3600)) 小時前"; else echo "$((d / 86400)) 天前"; fi
}
cmd_note() { # kit note [text...] | --clear | --pid PID [--json] [text...] | --history [--dir DIR] [--json]
    local pid="" tool="" dir="" json="" clear="" hist="" text="" a f p n=0 out=""
    local use="用法：kit note [\"做了什麼；下一步\"] | kit note --clear | kit note --pid <pid> [--json] | kit note --history [--dir 資料夾] [--json]"
    while [ $# -gt 0 ]; do
        case $1 in
            --pid|--dir) [ $# -ge 2 ] || die_c usage "$use"
                case $1 in --pid) pid=$2;; *) dir=$2;; esac; shift 2;;
            --json) json=1; shift;;
            --clear) clear=1; shift;;
            --history) hist=1; shift;;
            --) shift; text="$text${text:+ }$*"; break;;
            -*) die_c usage "$use";;
            *) text="$text${text:+ }$1"; shift;;
        esac
    done
    [ -z "$json" ] || json_mode
    case $pid in *[!0-9]*) die_c usage "$use";; esac
    if [ -z "$pid" ] && [ -z "$dir" ]; then                 # the agent above (history: only for its folder)
        a=$(agent_pid)
        if [ -n "$a" ]; then pid=${a%% *}; tool=${a#* }
        elif [ -z "$hist" ]; then die_c no-agent "找不到上面的 agent（claude、codex、omp）：kit note 要在 agent 自己的 shell 裡跑，或用 --pid 指定"; fi
    fi
    if [ -n "$hist" ]; then
        if [ -z "$dir" ] && [ -n "$pid" ]; then dir=$(proc_cwd "$pid"); fi
        [ -n "$dir" ] || dir=$PWD
        out=$( [ -f "$NOTE_DIR/history.tsv" ] && awk -F '\t' -v d="$dir" '$4 == d' "$NOTE_DIR/history.tsv" | tail -n 20 | awk '{ l[NR] = $0 } END { for (i = NR; i >= 1; i--) print l[i] }' )
        if [ -n "$json" ]; then
            printf '{"dir": %s, "notes": [' "$(json_s "$dir")" >&3
            [ -z "$out" ] || printf '%s\n' "$out" | while IFS="$TAB" read -r at p t d x; do
                [ $n = 0 ] || printf ', ' >&3; n=1
                printf '{"pid": %s, "tool": %s, "dir": %s, "at": %s, "text": %s}' "$p" "$(json_s "$t")" "$(json_s "$d")" "$at" "$(json_s "$(printf '%s' "$x" | tr "$US" '\n')")" >&3
            done
            printf ']}\n' >&3
        elif [ -z "$out" ]; then echo "（${dir} 還沒有人寫過進度）"
        else printf '%s\n' "$out" | while IFS="$TAB" read -r at p t d x; do
                printf '%s（%s %s）\n' "$(note_ago "$at")" "$t" "$p"; printf '%s\n' "$x" | tr "$US" '\n' | sed 's/^/  /'; done
        fi
        return 0
    fi
    if [ -n "$clear" ]; then rm -f "$NOTE_DIR/$pid"; say "進度清掉了"; return 0; fi
    if [ -z "$text" ]; then
        if [ -n "$json" ]; then note_json "$pid" >&3; echo >&3
        elif note_read "$pid"; then printf '%s\n（%s）\n' "$N_TEXT" "$(note_ago "$N_AT")"
        else echo "（還沒寫過進度）"; fi
        return 0
    fi
    # write: one or two lines, each trimmed, a TAB made a space
    text=$(printf '%s\n' "$text" | tr '\t\r' '  ' | sed 's/^ *//; s/ *$//' | grep -v '^$')
    [ -n "$text" ] || die_c usage "$use"
    [ "$(printf '%s\n' "$text" | wc -l | tr -d ' ')" -le 2 ] || die_c too-long "進度最多兩行：第一行寫剛做了什麼、下一步，第二行（選用）寫目標"
    [ "$(printf '%s' "$text" | wc -c | tr -d ' ')" -le $NOTE_MAX ] || die_c too-long "進度太長（最多 $NOTE_MAX bytes）：寫一兩句就好"
    kill -0 "$pid" 2>/dev/null || die_c no-agent "沒有這個程序：$pid"
    [ -n "$tool" ] || { agent_guess "$pid" "" ""; tool=$A_TOOL; }
    dir=$(proc_cwd "$pid"); [ -n "$dir" ] || dir=$PWD
    mkdir -p "$NOTE_DIR"
    for f in "$NOTE_DIR"/*; do                                   # notes of processes that are gone (history keeps them)
        p=${f##*/}; case $p in ""|*[!0-9]*) continue;; esac
        kill -0 "$p" 2>/dev/null || rm -f "$f"
    done
    a=$(date +%s)
    { proc_start "$pid"; printf '%s\n%s\n%s\n%s\n' "$tool" "$dir" "$a" "$text"; } > "$NOTE_DIR/$pid.tmp" && mv "$NOTE_DIR/$pid.tmp" "$NOTE_DIR/$pid"
    printf '%s\t%s\t%s\t%s\t%s\n' "$a" "$pid" "$tool" "$dir" "$(printf '%s' "$text" | tr '\n' "$US")" >> "$NOTE_DIR/history.tsv"
    [ "$(wc -l < "$NOTE_DIR/history.tsv" | tr -d ' ')" -le $((NOTE_KEEP + 100)) ] ||
        { tail -n $NOTE_KEEP "$NOTE_DIR/history.tsv" > "$NOTE_DIR/history.tmp" && mv "$NOTE_DIR/history.tmp" "$NOTE_DIR/history.tsv"; }
    if [ -n "$json" ]; then note_json "$pid" >&3; echo >&3; else say "進度記下了"; fi
}

# ---------- kit files: the files an agent read or changed ----------
# One JSON line (kit.ps1 prints the same), from the agent's own log; only paths are taken from it, and of what was said
# only the start of the person's messages (turns' "text", 30 characters at most):
#   {"tool", "log", "dir", "files": [{"path", "tag": read|edit|write|git, "exists"}],
#    "turns": [{"n", "at", "text", "files": [{"path", "tag", "exists"}]}][, "note"]}
# Newest first, one entry per path (its newest touch), at most FILES_MAX; a path that is gone only when it was written
# or edited. Each log: its last KIT_CTX_TAIL bytes (8 MB).
# turns: what was touched after each message the person sent, until the next one (the files before the first one seen
# in what was read: n 0); newest first, only those with files (no git ones), at most TURNS_MAX, TURN_FILES each.
# Claude: its transcript and its sub-agents' (<session>/subagents/*.jsonl), merged by the records' timestamps (then by
#   the files' age, oldest first, and line order); Read / Edit, MultiEdit, NotebookEdit / Write. api-request records
#   repeat old calls: skipped. Turns: the main transcript's user records with a text (not tool results, not isMeta or
#   isCompactSummary, not commands or what Claude Code wrote itself); a sub-agent's touch goes to the main turn that
#   started last at or before it.
# Codex: what its patches changed (FileChange items, patch_apply events, *** Add/Update/Delete File: in its tool calls);
#   Codex reads files through the shell, so reads are not seen. Turns: user_message events, UserMessage items.
# omp: its read / edit / write tool calls (a read's :LINES taken off; xd://, skill:// ... are not files). Turns: its
#   user messages.
# The producers print "time TAB file TAB n TAB turn TAB tag TAB path" (time: 17 digits, path as in the log, escapes
# undone; turn: the main log's turn number, - for a sub-agent's) and for a turn's start "time TAB 0 TAB n TAB turn TAB
# turn TAB at TAB text" (text: JSON-escaped).
FILES_MAX=200
TURNS_MAX=30
TURN_FILES=50
FILES_AWK='
function lastts(s,   x) { x = ""; while (match(s, /"timestamp":"[^"]*"/)) { x = substr(s, RSTART + 13, RLENGTH - 14); s = substr(s, RSTART + RLENGTH) }; return x }
function firstts(s) { return match(s, /"timestamp":"[^"]*"/) ? substr(s, RSTART + 13, RLENGTH - 14) : "" }
function sortt(x) { gsub(/[^0-9]/, "", x); return substr(x "00000000000000000", 1, 17) }
function p2(n) { return (n < 10 ? "0" : "") n }
function tsnorm(x,   z, o, y, m, d, era, yoe, doe, mi, dd, mp) { # a timestamp as YYYY-MM-DDTHH:MM:SSZ (UTC), else ""
    if (x !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9](\.[0-9]+)?(Z|[+-][0-9][0-9]:?[0-9][0-9])?$/) return ""
    z = x; sub(/^[^T]*T[0-9:]*(\.[0-9]+)?/, "", z)
    if (z == "" || z == "Z") return substr(x, 1, 19) "Z"
    o = (substr(z, 2, 2) * 60 + substr(z, length(z) - 1, 2)) * (substr(z, 1, 1) == "-" ? -1 : 1)
    y = substr(x, 1, 4) + 0; m = substr(x, 6, 2) + 0; d = substr(x, 9, 2) + 0
    y -= (m <= 2); era = int(y / 400); yoe = y - era * 400                    # (days from 1970-01-01: H. Hinnant)
    doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + int((153 * (m > 2 ? m - 3 : m + 9) + 2) / 5) + d - 1
    mi = (era * 146097 + doe - 719468) * 1440 + substr(x, 12, 2) * 60 + substr(x, 15, 2) - o
    dd = int(mi / 1440); if (dd * 1440 > mi) dd--; mi -= dd * 1440
    dd += 719468; era = int(dd / 146097); doe = dd - era * 146097
    yoe = int((doe - int(doe / 1460) + int(doe / 36524) - int(doe / 146096)) / 365)
    y = yoe + era * 400; doe -= 365 * yoe + int(yoe / 4) - int(yoe / 100); mp = int((5 * doe + 2) / 153)
    d = doe - int((153 * mp + 2) / 5) + 1; m = mp < 10 ? mp + 3 : mp - 9; y += (m <= 2)
    return y "-" p2(m) "-" p2(d) "T" p2(int(mi / 60)) ":" p2(mi % 60) ":" substr(x, 18, 2) "Z"
}
function ttext(s,   o, n, c, e, h, w, st, sp, i, L, x, cut) { # the start of a message (S: JSON-escaped) for a turn, still
    # escaped: leading <system-reminder> blocks skipped, <hc from="X"> -> "hc X：", white space runs one space, control
    # characters out, 30 characters at most (+ "…"); "\001": not a message the person sent
    while (1) {
        sub(/^([ \t]|\\[nrtf])+/, "", s)
        if (substr(s, 1, 17) != "<system-reminder>") break
        i = index(s, "</system-reminder>"); if (!i) return ""
        s = substr(s, i + 18)
    }
    if (s ~ /^(<command-name>|<command-message>|<local-command-stdout>|<local-command-caveat>|Caveat:|\[Request interrupted|<task-notification>|<bash-input>|<bash-stdout>|<bash-stderr>|<environment_context>|<user_instructions>)/) return "\001"
    if (substr(s, 1, 11) == "<hc from=\\\"" && (i = index(substr(s, 12), "\\\">"))) {
        x = substr(s, 12, i - 1); s = substr(s, i + 14); gsub(/<\/hc>/, "", s); s = "hc " x "：" s
    }
    o = ""; n = 0; sp = 0; cut = 0; L = length(s); i = 1
    while (i <= L) {
        c = substr(s, i, 1); w = 0; st = 1
        if (c == "\\") {
            e = substr(s, i + 1, 1)
            if (e == "u") {
                h = tolower(substr(s, i + 2, 4))
                if (h !~ /^[0-9a-f][0-9a-f][0-9a-f][0-9a-f]$/) { i += 2; continue }
                i += 6
                if (h ~ /^00[01]/ || h == "007f") { if (h >= "0009" && h <= "000d") w = 1; else continue }
                else { c = "\\u" h; if (h ~ /^d[c-f]/) st = 0 }                 # (a low surrogate: the same character)
            } else if (e == "n" || e == "r" || e == "t" || e == "f") { w = 1; i += 2 }
            else if (e == "b") { i += 2; continue }
            else if (e == "\"" || e == "\\") { c = "\\" e; i += 2 }
            else { c = e; i += 2 }
        } else {
            i++
            if (c == " " || (c >= "\011" && c <= "\015")) w = 1
            else if (c < " " || c == "\177") continue
            else if (c >= "\200" && c < "\300") st = 0                          # (a UTF-8 continuation byte)
        }
        if (w) { sp = 1; continue }
        if (st) {
            if (sp && n) { if (n == 30) { cut = 1; break }; o = o " "; n++ }
            sp = 0
            if (n == 30) { cut = 1; break }
            n++
        }
        o = o c
    }
    if (cut) { sub(/ $/, "", o); o = o "…" }
    return o
}
function turn(t, at, raw,   x) { # a turn starts (RAW: the message, JSON-escaped); 0: it is not one
    x = ttext(raw); if (x == "\001" || x == "") return 0
    print t "\t0\t" (++r) "\t" (++tn) "\tturn\t" tsnorm(at) "\t" x; return 1
}
function firsttext(s,   i, x) { # the first text item in S (an array of content items) that has words, JSON-escaped
    while ((i = index(s, "{\"type\":\"text\",\"text\":\"")) > 0) {
        s = substr(s, i + 15); x = strv(s, "text"); if (ttext(x) != "") return x
    }
    return ""
}
function msgtext(s) { # the message (S: from its content on): a string, or the first text in an array of items
    if (substr(s, 1, 1) == "\"") return match(s, /^"([^"\\]|\\.)*"/) ? substr(s, 2, RLENGTH - 2) : ""
    return firsttext(s)
}
function tno() { return main ? tn + 0 : "-" }
'
FILES_CLAUDE='
cut && NR == 1 { next }
/^\{"type":"api-request/ { next }
main && index($0, "\"type\":\"user\"") && (k = index($0, "\"message\":{\"role\":\"user\",\"content\":")) && !index($0, "\"isMeta\":true") && !index($0, "\"isCompactSummary\":true") {
    x = lastts($0); if (x != "") t = sortt(x); else if (t == "") t = "00000000000000000"
    s = substr($0, k + 35)
    if (substr(s, 1, 1) == "[" && index(s, "\"type\":\"tool_result\"")) next
    turn(t, x, msgtext(s)); next
}
index($0, "\"type\":\"assistant\"") && index($0, "\"type\":\"tool_use\"") {
    x = lastts($0); if (x != "") t = sortt(x); else if (t == "") t = "00000000000000000"
    if (!(i = index($0, "\"content\":["))) next
    nb = jblocks(substr($0, i + 10), JB, JF)   # (whatever order the keys come in)
    for (b = 1; b <= nb; b++) {
        if (JF[b, "type"] != "tool_use") continue
        seg = JB[b]; n = JF[b, "name"]; g = ""
        if (n == "Read") g = "read"; else if (n == "Write") g = "write"; else if (n == "Edit" || n == "MultiEdit" || n == "NotebookEdit") g = "edit"
        if (g == "") continue
        p = strv(seg, "file_path"); if (p == "") p = strv(seg, "notebook_path")
        if (p != "") print t "\t" fi "\t" (++r) "\t" tno() "\t" g "\t" unesc(p)
    }
}'
FILES_CODEX='
function ptxt(s, lv,   o, c) { # the path after "*** Add File: " up to the end of its line (LV: 2 when the patch is a string in a string)
    o = ""
    while (s != "") {
        c = substr(s, 1, 1)
        if (c == "\"") break
        if (c == "\\") {
            if (lv == 1 && substr(s, 2, 1) == "\\") { o = o "\\"; s = substr(s, 3); continue }
            if (lv == 1 && substr(s, 2, 1) == "/") { o = o "/"; s = substr(s, 3); continue }
            if (lv == 2 && substr(s, 1, 4) == "\\\\\\\\") { o = o "\\"; s = substr(s, 5); continue }
            break
        }
        o = o c; s = substr(s, 2)
    }
    sub(/[ \t]+$/, "", o); return o
}
function out(g, p) { if (p != "") { print "00000000000000000\t" fi "\t" (++r) "\t" tno() "\t" g "\t" p; touched = 1 } }
function cturn(raw) { # (a version that writes both a user_message event and a UserMessage item: one turn)
    if (raw == last && !touched) return
    if (turn("00000000000000000", firstts($0), raw)) { last = raw; touched = 0 }
}
cut && NR == 1 { next }
index($0, "\"type\":\"event_msg\"") && (i = index($0, "\"payload\":{\"type\":\"user_message\"")) {
    s = substr($0, i + 10); k = strv(s, "kind"); if (k == "" || k == "plain") cturn(strv(s, "message")); next
}
index($0, "\"type\":\"item_completed\"") && (i = index($0, "\"item\":{\"type\":\"UserMessage\"")) {
    s = substr($0, i); if ((i = index(s, "\"content\":["))) cturn(firsttext(substr(s, i + 11))); next
}
(index($0, "\"type\":\"FileChange\"") || index($0, "\"type\":\"patch_apply_")) && (i = index($0, "\"changes\":")) {
    s = substr($0, i + 10)
    while (match(s, /"([^"\\]|\\.)*":\{("type":)?"(add|update|delete)"/)) {
        m = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
        out(m ~ /"add"$/ ? "write" : "edit", unesc(substr(m, 2, index(m, "\":{") - 2)))
    }
    s = substr($0, i + 10)
    while (match(s, /"path":"([^"\\]|\\.)*","kind":\{"type":"(add|update|delete)"/)) {
        m = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
        out(m ~ /"add"$/ ? "write" : "edit", unesc(substr(m, 9, index(m, "\",\"kind\":") - 9)))
    }
    s = substr($0, i + 10)
    while (match(s, /"move_path":"([^"\\]|\\.)*"/)) { out("edit", unesc(substr(s, RSTART + 13, RLENGTH - 14))); s = substr(s, RSTART + RLENGTH) }
    next
}
index($0, "\"type\":\"custom_tool_call\"") || index($0, "\"type\":\"function_call\"") {
    s = $0
    while (match(s, /\*\*\* (Add File|Update File|Delete File|Move to): /)) {
        lv = substr(s, RSTART - 3, 3) == "\\\\n" ? 2 : 1; m = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
        out(m ~ /Add/ ? "write" : "edit", ptxt(s, lv))
    }
}'
FILES_OMP='
function out(g, p) { if (p != "" && p !~ /^[A-Za-z][A-Za-z0-9+.-]+:\/\//) print "00000000000000000\t" fi "\t" (++r) "\t" tno() "\t" g "\t" p }
cut && NR == 1 { next }
index($0, "\"type\":\"message\"") && (k = index($0, "\"message\":{\"role\":\"user\",\"content\":")) {
    turn("00000000000000000", firstts($0), msgtext(substr($0, k + 35))); next
}
index($0, "\"role\":\"assistant\"") && index($0, "{\"type\":\"toolCall\"") {
    s = $0
    while ((i = index(s, "{\"type\":\"toolCall\"")) > 0) {
        s = substr(s, i + 18); seg = s; j = index(seg, "{\"type\":\"toolCall\""); if (j) seg = substr(seg, 1, j - 1)
        n = strv(seg, "name"); if (n != "read" && n != "edit" && n != "write") continue
        k = index(seg, "\"arguments\":{"); if (!k) continue
        a = substr(seg, k + 12); p = unesc(strv(a, "path"))
        if (n == "read") sub(/:[0-9][0-9,-]*$/, "", p)
        out(n, p)
        if (n != "edit") continue
        x = strv(a, "input")   # hashline edits: a [path#hash] line before each file
        while (match(x, /(^|\\n)\[[^]]+#[0-9A-Za-z]+]\\n/)) {
            h = substr(x, RSTART, RLENGTH); x = substr(x, RSTART + RLENGTH - 2)
            sub(/^\\n/, "", h); sub(/#[0-9A-Za-z]+]\\n$/, "", h); out("edit", unesc(substr(h, 2)))
        }
    }
}'
# newest first, one per path: absolute (a relative one under DIR; ~/ is the home folder), a path with a drive letter
# (or \\server) with / and compared ignoring case; then the --git ones (after a line --git--), not already listed
FILES_PICK='
BEGIN { dir = ENVIRON["FILES_DIR"]; home = ENVIRON["HOME"] }
function abs(p,   d, i) {
    if (substr(p, 1, 2) == "~/" && home != "") p = home substr(p, 2)
    if (p !~ /^\// && p !~ /^[A-Za-z]:[\\\/]/ && p !~ /^\\\\/) {
        if (dir == "") return ""
        while (substr(p, 1, 2) == "./") p = substr(p, 3)
        d = dir; sub(/[\\\/]+$/, "", d); p = d "/" p
    }
    if (p ~ /^[A-Za-z]:[\\\/]/ || p ~ /^\\\\/) gsub(/\\/, "/", p)
    while ((i = index(p, "/./")) > 0) p = substr(p, 1, i) substr(p, i + 3)
    return p
}
function key(p) { return (p ~ /^[A-Za-z]:\// || p ~ /^\/\//) ? tolower(p) : p }
function pick(g, p,   k) { p = abs(p); if (p == "") return; k = key(p); if (k in seen) return; seen[k] = 1; print "F\t" g "\t" p }
# the rows: "time TAB turn TAB tag TAB path", a turn start "time TAB n TAB turn TAB at TAB text"; then "F TAB tag TAB
# path" for files, and the turns newest first (n 0 last), "T TAB n TAB at TAB text" and its files "P TAB tag TAB path"
# (newest first, one per path; a sub-agent touch: in the turn that started last before it, the rows are in time order)
$0 == "--git--" { git = 1; next }
git { m++; gp[m] = substr($0, 5); next }
$3 == "turn" { cur = $2; if ($2 > top) top = $2; at[$2] = $4; tx[$2] = $5; next }
{ n++; tg[n] = $3; pa[n] = substr($0, length($1) + length($2) + length($3) + 4); tu[n] = $2 == "-" ? cur + 0 : $2 + 0 }
END {
    for (i = n; i >= 1; i--) pick(tg[i], pa[i])
    for (i = 1; i <= m; i++) pick("git", gp[i])
    for (i = n; i >= 1; i--) {
        p = abs(pa[i]); if (p == "") continue
        k = tu[i] SUBSEP key(p); if (k in ts) continue; ts[k] = 1; tl[tu[i], ++tc[tu[i]]] = tg[i] "\t" p
    }
    for (u = top + 0; u >= 0; u--) {
        if (!tc[u]) continue
        print "T\t" u "\t" at[u] "\t" tx[u]; for (i = 1; i <= tc[u]; i++) print "P\t" tl[u, i]
    }
}'
files_rows() { # files_rows TOOL LOG : the rows of every file the log (and, Claude, its sub-agents) shows, oldest first
    local f i=0 m prog
    case $1 in claude) prog=$FILES_CLAUDE;; codex) prog=$FILES_CODEX;; omp) prog=$FILES_OMP;; *) return 0;; esac
    [ -n "$2" ] && [ -f "$2" ] || return 0
    { if [ "$1" = claude ]; then ls -tr "$2" "${2%.jsonl}/subagents/"*.jsonl 2>/dev/null; else printf '%s\n' "$2"; fi; } |
    while IFS= read -r f; do
        [ -f "$f" ] || continue; i=$((i + 1)); m=0; [ "$f" = "$2" ] && m=1
        ctx_scan "$f" "BEGIN { fi = $i; main = $m }$CTX_AWK$FILES_AWK$prog"
